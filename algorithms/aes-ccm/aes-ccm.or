// AES-CCM: Counter with CBC-MAC, the authenticated-encryption mode of NIST
// SP 800-38C (2004, updated 2007), https://doi.org/10.6028/NIST.SP.800-38C,
// with AES-128 of FIPS 197 as the block cipher; RFC 3610 (Whiting, Housley
// and Ferguson, 2003) is the original definition. The block cipher is the
// module aes (aes.or beside this file), the forward cipher only: CCM never
// inverts it. This file transcribes the formatting function of Appendix A.2
// (B_0, the associated-data blocks and the payload blocks), the counter
// blocks of A.3, the CBC-MAC and counter-mode steps of section 6.1, the
// generation-encryption process of section 6.1 and the
// decryption-verification process of section 6.2. Lengths are sizes: the
// parts of the formatting function and counter mode are written for a nonce
// of 7 to 13 bytes and associated data and payload of 1 to 32 bytes, and
// the two processes for the lengths of the vectors (see generation_encryption
// for why).
//
// It reproduces the examples C.1, C.2 and C.3 of Appendix C, test case 12 of
// Wycheproof's aes_ccm_test.json, the decryption-verification of C.1 (VALID,
// with its payload), and the rejection of Wycheproof's test case 52, whose
// tag has one bit flipped.
edition 2026;
module aes_ccm {
  use aes;

  type Block = Word[8]^16;

  // Section 5.1: CIPH_K, the forward cipher function of the block cipher
  // under the key K, here AES-128 (FIPS 197 section 5).
  spec ciph(key: Word[8]^16, x: Block) -> Block { aes::aes128(key, x) }

  // From the standard's list of symbols: X ^ Y, the bitwise exclusive-or of
  // two strings of one length.
  spec xor[l in 1..33](x: Word[8]^l, y: Word[8]^l) -> Word[8]^l {
    for i in 0..(l) with z: Word[8]^l = x { z with [i] = x[i] ^ y[i] }
  }

  // From the standard's list of symbols: len(X), here in octets rather than
  // bits, a for A and Plen / 8 for P.
  spec octets[l in 1..33](x: Word[8]^l) -> Int { l }

  // Appendix A.1: the nonce N has n bytes, 7 <= n <= 13, and q = 15 - n
  // bytes encode a length or a counter, so that B_0 (A.2.1) and the counter
  // blocks Ctr_i (A.3) share one layout, Flags || N || [x]_8q, the integer x
  // big-endian in q bytes. The nonce's length n is a size, and q follows
  // from it.
  spec flags_nonce_integer[n in 7..14](flags: Int, nonce: Word[8]^n, x: Int) -> Block {
    (flags as big Word[8]^1) ++ nonce ++ (x as big Word[8]^(15 - n))
  }

  // Appendix A.2.1: B_0 = Flags || N || Q, where Q = [Plen / 8]_8q is the
  // payload length in octets (plen here) and the flags byte is
  // 0 || Adata || [(t - 2) / 2]_3 || [q - 1]_3 (Table 1), with Adata = 1
  // when a > 0 and t = Tlen / 8 the tag length in bytes.
  spec b_0[n in 7..14](nonce: Word[8]^n, a: Int, t: Int, plen: Int) -> Block {
    let adata: Int = if a > 0 { 1 } else { 0 };
    let q: Int = 15 - n;
    flags_nonce_integer(64 * adata + 8 * ((t - 2) / 2) + (q - 1), nonce, plen)
  }

  // Appendix A.2.2, for 0 < a < 2^16 - 2^8: the associated data is encoded
  // as [a]_16 || A and padded with zeros to a multiple of 16 bytes,
  // ceil((2 + a) / 16) blocks. A has at most 32 bytes here, so the longer
  // encodings of a (0xff 0xfe || [a]_32 and 0xff 0xff || [a]_64) do not
  // arise. When a = 0 there are no such blocks (see
  // decryption_verification_without_a).
  spec associated_data_blocks[a in 1..33](x: Word[8]^a) -> Word[8]^(16 * ((a + 17) / 16)) {
    let length: Int = a;
    ([0; (16 * ((a + 17) / 16))] with [0..2] = (length as big Word[8]^2)) with [2..a + 2] = x
  }

  // Appendix A.2.3: the payload padded with zeros to a multiple of 16 bytes,
  // ceil(Plen / 128) blocks.
  spec payload_blocks[p in 1..33](x: Word[8]^p) -> Word[8]^(16 * ((p + 15) / 16)) {
    [0; (16 * ((p + 15) / 16))] with [0..p] = x
  }

  // Section 6.1, steps 2 and 3 (and section 6.2, steps 8 and 9): the CBC-MAC
  // over the formatted blocks B_0 || ... || B_r, here blocks = r + 1 of them.
  // Y_0 = CIPH_K(B_0) and Y_i = CIPH_K(B_i ^ Y_(i-1)); starting the chain
  // from sixteen zero bytes makes the first step Y_0 = CIPH_K(B_0 ^ 0^128),
  // the same block. The result is Y_r; MSB_Tlen of it (step 4) is taken by
  // the caller, which knows Tlen.
  spec cbc_mac[blocks in 1..7](key: Word[8]^16, b: Word[8]^(16 * blocks)) -> Block {
    for i in 0..(blocks) with y: Block = [0; 16] { ciph(key, xor(b[16 * i..16 * i + 16], y)) }
  }

  // Appendix A.3: the counter blocks Ctr_i = Flags || N || [i]_8q, whose
  // flags byte is 0 || 0 || 000 || [q - 1]_3 (Table 2).
  spec ctr[n in 7..14](nonce: Word[8]^n, i: Int) -> Block {
    let q: Int = 15 - n;
    flags_nonce_integer(q - 1, nonce, i)
  }

  // Section 6.1, steps 5 to 7 (and section 6.2, steps 2 to 4): the counter
  // blocks Ctr_1, ..., Ctr_m, S_j = CIPH_K(Ctr_j), and
  // S = S_1 || S_2 || ... || S_m. Ctr_0 and S_0 are the caller's, for the
  // tag. m is at most 2 here, payloads having at most 32 bytes.
  spec keystream[n in 7..14, m in 1..3](key: Word[8]^16, nonce: Word[8]^n) -> Word[8]^(16 * m) {
    for j in 0..(m) with s: Word[8]^(16 * m) = [0; (16 * m)] {
      s with [16 * j..16 * j + 16] = ciph(key, ctr(nonce, j + 1))
    }
  }

  // Section 6.1, step 8, first half (and section 6.2, step 5): a payload of
  // p bytes exclusive-ored with MSB_Plen(S), S of m = ceil(Plen / 128)
  // blocks.
  spec counter_mode[n in 7..14, p in 1..33](key: Word[8]^16, nonce: Word[8]^n, x: Word[8]^p)
    -> Word[8]^p {
    xor(x, keystream[n, (p + 15) / 16](key, nonce)[..p])
  }

  // Section 6.1: the generation-encryption process. Step 1 applies the
  // formatting function of Appendix A.2 to (N, A, P), giving B_0 followed by
  // the associated-data blocks and the payload blocks; steps 2 to 4 are the
  // CBC-MAC and T = MSB_Tlen(Y_r); steps 5 to 7 make the counter blocks and
  // S_0, S_1, ..., S_m; and step 8 returns
  // C = (P ^ MSB_Plen(S)) || (T ^ MSB_Tlen(S_0)), Clen = Plen + Tlen.
  //
  // A function has at most 256 instances, counting every combination of its
  // sizes, and this process depends on four lengths: n, a, Plen / 8 and
  // t = Tlen / 8. Ranges over every length from the shortest to the longest
  // of the vectors would make 6 x 13 x 21 x 13 instances, and a and Plen / 8
  // alone 13 x 21. So the process takes N, A and P at the lengths of the
  // vectors, listed as types (nonces of 7, 8 and 12 bytes, associated data
  // of 8, 16 and 20, payloads of 4, 16 and 24), and the tag length as the
  // size u, t = 2u bytes: u = 2 through 8 are the seven tag lengths of
  // Appendix A.1, 4, 6, ..., 16 bytes, whose flags field [(t - 2) / 2]_3 is
  // u - 1. The steps it calls are sized, and each instance picks theirs from
  // the lengths of its arguments. For the same reason C is returned as the
  // pair (ciphertext, tag), the two halves of C: an Orange type cannot write
  // the length Plen / 8 + t of their join when Plen / 8 is a listed type.
  // The type parameters N, A and P carry the standard's names, so the
  // strings themselves are nonce, assoc and payload; a and Plen / 8 remain
  // their lengths, as in b_0.
  spec generation_encryption[
    N in {Word[8]^7, Word[8]^8, Word[8]^12},
    A in {Word[8]^8, Word[8]^16, Word[8]^20},
    P in {Word[8]^4, Word[8]^16, Word[8]^24},
    u in 2..9
  ](key: Word[8]^16, nonce: N, assoc: A, payload: P) -> (P, Word[8]^(2 * u)) {
    let y: Block = cbc_mac(
      key,
      b_0(nonce, octets(assoc), 2 * u, octets(payload))
        ++ associated_data_blocks(assoc)
        ++ payload_blocks(payload),
    );
    let t: Word[8]^(2 * u) = y[..2 * u];
    let s_0: Block = ciph(key, ctr(nonce, 0));
    (counter_mode(key, nonce, payload), xor(t, s_0[..2 * u]))
  }

  // Section 6.2: the decryption-verification process, on C given as its two
  // halves, ciphertext = MSB_(Clen - Tlen)(C) and tag = LSB_Tlen(C), the
  // pair generation_encryption returns; they are two parameters rather than
  // one pair because the length of an array inside a tuple does not choose
  // an instance, and the tag's length is what picks u. Step 1 rejects
  // Clen <= Tlen; here the ciphertext has at least one byte by its type, so
  // the step cannot fail. Steps 2 to 5 recover P (payload) by counter mode,
  // step 6 unmasks the received tag, T = LSB_Tlen(C) ^ MSB_Tlen(S_0), steps
  // 7 to 9 format N, A and P and recompute the CBC-MAC (the validity checks
  // of step 7 hold by the listed lengths), and step 10 compares T with
  // MSB_Tlen(Y_r), whole.
  // The standard returns either P or INVALID; Orange has no sum type, so the
  // result is the pair (verdict, P), VALID as true, and P counts only when
  // the verdict is true.
  spec decryption_verification[
    N in {Word[8]^7, Word[8]^8, Word[8]^12},
    A in {Word[8]^8, Word[8]^16, Word[8]^20},
    P in {Word[8]^4, Word[8]^16, Word[8]^24},
    u in 2..9
  ](key: Word[8]^16, nonce: N, assoc: A, ciphertext: P, tag: Word[8]^(2 * u)) -> (Bool, P) {
    let payload: P = counter_mode(key, nonce, ciphertext);
    let s_0: Block = ciph(key, ctr(nonce, 0));
    let t: Word[8]^(2 * u) = xor(tag, s_0[..2 * u]);
    let y: Block = cbc_mac(
      key,
      b_0(nonce, octets(assoc), 2 * u, octets(payload))
        ++ associated_data_blocks(assoc)
        ++ payload_blocks(payload),
    );
    (t == y[..2 * u], payload)
  }

  // Section 6.2 with a = 0: Adata is 0 in B_0 and the formatting function
  // has no associated-data blocks (A.2.1, A.2.2). An Orange array has at
  // least one element, so the empty A is not a value, and this is the
  // process above without the parameter A. Only a rejection (Wycheproof's
  // test case 52) exercises it here: no published vector in this entry
  // takes its accepting side.
  spec decryption_verification_without_a[
    N in {Word[8]^7, Word[8]^8, Word[8]^12},
    P in {Word[8]^4, Word[8]^16, Word[8]^24},
    u in 2..9
  ](key: Word[8]^16, nonce: N, ciphertext: P, tag: Word[8]^(2 * u)) -> (Bool, P) {
    let payload: P = counter_mode(key, nonce, ciphertext);
    let s_0: Block = ciph(key, ctr(nonce, 0));
    let t: Word[8]^(2 * u) = xor(tag, s_0[..2 * u]);
    let y: Block = cbc_mac(key, b_0(nonce, 0, 2 * u, octets(payload)) ++ payload_blocks(payload));
    (t == y[..2 * u], payload)
  }

  // The vectors. Each generation test binds its result to a name whose type
  // gives the lengths of C's two halves, which fixes Tlen; the halves are C
  // as the source prints it, cut after Plen / 8 bytes.

  // SP 800-38C Appendix C.1: Klen 128, Tlen 32, Nlen 56, Alen 64, Plen 32.
  test "SP 800-38C C.1: generation-encryption" {
    let c: (Word[8]^4, Word[8]^4) = generation_encryption(
      hex"40414243 44454647 48494a4b 4c4d4e4f",
      hex"10111213 141516",
      hex"00010203 04050607",
      hex"20212223",
    );
    c == (hex"7162015b", hex"4dac255d")
  }

  // SP 800-38C Appendix C.2: Klen 128, Tlen 48, Nlen 64, Alen 128, Plen 128.
  test "SP 800-38C C.2: generation-encryption" {
    let c: (Word[8]^16, Word[8]^6) = generation_encryption(
      hex"40414243 44454647 48494a4b 4c4d4e4f",
      hex"10111213 14151617",
      hex"00010203 04050607 08090a0b 0c0d0e0f",
      hex"20212223 24252627 28292a2b 2c2d2e2f",
    );
    c == (hex"d2a1f0e0 51ea5f62 081a7792 073d593d", hex"1fc64fbf accd")
  }

  // SP 800-38C Appendix C.3: Klen 128, Tlen 64, Nlen 96, Alen 160, Plen 192.
  test "SP 800-38C C.3: generation-encryption" {
    let c: (Word[8]^24, Word[8]^8) = generation_encryption(
      hex"40414243 44454647 48494a4b 4c4d4e4f",
      hex"10111213 14151617 18191a1b",
      hex"00010203 04050607 08090a0b 0c0d0e0f 10111213",
      hex"20212223 24252627 28292a2b 2c2d2e2f 30313233 34353637",
    );
    c == (hex"e3b201a9 f5b71a7a 9b1ceaec cd97e70b 6176aad9 a4428aa5", hex"484392fb c1b09951")
  }

  // Wycheproof aes_ccm_test.json, tcId 12: AES-128, a 12-byte nonce, 8 bytes
  // of aad, a 16-byte msg and a 16-byte tag; ct and tag as printed.
  test "Wycheproof tcId 12: generation-encryption" {
    let c: (Word[8]^16, Word[8]^16) = generation_encryption(
      hex"9415f925 bcb41dc2 5e86c826 dbc8bf68",
      hex"bdffaa76 3b916ff0 ee3f3ce4",
      hex"705d676c d8a94451",
      hex"feb36167 eafc02c8 e2bd6e13 817686ba",
    );
    c == (hex"08db327a 88be7b48 f430fd7b fccdf502", hex"b7c249f8 10adacf9 9abded1f 3b9130f2")
  }

  // SP 800-38C Appendix C.1, decrypted: the ciphertext 7162015b with the tag
  // 4dac255d is VALID (step 10) and gives back the payload P (step 5).
  test "SP 800-38C C.1: decryption-verification" {
    decryption_verification(
      hex"40414243 44454647 48494a4b 4c4d4e4f",
      hex"10111213 141516",
      hex"00010203 04050607",
      hex"7162015b",
      hex"4dac255d",
    ) == (true, hex"20212223")
  }

  // Wycheproof aes_ccm_test.json, tcId 52, "Flipped bit 0 in tag", result
  // invalid: no aad, a 16-byte ct and a 16-byte tag; step 10 returns
  // INVALID.
  test "Wycheproof tcId 52: decryption-verification rejects" {
    !decryption_verification_without_a(
      hex"00010203 04050607 08090a0b 0c0d0e0f",
      hex"50515253 54555657 58595a5b",
      hex"3ee9f343 0f3e803c 0a46b7a8 4cd803de",
      hex"3d6d5f66 430ad65b b0340772 97f0929a",
    ).0
  }
}
