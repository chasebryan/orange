// OEP-0022 P2 representations and partial P4 mathematical field operations
// for p = 2^255 - 19: products, biased subtraction, dedicated squaring, and
// multiplication by the ladder constant a24 = 121665. Limb order is least
// significant first. This radix and these carry schedules are original
// executable definitions, not an RFC 7748 storage requirement. The aliases
// are transparent; none enforces a range. Boolean examples are not
// refinement proofs, and reference evaluation establishes no machine layout,
// constant-time, or native-code property.
edition 2026;
module field25519 {
  type Limbs = Word[64]^5;
  type ProductAccumulators = Int^5;
  type Field = Mod[57896044618658097711785492504343953926634992332820282019728792003956564819949];

  spec radix() -> Int { 2251799813685248 }
  spec prime() -> Int {
    57896044618658097711785492504343953926634992332820282019728792003956564819949
  }

  // N(x) = sum Int(x[i]) * B^i, computed by exact Horner reconstruction.
  spec reconstruct(x: Limbs) -> Int {
    for i in 0..5 with n: Int = 0 { n * radix() + (x[4 - i] as Int) }
  }

  // Conversion into the existing residue ring reduces the reconstruction.
  spec alpha(x: Limbs) -> Field { reconstruct(x) as Field }

  spec tight(x: Limbs) -> Bool {
    for i in 0..5 with valid: Bool = true { valid && ((x[i] as Int) < radix()) }
  }

  spec loose(x: Limbs) -> Bool {
    for i in 0..5 with valid: Bool = true { valid && ((x[i] as Int) < (2 * radix())) }
  }

  spec canonical(x: Limbs) -> Bool { tight(x) && (reconstruct(x) < prime()) }

  // Intended input contract: tight(x) && tight(y). Under that contract
  // each exact sum is below 2^52, so the Word[64] conversion loses no bits.
  // The current language does not automatically check this precondition.
  spec add_tight(x: Limbs, y: Limbs) -> Limbs {
    for i in 0..5 with sum: Limbs = [0; 5] {
      sum with [i] = ((x[i] as Int) + (y[i] as Int)) as Word[64]
    }
  }

  // Fold the exact convolution using B^5 = p + 19. Intended input
  // contract: tight(x) && tight(y). Each scalar product is at most
  // M = (B - 1)^2 < 2^102. Coefficient k has k + 1 ordinary terms and
  // 4 - k terms weighted by 19, so its exact maximum is respectively
  // [77, 59, 41, 23, 5] * M, below 2^109. No accumulator is narrowed
  // to Word[64]; a wrapping word product would not implement this sum.
  spec product_accumulators(x: Limbs, y: Limbs) -> ProductAccumulators {
    for k in 0..5 with product: ProductAccumulators = [0; 5] {
      let coefficient: Int = for i in 0..5 with sum: Int = 0 {
        let weight: Int = if i > k { 19 } else { 1 };
        sum + weight * (x[i] as Int) * (y[(k + 5 - i) % 5] as Int)
      };
      product with [k] = coefficient
    }
  }

  // Under bounded_product(h), this reconstruction is below 6B^6,
  // less than 2^309, well inside the existing exact Int magnitude limit.
  spec reconstruct_product(h: ProductAccumulators) -> Int {
    for i in 0..5 with n: Int = 0 { n * radix() + h[4 - i] }
  }

  // This ordinary predicate records the intended normalization contract.
  // The transparent alias does not enforce it, even for a value whose
  // residue happens to agree with an independently computed product.
  spec bounded_product(h: ProductAccumulators) -> Bool {
    let weights: Int^5 = [77, 59, 41, 23, 5];
    let maximum: Int = (radix() - 1) * (radix() - 1);
    for i in 0..5 with valid: Bool = true {
      valid && (h[i] >= 0) && (h[i] <= (weights[i] * maximum))
    }
  }

  // One exact carry pass; the tuple retains both the digits and overflow.
  // The returned digits are below B and its carry records the coefficient
  // of B^5. No Word[64] addition or multiplication is used for carries.
  spec carry_pass(x: Limbs, incoming: Int) -> (Limbs, Int) {
    for i in 0..5 with state: (Limbs, Int) = ([0; 5], incoming) {
      let digit: Int = (x[i] as Int) + state.1;
      (state.0 with [i] = (digit % radix()) as Word[64], digit / radix())
    }
  }

  // Intended input contract: every h[i] and incoming is nonnegative.
  // Every narrowing is of digit % B, which is in [0, B), below 2^51.
  // Products and carries remain exact Int values throughout this pass.
  spec carry_accumulators(h: ProductAccumulators, incoming: Int) -> (Limbs, Int) {
    for i in 0..5 with state: (Limbs, Int) = ([0; 5], incoming) {
      let digit: Int = h[i] + state.1;
      (state.0 with [i] = (digit % radix()) as Word[64], digit / radix())
    }
  }

  // Intended input contract: bounded_product(h). With incoming zero,
  // successive first-pass carries are at most
  // [77B-154, 59B-42, 41B-24, 23B-6, 5B+12]. All sums are below 2^109.
  // Thus the first fold adds at most 95B+228, below 2^58. The second
  // pass's low carry is at most 96, all later carries at most 1, and
  // its top carry is at most 1. Its digits are each below B.
  // If that top carry is 1, the reconstructed second digits are below
  // 95B+228; folding its 19 therefore stays below B^5. If it is zero,
  // no further input is added. The third top carry is consequently zero.
  // The third pass is required: adding 19 only to the second low digit
  // can exceed B even though it fits Word[64] and has the right residue.
  // This tuple exposes all three digit arrays and their exact top carries.
  spec product_carry_trace(h: ProductAccumulators) -> (Limbs, Int, Limbs, Int, Limbs, Int) {
    let first: (Limbs, Int) = carry_accumulators(h, 0);
    let second: (Limbs, Int) = carry_pass(first.0, 19 * first.1);
    let third: (Limbs, Int) = carry_pass(second.0, 19 * second.1);
    (first.0, first.1, second.0, second.1, third.0, third.1)
  }

  // Under bounded_product(h), the discarded final top carry is zero,
  // the result is tight, and reconstruction retains its residue modulo p.
  spec carry_product(h: ProductAccumulators) -> Limbs { product_carry_trace(h).4 }

  // Intended input contract: tight(x) && tight(y), without requiring
  // canonical inputs. These are executable definitions, not checked
  // representation contracts or a native wide multiplication primitive.
  spec multiply_tight(x: Limbs, y: Limbs) -> Limbs {
    carry_product(product_accumulators(x, y))
  }

  // A tight result reconstructs below B^5 = p + 19, so the existing
  // single subtraction and digit extraction yield the canonical result.
  spec multiply_canonical(x: Limbs, y: Limbs) -> Limbs {
    canonicalize_tight(multiply_tight(x, y))
  }

  // RFC 7748 section 5: a24 = (A - 2) / 4 = 121665. Kept as an exact Int
  // factor; wrapping Word[64] multiplication is not this operation.
  spec a24() -> Int { 121665 }

  // 2p as five limbs. Reconstructs to 2 * (B^5 - 19) = 2p, so subtracting
  // y and adding this bias preserves the residue class of x - y.
  spec two_p() -> Limbs {
    [4503599627370458, 4503599627370494, 4503599627370494, 4503599627370494, 4503599627370494]
  }

  // Intended input contract: tight(x) && tight(y). Each limb equals
  // x[i] + 2p[i] - y[i] and therefore lies in [B - 37, 3B - 3] ⊂ [0, 4B).
  // That range is wider than loose; the biased difference is not a loose
  // value by convention and does not reuse carry_loose's contract.
  spec sub_biased(x: Limbs, y: Limbs) -> Limbs {
    for i in 0..5 with diff: Limbs = [0; 5] {
      diff with [i] = ((x[i] as Int) + (two_p()[i] as Int) - (y[i] as Int)) as Word[64]
    }
  }

  // Ordinary predicate for the biased-difference bound. The Limbs alias
  // does not enforce it.
  spec bounded_difference(x: Limbs) -> Bool {
    for i in 0..5 with valid: Bool = true { valid && ((x[i] as Int) < (4 * radix())) }
  }

  // Carry schedule for nonnegative limbs below 4B. Under that bound the
  // first top carry is at most 3 and the second at most 1; adding 19 times
  // the second carry into the low digit stays below B, so the result is
  // tight and retains the residue class modulo p.
  spec carry_difference(x: Limbs) -> Limbs {
    let first: (Limbs, Int) = carry_pass(x, 0);
    let second: (Limbs, Int) = carry_pass(first.0, 19 * first.1);
    second.0 with [0] = ((second.0[0] as Int) + 19 * second.1) as Word[64]
  }

  // Intended input contract: tight(x) && tight(y). Executable biased
  // subtraction with its own carry schedule; not a checked P3 contract.
  spec subtract_tight(x: Limbs, y: Limbs) -> Limbs {
    carry_difference(sub_biased(x, y))
  }

  spec subtract_canonical(x: Limbs, y: Limbs) -> Limbs {
    canonicalize_tight(subtract_tight(x, y))
  }

  // Dedicated square: the same folded convolution as product_accumulators,
  // counting each off-diagonal pair once with the factor 2. Complementary
  // positions share the same 1-or-19 weight, so the doubling is exact.
  // Intended input contract: tight(x). Bounds match bounded_product.
  spec square_accumulators(x: Limbs) -> ProductAccumulators {
    for k in 0..5 with product: ProductAccumulators = [0; 5] {
      let coefficient: Int = for i in 0..5 with sum: Int = 0 {
        let weight: Int = if i > k { 19 } else { 1 };
        if i < ((k + 5 - i) % 5) {
          sum + weight * 2 * (x[i] as Int) * (x[(k + 5 - i) % 5] as Int)
        } else {
          if i == ((k + 5 - i) % 5) {
            sum + weight * (x[i] as Int) * (x[i] as Int)
          } else {
            sum
          }
        }
      };
      product with [k] = coefficient
    }
  }

  spec square_tight(x: Limbs) -> Limbs { carry_product(square_accumulators(x)) }

  spec square_canonical(x: Limbs) -> Limbs { canonicalize_tight(square_tight(x)) }

  // Intended input contract: tight(x). Each coefficient is x[i] * a24 and
  // at most (B - 1) * 121665 < 2^68, so it does not fit in Word[64].
  spec mul_a24_accumulators(x: Limbs) -> ProductAccumulators {
    for i in 0..5 with h: ProductAccumulators = [0; 5] {
      h with [i] = (x[i] as Int) * a24()
    }
  }

  spec bounded_a24(h: ProductAccumulators) -> Bool {
    for i in 0..5 with valid: Bool = true {
      valid && (h[i] >= 0) && (h[i] <= ((radix() - 1) * a24()))
    }
  }

  // Reuses the three-pass product carry. Under bounded_a24 the first top
  // carry is at most 121664, the second at most 1, and the third zero.
  spec mul_a24_tight(x: Limbs) -> Limbs { carry_product(mul_a24_accumulators(x)) }

  spec mul_a24_canonical(x: Limbs) -> Limbs { canonicalize_tight(mul_a24_tight(x)) }

  // Intended input contract: loose(x). Fold B^5 into 19 twice, using
  // B^5 = p + 19, and return tight digits with the same abstraction.
  // On loose inputs the first carry is at most 2 and the second at most
  // 1. If the second is 1, its low digit is below 38; the final addition
  // of 19 stays below B. These are mathematical schedule bounds, not
  // checked contracts in the current language.
  spec carry_loose(x: Limbs) -> Limbs {
    let first: (Limbs, Int) = carry_pass(x, 0);
    let second: (Limbs, Int) = carry_pass(first.0, 19 * first.1);
    second.0 with [0] = ((second.0[0] as Int) + 19 * second.1) as Word[64]
  }

  // Split a nonnegative integer below B^5 into exactly five radix digits.
  spec digits(n: Int) -> Limbs {
    let split: (Limbs, Int) = for i in 0..5 with state: (Limbs, Int) = ([0; 5], n) {
      (state.0 with [i] = (state.1 % radix()) as Word[64], state.1 / radix())
    };
    split.0
  }

  // Intended input contract: tight(x). N(x) is below p + 19, so one
  // conditional subtraction yields the unique nonnegative residue.
  // Noncanonical inputs are accepted; this is not a coordinate decoder.
  spec canonicalize_tight(x: Limbs) -> Limbs {
    let n: Int = reconstruct(x);
    digits(if n >= prime() { n - prime() } else { n })
  }

  spec canonical_output(x: Limbs) -> Limbs { canonicalize_tight(carry_loose(x)) }

  spec zero() -> Limbs { [0; 5] }
  spec p_minus_one() -> Limbs {
    [2251799813685228, 2251799813685247, 2251799813685247, 2251799813685247, 2251799813685247]
  }
  spec p_limbs() -> Limbs {
    [2251799813685229, 2251799813685247, 2251799813685247, 2251799813685247, 2251799813685247]
  }
  spec p_plus_one() -> Limbs {
    [2251799813685230, 2251799813685247, 2251799813685247, 2251799813685247, 2251799813685247]
  }
  spec maximum_tight() -> Limbs { [2251799813685247; 5] }

  spec reconstruction_vectors() -> Int^5 {
    [reconstruct(zero()), reconstruct(p_minus_one()), reconstruct(p_limbs()),
     reconstruct(p_plus_one()), reconstruct(maximum_tight())]
  }
  spec reconstruction_vectors_expected() -> Int^5 {
    [0,
     57896044618658097711785492504343953926634992332820282019728792003956564819948,
     57896044618658097711785492504343953926634992332820282019728792003956564819949,
     57896044618658097711785492504343953926634992332820282019728792003956564819950,
     57896044618658097711785492504343953926634992332820282019728792003956564819967]
  }

  spec abstraction_vectors() -> Field^5 {
    [alpha(zero()), alpha(p_minus_one()), alpha(p_limbs()), alpha(p_plus_one()), alpha(maximum_tight())]
  }
  spec abstraction_vectors_expected() -> Field^5 {
    [0, 57896044618658097711785492504343953926634992332820282019728792003956564819948, 0, 1, 18]
  }

  spec predicate_vectors() -> Bool^12 {
    [tight(zero()), loose(zero()), canonical(zero()), canonical(p_minus_one()),
     tight(p_limbs()), canonical(p_limbs()), tight(maximum_tight()), canonical(maximum_tight()),
     tight([2251799813685248; 5]), loose([2251799813685248; 5]),
     loose([4503599627370496; 5]), loose([4503599627370497; 5])]
  }
  spec predicate_vectors_expected() -> Bool^12 {
    [true, true, true, true, true, false, true, false, false, true, false, false]
  }

  spec exact_addition() -> Limbs { add_tight(p_minus_one(), p_minus_one()) }
  spec exact_addition_expected() -> Limbs {
    [4503599627370456, 4503599627370494, 4503599627370494, 4503599627370494, 4503599627370494]
  }
  spec carried_addition() -> Limbs { carry_loose(exact_addition()) }
  spec carried_addition_expected() -> Limbs {
    [2251799813685227, 2251799813685247, 2251799813685247, 2251799813685247, 2251799813685247]
  }

  spec canonical_boundaries() -> (Limbs, Limbs, Limbs, Limbs) {
    (canonicalize_tight(p_minus_one()), canonicalize_tight(p_limbs()),
     canonicalize_tight(p_plus_one()), canonicalize_tight(maximum_tight()))
  }
  spec canonical_boundaries_expected() -> (Limbs, Limbs, Limbs, Limbs) {
    (p_minus_one(), [0; 5], [1, 0, 0, 0, 0], [18, 0, 0, 0, 0])
  }

  // This forces both top-carry folds, rather than only ordinary carries.
  spec second_fold() -> Limbs {
    carry_loose([2251799813685247, 4503599627370495, 4503599627370494,
                 4503599627370494, 4503599627370494])
  }
  spec second_fold_expected() -> Limbs { [37, 0, 0, 0, 0] }

  spec product_accumulator_maxima() -> ProductAccumulators {
    product_accumulators(maximum_tight(), maximum_tight())
  }
  spec product_accumulator_maxima_expected() -> ProductAccumulators {
    [390436384870294308883813279727693, 299165541653861873040843941609531,
     207894698437429437197874603491369, 116623855220997001354905265373207,
     25353012004564565511935927255045]
  }

  spec product_maximum_trace() -> (Limbs, Int, Limbs, Int, Limbs, Int) {
    product_carry_trace(product_accumulator_maxima())
  }
  spec product_maximum_trace_expected() -> (Limbs, Int, Limbs, Int, Limbs, Int) {
    ([77, 2251799813685153, 2251799813685247, 2251799813685247, 2251799813685247],
     11258999068426252, [305, 0, 0, 0, 0], 1, [324, 0, 0, 0, 0], 0)
  }

  spec product_maximum() -> Limbs { multiply_canonical(maximum_tight(), maximum_tight()) }
  spec product_maximum_expected() -> Limbs { [324, 0, 0, 0, 0] }

  spec product_third_pass() -> Limbs {
    multiply_tight(maximum_tight(), [125099989649181, 0, 0, 0, 0])
  }
  spec product_third_pass_expected() -> Limbs { [10, 1, 0, 0, 0] }

  spec product_boundaries() -> (Limbs, Limbs, Limbs, Limbs, Limbs) {
    (multiply_canonical(zero(), maximum_tight()), multiply_canonical(p_minus_one(), p_minus_one()),
     multiply_canonical(p_limbs(), p_limbs()), multiply_canonical(p_plus_one(), p_plus_one()),
     multiply_canonical(maximum_tight(), maximum_tight()))
  }
  spec product_boundaries_expected() -> (Limbs, Limbs, Limbs, Limbs, Limbs) {
    (zero(), [1, 0, 0, 0, 0], zero(), [1, 0, 0, 0, 0], [324, 0, 0, 0, 0])
  }

  // Biased difference of zero is the limb form of 2p; after carrying it is
  // the noncanonical tight representation of p, then canonical zero.
  spec subtract_zero() -> Limbs { subtract_tight(zero(), zero()) }
  spec subtract_zero_expected() -> Limbs { p_limbs() }

  spec subtract_boundaries() -> (Limbs, Limbs, Limbs, Limbs, Limbs) {
    (subtract_canonical(zero(), zero()), subtract_canonical(zero(), [1, 0, 0, 0, 0]),
     subtract_canonical(p_minus_one(), p_minus_one()), subtract_canonical(maximum_tight(), maximum_tight()),
     subtract_canonical(zero(), maximum_tight()))
  }
  spec subtract_boundaries_expected() -> (Limbs, Limbs, Limbs, Limbs, Limbs) {
    (zero(), p_minus_one(), zero(), zero(),
     [2251799813685211, 2251799813685247, 2251799813685247, 2251799813685247, 2251799813685247])
  }

  // Forces the high end of the biased-difference limb bound before carrying.
  spec subtract_wide() -> Limbs { sub_biased(maximum_tight(), zero()) }
  spec subtract_wide_expected() -> Limbs {
    [6755399441055705, 6755399441055741, 6755399441055741, 6755399441055741, 6755399441055741]
  }

  spec square_accumulator_maxima() -> ProductAccumulators {
    square_accumulators(maximum_tight())
  }
  spec square_accumulator_maxima_expected() -> ProductAccumulators {
    product_accumulator_maxima_expected()
  }

  spec square_maximum() -> Limbs { square_canonical(maximum_tight()) }
  spec square_maximum_expected() -> Limbs { [324, 0, 0, 0, 0] }

  spec square_boundaries() -> (Limbs, Limbs, Limbs, Limbs) {
    (square_canonical(zero()), square_canonical(p_minus_one()), square_canonical(p_limbs()),
     square_canonical(maximum_tight()))
  }
  spec square_boundaries_expected() -> (Limbs, Limbs, Limbs, Limbs) {
    (zero(), [1, 0, 0, 0, 0], zero(), [324, 0, 0, 0, 0])
  }

  spec a24_accumulator_maxima() -> ProductAccumulators {
    mul_a24_accumulators(maximum_tight())
  }
  spec a24_accumulator_maxima_expected() -> ProductAccumulators {
    [273965224332015576255, 273965224332015576255, 273965224332015576255,
     273965224332015576255, 273965224332015576255]
  }

  spec a24_maximum() -> Limbs { mul_a24_canonical(maximum_tight()) }
  spec a24_maximum_expected() -> Limbs { [2189970, 0, 0, 0, 0] }

  spec a24_boundaries() -> (Limbs, Limbs, Limbs, Limbs) {
    (mul_a24_canonical(zero()), mul_a24_canonical([1, 0, 0, 0, 0]), mul_a24_canonical(p_limbs()),
     mul_a24_canonical(maximum_tight()))
  }
  spec a24_boundaries_expected() -> (Limbs, Limbs, Limbs, Limbs) {
    (zero(), [121665, 0, 0, 0, 0], zero(), [2189970, 0, 0, 0, 0])
  }

  test "tight does not imply canonical" { tight(p_limbs()) && !canonical(p_limbs()) }
  test "distinct admitted representations can denote zero" {
    loose(p_limbs()) && (alpha(p_limbs()) == alpha(zero()))
  }
  test "addition examples retain the loose bound" { loose(exact_addition()) && !tight(exact_addition()) }
  test "carry examples retain their field value" { alpha(carried_addition()) == alpha(exact_addition()) }
  test "noncanonical input has canonical output" {
    canonical(canonical_output(p_limbs())) && (canonical_output(p_limbs()) == zero())
  }
  test "canonicalization retains the p plus one field value" {
    canonical(canonicalize_tight(p_plus_one())) &&
    (alpha(canonicalize_tight(p_plus_one())) == alpha(p_plus_one()))
  }
  test "maximum exact product satisfies its accumulator bound" {
    bounded_product(product_accumulator_maxima()) && tight(product_maximum()) && canonical(product_maximum())
  }
  test "the third product carry preserves the tight output bound" {
    tight(product_third_pass()) &&
    (alpha(product_third_pass()) == (alpha(maximum_tight()) * alpha([125099989649181, 0, 0, 0, 0])))
  }
  test "correct multiplication residue does not admit a nontight input" {
    let x: Limbs = [2251799813685248, 0, 0, 0, 0];
    let y: Limbs = [1, 0, 0, 0, 0];
    !tight(x) && tight(y) && (alpha(multiply_tight(x, y)) == (alpha(x) * alpha(y)))
  }
  test "correct carry residue does not establish the accumulator contract" {
    let h: ProductAccumulators = [390436384870294308883813279727694, 0, 0, 0, 0];
    !bounded_product(h) && !bounded_product([-1, 0, 0, 0, 0]) &&
    (alpha(carry_product(h)) == (reconstruct_product(h) as Field))
  }
  test "biased subtraction retains the difference residue" {
    let x: Limbs = p_minus_one();
    let y: Limbs = maximum_tight();
    tight(subtract_tight(x, y)) &&
    (alpha(subtract_tight(x, y)) == (alpha(x) - alpha(y)))
  }
  test "the biased difference bound is wider than loose" {
    let wide: Limbs = subtract_wide();
    bounded_difference(wide) && !loose(wide) && tight(carry_difference(wide))
  }
  test "dedicated squaring agrees with the product schedule" {
    bounded_product(square_accumulator_maxima()) &&
    (square_accumulator_maxima() == product_accumulator_maxima()) &&
    (square_maximum() == product_maximum())
  }
  test "a24 multiplication exceeds a wrapping Word[64] limb product" {
    let h: ProductAccumulators = a24_accumulator_maxima();
    bounded_a24(h) && (h[0] > 18446744073709551615) &&
    tight(a24_maximum()) && canonical(a24_maximum())
  }
  test "correct a24 residue does not admit a nontight input" {
    let x: Limbs = [2251799813685248, 0, 0, 0, 0];
    !tight(x) && (alpha(mul_a24_tight(x)) == (alpha(x) * (a24() as Field)))
  }
}
