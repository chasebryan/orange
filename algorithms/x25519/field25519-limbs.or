// OEP-0022 P2: mathematical radix-2^51 representations of the field
// p = 2^255 - 19. Limb order is least significant first. This radix and
// carry schedule are original executable definitions, not an RFC 7748
// storage requirement. The aliases are transparent; none enforces a range.
// Boolean examples are not refinement proofs, and reference evaluation
// establishes no machine layout, constant-time, or native-code property.
edition 2026;
module field25519 {
  type Limbs = Word[64]^5;
  type Field = Mod[57896044618658097711785492504343953926634992332820282019728792003956564819949];

  spec radix() -> Int { 2251799813685248 }
  spec prime() -> Int {
    57896044618658097711785492504343953926634992332820282019728792003956564819949
  }

  // N(x) = sum Int(x[i]) * B^i, computed by exact Horner reconstruction.
  spec reconstruct(x: Limbs) -> Int {
    for i in 0..5 with n: Int = 0 { n * radix() + (x[4 - i] as Int) }
  }

  // Conversion into the existing residue ring reduces the reconstruction.
  spec alpha(x: Limbs) -> Field { reconstruct(x) as Field }

  spec tight(x: Limbs) -> Bool {
    for i in 0..5 with valid: Bool = true { valid && ((x[i] as Int) < radix()) }
  }

  spec loose(x: Limbs) -> Bool {
    for i in 0..5 with valid: Bool = true { valid && ((x[i] as Int) < (2 * radix())) }
  }

  spec canonical(x: Limbs) -> Bool { tight(x) && (reconstruct(x) < prime()) }

  // Intended input contract: tight(x) && tight(y). Under that contract
  // each exact sum is below 2^52, so the Word[64] conversion loses no bits.
  // The current language does not automatically check this precondition.
  spec add_tight(x: Limbs, y: Limbs) -> Limbs {
    for i in 0..5 with sum: Limbs = [0; 5] {
      sum with [i] = ((x[i] as Int) + (y[i] as Int)) as Word[64]
    }
  }

  // One exact carry pass; the tuple retains both the digits and overflow.
  // The returned digits are below B and its carry records the coefficient
  // of B^5. No Word[64] addition or multiplication is used for carries.
  spec carry_pass(x: Limbs, incoming: Int) -> (Limbs, Int) {
    for i in 0..5 with state: (Limbs, Int) = ([0; 5], incoming) {
      let digit: Int = (x[i] as Int) + state.1;
      (state.0 with [i] = (digit % radix()) as Word[64], digit / radix())
    }
  }

  // Intended input contract: loose(x). Fold B^5 into 19 twice, using
  // B^5 = p + 19, and return tight digits with the same abstraction.
  // On loose inputs the first carry is at most 2 and the second at most
  // 1. If the second is 1, its low digit is below 38; the final addition
  // of 19 stays below B. These are mathematical schedule bounds, not
  // checked contracts in the current language.
  spec carry_loose(x: Limbs) -> Limbs {
    let first: (Limbs, Int) = carry_pass(x, 0);
    let second: (Limbs, Int) = carry_pass(first.0, 19 * first.1);
    second.0 with [0] = ((second.0[0] as Int) + 19 * second.1) as Word[64]
  }

  // Split a nonnegative integer below B^5 into exactly five radix digits.
  spec digits(n: Int) -> Limbs {
    let split: (Limbs, Int) = for i in 0..5 with state: (Limbs, Int) = ([0; 5], n) {
      (state.0 with [i] = (state.1 % radix()) as Word[64], state.1 / radix())
    };
    split.0
  }

  // Intended input contract: tight(x). N(x) is below p + 19, so one
  // conditional subtraction yields the unique nonnegative residue.
  // Noncanonical inputs are accepted; this is not a coordinate decoder.
  spec canonicalize_tight(x: Limbs) -> Limbs {
    let n: Int = reconstruct(x);
    digits(if n >= prime() { n - prime() } else { n })
  }

  spec canonical_output(x: Limbs) -> Limbs { canonicalize_tight(carry_loose(x)) }

  spec zero() -> Limbs { [0; 5] }
  spec p_minus_one() -> Limbs {
    [2251799813685228, 2251799813685247, 2251799813685247, 2251799813685247, 2251799813685247]
  }
  spec p_limbs() -> Limbs {
    [2251799813685229, 2251799813685247, 2251799813685247, 2251799813685247, 2251799813685247]
  }
  spec p_plus_one() -> Limbs {
    [2251799813685230, 2251799813685247, 2251799813685247, 2251799813685247, 2251799813685247]
  }
  spec maximum_tight() -> Limbs { [2251799813685247; 5] }

  spec reconstruction_vectors() -> Int^5 {
    [reconstruct(zero()), reconstruct(p_minus_one()), reconstruct(p_limbs()),
     reconstruct(p_plus_one()), reconstruct(maximum_tight())]
  }
  spec reconstruction_vectors_expected() -> Int^5 {
    [0,
     57896044618658097711785492504343953926634992332820282019728792003956564819948,
     57896044618658097711785492504343953926634992332820282019728792003956564819949,
     57896044618658097711785492504343953926634992332820282019728792003956564819950,
     57896044618658097711785492504343953926634992332820282019728792003956564819967]
  }

  spec abstraction_vectors() -> Field^5 {
    [alpha(zero()), alpha(p_minus_one()), alpha(p_limbs()), alpha(p_plus_one()), alpha(maximum_tight())]
  }
  spec abstraction_vectors_expected() -> Field^5 {
    [0, 57896044618658097711785492504343953926634992332820282019728792003956564819948, 0, 1, 18]
  }

  spec predicate_vectors() -> Bool^12 {
    [tight(zero()), loose(zero()), canonical(zero()), canonical(p_minus_one()),
     tight(p_limbs()), canonical(p_limbs()), tight(maximum_tight()), canonical(maximum_tight()),
     tight([2251799813685248; 5]), loose([2251799813685248; 5]),
     loose([4503599627370496; 5]), loose([4503599627370497; 5])]
  }
  spec predicate_vectors_expected() -> Bool^12 {
    [true, true, true, true, true, false, true, false, false, true, false, false]
  }

  spec exact_addition() -> Limbs { add_tight(p_minus_one(), p_minus_one()) }
  spec exact_addition_expected() -> Limbs {
    [4503599627370456, 4503599627370494, 4503599627370494, 4503599627370494, 4503599627370494]
  }
  spec carried_addition() -> Limbs { carry_loose(exact_addition()) }
  spec carried_addition_expected() -> Limbs {
    [2251799813685227, 2251799813685247, 2251799813685247, 2251799813685247, 2251799813685247]
  }

  spec canonical_boundaries() -> (Limbs, Limbs, Limbs, Limbs) {
    (canonicalize_tight(p_minus_one()), canonicalize_tight(p_limbs()),
     canonicalize_tight(p_plus_one()), canonicalize_tight(maximum_tight()))
  }
  spec canonical_boundaries_expected() -> (Limbs, Limbs, Limbs, Limbs) {
    (p_minus_one(), [0; 5], [1, 0, 0, 0, 0], [18, 0, 0, 0, 0])
  }

  // This forces both top-carry folds, rather than only ordinary carries.
  spec second_fold() -> Limbs {
    carry_loose([2251799813685247, 4503599627370495, 4503599627370494,
                 4503599627370494, 4503599627370494])
  }
  spec second_fold_expected() -> Limbs { [37, 0, 0, 0, 0] }

  test "tight does not imply canonical" { tight(p_limbs()) && !canonical(p_limbs()) }
  test "distinct admitted representations can denote zero" {
    loose(p_limbs()) && (alpha(p_limbs()) == alpha(zero()))
  }
  test "addition examples retain the loose bound" { loose(exact_addition()) && !tight(exact_addition()) }
  test "carry examples retain their field value" { alpha(carried_addition()) == alpha(exact_addition()) }
  test "noncanonical input has canonical output" {
    canonical(canonical_output(p_limbs())) && (canonical_output(p_limbs()) == zero())
  }
  test "canonicalization retains the p plus one field value" {
    canonical(canonicalize_tight(p_plus_one())) &&
    (alpha(canonicalize_tight(p_plus_one())) == alpha(p_plus_one()))
  }
}
