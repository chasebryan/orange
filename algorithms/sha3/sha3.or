// SHA-3 and SHAKE of FIPS 202, "SHA-3 Standard: Permutation-Based Hash and
// Extendable-Output Functions" (NIST, August 2015),
// https://doi.org/10.6028/NIST.FIPS.202: Keccak-p[1600, 24] (section 3) on
// the state array A[x][y] of 25 lanes of 64 bits, with the conversions of
// sections 3.1.2 and 3.1.3 and the step mappings theta, rho, pi, chi and
// iota of section 3.2 (Algorithms 1 through 6) each written in the
// standard's coordinates; the sponge construction of section 4
// (Algorithm 8) as KECCAK[c] of section 5.2; pad10*1 (section 5.1) after the
// domain suffix of section 6, in the byte form of Appendix B.2; and
// SHA3-224, SHA3-256, SHA3-384 and SHA3-512 (6.1), SHAKE128 and SHAKE256
// (6.2). Strings are bytes, read as Appendix B.1 reads them: bit i of a
// byte is bit 8k + i of the string, so a lane is eight bytes,
// little-endian.
//
// The file reproduces the digests of the empty message for SHA3-256 and
// SHA3-512 from Botan's sha3.vec, and from Python's hashlib 32 bytes of
// SHAKE128 of the empty message (the first 16 as Botan's shake.vec gives
// them, selected from the NIST CAVS file), the outputs for "abc" of all six
// functions (64 bytes of SHAKE256, 168 of SHAKE128, one full rate), and the
// SHA3-256 digest of a 200-byte two-block message.
edition 2026;
module sha3 {
  // Section 3.1: the state array. A sheet is the five lanes A[x][0]
  // through A[x][4] of one x, so a[x][y] is lane (x, y), and bit z of
  // the lane is A[x, y, z].
  type Sheet = Word[64]^5;
  type State = Sheet^5;
  // Lane coordinates modulo 5, for the walk of rho.
  type Z5 = Mod[5];

  // Section 3.1.2: the string S of b = 1600 bits, 200 bytes, gives
  // A[x, y, z] = S[64(5y + x) + z]: lane (x, y) is word 5y + x of S.
  spec state_array(s: Word[8]^200) -> State {
    let lane: Word[64]^25 = s as little Word[64]^25;
    for x in 0..5 with a: State = [[0; 5]; 5] {
      for y in 0..5 with b: State = a { b with [x][y] = lane[5 * y + x] }
    }
  }

  // Section 3.1.3: the string is the planes y = 0 through 4 in order, each
  // the lanes x = 0 through 4 in order.
  spec state_string(a: State) -> Word[8]^200 {
    let lane: Word[64]^25 = for y in 0..5 with l: Word[64]^25 = [0; 25] {
      for x in 0..5 with m: Word[64]^25 = l { m with [5 * y + x] = a[x][y] }
    };
    lane as little Word[8]^200
  }

  // Section 3.2.1, Algorithm 1, theta: C[x] is the parity of column x,
  // D[x] = C[(x - 1) mod 5] ^ rot(C[(x + 1) mod 5], 1), and every lane of
  // column x takes in D[x].
  spec theta(a: State) -> State {
    let c: Word[64]^5 = for x in 0..5 with c: Word[64]^5 = [0; 5] {
      c with [x] = a[x][0] ^ a[x][1] ^ a[x][2] ^ a[x][3] ^ a[x][4]
    };
    let d: Word[64]^5 = for x in 0..5 with d: Word[64]^5 = [0; 5] {
      d with [x] = c[(x - 1) % 5] ^ (c[(x + 1) % 5] <<< 1)
    };
    for x in 0..5 with b: State = a {
      for y in 0..5 with t: State = b { t with [x][y] = a[x][y] ^ d[x] }
    }
  }

  // Section 3.2.2, Algorithm 2, rho: lane (0, 0) stays; from (x, y) =
  // (1, 0), step t of 0 through 23 turns lane (x, y) by (t + 1)(t + 2)/2
  // bits (z moves to z + (t + 1)(t + 2)/2 mod 64, a left rotation) and
  // moves to (y, (2x + 3y) mod 5). The offsets are those of Table 2,
  // computed as the standard computes them.
  spec rho_walk(a: State) -> (State, Z5, Z5) {
    for t in 0..24 with (b: State, x: Z5, y: Z5) = (a, 1, 0) {
      (
        b with [x as Int][y as Int] = a[x as Int][y as Int] <<< (((t + 1) * (t + 2)) / 2),
        y,
        2 * x + 3 * y,
      )
    }
  }

  spec rho(a: State) -> State { rho_walk(a).0 }

  // Section 3.2.3, Algorithm 3, pi: A'[x, y] = A[(x + 3y) mod 5, x].
  spec pi(a: State) -> State {
    for x in 0..5 with b: State = a {
      for y in 0..5 with t: State = b { t with [x][y] = a[(x + 3 * y) % 5][x] }
    }
  }

  // Section 3.2.4, Algorithm 4, chi, the only non-linear step:
  // A'[x, y] = A[x, y] ^ ((A[(x + 1) mod 5, y] ^ 1) . A[(x + 2) mod 5, y]),
  // the xor with 1 and the product over a lane being ~ and &.
  spec chi(a: State) -> State {
    for x in 0..5 with b: State = a {
      for y in 0..5 with t: State = b {
        t with [x][y] = a[x][y] ^ (~a[(x + 1) % 5][y] & a[(x + 2) % 5][y])
      }
    }
  }

  // Section 3.2.5, Algorithm 5: rc(t) for t = 0 through 167, the bit R[0]
  // of an 8-bit linear feedback shift register after t steps. R is held
  // with R[i] as bit i, so R = 10000000 is 1, R = 0 || R is a shift up,
  // and the xor of R[8] into R[0], R[4], R[5] and R[6] followed by Trunc_8
  // is the xor of 0x171 when bit 8 is set. Rounds 0 through 23 use rc(t)
  // for t below 7 * 24 = 168, so t mod 255 is t.
  spec rc() -> Word[8]^168 {
    let walk: (Word[8]^168, Word[16]) =
      for t in 0..168 with (bits: Word[8]^168, r: Word[16]) = ([0; 168], 1) {
        let shifted: Word[16] = r << 1;
        (
          bits with [t] = (r & 1) as Word[8],
          if (shifted & 0x100) == 0 { shifted } else { shifted ^ 0x171 },
        )
      };
    walk.0
  }

  // Section 3.2.5, Algorithm 6, steps 2 and 3: the round constant RC of
  // round i_r has bit 2^j - 1 equal to rc(j + 7 i_r) for j = 0 through
  // l = 6, and every other bit 0; here for i_r = 0 through 23.
  spec round_constants() -> Word[64]^24 {
    let bits: Word[8]^168 = rc();
    let one: Word[64] = 1;
    for ir in 0..24 with table: Word[64]^24 = [0; 24] {
      table with [ir] = for j in 0..7 with word: Word[64] = 0 {
        word | ((bits[j + 7 * ir] as Word[64]) << ((one << j) - 1))
      }
    }
  }

  // Section 3.2.5, Algorithm 6, step 4, iota: RC enters lane (0, 0). The
  // standard's iota takes the round index i_r and computes RC itself; here
  // it takes RC[i_r] from the table above, built once per permutation.
  spec iota(a: State, rc_ir: Word[64]) -> State { a with [0][0] = a[0][0] ^ rc_ir }

  // Section 3.3: Rnd(A, i_r) = iota(chi(pi(rho(theta(A)))), i_r), given
  // RC[i_r] for i_r.
  spec rnd(a: State, rc_ir: Word[64]) -> State { iota(chi(pi(rho(theta(a)))), rc_ir) }

  // Section 3.3, Algorithm 7, Keccak-p[1600, 24]: the string becomes a
  // state array, the rounds i_r = 12 + 2l - n_r through 12 + 2l - 1 run,
  // here 0 through 23 (l = 6, n_r = 24), and the array becomes a string
  // again. Section 3.4: this is Keccak-f[1600].
  spec keccak_p(s: Word[8]^200) -> Word[8]^200 {
    let rcs: Word[64]^24 = round_constants();
    state_string(for ir in 0..24 with a: State = state_array(s) { rnd(a, rcs[ir]) })
  }

  // Section 4, Algorithm 8, step 6: S ^ (P_i || 0^c), lane by lane.
  spec xor_string(s: Word[8]^200, p: Word[8]^200) -> Word[8]^200 {
    let x: Word[64]^25 = s as little Word[64]^25;
    let y: Word[64]^25 = p as little Word[64]^25;
    let z: Word[64]^25 = for i in 0..25 with z: Word[64]^25 = x { z with [i] = x[i] ^ y[i] };
    z as little Word[8]^200
  }

  // Sections 4 and 5.2: KECCAK[c] = SPONGE[Keccak-p[1600, 24], pad10*1,
  // 1600 - c], applied to a padded string P of n blocks. The capacity c is
  // counted in lanes of 64 bits, 4 through 16 (256 through 1024 bits), so
  // the rate r = 1600 - c is 8(25 - c) bytes. Algorithm 8, steps 1 through
  // 6: P is split into P_0, ..., P_(n-1) of r bits and S = f(S ^ (P_i ||
  // 0^c)) from S = 0^b. Steps 7 through 9: Z = Trunc_r(S), returned whole;
  // every caller keeps d <= r bits of it, so step 9 returns and step 10, a
  // further permutation, is never reached. Padding is the caller's: the
  // string P = N || pad(r, len(N)) of step 1 arrives already formed.
  spec keccak[c in 4..17, n in 1..3](p: Word[8]^(8 * (25 - c) * n))
    -> Word[8]^(8 * (25 - c)) {
    let absorbed: Word[8]^200 = for i in 0..(n) with s: Word[8]^200 = [0; 200] {
      let block: Word[8]^(8 * (25 - c)) = p[8 * (25 - c) * i..8 * (25 - c) * (i + 1)];
      keccak_p(xor_string(s, block ++ [0; (8 * c)]))
    };
    absorbed[..8 * (25 - c)]
  }

  // Sections 5.1 and 6, in the byte form of Appendix B.2: the q bytes that
  // follow a message of m bytes, q = r/8 - (m mod r/8) for the rate r in
  // bits. The domain suffix (01 for SHA-3, 1111 for SHAKE) and the first 1
  // of pad10*1 form the first byte, 06 or 1f, given as `suffix`; the last 1
  // of pad10*1 is bit 7 of the last byte, 80; between them are zeros. When
  // q = 1 the two share a byte (86 or 9f, Table 6). The spec returns what is
  // appended rather than the padded message because an array has at least
  // one element: the empty message's padded form is pad[r/8](suffix) alone.
  spec pad[q in 1..169](suffix: Word[8]) -> Word[8]^q {
    let opened: Word[8]^q = [0; q] with [0] = suffix;
    let last: Word[8]^1 = opened[q - 1..q];
    opened with [q - 1..q] = [last[0] ^ 0x80]
  }

  // Section 6.1: SHA3-224(M) = KECCAK[448](M || 01, 224); c = 7 lanes,
  // r = 144 bytes, for M and its padding of n blocks.
  spec sha3_224[n in 1..3](p: Word[8]^(144 * n)) -> Word[8]^28 { keccak[7, n](p)[..28] }

  // Section 6.1: SHA3-256(M) = KECCAK[512](M || 01, 256); c = 8, r = 136.
  spec sha3_256[n in 1..3](p: Word[8]^(136 * n)) -> Word[8]^32 { keccak[8, n](p)[..32] }

  // Section 6.1: SHA3-384(M) = KECCAK[768](M || 01, 384); c = 12, r = 104.
  spec sha3_384[n in 1..3](p: Word[8]^(104 * n)) -> Word[8]^48 { keccak[12, n](p)[..48] }

  // Section 6.1: SHA3-512(M) = KECCAK[1024](M || 01, 512); c = 16, r = 72.
  spec sha3_512[n in 1..3](p: Word[8]^(72 * n)) -> Word[8]^64 { keccak[16, n](p)[..64] }

  // Section 6.2: SHAKE128(M, d) = KECCAK[256](M || 1111, d); c = 4,
  // r = 168. The spec returns the first block of output, all 168 bytes;
  // SHAKE128(M, d) for d <= 1344 bits is its first d/8 bytes, which each
  // test takes with a slice.
  spec shake128[n in 1..3](p: Word[8]^(168 * n)) -> Word[8]^168 { keccak[4, n](p) }

  // Section 6.2: SHAKE256(M, d) = KECCAK[512](M || 1111, d); c = 8,
  // r = 136, likewise for d <= 1088 bits.
  spec shake256[n in 1..3](p: Word[8]^(136 * n)) -> Word[8]^136 { keccak[8, n](p) }

  // The vectors. Each test hashes its message followed by pad[q](suffix),
  // q = r/8 - (m mod r/8) for its length m and rate; the empty message's
  // padded form is the padding alone.

  // Botan sha3.vec, [SHA-3(256)], In empty; hashlib.sha3_256 agrees.
  test "Botan sha3.vec: SHA3-256 of the empty message" {
    sha3_256(pad[136](0x06)) ==
      hex"a7ffc6f8 bf1ed766 51c14756 a061d662 f580ff4d e43b49fa 82d80a4b 80f8434a"
  }

  // Botan sha3.vec, [SHA-3(512)], In empty; hashlib.sha3_512 agrees.
  test "Botan sha3.vec: SHA3-512 of the empty message" {
    sha3_512(pad[72](0x06)) == (
      hex"a69f73cca23a9ac5 c8b567dc185a756e 97c982164fe25859 e0d1dcc1475c80a6" ++
      hex"15b2123af1f5f94c 11e3e9402c3ac558 f500199d95b6d3e3 01758586281dcd26"
    )
  }

  // hashlib.sha3_224(b"abc"); pycryptodome's SHA3_224 agrees.
  test "hashlib: SHA3-224 of abc" {
    sha3_224("abc" ++ pad[144 - 3](0x06)) ==
      hex"e642824c 3f8cf24a d09234ee 7d3c766f c9a3a516 8d0c94ad 73b46fdf"
  }

  // hashlib.sha3_256(b"abc"), the widely quoted value 3a985da7...11431532;
  // CompactFIPS202.py agrees.
  test "hashlib: SHA3-256 of abc" {
    sha3_256("abc" ++ pad[136 - 3](0x06)) ==
      hex"3a985da7 4fe225b2 045c172d 6bd390bd 855f086e 3e9d525b 46bfe245 11431532"
  }

  // hashlib.sha3_384(b"abc"); pycryptodome's SHA3_384 agrees.
  test "hashlib: SHA3-384 of abc" {
    sha3_384("abc" ++ pad[104 - 3](0x06)) == (
      hex"ec01498288516fc9 26459f58e2c6ad8d f9b473cb0fc08c25" ++
      hex"96da7cf0e49be4b2 98d88cea927ac7f5 39f1edf228376d25"
    )
  }

  // hashlib.sha3_512(b"abc"); CompactFIPS202.py agrees.
  test "hashlib: SHA3-512 of abc" {
    sha3_512("abc" ++ pad[72 - 3](0x06)) == (
      hex"b751850b1a57168a 5693cd924b6b096e 08f621827444f70d 884f5d0240d2712e" ++
      hex"10e116e9192af3c9 1a7ec57647e39340 57340b4cf408d5a5 6592f8274eec53f0"
    )
  }

  // hashlib.shake_128(b"").digest(32); Botan shake.vec, [SHAKE-128], In
  // empty, gives the first 16 bytes; CompactFIPS202.py agrees.
  test "hashlib: SHAKE128 of the empty message, 32 bytes" {
    shake128(pad[168](0x1f))[..32] ==
      hex"7f9c2ba4 e88f827d 61604550 7605853e d73b8093 f6efbc88 eb1a6eac fa66ef26"
  }

  // hashlib.shake_256(b"abc").digest(64); CompactFIPS202.py agrees.
  test "hashlib: SHAKE256 of abc, 64 bytes" {
    shake256("abc" ++ pad[136 - 3](0x1f))[..64] == (
      hex"483366601360a877 1c6863080cc4114d 8db44530f8f1e1ee 4f94ea37e78b5739" ++
      hex"d5a15bef186a5386 c75744c0527e1faa 9f8726e462a12a4f eb06bd8801e751e4"
    )
  }

  // hashlib.sha3_256(bytes(range(200))), the bytes 00 through c7: two
  // blocks at rate 136, the second holding the last 64 message bytes and
  // the padding; CompactFIPS202.py agrees.
  test "hashlib: SHA3-256 of the 200 bytes 00 through c7" {
    let m: Word[8]^200 =
      hex"000102030405060708090a0b0c0d0e0f 101112131415161718191a1b1c1d1e1f" ++
      hex"202122232425262728292a2b2c2d2e2f 303132333435363738393a3b3c3d3e3f" ++
      hex"404142434445464748494a4b4c4d4e4f 505152535455565758595a5b5c5d5e5f" ++
      hex"606162636465666768696a6b6c6d6e6f 707172737475767778797a7b7c7d7e7f" ++
      hex"808182838485868788898a8b8c8d8e8f 909192939495969798999a9b9c9d9e9f" ++
      hex"a0a1a2a3a4a5a6a7a8a9aaabacadaeaf b0b1b2b3b4b5b6b7b8b9babbbcbdbebf" ++
      hex"c0c1c2c3c4c5c6c7";
    sha3_256(m ++ pad[136 - (200 % 136)](0x06)) ==
      hex"5f728f63 bf5ee48c 77f453c0 490398fa 645b8d4c 4e56be9a 41cfec34 4d6ca899"
  }

  // hashlib.shake_128(b"abc").digest(168), one full rate of output;
  // CompactFIPS202.py agrees.
  test "hashlib: SHAKE128 of abc, 168 bytes" {
    shake128("abc" ++ pad[168 - 3](0x1f)) == (
      hex"5881092dd818bf5c f8a3ddb793fbcba7 4097d5c526a6d35f 97b83351940f2cc8" ++
      hex"44c50af32acd3f2c dd066568706f509b c1bdde58295dae3f 891a9a0fca578378" ++
      hex"9a41f8611214ce61 2394df286a62d1a2 252aa94db9c53895 6c717dc2bed4f232" ++
      hex"a0294c857c730aa1 6067ac1062f1201f b0d377cfb9cde4c6 3599b27f3462bba4" ++
      hex"a0ed296c801f9ff7 f57302bb3076ee14 5f97a32ae68e76ab 66c48d51675bd49a" ++
      hex"cc29082f5647584e"
    )
  }
}
