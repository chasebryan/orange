// ARIA of RFC 5794, "A Description of the ARIA Encryption Algorithm" (Lee,
// Lee, Kim, Kwon, Kim; March 2010; https://www.rfc-editor.org/rfc/rfc5794),
// the block cipher of the Korean standard KS X 1213 (2004; now part 1 of
// KS X 1213). The file carries the 128-bit operations of section 2.1, the
// key scheduling part of section 2.2, the data randomizing part of section
// 2.3 for 128-, 192- and 256-bit keys (12, 14 and 16 rounds), and the
// components of section 2.4: the round functions FO and FE, the
// substitution layers SL1 and SL2 with the S-boxes SB1 through SB4, and the
// diffusion layer A written as the RFC's sixteen equations. Encryption of
// the plaintext 00112233445566778899aabbccddeeff under the three keys of
// Appendix A gives the RFC's ciphertexts, decryption gives the plaintext
// back, and the first block of Botan's ARIA-128 and ARIA-256 cases agrees
// with aria.vec.
edition 2026;
module aria {
  // A 128-bit string: a data block, a round key, KL, KR, W0 through W3 and
  // the constants, as sixteen bytes with the leftmost byte first.
  type Block = Word[8]^16;
  type SBox = Word[8]^256;
  // ek1 through ek17, ek(i+1) at index i.
  type RoundKeys = Block^17;

  // Section 2.1: A ^ B, the exclusive or of two 128-bit strings, taken on
  // each string read as two big-endian 64-bit words.
  spec xor(a: Block, b: Block) -> Block {
    let x: Word[64]^2 = a as big Word[64]^2;
    let y: Word[64]^2 = b as big Word[64]^2;
    [x[0] ^ y[0], x[1] ^ y[1]] as big Word[8]^16
  }

  // Section 2.1: A >>> n and A <<< n, the right and left rotations of a
  // 128-bit string, on its two big-endian 64-bit halves, each half taking
  // n bits from the other. This is right for 0 <= n <= 64 (a shift by 64
  // gives zero), which covers the key schedule's 19, 31 and 61.
  spec rotate_right(a: Block, n: Int) -> Block {
    let w: Word[64]^2 = a as big Word[64]^2;
    [(w[0] >> n) | (w[1] << (64 - n)), (w[1] >> n) | (w[0] << (64 - n))] as big Word[8]^16
  }

  spec rotate_left(a: Block, n: Int) -> Block {
    let w: Word[64]^2 = a as big Word[64]^2;
    [(w[0] << n) | (w[1] >> (64 - n)), (w[1] << n) | (w[0] >> (64 - n))] as big Word[8]^16
  }

  // Section 2.4.2: the four S-boxes, each a 256-byte table printed in rows
  // of sixteen as the RFC prints it, entry x at row x >> 4 and column
  // x & 15. SB1 is the AES S-box (the inverse in GF(2^8) modulo
  // x^8+x^4+x^3+x+1, with 0 to 0, followed by AES's affine map); SB2 is
  // x^247 in the same field followed by another affine map; SB3 and SB4 are
  // the inverses of SB1 and SB2, so SL2 is the inverse of SL1.
  spec sb1() -> SBox {
    (
      hex"63 7c 77 7b f2 6b 6f c5 30 01 67 2b fe d7 ab 76" ++
      hex"ca 82 c9 7d fa 59 47 f0 ad d4 a2 af 9c a4 72 c0" ++
      hex"b7 fd 93 26 36 3f f7 cc 34 a5 e5 f1 71 d8 31 15" ++
      hex"04 c7 23 c3 18 96 05 9a 07 12 80 e2 eb 27 b2 75" ++
      hex"09 83 2c 1a 1b 6e 5a a0 52 3b d6 b3 29 e3 2f 84" ++
      hex"53 d1 00 ed 20 fc b1 5b 6a cb be 39 4a 4c 58 cf" ++
      hex"d0 ef aa fb 43 4d 33 85 45 f9 02 7f 50 3c 9f a8" ++
      hex"51 a3 40 8f 92 9d 38 f5 bc b6 da 21 10 ff f3 d2" ++
      hex"cd 0c 13 ec 5f 97 44 17 c4 a7 7e 3d 64 5d 19 73" ++
      hex"60 81 4f dc 22 2a 90 88 46 ee b8 14 de 5e 0b db" ++
      hex"e0 32 3a 0a 49 06 24 5c c2 d3 ac 62 91 95 e4 79" ++
      hex"e7 c8 37 6d 8d d5 4e a9 6c 56 f4 ea 65 7a ae 08" ++
      hex"ba 78 25 2e 1c a6 b4 c6 e8 dd 74 1f 4b bd 8b 8a" ++
      hex"70 3e b5 66 48 03 f6 0e 61 35 57 b9 86 c1 1d 9e" ++
      hex"e1 f8 98 11 69 d9 8e 94 9b 1e 87 e9 ce 55 28 df" ++
      hex"8c a1 89 0d bf e6 42 68 41 99 2d 0f b0 54 bb 16"
    )
  }

  spec sb2() -> SBox {
    (
      hex"e2 4e 54 fc 94 c2 4a cc 62 0d 6a 46 3c 4d 8b d1" ++
      hex"5e fa 64 cb b4 97 be 2b bc 77 2e 03 d3 19 59 c1" ++
      hex"1d 06 41 6b 55 f0 99 69 ea 9c 18 ae 63 df e7 bb" ++
      hex"00 73 66 fb 96 4c 85 e4 3a 09 45 aa 0f ee 10 eb" ++
      hex"2d 7f f4 29 ac cf ad 91 8d 78 c8 95 f9 2f ce cd" ++
      hex"08 7a 88 38 5c 83 2a 28 47 db b8 c7 93 a4 12 53" ++
      hex"ff 87 0e 31 36 21 58 48 01 8e 37 74 32 ca e9 b1" ++
      hex"b7 ab 0c d7 c4 56 42 26 07 98 60 d9 b6 b9 11 40" ++
      hex"ec 20 8c bd a0 c9 84 04 49 23 f1 4f 50 1f 13 dc" ++
      hex"d8 c0 9e 57 e3 c3 7b 65 3b 02 8f 3e e8 25 92 e5" ++
      hex"15 dd fd 17 a9 bf d4 9a 7e c5 39 67 fe 76 9d 43" ++
      hex"a7 e1 d0 f5 68 f2 1b 34 70 05 a3 8a d5 79 86 a8" ++
      hex"30 c6 51 4b 1e a6 27 f6 35 d2 6e 24 16 82 5f da" ++
      hex"e6 75 a2 ef 2c b2 1c 9f 5d 6f 80 0a 72 44 9b 6c" ++
      hex"90 0b 5b 33 7d 5a 52 f3 61 a1 f7 b0 d6 3f 7c 6d" ++
      hex"ed 14 e0 a5 3d 22 b3 f8 89 de 71 1a af ba b5 81"
    )
  }

  spec sb3() -> SBox {
    (
      hex"52 09 6a d5 30 36 a5 38 bf 40 a3 9e 81 f3 d7 fb" ++
      hex"7c e3 39 82 9b 2f ff 87 34 8e 43 44 c4 de e9 cb" ++
      hex"54 7b 94 32 a6 c2 23 3d ee 4c 95 0b 42 fa c3 4e" ++
      hex"08 2e a1 66 28 d9 24 b2 76 5b a2 49 6d 8b d1 25" ++
      hex"72 f8 f6 64 86 68 98 16 d4 a4 5c cc 5d 65 b6 92" ++
      hex"6c 70 48 50 fd ed b9 da 5e 15 46 57 a7 8d 9d 84" ++
      hex"90 d8 ab 00 8c bc d3 0a f7 e4 58 05 b8 b3 45 06" ++
      hex"d0 2c 1e 8f ca 3f 0f 02 c1 af bd 03 01 13 8a 6b" ++
      hex"3a 91 11 41 4f 67 dc ea 97 f2 cf ce f0 b4 e6 73" ++
      hex"96 ac 74 22 e7 ad 35 85 e2 f9 37 e8 1c 75 df 6e" ++
      hex"47 f1 1a 71 1d 29 c5 89 6f b7 62 0e aa 18 be 1b" ++
      hex"fc 56 3e 4b c6 d2 79 20 9a db c0 fe 78 cd 5a f4" ++
      hex"1f dd a8 33 88 07 c7 31 b1 12 10 59 27 80 ec 5f" ++
      hex"60 51 7f a9 19 b5 4a 0d 2d e5 7a 9f 93 c9 9c ef" ++
      hex"a0 e0 3b 4d ae 2a f5 b0 c8 eb bb 3c 83 53 99 61" ++
      hex"17 2b 04 7e ba 77 d6 26 e1 69 14 63 55 21 0c 7d"
    )
  }

  spec sb4() -> SBox {
    (
      hex"30 68 99 1b 87 b9 21 78 50 39 db e1 72 09 62 3c" ++
      hex"3e 7e 5e 8e f1 a0 cc a3 2a 1d fb b6 d6 20 c4 8d" ++
      hex"81 65 f5 89 cb 9d 77 c6 57 43 56 17 d4 40 1a 4d" ++
      hex"c0 63 6c e3 b7 c8 64 6a 53 aa 38 98 0c f4 9b ed" ++
      hex"7f 22 76 af dd 3a 0b 58 67 88 06 c3 35 0d 01 8b" ++
      hex"8c c2 e6 5f 02 24 75 93 66 1e e5 e2 54 d8 10 ce" ++
      hex"7a e8 08 2c 12 97 32 ab b4 27 0a 23 df ef ca d9" ++
      hex"b8 fa dc 31 6b d1 ad 19 49 bd 51 96 ee e4 a8 41" ++
      hex"da ff cd 55 86 36 be 61 52 f8 bb 0e 82 48 69 9a" ++
      hex"e0 47 9e 5c 04 4b 34 15 79 26 a7 de 29 ae 92 d7" ++
      hex"84 e9 d2 ba 5d f3 c5 b0 bf a4 3b 71 44 46 2b fc" ++
      hex"eb 6f d5 f6 14 fe 7c 70 5a 7d fd 2f 18 83 16 a5" ++
      hex"91 1f 05 95 74 a9 c1 5b 4a 85 6d 13 07 4f 4e 45" ++
      hex"b2 0f c9 1c a6 bc ec 73 90 7b cf 59 8f a1 f9 2d" ++
      hex"f2 b1 00 94 37 9f d0 2e 9c 6e 28 3f 80 f0 3d d3" ++
      hex"25 8a b5 e7 42 b3 c7 ea f7 4c 11 33 03 a2 ac 60"
    )
  }

  // Section 2.4.2: the type 1 substitution layer, SB1, SB2, SB3, SB4
  // across each group of four bytes.
  spec sl1(x: Block) -> Block {
    let s1: SBox = sb1();
    let s2: SBox = sb2();
    let s3: SBox = sb3();
    let s4: SBox = sb4();
    [
      s1[x[0]], s2[x[1]], s3[x[2]], s4[x[3]],
      s1[x[4]], s2[x[5]], s3[x[6]], s4[x[7]],
      s1[x[8]], s2[x[9]], s3[x[10]], s4[x[11]],
      s1[x[12]], s2[x[13]], s3[x[14]], s4[x[15]],
    ]
  }

  // Section 2.4.2: the type 2 substitution layer, SB3, SB4, SB1, SB2.
  spec sl2(x: Block) -> Block {
    let s1: SBox = sb1();
    let s2: SBox = sb2();
    let s3: SBox = sb3();
    let s4: SBox = sb4();
    [
      s3[x[0]], s4[x[1]], s1[x[2]], s2[x[3]],
      s3[x[4]], s4[x[5]], s1[x[6]], s2[x[7]],
      s3[x[8]], s4[x[9]], s1[x[10]], s2[x[11]],
      s3[x[12]], s4[x[13]], s1[x[14]], s2[x[15]],
    ]
  }

  // Section 2.4.3: the diffusion layer A, y0 through y15 as the RFC's
  // sixteen equations. A is an involution.
  spec diffusion(x: Block) -> Block {
    [
      x[3] ^ x[4] ^ x[6] ^ x[8] ^ x[9] ^ x[13] ^ x[14],
      x[2] ^ x[5] ^ x[7] ^ x[8] ^ x[9] ^ x[12] ^ x[15],
      x[1] ^ x[4] ^ x[6] ^ x[10] ^ x[11] ^ x[12] ^ x[15],
      x[0] ^ x[5] ^ x[7] ^ x[10] ^ x[11] ^ x[13] ^ x[14],
      x[0] ^ x[2] ^ x[5] ^ x[8] ^ x[11] ^ x[14] ^ x[15],
      x[1] ^ x[3] ^ x[4] ^ x[9] ^ x[10] ^ x[14] ^ x[15],
      x[0] ^ x[2] ^ x[7] ^ x[9] ^ x[10] ^ x[12] ^ x[13],
      x[1] ^ x[3] ^ x[6] ^ x[8] ^ x[11] ^ x[12] ^ x[13],
      x[0] ^ x[1] ^ x[4] ^ x[7] ^ x[10] ^ x[13] ^ x[15],
      x[0] ^ x[1] ^ x[5] ^ x[6] ^ x[11] ^ x[12] ^ x[14],
      x[2] ^ x[3] ^ x[5] ^ x[6] ^ x[8] ^ x[13] ^ x[15],
      x[2] ^ x[3] ^ x[4] ^ x[7] ^ x[9] ^ x[12] ^ x[14],
      x[1] ^ x[2] ^ x[6] ^ x[7] ^ x[9] ^ x[11] ^ x[12],
      x[0] ^ x[3] ^ x[6] ^ x[7] ^ x[8] ^ x[10] ^ x[13],
      x[0] ^ x[3] ^ x[4] ^ x[5] ^ x[9] ^ x[11] ^ x[14],
      x[1] ^ x[2] ^ x[4] ^ x[5] ^ x[8] ^ x[10] ^ x[15],
    ]
  }

  // Section 2.4.1: the odd round function FO(D, RK) = A(SL1(D ^ RK)) and
  // the even round function FE(D, RK) = A(SL2(D ^ RK)).
  spec fo(d: Block, rk: Block) -> Block { diffusion(sl1(xor(d, rk))) }

  spec fe(d: Block, rk: Block) -> Block { diffusion(sl2(xor(d, rk))) }

  // Section 2.2: the constants C1, C2, C3, the first 128*3 bits of the
  // fractional part of 1/pi.
  spec c1() -> Block { hex"517cc1b727220a94fe13abe8fa9a6ee0" }

  spec c2() -> Block { hex"6db14acc9e21c820ff28b1d5ef5de2b0" }

  spec c3() -> Block { hex"db92371d2126e9700324977504e8c90e" }

  // Section 2.2: W0 through W3, the intermediate values of the encryption
  // of KL || KR by a 3-round 256-bit Feistel cipher with the constants CK1,
  // CK2, CK3, and the encryption round keys ek1 through ek17 as the RFC
  // lists them. A 128-bit key uses ek1 through ek13, a 192-bit key ek1
  // through ek15, a 256-bit key all seventeen.
  spec round_keys(kl: Block, kr: Block, ck1: Block, ck2: Block, ck3: Block) -> RoundKeys {
    let w0: Block = kl;
    let w1: Block = xor(fo(w0, ck1), kr);
    let w2: Block = xor(fe(w1, ck2), w0);
    let w3: Block = xor(fo(w2, ck3), w1);
    [
      xor(w0, rotate_right(w1, 19)),
      xor(w1, rotate_right(w2, 19)),
      xor(w2, rotate_right(w3, 19)),
      xor(rotate_right(w0, 19), w3),
      xor(w0, rotate_right(w1, 31)),
      xor(w1, rotate_right(w2, 31)),
      xor(w2, rotate_right(w3, 31)),
      xor(rotate_right(w0, 31), w3),
      xor(w0, rotate_left(w1, 61)),
      xor(w1, rotate_left(w2, 61)),
      xor(w2, rotate_left(w3, 61)),
      xor(rotate_left(w0, 61), w3),
      xor(w0, rotate_left(w1, 31)),
      xor(w1, rotate_left(w2, 31)),
      xor(w2, rotate_left(w3, 31)),
      xor(rotate_left(w0, 31), w3),
      xor(w0, rotate_left(w1, 19)),
    ]
  }

  // Section 2.2: the key scheduling part for a master key MK of 64 * k
  // bits, k = 2, 3, 4 for 128, 192 and 256. KL || KR is MK followed by
  // zeros up to 256 bits: KL is the leftmost 128 bits of MK and KR the rest,
  // right-padded with zeros. Sixteen zero bytes after MK cover every key
  // size, and the slices keep the first 32 bytes. CK1, CK2, CK3 follow the
  // RFC's table: C1, C2, C3 for a 128-bit key, C2, C3, C1 for 192 and C3,
  // C1, C2 for 256.
  spec key_schedule[k in 2..5](mk: Word[8]^(8 * k)) -> RoundKeys {
    let padded: Word[8]^(8 * k + 16) = mk ++ [0; 16];
    let kl: Block = padded[..16];
    let kr: Block = padded[16..32];
    if k == 2 { round_keys(kl, kr, c1(), c2(), c3()) }
    else if k == 3 { round_keys(kl, kr, c2(), c3(), c1()) }
    else { round_keys(kl, kr, c3(), c1(), c2()) }
  }

  // Section 2.2: the decryption round keys of an n-round cipher, n = 2h,
  // dk1 = ek(n+1), dk(i+1) = A(ek(n+1-i)) for 1 <= i < n, and
  // dk(n+1) = ek1, from ek1 through ek(n+1).
  spec decryption_keys[h in 6..9](ek: Block^(2 * h + 1)) -> Block^(2 * h + 1) {
    for i in 0..(2 * h + 1) with dk: Block^(2 * h + 1) = ek {
      let key: Block = ek[2 * h - i];
      dk with [i] = if (i == 0) || (i == (2 * h)) { key } else { diffusion(key) }
    }
  }

  // Sections 2.3.1 and 2.3.2: the data randomizing part with n = 2h rounds
  // (12, 14 or 16) and round keys rk1 through rk(n+1), the number of rounds
  // taken from the number of keys. Rounds 1 through n-1 are FO in odd
  // rounds and FE in even ones; round n is SL2 followed by the extra key
  // addition, with no diffusion. Encryption passes ek, decryption dk.
  spec data_randomizing[h in 6..9](rk: Block^(2 * h + 1), p: Block) -> Block {
    let middle: Block = for i in 0..(2 * h - 1) with x: Block = p {
      if (i % 2) == 0 { fo(x, rk[i]) } else { fe(x, rk[i]) }
    };
    xor(sl2(xor(middle, rk[2 * h - 1])), rk[2 * h])
  }

  // Sections 2.3.1.1 through 2.3.1.3 and 2.3.2: a key of 64 * k bits runs
  // 2k + 8 rounds with ek1 through ek(2k+9): 12 rounds with ek1 through
  // ek13, 14 with ek1 through ek15, 16 with all seventeen.
  spec encrypt[k in 2..5](mk: Word[8]^(8 * k), p: Block) -> Block {
    data_randomizing(key_schedule(mk)[..(2 * k + 9)], p)
  }

  spec decrypt[k in 2..5](mk: Word[8]^(8 * k), c: Block) -> Block {
    data_randomizing(decryption_keys(key_schedule(mk)[..(2 * k + 9)]), c)
  }

  // RFC 5794, Appendix A: the plaintext 00112233...ff under the keys
  // 000102...0f, 000102...17 and 000102...1f, and each ciphertext read
  // back to the plaintext.
  test "RFC 5794 A.1: ARIA-128 encrypts" {
    encrypt(hex"000102030405060708090a0b0c0d0e0f", hex"00112233445566778899aabbccddeeff")
      == hex"d718fbd6ab644c739da95f3be6451778"
  }

  test "RFC 5794 A.2: ARIA-192 encrypts" {
    let mk: Word[8]^24 = hex"000102030405060708090a0b0c0d0e0f1011121314151617";
    encrypt(mk, hex"00112233445566778899aabbccddeeff") == hex"26449c1805dbe7aa25a468ce263a9e79"
  }

  test "RFC 5794 A.3: ARIA-256 encrypts" {
    let mk: Word[8]^32 = hex"000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f";
    encrypt(mk, hex"00112233445566778899aabbccddeeff") == hex"f92bd7c79fb72e2f2b8f80c1972d24fc"
  }

  test "RFC 5794 A.1: ARIA-128 decrypts" {
    decrypt(hex"000102030405060708090a0b0c0d0e0f", hex"d718fbd6ab644c739da95f3be6451778")
      == hex"00112233445566778899aabbccddeeff"
  }

  test "RFC 5794 A.2: ARIA-192 decrypts" {
    let mk: Word[8]^24 = hex"000102030405060708090a0b0c0d0e0f1011121314151617";
    decrypt(mk, hex"26449c1805dbe7aa25a468ce263a9e79") == hex"00112233445566778899aabbccddeeff"
  }

  test "RFC 5794 A.3: ARIA-256 decrypts" {
    let mk: Word[8]^32 = hex"000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f";
    decrypt(mk, hex"f92bd7c79fb72e2f2b8f80c1972d24fc") == hex"00112233445566778899aabbccddeeff"
  }

  // Botan src/tests/data/block/aria.vec, sections [ARIA-128] and
  // [ARIA-256], the cases headed "ARIA Test Vector PDF": key
  // 00112233445566778899aabbccddeeff (twice for ARIA-256), first 16-byte
  // block of the ECB input and output.
  test "Botan aria.vec [ARIA-128] ARIA Test Vector PDF: block 1" {
    encrypt(hex"00112233445566778899aabbccddeeff", hex"11111111aaaaaaaa11111111bbbbbbbb")
      == hex"c6ecd08e22c30abdb215cf74e2075e6e"
  }

  test "Botan aria.vec [ARIA-256] ARIA Test Vector PDF: block 1" {
    let mk: Word[8]^32 = hex"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff";
    encrypt(mk, hex"11111111aaaaaaaa11111111bbbbbbbb") == hex"58a875e6044ad7fffa4f58420f7f442d"
  }
}
