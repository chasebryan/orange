// Camellia, the 128-bit block cipher of RFC 3713, "A Description of the
// Camellia Encryption Algorithm" (Matsui, Nakajima, Moriai; NTT and
// Mitsubishi, 2004), https://www.rfc-editor.org/rfc/rfc3713, written the way
// the RFC writes it: the key schedule of section 2.2 with the Sigma constants
// and its 128-bit rotations, the data randomizing part of section 2.3 for
// 128-bit keys (18 rounds, FL and FLINV after rounds 6 and 12) and for 192-
// and 256-bit keys (24 rounds), and the F, FL, FLINV, S and P functions of
// section 2.4. Encryption and decryption for all three key sizes reproduce
// the test data of RFC 3713 Appendix A and two cases of Botan's camellia.vec.
edition 2026;
module camellia {
  // Bytes and words. Camellia reads its key and its blocks big-endian.
  spec load_be64(
    b0: Word[8], b1: Word[8], b2: Word[8], b3: Word[8],
    b4: Word[8], b5: Word[8], b6: Word[8], b7: Word[8],
  ) -> Word[64] {
    ((b0 as Word[64]) << 56) | ((b1 as Word[64]) << 48) | ((b2 as Word[64]) << 40)
      | ((b3 as Word[64]) << 32) | ((b4 as Word[64]) << 24) | ((b5 as Word[64]) << 16)
      | ((b6 as Word[64]) << 8) | (b7 as Word[64])
  }

  spec be_bytes64(x: Word[64]) -> Word[8]^8 {
    [
      (x >> 56) as Word[8], (x >> 48) as Word[8], (x >> 40) as Word[8], (x >> 32) as Word[8],
      (x >> 24) as Word[8], (x >> 16) as Word[8], (x >> 8) as Word[8], x as Word[8],
    ]
  }

  // A 128-bit value is two 64-bit words, the high word first: [D1, D2] for
  // a block, and likewise for KL, KR, KA and KB of the key schedule.
  spec block_words(b: Word[8]^16) -> Word[64]^2 {
    [
      load_be64(b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]),
      load_be64(b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]),
    ]
  }

  spec block_bytes(d: Word[64]^2) -> Word[8]^16 {
    let hi: Word[8]^8 = be_bytes64(d[0]);
    let lo: Word[8]^8 = be_bytes64(d[1]);
    [
      hi[0], hi[1], hi[2], hi[3], hi[4], hi[5], hi[6], hi[7],
      lo[0], lo[1], lo[2], lo[3], lo[4], lo[5], lo[6], lo[7],
    ]
  }

  // Section 2.4.4: SBOX1, packed eight entries to a 64-bit word, the first
  // entry in the most significant byte, so that each literal holds eight
  // consecutive entries of the RFC's table (0x70822cecb327c0e5 is 112 130 44
  // 236 179 39 192 229, the first eight). Only s1 is a table: RFC 3713
  // defines s2, s3 and s4 as rotations of s1, so one table suffices and the
  // other three are written as the rotations below.
  spec sbox1() -> Word[64]^32 {
    [
      0x70822cecb327c0e5, 0xe4855735ea0cae41, 0x23ef6b934519a521, 0xed0e4f4e1d6592bd,
      0x86b8af8f7ceb1fce, 0x3e30dc5f5ec50b1a, 0xa6e139cad5475d3d, 0xd9015ad651566c4d,
      0x8b0d9a66fbccb02d, 0x74122b20f0b18499, 0xdf4ccbc2347e7605, 0x6db7a931d11704d7,
      0x14583a61de1b111c, 0x320f9c165318f222, 0xfe44cfb2c3b57a91, 0x2408e8a860fc6950,
      0xaad0a07da1896297, 0x545b1e95e0ff64d2, 0x10c40048a3f775db, 0x8a03e6da093fdd94,
      0x875c8302cd4a9033, 0x7367f6f39d7fbfe2, 0x529bd826c837c63b, 0x81966f4b13be632e,
      0xe979a78c9f6ebc8e, 0x29f5f9b62ffdb459, 0x7898066ae74671ba, 0xd425ab4288a28dfa,
      0x7207b955f8eeac0a, 0x36492a683c38f1a4, 0x4028d37bbbc943c1, 0x15e3adf477c7809e,
    ]
  }

  // The byte at position k of a word holding eight table entries.
  spec byte_at(w: Word[64], k: Word[8]) -> Word[8] {
    if k == 0 { (w >> 56) as Word[8] }
    else if k == 1 { (w >> 48) as Word[8] }
    else if k == 2 { (w >> 40) as Word[8] }
    else if k == 3 { (w >> 32) as Word[8] }
    else if k == 4 { (w >> 24) as Word[8] }
    else if k == 5 { (w >> 16) as Word[8] }
    else if k == 6 { (w >> 8) as Word[8] }
    else { w as Word[8] }
  }

  // Entry x of a 256-entry table packed eight entries to a word. A byte may
  // index a table of 256 entries; this rendering still selects the word
  // holding x and then the byte within it.
  spec lookup(t: Word[64]^32, x: Word[8]) -> Word[8] {
    let w: Word[64] = for i in 0..32 with acc: Word[64] = 0 {
      if (x >> 3) == (i as Word[8]) { t[i] } else { acc }
    };
    byte_at(w, x & 7)
  }

  // Section 2.4.4: s1 is the table; s2(x) = s1(x) <<< 1, s3(x) = s1(x) <<< 7,
  // s4(x) = s1(x <<< 1).
  spec s1(t: Word[64]^32, x: Word[8]) -> Word[8] { lookup(t, x) }
  spec s2(t: Word[64]^32, x: Word[8]) -> Word[8] { lookup(t, x) <<< 1 }
  spec s3(t: Word[64]^32, x: Word[8]) -> Word[8] { lookup(t, x) <<< 7 }
  spec s4(t: Word[64]^32, x: Word[8]) -> Word[8] { lookup(t, x <<< 1) }

  // Section 2.4.4: the S-function. The input's eight bytes l1 through l8
  // pass through s1, s2, s3, s4, s2, s3, s4, s1 in that order.
  spec s_function(t: Word[64]^32, x: Word[64]) -> Word[8]^8 {
    let l: Word[8]^8 = be_bytes64(x);
    [
      s1(t, l[0]), s2(t, l[1]), s3(t, l[2]), s4(t, l[3]),
      s2(t, l[4]), s3(t, l[5]), s4(t, l[6]), s1(t, l[7]),
    ]
  }

  // Section 2.4.5: the P-function, a linear map on eight bytes; z1 is the
  // most significant byte of the input and y1 of the output.
  spec p_function(z: Word[8]^8) -> Word[64] {
    let z1: Word[8] = z[0];
    let z2: Word[8] = z[1];
    let z3: Word[8] = z[2];
    let z4: Word[8] = z[3];
    let z5: Word[8] = z[4];
    let z6: Word[8] = z[5];
    let z7: Word[8] = z[6];
    let z8: Word[8] = z[7];
    let y1: Word[8] = z1 ^ z3 ^ z4 ^ z6 ^ z7 ^ z8;
    let y2: Word[8] = z1 ^ z2 ^ z4 ^ z5 ^ z7 ^ z8;
    let y3: Word[8] = z1 ^ z2 ^ z3 ^ z5 ^ z6 ^ z8;
    let y4: Word[8] = z2 ^ z3 ^ z4 ^ z5 ^ z6 ^ z7;
    let y5: Word[8] = z1 ^ z2 ^ z6 ^ z7 ^ z8;
    let y6: Word[8] = z2 ^ z3 ^ z5 ^ z7 ^ z8;
    let y7: Word[8] = z3 ^ z4 ^ z5 ^ z6 ^ z8;
    let y8: Word[8] = z1 ^ z4 ^ z5 ^ z6 ^ z7;
    load_be64(y1, y2, y3, y4, y5, y6, y7, y8)
  }

  // Section 2.4.1: the F-function, F(F_IN, KE) = P(S(F_IN ^ KE)).
  spec f_function(f_in: Word[64], ke: Word[64]) -> Word[64] {
    let t: Word[64]^32 = sbox1();
    p_function(s_function(t, f_in ^ ke))
  }

  // Section 2.4.2: the FL-function on the 32-bit halves x1 || x2 of FL_IN
  // with the halves k1 || k2 of KE.
  spec fl_function(fl_in: Word[64], ke: Word[64]) -> Word[64] {
    let x1: Word[32] = (fl_in >> 32) as Word[32];
    let x2: Word[32] = fl_in as Word[32];
    let k1: Word[32] = (ke >> 32) as Word[32];
    let k2: Word[32] = ke as Word[32];
    let x2_out: Word[32] = x2 ^ ((x1 & k1) <<< 1);
    let x1_out: Word[32] = x1 ^ (x2_out | k2);
    ((x1_out as Word[64]) << 32) | (x2_out as Word[64])
  }

  // Section 2.4.3: the FLINV-function, the inverse of FL, on the halves
  // y1 || y2 of FLINV_IN.
  spec flinv_function(flinv_in: Word[64], ke: Word[64]) -> Word[64] {
    let y1: Word[32] = (flinv_in >> 32) as Word[32];
    let y2: Word[32] = flinv_in as Word[32];
    let k1: Word[32] = (ke >> 32) as Word[32];
    let k2: Word[32] = ke as Word[32];
    let y1_out: Word[32] = y1 ^ (y2 | k2);
    let y2_out: Word[32] = y2 ^ ((y1_out & k1) <<< 1);
    ((y1_out as Word[64]) << 32) | (y2_out as Word[64])
  }

  // Section 2.2: the constants Sigma1 through Sigma6 of the key schedule.
  spec sigma() -> Word[64]^6 {
    [
      0xa09e667f3bcc908b, 0xb67ae8584caa73b2, 0xc6ef372fe94f82be, 0x54ff53a5f1d36f1c,
      0x10e527fade682d1d, 0xb05688c2b3e6c1fd,
    ]
  }

  // Section 2.2: the 128-bit rotations (x <<< n) of the key schedule. A
  // shift amount may be computed; this rendering still writes one spec per
  // amount. For n above 64 the words change places and the rotation by
  // n - 64 remains.
  spec rotl128_15(x: Word[64]^2) -> Word[64]^2 {
    [(x[0] << 15) | (x[1] >> 49), (x[1] << 15) | (x[0] >> 49)]
  }
  spec rotl128_30(x: Word[64]^2) -> Word[64]^2 {
    [(x[0] << 30) | (x[1] >> 34), (x[1] << 30) | (x[0] >> 34)]
  }
  spec rotl128_45(x: Word[64]^2) -> Word[64]^2 {
    [(x[0] << 45) | (x[1] >> 19), (x[1] << 45) | (x[0] >> 19)]
  }
  spec rotl128_60(x: Word[64]^2) -> Word[64]^2 {
    [(x[0] << 60) | (x[1] >> 4), (x[1] << 60) | (x[0] >> 4)]
  }
  spec rotl128_77(x: Word[64]^2) -> Word[64]^2 {
    [(x[1] << 13) | (x[0] >> 51), (x[0] << 13) | (x[1] >> 51)]
  }
  spec rotl128_94(x: Word[64]^2) -> Word[64]^2 {
    [(x[1] << 30) | (x[0] >> 34), (x[0] << 30) | (x[1] >> 34)]
  }
  spec rotl128_111(x: Word[64]^2) -> Word[64]^2 {
    [(x[1] << 47) | (x[0] >> 17), (x[0] << 47) | (x[1] >> 17)]
  }

  // Section 2.2: KA from KL and KR, by four Feistel rounds keyed with Sigma1
  // through Sigma4, with KL xored back in after the second.
  spec derive_ka(kl: Word[64]^2, kr: Word[64]^2) -> Word[64]^2 {
    let c: Word[64]^6 = sigma();
    let d1: Word[64] = kl[0] ^ kr[0];
    let d2: Word[64] = kl[1] ^ kr[1];
    let d2_a: Word[64] = d2 ^ f_function(d1, c[0]);
    let d1_a: Word[64] = d1 ^ f_function(d2_a, c[1]);
    let d1_b: Word[64] = d1_a ^ kl[0];
    let d2_b: Word[64] = d2_a ^ kl[1];
    let d2_c: Word[64] = d2_b ^ f_function(d1_b, c[2]);
    let d1_c: Word[64] = d1_b ^ f_function(d2_c, c[3]);
    [d1_c, d2_c]
  }

  // Section 2.2: KB from KA and KR, by two more rounds keyed with Sigma5 and
  // Sigma6; used only for 192- and 256-bit keys.
  spec derive_kb(ka: Word[64]^2, kr: Word[64]^2) -> Word[64]^2 {
    let c: Word[64]^6 = sigma();
    let d1: Word[64] = ka[0] ^ kr[0];
    let d2: Word[64] = ka[1] ^ kr[1];
    let d2_a: Word[64] = d2 ^ f_function(d1, c[4]);
    let d1_a: Word[64] = d1 ^ f_function(d2_a, c[5]);
    [d1_a, d2_a]
  }

  // Section 2.2: the 26 subkeys of a 128-bit key, in one array laid out as
  // kw1, kw2, k1 through k18, ke1 through ke4, kw3, kw4. Each is a 64-bit
  // half of KL or KA rotated by the amount the RFC's table gives.
  spec subkeys_128(kl: Word[64]^2) -> Word[64]^26 {
    let ka: Word[64]^2 = derive_ka(kl, [0, 0]);
    let kl_15: Word[64]^2 = rotl128_15(kl);
    let ka_15: Word[64]^2 = rotl128_15(ka);
    let ka_30: Word[64]^2 = rotl128_30(ka);
    let kl_45: Word[64]^2 = rotl128_45(kl);
    let ka_45: Word[64]^2 = rotl128_45(ka);
    let kl_60: Word[64]^2 = rotl128_60(kl);
    let ka_60: Word[64]^2 = rotl128_60(ka);
    let kl_77: Word[64]^2 = rotl128_77(kl);
    let kl_94: Word[64]^2 = rotl128_94(kl);
    let ka_94: Word[64]^2 = rotl128_94(ka);
    let kl_111: Word[64]^2 = rotl128_111(kl);
    let ka_111: Word[64]^2 = rotl128_111(ka);
    [
      kl[0], kl[1],                                       // kw1, kw2
      ka[0], ka[1], kl_15[0], kl_15[1], ka_15[0], ka_15[1], // k1 to k6
      kl_45[0], kl_45[1], ka_45[0], kl_60[1], ka_60[0], ka_60[1], // k7 to k12
      kl_94[0], kl_94[1], ka_94[0], ka_94[1], kl_111[0], kl_111[1], // k13 to k18
      ka_30[0], ka_30[1], kl_77[0], kl_77[1],             // ke1 to ke4
      ka_111[0], ka_111[1],                               // kw3, kw4
    ]
  }

  // Section 2.2: the 34 subkeys of a 192- or 256-bit key, laid out as kw1,
  // kw2, k1 through k24, ke1 through ke6, kw3, kw4, from KL, KR, KA and KB.
  spec subkeys_192_256(kl: Word[64]^2, kr: Word[64]^2) -> Word[64]^34 {
    let ka: Word[64]^2 = derive_ka(kl, kr);
    let kb: Word[64]^2 = derive_kb(ka, kr);
    let kr_15: Word[64]^2 = rotl128_15(kr);
    let ka_15: Word[64]^2 = rotl128_15(ka);
    let kr_30: Word[64]^2 = rotl128_30(kr);
    let kb_30: Word[64]^2 = rotl128_30(kb);
    let kl_45: Word[64]^2 = rotl128_45(kl);
    let ka_45: Word[64]^2 = rotl128_45(ka);
    let kl_60: Word[64]^2 = rotl128_60(kl);
    let kr_60: Word[64]^2 = rotl128_60(kr);
    let kb_60: Word[64]^2 = rotl128_60(kb);
    let kl_77: Word[64]^2 = rotl128_77(kl);
    let ka_77: Word[64]^2 = rotl128_77(ka);
    let kr_94: Word[64]^2 = rotl128_94(kr);
    let ka_94: Word[64]^2 = rotl128_94(ka);
    let kl_111: Word[64]^2 = rotl128_111(kl);
    let kb_111: Word[64]^2 = rotl128_111(kb);
    [
      kl[0], kl[1],                                       // kw1, kw2
      kb[0], kb[1], kr_15[0], kr_15[1], ka_15[0], ka_15[1], // k1 to k6
      kb_30[0], kb_30[1], kl_45[0], kl_45[1], ka_45[0], ka_45[1], // k7 to k12
      kr_60[0], kr_60[1], kb_60[0], kb_60[1], kl_77[0], kl_77[1], // k13 to k18
      kr_94[0], kr_94[1], ka_94[0], ka_94[1], kl_111[0], kl_111[1], // k19 to k24
      kr_30[0], kr_30[1], kl_60[0], kl_60[1], ka_77[0], ka_77[1], // ke1 to ke6
      kb_111[0], kb_111[1],                               // kw3, kw4
    ]
  }

  // Section 2.2: a 128-bit key K is KL, and KR is zero.
  spec key_schedule_128(key: Word[8]^16) -> Word[64]^26 { subkeys_128(block_words(key)) }

  // Section 2.2: for a 192-bit key, KL is the first 128 bits and KR is the
  // remaining 64 bits followed by their complement.
  spec key_schedule_192(key: Word[8]^24) -> Word[64]^34 {
    let kl: Word[64]^2 = [
      load_be64(key[0], key[1], key[2], key[3], key[4], key[5], key[6], key[7]),
      load_be64(key[8], key[9], key[10], key[11], key[12], key[13], key[14], key[15]),
    ];
    let kr_hi: Word[64] =
      load_be64(key[16], key[17], key[18], key[19], key[20], key[21], key[22], key[23]);
    subkeys_192_256(kl, [kr_hi, ~kr_hi])
  }

  // Section 2.2: for a 256-bit key, KL is the first 128 bits and KR the last.
  spec key_schedule_256(key: Word[8]^32) -> Word[64]^34 {
    let kl: Word[64]^2 = [
      load_be64(key[0], key[1], key[2], key[3], key[4], key[5], key[6], key[7]),
      load_be64(key[8], key[9], key[10], key[11], key[12], key[13], key[14], key[15]),
    ];
    let kr: Word[64]^2 = [
      load_be64(key[16], key[17], key[18], key[19], key[20], key[21], key[22], key[23]),
      load_be64(key[24], key[25], key[26], key[27], key[28], key[29], key[30], key[31]),
    ];
    subkeys_192_256(kl, kr)
  }

  // Section 2.3: decryption uses the subkeys in the reverse order, kw1 with
  // kw3, kw2 with kw4, k1 with k18 and so on, ke1 with ke4 and ke2 with ke3.
  spec reverse_subkeys_128(sk: Word[64]^26) -> Word[64]^26 {
    let kw: Word[64]^26 = for i in 0..26 with r: Word[64]^26 = [0; 26] {
      if i == 0 { r with [0] = sk[24] }
      else if i == 1 { r with [1] = sk[25] }
      else if i == 24 { r with [24] = sk[0] }
      else if i == 25 { r with [25] = sk[1] }
      else { r }
    };
    let k: Word[64]^26 = for i in 0..18 with r: Word[64]^26 = kw { r with [2 + i] = sk[19 - i] };
    for i in 0..4 with r: Word[64]^26 = k { r with [20 + i] = sk[23 - i] }
  }

  // Section 2.3: the same for 24 rounds, k1 with k24 and ke1 with ke6.
  spec reverse_subkeys_192_256(sk: Word[64]^34) -> Word[64]^34 {
    let kw: Word[64]^34 = for i in 0..34 with r: Word[64]^34 = [0; 34] {
      if i == 0 { r with [0] = sk[32] }
      else if i == 1 { r with [1] = sk[33] }
      else if i == 32 { r with [32] = sk[0] }
      else if i == 33 { r with [33] = sk[1] }
      else { r }
    };
    let k: Word[64]^34 = for i in 0..24 with r: Word[64]^34 = kw { r with [2 + i] = sk[25 - i] };
    for i in 0..6 with r: Word[64]^34 = k { r with [26 + i] = sk[31 - i] }
  }

  // Section 2.3: one Feistel round. The RFC writes odd rounds as
  // D2 = D2 ^ F(D1, k) and even rounds as D1 = D1 ^ F(D2, k); with the halves
  // exchanged after every round both are this one formula, and six rounds
  // leave D1 and D2 in their original places.
  spec feistel_round(d: Word[64]^2, k: Word[64]) -> Word[64]^2 {
    [d[1] ^ f_function(d[0], k), d[0]]
  }

  // Section 2.3, 128-bit key: prewhitening with kw1 and kw2, 18 rounds with
  // FL and FLINV after rounds 6 and 12, and C = (D2 ^ kw3) || (D1 ^ kw4).
  // The subkeys are laid out as key_schedule_128 leaves them.
  spec data_randomizing_128(m: Word[64]^2, sk: Word[64]^26) -> Word[64]^2 {
    let d0: Word[64]^2 = [m[0] ^ sk[0], m[1] ^ sk[1]];
    let d6: Word[64]^2 = for r in 0..6 with d: Word[64]^2 = d0 { feistel_round(d, sk[2 + r]) };
    let fl6: Word[64]^2 = [fl_function(d6[0], sk[20]), flinv_function(d6[1], sk[21])];
    let d12: Word[64]^2 = for r in 6..12 with d: Word[64]^2 = fl6 { feistel_round(d, sk[2 + r]) };
    let fl12: Word[64]^2 = [fl_function(d12[0], sk[22]), flinv_function(d12[1], sk[23])];
    let d18: Word[64]^2 = for r in 12..18 with d: Word[64]^2 = fl12 { feistel_round(d, sk[2 + r]) };
    [d18[1] ^ sk[24], d18[0] ^ sk[25]]
  }

  // Section 2.3, 192- and 256-bit keys: 24 rounds with FL and FLINV after
  // rounds 6, 12 and 18.
  spec data_randomizing_192_256(m: Word[64]^2, sk: Word[64]^34) -> Word[64]^2 {
    let d0: Word[64]^2 = [m[0] ^ sk[0], m[1] ^ sk[1]];
    let d6: Word[64]^2 = for r in 0..6 with d: Word[64]^2 = d0 { feistel_round(d, sk[2 + r]) };
    let fl6: Word[64]^2 = [fl_function(d6[0], sk[26]), flinv_function(d6[1], sk[27])];
    let d12: Word[64]^2 = for r in 6..12 with d: Word[64]^2 = fl6 { feistel_round(d, sk[2 + r]) };
    let fl12: Word[64]^2 = [fl_function(d12[0], sk[28]), flinv_function(d12[1], sk[29])];
    let d18: Word[64]^2 = for r in 12..18 with d: Word[64]^2 = fl12 { feistel_round(d, sk[2 + r]) };
    let fl18: Word[64]^2 = [fl_function(d18[0], sk[30]), flinv_function(d18[1], sk[31])];
    let d24: Word[64]^2 = for r in 18..24 with d: Word[64]^2 = fl18 { feistel_round(d, sk[2 + r]) };
    [d24[1] ^ sk[32], d24[0] ^ sk[33]]
  }

  // Sections 2.2 and 2.3 together: one block, each key size, each direction.
  spec encrypt_128(key: Word[8]^16, m: Word[8]^16) -> Word[8]^16 {
    block_bytes(data_randomizing_128(block_words(m), key_schedule_128(key)))
  }
  spec decrypt_128(key: Word[8]^16, c: Word[8]^16) -> Word[8]^16 {
    block_bytes(data_randomizing_128(block_words(c), reverse_subkeys_128(key_schedule_128(key))))
  }
  spec encrypt_192(key: Word[8]^24, m: Word[8]^16) -> Word[8]^16 {
    block_bytes(data_randomizing_192_256(block_words(m), key_schedule_192(key)))
  }
  spec decrypt_192(key: Word[8]^24, c: Word[8]^16) -> Word[8]^16 {
    block_bytes(data_randomizing_192_256(
      block_words(c), reverse_subkeys_192_256(key_schedule_192(key))
    ))
  }
  spec encrypt_256(key: Word[8]^32, m: Word[8]^16) -> Word[8]^16 {
    block_bytes(data_randomizing_192_256(block_words(m), key_schedule_256(key)))
  }
  spec decrypt_256(key: Word[8]^32, c: Word[8]^16) -> Word[8]^16 {
    block_bytes(data_randomizing_192_256(
      block_words(c), reverse_subkeys_192_256(key_schedule_256(key))
    ))
  }

  // RFC 3713 Appendix A: the plaintext 0123456789abcdeffedcba9876543210 under
  // the 128-bit key 0123456789abcdeffedcba9876543210 gives the ciphertext
  // 67673138549669730857065648eabe43.
  spec appendix_a_plaintext() -> Word[8]^16 {
    [0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef, 0xfe, 0xdc, 0xba, 0x98, 0x76, 0x54, 0x32, 0x10]
  }

  spec appendix_a_key_128() -> Word[8]^16 {
    [0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef, 0xfe, 0xdc, 0xba, 0x98, 0x76, 0x54, 0x32, 0x10]
  }

  spec rfc3713_a_128() -> Word[8]^16 {
    encrypt_128(appendix_a_key_128(), appendix_a_plaintext())
  }
  spec rfc3713_a_128_expected() -> Word[8]^16 {
    [0x67, 0x67, 0x31, 0x38, 0x54, 0x96, 0x69, 0x73, 0x08, 0x57, 0x06, 0x56, 0x48, 0xea, 0xbe, 0x43]
  }

  // RFC 3713 Appendix A: the same ciphertext decrypted under the 128-bit key
  // gives the plaintext back.
  spec rfc3713_a_128_decrypt() -> Word[8]^16 {
    decrypt_128(appendix_a_key_128(), rfc3713_a_128_expected())
  }
  spec rfc3713_a_128_decrypt_expected() -> Word[8]^16 { appendix_a_plaintext() }

  // RFC 3713 Appendix A: the 192-bit key
  // 0123456789abcdeffedcba98765432100011223344556677 gives
  // b4993401b3e996f84ee5cee7d79b09b9.
  spec appendix_a_key_192() -> Word[8]^24 {
    [
      0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef, 0xfe, 0xdc, 0xba, 0x98, 0x76, 0x54, 0x32, 0x10,
      0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
    ]
  }

  spec rfc3713_a_192() -> Word[8]^16 {
    encrypt_192(appendix_a_key_192(), appendix_a_plaintext())
  }
  spec rfc3713_a_192_expected() -> Word[8]^16 {
    [0xb4, 0x99, 0x34, 0x01, 0xb3, 0xe9, 0x96, 0xf8, 0x4e, 0xe5, 0xce, 0xe7, 0xd7, 0x9b, 0x09, 0xb9]
  }

  spec rfc3713_a_192_decrypt() -> Word[8]^16 {
    decrypt_192(appendix_a_key_192(), rfc3713_a_192_expected())
  }
  spec rfc3713_a_192_decrypt_expected() -> Word[8]^16 { appendix_a_plaintext() }

  // RFC 3713 Appendix A: the 256-bit key
  // 0123456789abcdeffedcba987654321000112233445566778899aabbccddeeff gives
  // 9acc237dff16d76c20ef7c919e3a7509.
  spec appendix_a_key_256() -> Word[8]^32 {
    [
      0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef, 0xfe, 0xdc, 0xba, 0x98, 0x76, 0x54, 0x32, 0x10,
      0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff,
    ]
  }

  spec rfc3713_a_256() -> Word[8]^16 {
    encrypt_256(appendix_a_key_256(), appendix_a_plaintext())
  }
  spec rfc3713_a_256_expected() -> Word[8]^16 {
