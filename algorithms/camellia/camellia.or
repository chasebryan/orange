// Camellia, the 128-bit block cipher of RFC 3713, "A Description of the
// Camellia Encryption Algorithm" (Matsui, Nakajima, Moriai; NTT and
// Mitsubishi, 2004), https://www.rfc-editor.org/rfc/rfc3713, written the way
// the RFC writes it: the key scheduling part of section 2.2 with the Sigma
// constants and its 128-bit rotations, the data randomizing part of section
// 2.3 for 128-bit keys (18 rounds, FL and FLINV after rounds 6 and 12, 2.3.1)
// and for 192- and 256-bit keys (24 rounds, 2.3.2), decryption with the
// subkeys reversed (2.3.3), and the F-function, the FL- and FLINV-functions
// and the S-boxes of section 2.4. Encryption and decryption for all three key
// sizes reproduce the test data of RFC 3713 Appendix A, and encryption two
// cases of Botan's camellia.vec.
edition 2026;
module camellia {
  // Section 2.1: a 128-bit value (M, C, KL, KR, KA, KB) is held as its two
  // 64-bit halves, [v >> 64, v & MASK64]; in the data randomizing part these
  // are [D1, D2].
  type U128 = Word[64]^2;

  // Section 2.2: the subkeys of one key, as the three arrays kw1 through
  // kw4, k1 through k18 (or k24), and ke1 through ke4 (or ke6). The RFC
  // lists them in the order they are used; the arrays keep each family in
  // the order of its index.
  type Subkeys18 = (Word[64]^4, Word[64]^18, Word[64]^4);
  type Subkeys24 = (Word[64]^4, Word[64]^24, Word[64]^6);

  // Section 2.4.3: SBOX1, entry 16 r + c in row r and column c, in decimal
  // as the RFC prints it.
  spec sbox1() -> Word[8]^256 {
    [
      112, 130,  44, 236, 179,  39, 192, 229, 228, 133,  87,  53, 234,  12, 174,  65,  // 00
       35, 239, 107, 147,  69,  25, 165,  33, 237,  14,  79,  78,  29, 101, 146, 189,  // 10
      134, 184, 175, 143, 124, 235,  31, 206,  62,  48, 220,  95,  94, 197,  11,  26,  // 20
      166, 225,  57, 202, 213,  71,  93,  61, 217,   1,  90, 214,  81,  86, 108,  77,  // 30
      139,  13, 154, 102, 251, 204, 176,  45, 116,  18,  43,  32, 240, 177, 132, 153,  // 40
      223,  76, 203, 194,  52, 126, 118,   5, 109, 183, 169,  49, 209,  23,   4, 215,  // 50
       20,  88,  58,  97, 222,  27,  17,  28,  50,  15, 156,  22,  83,  24, 242,  34,  // 60
      254,  68, 207, 178, 195, 181, 122, 145,  36,   8, 232, 168,  96, 252, 105,  80,  // 70
      170, 208, 160, 125, 161, 137,  98, 151,  84,  91,  30, 149, 224, 255, 100, 210,  // 80
       16, 196,   0,  72, 163, 247, 117, 219, 138,   3, 230, 218,   9,  63, 221, 148,  // 90
      135,  92, 131,   2, 205,  74, 144,  51, 115, 103, 246, 243, 157, 127, 191, 226,  // a0
       82, 155, 216,  38, 200,  55, 198,  59, 129, 150, 111,  75,  19, 190,  99,  46,  // b0
      233, 121, 167, 140, 159, 110, 188, 142,  41, 245, 249, 182,  47, 253, 180,  89,  // c0
      120, 152,   6, 106, 231,  70, 113, 186, 212,  37, 171,  66, 136, 162, 141, 250,  // d0
      114,   7, 185,  85, 248, 238, 172,  10,  54,  73,  42, 104,  60,  56, 241, 164,  // e0
       64,  40, 211, 123, 187, 201,  67, 193,  21, 227, 173, 244, 119, 199, 128, 158,  // f0
    ]
  }

  // Section 2.4.3: SBOX2, SBOX3 and SBOX4 are defined from SBOX1, so only
  // SBOX1 is a table. Each takes the table s1 that the F-function reads once.
  spec sbox2(s1: Word[8]^256, x: Word[8]) -> Word[8] { s1[x] <<< 1 }
  spec sbox3(s1: Word[8]^256, x: Word[8]) -> Word[8] { s1[x] <<< 7 }
  spec sbox4(s1: Word[8]^256, x: Word[8]) -> Word[8] { s1[x <<< 1] }

  // Section 2.4.1: the F-function. The RFC's t1 = x >> 56 through
  // t8 = x & MASK8 are the eight bytes of x, most significant first, here
  // x[0] through x[7]; its t1 = SBOX1[t1] through t8 = SBOX1[t8] bind t1
  // through t8, and F_OUT = (y1 << 56) | ... | y8 joins y1 through y8 the
  // same way round.
  spec f(f_in: Word[64], ke: Word[64]) -> Word[64] {
    let s1: Word[8]^256 = sbox1();
    let x: Word[8]^8 = (f_in ^ ke) as big Word[8]^8;
    let t1: Word[8] = s1[x[0]];
    let t2: Word[8] = sbox2(s1, x[1]);
    let t3: Word[8] = sbox3(s1, x[2]);
    let t4: Word[8] = sbox4(s1, x[3]);
    let t5: Word[8] = sbox2(s1, x[4]);
    let t6: Word[8] = sbox3(s1, x[5]);
    let t7: Word[8] = sbox4(s1, x[6]);
    let t8: Word[8] = s1[x[7]];
    let y1: Word[8] = t1 ^ t3 ^ t4 ^ t6 ^ t7 ^ t8;
    let y2: Word[8] = t1 ^ t2 ^ t4 ^ t5 ^ t7 ^ t8;
    let y3: Word[8] = t1 ^ t2 ^ t3 ^ t5 ^ t6 ^ t8;
    let y4: Word[8] = t2 ^ t3 ^ t4 ^ t5 ^ t6 ^ t7;
    let y5: Word[8] = t1 ^ t2 ^ t6 ^ t7 ^ t8;
    let y6: Word[8] = t2 ^ t3 ^ t5 ^ t7 ^ t8;
    let y7: Word[8] = t3 ^ t4 ^ t5 ^ t6 ^ t8;
    let y8: Word[8] = t1 ^ t4 ^ t5 ^ t6 ^ t7;
    [y1, y2, y3, y4, y5, y6, y7, y8] as big Word[64]
  }

  // Section 2.4.2: a 64-bit value as its 32-bit halves, (v >> 32, v & MASK32).
  spec halves(v: Word[64]) -> (Word[32], Word[32]) {
    let h: Word[32]^2 = v as big Word[32]^2;
    (h[0], h[1])
  }

  // Section 2.4.2: the FL-function. The RFC assigns x2 and then x1 again;
  // the new values are x2_out and x1_out, and FL_OUT = (x1 << 32) | x2.
  spec fl(fl_in: Word[64], ke: Word[64]) -> Word[64] {
    let (x1: Word[32], x2: Word[32]) = halves(fl_in);
    let (k1: Word[32], k2: Word[32]) = halves(ke);
    let x2_out: Word[32] = x2 ^ ((x1 & k1) <<< 1);
    let x1_out: Word[32] = x1 ^ (x2_out | k2);
    [x1_out, x2_out] as big Word[64]
  }

  // Section 2.4.2: the FLINV-function, the inverse of FL, which undoes its
  // two steps in the reverse order.
  spec flinv(flinv_in: Word[64], ke: Word[64]) -> Word[64] {
    let (y1: Word[32], y2: Word[32]) = halves(flinv_in);
    let (k1: Word[32], k2: Word[32]) = halves(ke);
    let y1_out: Word[32] = y1 ^ (y2 | k2);
    let y2_out: Word[32] = y2 ^ ((y1_out & k1) <<< 1);
    [y1_out, y2_out] as big Word[64]
  }

  // Sections 2.2 and 2.3.1: two rounds as the RFC writes each pair,
  // D2 = D2 ^ F(D1, k1) and then D1 = D1 ^ F(D2, k2). The halves never
  // change places, so six rounds are three pairs.
  spec two_rounds(d: U128, k1: Word[64], k2: Word[64]) -> U128 {
    let d2: Word[64] = d[1] ^ f(d[0], k1);
    let d1: Word[64] = d[0] ^ f(d2, k2);
    [d1, d2]
  }

  spec six_rounds(d: U128, k: Word[64]^6) -> U128 {
    for i in 0..3 with e: U128 = d { two_rounds(e, k[2 * i], k[2 * i + 1]) }
  }

  // Section 2.2: a 128-bit xor, written on both halves.
  spec xor128(a: U128, b: U128) -> U128 { [a[0] ^ b[0], a[1] ^ b[1]] }

  // Section 2.2: the constants Sigma1 through Sigma6, here sigma()[0]
  // through sigma()[5].
  spec sigma() -> Word[64]^6 {
    [
      0xa09e667f3bcc908b, 0xb67ae8584caa73b2, 0xc6ef372fe94f82be, 0x54ff53a5f1d36f1c,
      0x10e527fade682d1d, 0xb05688c2b3e6c1fd,
    ]
  }

  // Section 2.2: KA from KL and KR. D1 || D2 starts as KL ^ KR, takes two
  // rounds keyed with Sigma1 and Sigma2, is xored with KL, and takes two
  // more with Sigma3 and Sigma4; KA = (D1 << 64) | D2.
  spec derive_ka(kl: U128, kr: U128) -> U128 {
    let s: Word[64]^6 = sigma();
    let d: U128 = two_rounds(xor128(kl, kr), s[0], s[1]);
    two_rounds(xor128(d, kl), s[2], s[3])
  }

  // Section 2.2: KB from KA and KR, by two rounds keyed with Sigma5 and
  // Sigma6; used only for 192- and 256-bit keys.
  spec derive_kb(ka: U128, kr: U128) -> U128 {
    let s: Word[64]^6 = sigma();
    two_rounds(xor128(ka, kr), s[4], s[5])
  }

  // Section 2.1: x <<< n on a 128-bit value. From n = 64 on the halves
  // change places and the rotation by n - 64 remains; a shift by 64 is 0,
  // so n = 0 and n = 64 need no case of their own.
  spec rotl128(v: U128, n: Int) -> U128 {
    let h: U128 = if n < 64 { v } else { [v[1], v[0]] };
    let m: Int = n % 64;
    [(h[0] << m) | (h[1] >> (64 - m)), (h[1] << m) | (h[0] >> (64 - m))]
  }

  // Section 2.2: the two halves of a rotated value, as the subkey tables
  // write them: high(v, n) is (v <<< n) >> 64 and low(v, n) is
  // (v <<< n) & MASK64.
  spec high(v: U128, n: Int) -> Word[64] { rotl128(v, n)[0] }
  spec low(v: U128, n: Int) -> Word[64] { rotl128(v, n)[1] }

  // Section 2.2: the subkeys of a 128-bit key, KL = K and KR = 0, from the
  // RFC's table row by row.
  spec key_schedule_128(key: Word[8]^16) -> Subkeys18 {
    let kl: U128 = key as big U128;
    let ka: U128 = derive_ka(kl, [0, 0]);
    let kw: Word[64]^4 = [
      high(kl, 0), low(kl, 0),       // kw1, kw2
      high(ka, 111), low(ka, 111),   // kw3, kw4
    ];
    let k: Word[64]^18 = [
      high(ka, 0), low(ka, 0),       // k1, k2
      high(kl, 15), low(kl, 15),     // k3, k4
      high(ka, 15), low(ka, 15),     // k5, k6
      high(kl, 45), low(kl, 45),     // k7, k8
      high(ka, 45), low(kl, 60),     // k9, k10
      high(ka, 60), low(ka, 60),     // k11, k12
      high(kl, 94), low(kl, 94),     // k13, k14
      high(ka, 94), low(ka, 94),     // k15, k16
      high(kl, 111), low(kl, 111),   // k17, k18
    ];
    let ke: Word[64]^4 = [
      high(ka, 30), low(ka, 30),     // ke1, ke2
      high(kl, 77), low(kl, 77),     // ke3, ke4
    ];
    (kw, k, ke)
  }

  // Section 2.2: the subkeys of a 192- or 256-bit key from KL and KR, from
  // the RFC's second table row by row.
  spec subkeys_192_256(kl: U128, kr: U128) -> Subkeys24 {
    let ka: U128 = derive_ka(kl, kr);
    let kb: U128 = derive_kb(ka, kr);
    let kw: Word[64]^4 = [
      high(kl, 0), low(kl, 0),       // kw1, kw2
      high(kb, 111), low(kb, 111),   // kw3, kw4
    ];
    let k: Word[64]^24 = [
      high(kb, 0), low(kb, 0),       // k1, k2
      high(kr, 15), low(kr, 15),     // k3, k4
      high(ka, 15), low(ka, 15),     // k5, k6
      high(kb, 30), low(kb, 30),     // k7, k8
      high(kl, 45), low(kl, 45),     // k9, k10
      high(ka, 45), low(ka, 45),     // k11, k12
      high(kr, 60), low(kr, 60),     // k13, k14
      high(kb, 60), low(kb, 60),     // k15, k16
      high(kl, 77), low(kl, 77),     // k17, k18
      high(kr, 94), low(kr, 94),     // k19, k20
      high(ka, 94), low(ka, 94),     // k21, k22
      high(kl, 111), low(kl, 111),   // k23, k24
    ];
    let ke: Word[64]^6 = [
      high(kr, 30), low(kr, 30),     // ke1, ke2
      high(kl, 60), low(kl, 60),     // ke3, ke4
      high(ka, 77), low(ka, 77),     // ke5, ke6
    ];
    (kw, k, ke)
  }

  // Section 2.2: for a 192-bit key, KL = K >> 64 and KR is the remaining
  // 64 bits followed by their complement.
  spec key_schedule_192(key: Word[8]^24) -> Subkeys24 {
    let w: Word[64]^3 = key as big Word[64]^3;
    subkeys_192_256([w[0], w[1]], [w[2], ~w[2]])
  }

  // Section 2.2: for a 256-bit key, KL = K >> 128 and KR = K & MASK128.
  spec key_schedule_256(key: Word[8]^32) -> Subkeys24 {
    subkeys_192_256(key[0..16] as big U128, key[16..32] as big U128)
  }

  // Section 2.3.1, 128-bit keys: M = (D1 << 64) | D2, prewhitening with kw1
  // and kw2, 18 rounds with FL and FLINV after rounds 6 and 12,
  // postwhitening, and C = (D2 << 64) | D1.
  spec data_randomizing_128(m: U128, s: Subkeys18) -> U128 {
    let kw: Word[64]^4 = s.0;
    let k: Word[64]^18 = s.1;
    let ke: Word[64]^4 = s.2;
    let d0: U128 = [m[0] ^ kw[0], m[1] ^ kw[1]];
    let d6: U128 = six_rounds(d0, k[0..6]);
    let e6: U128 = [fl(d6[0], ke[0]), flinv(d6[1], ke[1])];
    let d12: U128 = six_rounds(e6, k[6..12]);
    let e12: U128 = [fl(d12[0], ke[2]), flinv(d12[1], ke[3])];
    let d18: U128 = six_rounds(e12, k[12..18]);
    [d18[1] ^ kw[2], d18[0] ^ kw[3]]
  }

  // Section 2.3.2, 192- and 256-bit keys: the same with 24 rounds and FL
  // and FLINV after rounds 6, 12 and 18.
  spec data_randomizing_192_256(m: U128, s: Subkeys24) -> U128 {
    let kw: Word[64]^4 = s.0;
    let k: Word[64]^24 = s.1;
    let ke: Word[64]^6 = s.2;
    let d0: U128 = [m[0] ^ kw[0], m[1] ^ kw[1]];
    let d6: U128 = six_rounds(d0, k[0..6]);
    let e6: U128 = [fl(d6[0], ke[0]), flinv(d6[1], ke[1])];
    let d12: U128 = six_rounds(e6, k[6..12]);
    let e12: U128 = [fl(d12[0], ke[2]), flinv(d12[1], ke[3])];
    let d18: U128 = six_rounds(e12, k[12..18]);
    let e18: U128 = [fl(d18[0], ke[4]), flinv(d18[1], ke[5])];
    let d24: U128 = six_rounds(e18, k[18..24]);
    [d24[1] ^ kw[2], d24[0] ^ kw[3]]
  }

  // Section 2.3.3: an array of subkeys in the reverse order, k1 with kn and
  // so on.
  spec reversed[n in 4..25](x: Word[64]^n) -> Word[64]^n {
    for i in 0..(n) with r: Word[64]^n = x { r with [i] = x[n - 1 - i] }
  }

  // Section 2.3.3: decryption is encryption with the subkeys reversed: kw1
  // with kw3 and kw2 with kw4, k1 with k18 (or k24) and so on, ke1 with ke4
  // (or ke6) and so on. One spec serves both layouts.
  spec decryption_subkeys[S in {Subkeys18, Subkeys24}](s: S) -> S {
    (s.0[2..4] ++ s.0[0..2], reversed(s.1), reversed(s.2))
  }

  // Sections 2.2 and 2.3: one block, each key size, each direction. A block
  // is a 128-bit value read and written big-endian.
  spec encrypt_128(key: Word[8]^16, m: Word[8]^16) -> Word[8]^16 {
    data_randomizing_128(m as big U128, key_schedule_128(key)) as big Word[8]^16
  }

  spec decrypt_128(key: Word[8]^16, c: Word[8]^16) -> Word[8]^16 {
    let s: Subkeys18 = decryption_subkeys(key_schedule_128(key));
    data_randomizing_128(c as big U128, s) as big Word[8]^16
  }

  spec encrypt_192(key: Word[8]^24, m: Word[8]^16) -> Word[8]^16 {
    data_randomizing_192_256(m as big U128, key_schedule_192(key)) as big Word[8]^16
  }

  spec decrypt_192(key: Word[8]^24, c: Word[8]^16) -> Word[8]^16 {
    let s: Subkeys24 = decryption_subkeys(key_schedule_192(key));
    data_randomizing_192_256(c as big U128, s) as big Word[8]^16
  }

  spec encrypt_256(key: Word[8]^32, m: Word[8]^16) -> Word[8]^16 {
    data_randomizing_192_256(m as big U128, key_schedule_256(key)) as big Word[8]^16
  }

  spec decrypt_256(key: Word[8]^32, c: Word[8]^16) -> Word[8]^16 {
    let s: Subkeys24 = decryption_subkeys(key_schedule_256(key));
    data_randomizing_192_256(c as big U128, s) as big Word[8]^16
  }

  // RFC 3713 Appendix A: the plaintext 0123456789abcdeffedcba9876543210
  // under the 128-bit key of the same value.
  test "RFC 3713 Appendix A: 128-bit key encrypts" {
    encrypt_128(
      hex"01234567 89abcdef fedcba98 76543210",
      hex"01234567 89abcdef fedcba98 76543210",
    ) == hex"67673138 54966973 08570656 48eabe43"
  }

  // RFC 3713 Appendix A: the ciphertext decrypted under the same key gives
  // the plaintext back.
  test "RFC 3713 Appendix A: 128-bit key decrypts" {
    decrypt_128(
      hex"01234567 89abcdef fedcba98 76543210",
      hex"67673138 54966973 08570656 48eabe43",
    ) == hex"01234567 89abcdef fedcba98 76543210"
  }

  // RFC 3713 Appendix A: the 192-bit key
  // 0123456789abcdeffedcba98765432100011223344556677, the same plaintext.
  test "RFC 3713 Appendix A: 192-bit key encrypts" {
    encrypt_192(
      hex"01234567 89abcdef fedcba98 76543210 00112233 44556677",
      hex"01234567 89abcdef fedcba98 76543210",
    ) == hex"b4993401 b3e996f8 4ee5cee7 d79b09b9"
  }

  test "RFC 3713 Appendix A: 192-bit key decrypts" {
    decrypt_192(
      hex"01234567 89abcdef fedcba98 76543210 00112233 44556677",
      hex"b4993401 b3e996f8 4ee5cee7 d79b09b9",
    ) == hex"01234567 89abcdef fedcba98 76543210"
  }

  // RFC 3713 Appendix A: the 256-bit key
  // 0123456789abcdeffedcba987654321000112233445566778899aabbccddeeff, the
  // same plaintext.
  test "RFC 3713 Appendix A: 256-bit key encrypts" {
    encrypt_256(
      hex"01234567 89abcdef fedcba98 76543210 00112233 44556677 8899aabb ccddeeff",
      hex"01234567 89abcdef fedcba98 76543210",
    ) == hex"9acc237d ff16d76c 20ef7c91 9e3a7509"
  }

  test "RFC 3713 Appendix A: 256-bit key decrypts" {
    decrypt_256(
      hex"01234567 89abcdef fedcba98 76543210 00112233 44556677 8899aabb ccddeeff",
      hex"9acc237d ff16d76c 20ef7c91 9e3a7509",
    ) == hex"01234567 89abcdef fedcba98 76543210"
  }

  // Botan src/tests/data/block/camellia.vec, section [Camellia-128], second
  // case: the key 80000000000000000000000000000000 on the zero block.
  test "Botan camellia.vec [Camellia-128] case 2" {
    let key: Word[8]^16 = hex"80000000 00000000 00000000 00000000";
    let zero: Word[8]^16 = [0; 16];
    encrypt_128(key, zero) == hex"6c227f74 9319a3aa 7da235a9 bba05a2c"
  }

  // Botan camellia.vec, section [Camellia-256], third case: the key
  // 0000000000000200 followed by 24 zero bytes, on the zero block.
  test "Botan camellia.vec [Camellia-256] case 3" {
    let key: Word[8]^32 = hex"00000000 00000200" ++ [0; 24];
    let zero: Word[8]^16 = [0; 16];
    encrypt_256(key, zero) == hex"e18b0cb1 98012450 4b46a46a 6f4273f3"
  }
}
