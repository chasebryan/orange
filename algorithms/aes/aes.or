// AES, the Advanced Encryption Standard of FIPS 197 (NIST, 2001; update 1,
// May 2023), https://doi.org/10.6028/NIST.FIPS.197-upd1, written as the
// standard writes it: the state is the 4 x 4 byte array s[r][c] of section
// 3.4, the four transformations of section 5.1 and their inverses of section
// 5.3 act on it, KeyExpansion of section 5.2 makes the round keys for
// Nk = 4, 6 and 8, and Cipher and InvCipher take the number of rounds Nr as
// the standard's Algorithms 1 and 3 do. The S-box and its inverse are the
// tables of sections 5.1.1 and 5.3.2, read by the byte they substitute.
//
// The file reproduces the cipher examples of Appendix C.1, C.2 and C.3 and
// their inverses, and the output of the round-by-round example of Appendix
// B. The modes of operation of SP 800-38A are in aes-modes.or, which uses
// this module.
edition 2026;
module aes {
  // Section 3.4: the state is four rows of four bytes, s[r][c] the byte in
  // row r and column c.
  type Row = Word[8]^4;
  type State = Row^4;

  // Section 3.4: the input fills the state column by column,
  // s[r][c] = in[r + 4c], and the output is read back the same way,
  // out[r + 4c] = s[r][c].
  spec state(input: Word[8]^16) -> State {
    for r in 0..4 with s: State = [[0; 4]; 4] {
      for c in 0..4 with t: State = s { t with [r][c] = input[r + 4 * c] }
    }
  }

  spec output(s: State) -> Word[8]^16 {
    for i in 0..16 with out: Word[8]^16 = [0; 16] { out with [i] = s[i % 4][i / 4] }
  }

  // Section 4.2: xtime, multiplication by x in GF(2^8) modulo
  // m(x) = x^8 + x^4 + x^3 + x + 1.
  spec xtime(b: Word[8]) -> Word[8] {
    (b << 1) ^ (if (b & 0x80) != 0 { 0x1b } else { 0 })
  }

  // Section 4.2: the product a * b, adding x^k a, made by k applications of
  // xtime, for every bit k of b that is set. MixColumns and InvMixColumns
  // pass a matrix constant as a and a state byte as b, so the branch on the
  // bits of b follows the data and the xtime steps on m do not.
  spec mul(a: Word[8], b: Word[8]) -> Word[8] {
    let walk: (Word[8], Word[8]) = for k in 0..8 with (p: Word[8], m: Word[8]) = (0, a) {
      (if ((b >> k) & 1) == 1 { p ^ m } else { p }, xtime(m))
    };
    walk.0
  }

  // Section 5.1.1, Table 4 (Figure 7 of the 2001 text): the S-box, row x (the high four bits of the
  // byte) as printed, columns y (the low four bits) 0 through f. Entry xy is
  // the affine map b'_i = b_i + b_(i+4) + b_(i+5) + b_(i+6) + b_(i+7) + c_i
  // over GF(2), the indices taken modulo 8 and c = 0x63, applied to the
  // multiplicative inverse of xy in GF(2^8) modulo m(x), the inverse of 0
  // being 0.
  spec sbox() -> Word[8]^256 {
    hex"63 7c 77 7b f2 6b 6f c5 30 01 67 2b fe d7 ab 76" ++
    hex"ca 82 c9 7d fa 59 47 f0 ad d4 a2 af 9c a4 72 c0" ++
    hex"b7 fd 93 26 36 3f f7 cc 34 a5 e5 f1 71 d8 31 15" ++
    hex"04 c7 23 c3 18 96 05 9a 07 12 80 e2 eb 27 b2 75" ++
    hex"09 83 2c 1a 1b 6e 5a a0 52 3b d6 b3 29 e3 2f 84" ++
    hex"53 d1 00 ed 20 fc b1 5b 6a cb be 39 4a 4c 58 cf" ++
    hex"d0 ef aa fb 43 4d 33 85 45 f9 02 7f 50 3c 9f a8" ++
    hex"51 a3 40 8f 92 9d 38 f5 bc b6 da 21 10 ff f3 d2" ++
    hex"cd 0c 13 ec 5f 97 44 17 c4 a7 7e 3d 64 5d 19 73" ++
    hex"60 81 4f dc 22 2a 90 88 46 ee b8 14 de 5e 0b db" ++
    hex"e0 32 3a 0a 49 06 24 5c c2 d3 ac 62 91 95 e4 79" ++
    hex"e7 c8 37 6d 8d d5 4e a9 6c 56 f4 ea 65 7a ae 08" ++
    hex"ba 78 25 2e 1c a6 b4 c6 e8 dd 74 1f 4b bd 8b 8a" ++
    hex"70 3e b5 66 48 03 f6 0e 61 35 57 b9 86 c1 1d 9e" ++
    hex"e1 f8 98 11 69 d9 8e 94 9b 1e 87 e9 ce 55 28 df" ++
    hex"8c a1 89 0d bf e6 42 68 41 99 2d 0f b0 54 bb 16"
  }

  // Section 5.3.2, Table 6 (Figure 14 of the 2001 text): the inverse S-box,
  // laid out the same way.
  spec inv_sbox() -> Word[8]^256 {
    hex"52 09 6a d5 30 36 a5 38 bf 40 a3 9e 81 f3 d7 fb" ++
    hex"7c e3 39 82 9b 2f ff 87 34 8e 43 44 c4 de e9 cb" ++
    hex"54 7b 94 32 a6 c2 23 3d ee 4c 95 0b 42 fa c3 4e" ++
    hex"08 2e a1 66 28 d9 24 b2 76 5b a2 49 6d 8b d1 25" ++
    hex"72 f8 f6 64 86 68 98 16 d4 a4 5c cc 5d 65 b6 92" ++
    hex"6c 70 48 50 fd ed b9 da 5e 15 46 57 a7 8d 9d 84" ++
    hex"90 d8 ab 00 8c bc d3 0a f7 e4 58 05 b8 b3 45 06" ++
    hex"d0 2c 1e 8f ca 3f 0f 02 c1 af bd 03 01 13 8a 6b" ++
    hex"3a 91 11 41 4f 67 dc ea 97 f2 cf ce f0 b4 e6 73" ++
    hex"96 ac 74 22 e7 ad 35 85 e2 f9 37 e8 1c 75 df 6e" ++
    hex"47 f1 1a 71 1d 29 c5 89 6f b7 62 0e aa 18 be 1b" ++
    hex"fc 56 3e 4b c6 d2 79 20 9a db c0 fe 78 cd 5a f4" ++
    hex"1f dd a8 33 88 07 c7 31 b1 12 10 59 27 80 ec 5f" ++
    hex"60 51 7f a9 19 b5 4a 0d 2d e5 7a 9f 93 c9 9c ef" ++
    hex"a0 e0 3b 4d ae 2a f5 b0 c8 eb bb 3c 83 53 99 61" ++
    hex"17 2b 04 7e ba 77 d6 26 e1 69 14 63 55 21 0c 7d"
  }

  // Section 5.1.1: SubBytes, s'[r][c] = SBOX(s[r][c]), the byte itself the
  // index into Table 4.
  spec sub_bytes(s: State) -> State {
    let sbox: Word[8]^256 = sbox();
    for r in 0..4 with t: State = s {
      for c in 0..4 with u: State = t { u with [r][c] = sbox[s[r][c]] }
    }
  }

  // Section 5.3.2: InvSubBytes, s'[r][c] = INVSBOX(s[r][c]).
  spec inv_sub_bytes(s: State) -> State {
    let inv_sbox: Word[8]^256 = inv_sbox();
    for r in 0..4 with t: State = s {
      for c in 0..4 with u: State = t { u with [r][c] = inv_sbox[s[r][c]] }
    }
  }

  // Section 5.1.2: ShiftRows turns row r left by r places,
  // s'[r][c] = s[r][(c + r) mod 4].
  spec shift_rows(s: State) -> State {
    for r in 0..4 with t: State = s {
      for c in 0..4 with u: State = t { u with [r][c] = s[r][(c + r) % 4] }
    }
  }

  // Section 5.3.1: InvShiftRows turns row r right by r places,
  // s'[r][c] = s[r][(c - r) mod 4].
  spec inv_shift_rows(s: State) -> State {
    for r in 0..4 with t: State = s {
      for c in 0..4 with u: State = t { u with [r][c] = s[r][(c - r) % 4] }
    }
  }

  // Sections 5.1.3 and 5.3.3: each column multiplied by a fixed matrix whose
  // rows are rotations of its first row m, so that
  // s'[r][c] = m[0] s[r][c] + m[1] s[r + 1][c] + m[2] s[r + 2][c] + m[3] s[r + 3][c],
  // the row indices taken modulo 4. This is the product of the column with a
  // fixed polynomial modulo x^4 + 1.
  spec mix(s: State, m: Row) -> State {
    for r in 0..4 with t: State = s {
      for c in 0..4 with u: State = t {
        u with [r][c] = mul(m[0], s[r][c])
          ^ mul(m[1], s[(r + 1) % 4][c])
          ^ mul(m[2], s[(r + 2) % 4][c])
          ^ mul(m[3], s[(r + 3) % 4][c])
      }
    }
  }

  // Section 5.1.3: MixColumns, the polynomial
  // a(x) = {03}x^3 + {01}x^2 + {01}x + {02}, whose matrix has first row
  // {02} {03} {01} {01}.
  spec mix_columns(s: State) -> State { mix(s, [0x02, 0x03, 0x01, 0x01]) }

  // Section 5.3.3: InvMixColumns, the inverse polynomial
  // a^-1(x) = {0b}x^3 + {0d}x^2 + {09}x + {0e}, first row {0e} {0b} {0d} {09}.
  spec inv_mix_columns(s: State) -> State { mix(s, [0x0e, 0x0b, 0x0d, 0x09]) }

  // Section 5.1.4: AddRoundKey adds word w[4 round + c] of the round key to
  // column c. A word [a0, a1, a2, a3] is held here with a0 its most
  // significant byte, as KeyExpansion reads the key, so its bytes from the
  // most significant down go to rows 0 through 3.
  spec add_round_key(s: State, k: Word[32]^4) -> State {
    for c in 0..4 with t: State = s {
      let word: Word[8]^4 = k[c] as big Word[8]^4;
      for r in 0..4 with u: State = t { u with [r][c] = s[r][c] ^ word[r] }
    }
  }

  // Section 5.2: RotWord([a0, a1, a2, a3]) = [a1, a2, a3, a0] and SubWord,
  // the S-box on each of the four bytes, with a0 the most significant byte
  // of the word.
  spec rot_word(w: Word[32]) -> Word[32] { w <<< 8 }

  spec sub_word(w: Word[32]) -> Word[32] {
    let sbox: Word[8]^256 = sbox();
    let a: Word[8]^4 = w as big Word[8]^4;
    [sbox[a[0]], sbox[a[1]], sbox[a[2]], sbox[a[3]]] as big Word[32]
  }

  // Section 5.2, Table 5: the round constants Rcon[1] through Rcon[10], the
  // words [x^(j - 1), 00, 00, 00] with the powers of x taken in GF(2^8).
  // Rcon[j] is element j - 1 of the array.
  spec rcon() -> Word[32]^10 {
    (
      hex"01000000 02000000 04000000 08000000 10000000" ++
      hex"20000000 40000000 80000000 1b000000 36000000"
    ) as big Word[32]^10
  }

  // Section 5.2, Algorithm 2: KeyExpansion(key) for a key of Nk words, the
  // schedule w of 4 Nr + 4 = 4 Nk + 28 words. The key fills w[0] through
  // w[Nk - 1]; then w[i] = w[i - Nk] + temp, where temp is w[i - 1],
  // transformed by RotWord, SubWord and Rcon[i / Nk] when i is a multiple of
  // Nk, and by SubWord alone when Nk > 6 and i mod Nk = 4. AES takes Nk = 4,
  // 6 and 8; a size ranges over an interval, so the instances 5 and 7 in the
  // range exist but are not called.
  spec key_expansion[nk in 4..9](key: Word[8]^(4 * nk)) -> Word[32]^(4 * nk + 28) {
    let rcon: Word[32]^10 = rcon();
    let first: Word[32]^(4 * nk + 28) = (key as big Word[32]^nk) ++ [0; (3 * nk + 28)];
    for i in (nk)..(4 * nk + 28) with w: Word[32]^(4 * nk + 28) = first {
      let temp: Word[32] = if (i % nk) == 0 {
        sub_word(rot_word(w[i - 1])) ^ rcon[(i / nk) - 1]
      } else if (nk > 6) && ((i % nk) == 4) {
        sub_word(w[i - 1])
      } else {
        w[i - 1]
      };
      w with [i] = w[i - nk] ^ temp
    }
  }

  // Section 5.1, Algorithm 1: Cipher(in, Nr, w). Round 0 adds the first
  // round key; rounds 1 through Nr - 1 apply SubBytes, ShiftRows, MixColumns
  // and AddRoundKey; round Nr omits MixColumns. Round key `round` is the
  // four words w[4 round] through w[4 round + 3], the slice
  // w[4 round .. 4 round + 4]. The standard's parameter Nr is the size `nr`;
  // its range 10..15 also holds 11 and 13, which AES does not use, and the
  // callers tie Nr = Nk + 6 (aes128 calls cipher[10], aes192 cipher[12],
  // aes256 cipher[14]).
  spec cipher[nr in 10..15](input: Word[8]^16, w: Word[32]^(4 * nr + 4)) -> Word[8]^16 {
    let first: State = add_round_key(state(input), w[0..4]);
    let middle: State = for round in 1..(nr) with s: State = first {
      add_round_key(mix_columns(shift_rows(sub_bytes(s))), w[4 * round..4 * round + 4])
    };
    output(add_round_key(shift_rows(sub_bytes(middle)), w[4 * nr..4 * nr + 4]))
  }

  // Section 5.3, Algorithm 3: InvCipher(in, Nr, w). Round Nr's key is added
  // first; the rounds Nr - 1 down to 1 apply InvShiftRows, InvSubBytes,
  // AddRoundKey and InvMixColumns; the last omits InvMixColumns and adds the
  // first round key. A loop counts up, so step j runs round Nr - j. Nr is
  // the size `nr`, as in Cipher.
  spec inv_cipher[nr in 10..15](input: Word[8]^16, w: Word[32]^(4 * nr + 4)) -> Word[8]^16 {
    let first: State = add_round_key(state(input), w[4 * nr..4 * nr + 4]);
    let middle: State = for j in 1..(nr) with s: State = first {
      inv_mix_columns(add_round_key(
        inv_sub_bytes(inv_shift_rows(s)),
        w[4 * (nr - j)..4 * (nr - j) + 4],
      ))
    };
    output(add_round_key(inv_sub_bytes(inv_shift_rows(middle)), w[0..4]))
  }

  // Section 5, as the 2023 update names them: AES-128, AES-192 and AES-256
  // are Cipher with Nr = 10, 12 and 14 under the schedule KeyExpansion(key),
  // and their inverses are InvCipher under the same schedule.
  spec aes128(key: Word[8]^16, input: Word[8]^16) -> Word[8]^16 {
    cipher[10](input, key_expansion(key))
  }

  spec aes192(key: Word[8]^24, input: Word[8]^16) -> Word[8]^16 {
    cipher[12](input, key_expansion(key))
  }

  spec aes256(key: Word[8]^32, input: Word[8]^16) -> Word[8]^16 {
    cipher[14](input, key_expansion(key))
  }

  spec aes128_inverse(key: Word[8]^16, input: Word[8]^16) -> Word[8]^16 {
    inv_cipher[10](input, key_expansion(key))
  }

  spec aes192_inverse(key: Word[8]^24, input: Word[8]^16) -> Word[8]^16 {
    inv_cipher[12](input, key_expansion(key))
  }

  spec aes256_inverse(key: Word[8]^32, input: Word[8]^16) -> Word[8]^16 {
    inv_cipher[14](input, key_expansion(key))
  }

  // The vectors. Appendix C encrypts the plaintext 00112233...eeff under
  // the keys 000102...0f, 000102...17 and 000102...1f, and its INVERSE
  // CIPHER sections take each ciphertext back to the plaintext; the values
  // as printed in OpenSSL's evpciph_aes_common.txt.

  // FIPS 197, Appendix C.1, AES-128 (Nk = 4, Nr = 10).
  test "FIPS 197 C.1: AES-128 encrypts" {
    aes128(hex"00010203 04050607 08090a0b 0c0d0e0f", hex"00112233 44556677 8899aabb ccddeeff")
      == hex"69c4e0d8 6a7b0430 d8cdb780 70b4c55a"
  }

  // FIPS 197, Appendix C.1, INVERSE CIPHER.
  test "FIPS 197 C.1: AES-128 inverse cipher" {
    aes128_inverse(
      hex"00010203 04050607 08090a0b 0c0d0e0f",
      hex"69c4e0d8 6a7b0430 d8cdb780 70b4c55a",
    ) == hex"00112233 44556677 8899aabb ccddeeff"
  }

  // FIPS 197, Appendix C.2, AES-192 (Nk = 6, Nr = 12).
  test "FIPS 197 C.2: AES-192 encrypts" {
    aes192(
      hex"00010203 04050607 08090a0b 0c0d0e0f 10111213 14151617",
      hex"00112233 44556677 8899aabb ccddeeff",
    ) == hex"dda97ca4 864cdfe0 6eaf70a0 ec0d7191"
  }

  // FIPS 197, Appendix C.2, INVERSE CIPHER.
  test "FIPS 197 C.2: AES-192 inverse cipher" {
    aes192_inverse(
      hex"00010203 04050607 08090a0b 0c0d0e0f 10111213 14151617",
      hex"dda97ca4 864cdfe0 6eaf70a0 ec0d7191",
    ) == hex"00112233 44556677 8899aabb ccddeeff"
  }

  // FIPS 197, Appendix C.3, AES-256 (Nk = 8, Nr = 14).
  test "FIPS 197 C.3: AES-256 encrypts" {
    aes256(
      hex"00010203 04050607 08090a0b 0c0d0e0f 10111213 14151617 18191a1b 1c1d1e1f",
      hex"00112233 44556677 8899aabb ccddeeff",
    ) == hex"8ea2b7ca 516745bf eafc4990 4b496089"
  }

  // FIPS 197, Appendix C.3, INVERSE CIPHER.
  test "FIPS 197 C.3: AES-256 inverse cipher" {
    aes256_inverse(
      hex"00010203 04050607 08090a0b 0c0d0e0f 10111213 14151617 18191a1b 1c1d1e1f",
      hex"8ea2b7ca 516745bf eafc4990 4b496089",
    ) == hex"00112233 44556677 8899aabb ccddeeff"
  }

  // FIPS 197, Appendix B: the round-by-round example, input 3243f6a8... under
  // the key 2b7e1516...; the output 3925841d... is the value the Python
  // cryptography package gives for it, since the vector file omits this case.
  test "FIPS 197 B: the cipher example" {
    aes128(hex"2b7e1516 28aed2a6 abf71588 09cf4f3c", hex"3243f6a8 885a308d 313198a2 e0370734")
      == hex"3925841d 02dc09fb dc118597 196a0b32"
  }
}
