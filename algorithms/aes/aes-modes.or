// The confidentiality modes of NIST SP 800-38A, Recommendation for Block
// Cipher Modes of Operation: Methods and Techniques (December 2001),
// https://doi.org/10.6028/NIST.SP.800-38A, over the AES of FIPS 197
// (https://doi.org/10.6028/NIST.FIPS.197-upd1), which this file uses from
// aes.or: ECB, CBC, CFB with a 128-bit segment, OFB and CTR, written as the
// equations of section 6 for messages of one to four whole blocks, with the
// standard incrementing function of Appendix B.1 for CTR.
//
// The file reproduces the four-block examples F.1.1, F.1.2, F.2.1, F.2.2,
// F.3.13, F.3.14, F.4.1, F.4.2, F.5.1, F.5.2, F.5.5 and F.5.6 of Appendix F,
// encryption and decryption of ECB, CBC, CFB128, OFB and CTR under AES-128
// and of CTR under AES-256.
edition 2026;
module aes_modes {
  use aes;

  // Every mode takes the forward cipher CIPH_K (and ECB and CBC decryption
  // the inverse cipher CIPH^-1_K) as the AES key schedule w of Nr rounds,
  // and a message of n blocks, P_1 through P_n, as 16 n bytes. Block j of
  // the standard, counted from 1, is the slice [16 (j - 1) .. 16 j]; the
  // loops below count j from 0.

  // Section 4.2: X xor Y, the bitwise exclusive-or of two strings of the
  // same length.
  spec xor[n in 1..5](x: Word[8]^(16 * n), y: Word[8]^(16 * n)) -> Word[8]^(16 * n) {
    for i in 0..(16 * n) with z: Word[8]^(16 * n) = x { z with [i] = x[i] ^ y[i] }
  }

  // Section 6.1, ECB encryption: C_j = CIPH_K(P_j) for j = 1 through n.
  spec ecb_encrypt[nr in 10..15, n in 1..5](
    w: Word[32]^(4 * nr + 4),
    p: Word[8]^(16 * n),
  ) -> Word[8]^(16 * n) {
    for j in 0..(n) with c: Word[8]^(16 * n) = p {
      c with [16 * j..16 * j + 16] = aes::cipher[nr](p[16 * j..16 * j + 16], w)
    }
  }

  // Section 6.1, ECB decryption: P_j = CIPH^-1_K(C_j).
  spec ecb_decrypt[nr in 10..15, n in 1..5](
    w: Word[32]^(4 * nr + 4),
    c: Word[8]^(16 * n),
  ) -> Word[8]^(16 * n) {
    for j in 0..(n) with p: Word[8]^(16 * n) = c {
      p with [16 * j..16 * j + 16] = aes::inv_cipher[nr](c[16 * j..16 * j + 16], w)
    }
  }

  // Section 6.2, CBC encryption: C_1 = CIPH_K(P_1 xor IV) and
  // C_j = CIPH_K(P_j xor C_(j-1)). The loop carries C_(j-1), the IV at first.
  spec cbc_encrypt[nr in 10..15, n in 1..5](
    w: Word[32]^(4 * nr + 4),
    iv: Word[8]^16,
    p: Word[8]^(16 * n),
  ) -> Word[8]^(16 * n) {
    let run: (Word[8]^(16 * n), Word[8]^16) =
      for j in 0..(n) with (c: Word[8]^(16 * n), last: Word[8]^16) = (p, iv) {
        let cj: Word[8]^16 = aes::cipher[nr](xor(p[16 * j..16 * j + 16], last), w);
        (c with [16 * j..16 * j + 16] = cj, cj)
      };
    run.0
  }

  // Section 6.2, CBC decryption: P_1 = CIPH^-1_K(C_1) xor IV and
  // P_j = CIPH^-1_K(C_j) xor C_(j-1).
  spec cbc_decrypt[nr in 10..15, n in 1..5](
    w: Word[32]^(4 * nr + 4),
    iv: Word[8]^16,
    c: Word[8]^(16 * n),
  ) -> Word[8]^(16 * n) {
    let run: (Word[8]^(16 * n), Word[8]^16) =
      for j in 0..(n) with (p: Word[8]^(16 * n), last: Word[8]^16) = (c, iv) {
        let cj: Word[8]^16 = c[16 * j..16 * j + 16];
        (p with [16 * j..16 * j + 16] = xor(aes::inv_cipher[nr](cj, w), last), cj)
      };
    run.0
  }

  // Section 6.3, CFB encryption with s = 128, so that a segment is a whole
  // block and the input block is the previous ciphertext block itself:
  // I_1 = IV, I_j = C_(j-1), O_j = CIPH_K(I_j), C_j = P_j xor O_j.
  spec cfb128_encrypt[nr in 10..15, n in 1..5](
    w: Word[32]^(4 * nr + 4),
    iv: Word[8]^16,
    p: Word[8]^(16 * n),
  ) -> Word[8]^(16 * n) {
    let run: (Word[8]^(16 * n), Word[8]^16) =
      for j in 0..(n) with (c: Word[8]^(16 * n), input: Word[8]^16) = (p, iv) {
        let cj: Word[8]^16 = xor(p[16 * j..16 * j + 16], aes::cipher[nr](input, w));
        (c with [16 * j..16 * j + 16] = cj, cj)
      };
    run.0
  }

  // Section 6.3, CFB decryption with s = 128: the same input blocks
  // I_j = C_(j-1), read from the ciphertext, and P_j = C_j xor O_j. The
  // forward cipher serves both directions.
  spec cfb128_decrypt[nr in 10..15, n in 1..5](
    w: Word[32]^(4 * nr + 4),
    iv: Word[8]^16,
    c: Word[8]^(16 * n),
  ) -> Word[8]^(16 * n) {
    let run: (Word[8]^(16 * n), Word[8]^16) =
      for j in 0..(n) with (p: Word[8]^(16 * n), input: Word[8]^16) = (c, iv) {
        let cj: Word[8]^16 = c[16 * j..16 * j + 16];
        (p with [16 * j..16 * j + 16] = xor(cj, aes::cipher[nr](input, w)), cj)
      };
    run.0
  }

  // Section 6.4, OFB: I_1 = IV, O_j = CIPH_K(I_j), I_(j+1) = O_j. The
  // output blocks O_1 through O_n depend on the IV alone.
  spec ofb_output_blocks[nr in 10..15, n in 1..5](
    w: Word[32]^(4 * nr + 4),
    iv: Word[8]^16,
  ) -> Word[8]^(16 * n) {
    let run: (Word[8]^(16 * n), Word[8]^16) =
      for j in 0..(n) with (o: Word[8]^(16 * n), input: Word[8]^16) = ([0; (16 * n)], iv) {
        let oj: Word[8]^16 = aes::cipher[nr](input, w);
        (o with [16 * j..16 * j + 16] = oj, oj)
      };
    run.0
  }

  // Section 6.4, OFB encryption C_j = P_j xor O_j and decryption
  // P_j = C_j xor O_j.
  spec ofb_encrypt[nr in 10..15, n in 1..5](
    w: Word[32]^(4 * nr + 4),
    iv: Word[8]^16,
    p: Word[8]^(16 * n),
  ) -> Word[8]^(16 * n) {
    xor(p, ofb_output_blocks[nr, n](w, iv))
  }

  spec ofb_decrypt[nr in 10..15, n in 1..5](
    w: Word[32]^(4 * nr + 4),
    iv: Word[8]^16,
    c: Word[8]^(16 * n),
  ) -> Word[8]^(16 * n) {
    xor(c, ofb_output_blocks[nr, n](w, iv))
  }

  // Appendix B.1, the standard incrementing function with m = 128: the
  // whole counter block as a big-endian integer, plus one modulo 2^128.
  spec increment(t: Word[8]^16) -> Word[8]^16 {
    let x: Int = t as big Int;
    let next: Int = x + 1;
    next as big Word[8]^16
  }

  // Section 6.5, CTR: the counter blocks T_1, T_2 = T_1 + 1, ... (Appendix
  // B.1) and the output blocks O_j = CIPH_K(T_j).
  spec ctr_output_blocks[nr in 10..15, n in 1..5](
    w: Word[32]^(4 * nr + 4),
    t1: Word[8]^16,
  ) -> Word[8]^(16 * n) {
    let run: (Word[8]^(16 * n), Word[8]^16) =
      for j in 0..(n) with (o: Word[8]^(16 * n), t: Word[8]^16) = ([0; (16 * n)], t1) {
        (o with [16 * j..16 * j + 16] = aes::cipher[nr](t, w), increment(t))
      };
    run.0
  }

  // Section 6.5, CTR encryption C_j = P_j xor O_j and decryption
  // P_j = C_j xor O_j.
  spec ctr_encrypt[nr in 10..15, n in 1..5](
    w: Word[32]^(4 * nr + 4),
    t1: Word[8]^16,
    p: Word[8]^(16 * n),
  ) -> Word[8]^(16 * n) {
    xor(p, ctr_output_blocks[nr, n](w, t1))
  }

  spec ctr_decrypt[nr in 10..15, n in 1..5](
    w: Word[32]^(4 * nr + 4),
    t1: Word[8]^16,
    c: Word[8]^(16 * n),
  ) -> Word[8]^(16 * n) {
    xor(c, ctr_output_blocks[nr, n](w, t1))
  }

  // Appendix F: the inputs the examples share. The AES-128 examples use the
  // key 2b7e1516..., the AES-256 ones 603deb10...; CBC, CFB and OFB use the
  // IV 00010203...0f, CTR the initial counter block f0f1f2f3...ff; every
  // example encrypts the same four plaintext blocks.
  spec example_key_128() -> Word[8]^16 { hex"2b7e1516 28aed2a6 abf71588 09cf4f3c" }

  spec example_key_256() -> Word[8]^32 {
    hex"603deb10 15ca71be 2b73aef0 857d7781 1f352c07 3b6108d7 2d9810a3 0914dff4"
  }

  spec example_iv() -> Word[8]^16 { hex"00010203 04050607 08090a0b 0c0d0e0f" }

  spec example_counter() -> Word[8]^16 { hex"f0f1f2f3 f4f5f6f7 f8f9fafb fcfdfeff" }

  spec example_plaintext() -> Word[8]^64 {
    hex"6bc1bee22e409f96e93d7e117393172a" ++
    hex"ae2d8a571e03ac9c9eb76fac45af8e51" ++
    hex"30c81c46a35ce411e5fbc1191a0a52ef" ++
    hex"f69f2445df4f9b17ad2b417be66c3710"
  }

  // The vectors, one test per example, the ciphertext one block to a line
  // as Appendix F prints it.

  // SP 800-38A, Appendix F.1.1, ECB-AES128.Encrypt.
  test "SP 800-38A F.1.1: ECB-AES128.Encrypt" {
    ecb_encrypt(aes::key_expansion(example_key_128()), example_plaintext()) == (
      hex"3ad77bb40d7a3660a89ecaf32466ef97" ++
      hex"f5d3d58503b9699de785895a96fdbaaf" ++
      hex"43b1cd7f598ece23881b00e3ed030688" ++
      hex"7b0c785e27e8ad3f8223207104725dd4"
    )
  }

  // SP 800-38A, Appendix F.1.2, ECB-AES128.Decrypt.
  test "SP 800-38A F.1.2: ECB-AES128.Decrypt" {
    let c: Word[8]^64 =
      hex"3ad77bb40d7a3660a89ecaf32466ef97" ++
      hex"f5d3d58503b9699de785895a96fdbaaf" ++
      hex"43b1cd7f598ece23881b00e3ed030688" ++
      hex"7b0c785e27e8ad3f8223207104725dd4";
    ecb_decrypt(aes::key_expansion(example_key_128()), c) == example_plaintext()
  }

  // SP 800-38A, Appendix F.2.1, CBC-AES128.Encrypt.
  test "SP 800-38A F.2.1: CBC-AES128.Encrypt" {
    cbc_encrypt(aes::key_expansion(example_key_128()), example_iv(), example_plaintext()) == (
      hex"7649abac8119b246cee98e9b12e9197d" ++
      hex"5086cb9b507219ee95db113a917678b2" ++
      hex"73bed6b8e3c1743b7116e69e22229516" ++
      hex"3ff1caa1681fac09120eca307586e1a7"
    )
  }

  // SP 800-38A, Appendix F.2.2, CBC-AES128.Decrypt.
  test "SP 800-38A F.2.2: CBC-AES128.Decrypt" {
    let c: Word[8]^64 =
      hex"7649abac8119b246cee98e9b12e9197d" ++
      hex"5086cb9b507219ee95db113a917678b2" ++
      hex"73bed6b8e3c1743b7116e69e22229516" ++
      hex"3ff1caa1681fac09120eca307586e1a7";
    cbc_decrypt(aes::key_expansion(example_key_128()), example_iv(), c) == example_plaintext()
  }

  // SP 800-38A, Appendix F.3.13, CFB128-AES128.Encrypt.
  test "SP 800-38A F.3.13: CFB128-AES128.Encrypt" {
    cfb128_encrypt(aes::key_expansion(example_key_128()), example_iv(), example_plaintext()) == (
      hex"3b3fd92eb72dad20333449f8e83cfb4a" ++
      hex"c8a64537a0b3a93fcde3cdad9f1ce58b" ++
      hex"26751f67a3cbb140b1808cf187a4f4df" ++
      hex"c04b05357c5d1c0eeac4c66f9ff7f2e6"
    )
  }

  // SP 800-38A, Appendix F.3.14, CFB128-AES128.Decrypt.
  test "SP 800-38A F.3.14: CFB128-AES128.Decrypt" {
    let c: Word[8]^64 =
      hex"3b3fd92eb72dad20333449f8e83cfb4a" ++
      hex"c8a64537a0b3a93fcde3cdad9f1ce58b" ++
      hex"26751f67a3cbb140b1808cf187a4f4df" ++
      hex"c04b05357c5d1c0eeac4c66f9ff7f2e6";
    cfb128_decrypt(aes::key_expansion(example_key_128()), example_iv(), c) == example_plaintext()
  }

  // SP 800-38A, Appendix F.4.1, OFB-AES128.Encrypt.
  test "SP 800-38A F.4.1: OFB-AES128.Encrypt" {
    ofb_encrypt(aes::key_expansion(example_key_128()), example_iv(), example_plaintext()) == (
      hex"3b3fd92eb72dad20333449f8e83cfb4a" ++
      hex"7789508d16918f03f53c52dac54ed825" ++
      hex"9740051e9c5fecf64344f7a82260edcc" ++
      hex"304c6528f659c77866a510d9c1d6ae5e"
    )
  }

  // SP 800-38A, Appendix F.4.2, OFB-AES128.Decrypt.
  test "SP 800-38A F.4.2: OFB-AES128.Decrypt" {
    let c: Word[8]^64 =
      hex"3b3fd92eb72dad20333449f8e83cfb4a" ++
      hex"7789508d16918f03f53c52dac54ed825" ++
      hex"9740051e9c5fecf64344f7a82260edcc" ++
      hex"304c6528f659c77866a510d9c1d6ae5e";
    ofb_decrypt(aes::key_expansion(example_key_128()), example_iv(), c) == example_plaintext()
  }

  // SP 800-38A, Appendix F.5.1, CTR-AES128.Encrypt.
  test "SP 800-38A F.5.1: CTR-AES128.Encrypt" {
    ctr_encrypt(aes::key_expansion(example_key_128()), example_counter(), example_plaintext()) == (
      hex"874d6191b620e3261bef6864990db6ce" ++
      hex"9806f66b7970fdff8617187bb9fffdff" ++
      hex"5ae4df3edbd5d35e5b4f09020db03eab" ++
      hex"1e031dda2fbe03d1792170a0f3009cee"
    )
  }

  // SP 800-38A, Appendix F.5.2, CTR-AES128.Decrypt.
  test "SP 800-38A F.5.2: CTR-AES128.Decrypt" {
    let c: Word[8]^64 =
      hex"874d6191b620e3261bef6864990db6ce" ++
      hex"9806f66b7970fdff8617187bb9fffdff" ++
      hex"5ae4df3edbd5d35e5b4f09020db03eab" ++
      hex"1e031dda2fbe03d1792170a0f3009cee";
    ctr_decrypt(aes::key_expansion(example_key_128()), example_counter(), c) == example_plaintext()
  }

  // SP 800-38A, Appendix F.5.5, CTR-AES256.Encrypt.
  test "SP 800-38A F.5.5: CTR-AES256.Encrypt" {
    ctr_encrypt(aes::key_expansion(example_key_256()), example_counter(), example_plaintext()) == (
      hex"601ec313775789a5b7a7f504bbf3d228" ++
      hex"f443e3ca4d62b59aca84e990cacaf5c5" ++
      hex"2b0930daa23de94ce87017ba2d84988d" ++
      hex"dfc9c58db67aada613c2dd08457941a6"
    )
  }

  // SP 800-38A, Appendix F.5.6, CTR-AES256.Decrypt.
  test "SP 800-38A F.5.6: CTR-AES256.Decrypt" {
    let c: Word[8]^64 =
      hex"601ec313775789a5b7a7f504bbf3d228" ++
      hex"f443e3ca4d62b59aca84e990cacaf5c5" ++
      hex"2b0930daa23de94ce87017ba2d84988d" ++
      hex"dfc9c58db67aada613c2dd08457941a6";
    ctr_decrypt(aes::key_expansion(example_key_256()), example_counter(), c) == example_plaintext()
  }
}
