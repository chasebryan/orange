// HPKE, base mode, with DHKEM(X25519, HKDF-SHA256), HKDF-SHA256 and
// ChaCha20-Poly1305: RFC 9180, "Hybrid Public Key Encryption" (Barnes,
// Bhargavan, Lipp, Wood, February 2022), https://www.rfc-editor.org/rfc/rfc9180.
// The primitives are modules beside this file: SHA-256 (FIPS 180-4) in
// `sha256`, HMAC (RFC 2104) and HKDF (RFC 5869) in `hkdf`, X25519 (RFC 7748)
// in `curve25519` and ChaCha20-Poly1305 (RFC 8439) in `chacha20poly1305`.
// This file follows the RFC's order: the labeled KDF and DHKEM (section 4),
// the key schedule (5.1), the context's Seal (5.2) and Export (5.3), and the
// suite of section 7 (7.1 to 7.3).
//
// The tests reproduce every value Appendix A.2 (DHKEM(X25519, HKDF-SHA256),
// HKDF-SHA256, ChaCha20Poly1305, base mode) prints for this mode: skRm and
// skEm from ikmR and ikmE by DeriveKeyPair (7.1.3), pkEm from skEm, the KEM
// shared secret of Encap from skEm, pkEm and pkRm, the key schedule's key,
// base_nonce and exporter_secret from that shared secret, the encryptions at
// sequence numbers 0, 1, 2, 4, 255 and 256, and the three exported values.
edition 2026;
module hpke {
  use hkdf;
  use curve25519;
  use chacha20poly1305;

  // Section 5.2: the encryption context, Context(key, base_nonce, seq,
  // exporter_secret). The RFC's context is an object whose seq each Seal
  // advances; here it is a value, and IncrementSeq returns the next one.
  type Context = (Word[8]^32, Word[8]^12, Int, Word[8]^32);

  // Section 7: the identifiers of the suite. DHKEM(X25519, HKDF-SHA256) is
  // kem_id 0x0020 (7.1), HKDF-SHA256 is kdf_id 0x0001 (7.2) and
  // ChaCha20Poly1305 is aead_id 0x0003 (7.3).
  spec kem_id() -> Word[16] { 0x0020 }
  spec kdf_id() -> Word[16] { 0x0001 }
  spec aead_id() -> Word[16] { 0x0003 }

  // Section 7.1: for DHKEM(X25519, HKDF-SHA256), Nsecret = Nsk = 32.
  // Section 7.2: for HKDF-SHA256, Nh = 32. Section 7.3: for
  // ChaCha20Poly1305, Nk = 32 and Nn = 12. They are the L of LabeledExpand,
  // two bytes wide in I2OSP(L, 2).
  spec n_secret() -> Word[16] { 32 }
  spec n_sk() -> Word[16] { 32 }
  spec n_h() -> Word[16] { 32 }
  spec n_k() -> Word[16] { 32 }
  spec n_n() -> Word[16] { 12 }

  // Section 4.1: inside DHKEM, suite_id = concat("KEM", I2OSP(kem_id, 2)).
  spec kem_suite_id() -> Word[8]^5 { "KEM" ++ (kem_id() as big Word[8]^2) }

  // Section 5.1: in the rest of HPKE, suite_id = concat("HPKE",
  // I2OSP(kem_id, 2), I2OSP(kdf_id, 2), I2OSP(aead_id, 2)).
  spec hpke_suite_id() -> Word[8]^10 {
    "HPKE" ++ (kem_id() as big Word[8]^2) ++ (kdf_id() as big Word[8]^2) ++
      (aead_id() as big Word[8]^2)
  }

  // Section 4: LabeledExtract(salt, label, ikm) is
  // Extract(salt, concat("HPKE-v1", suite_id, label, ikm)). The suite_id is
  // the KEM's or HPKE's, so the spec takes it as an argument of either
  // length. The label and ikm are adjacent in the concatenation and the RFC
  // passes an empty ikm (psk_id and psk are "" in mode_base); an array has
  // at least one element, so the spec takes label || ikm as one string, of
  // at most 128 bytes, and a call with an empty ikm passes the label alone.
  spec labeled_extract[S in {Word[8]^5, Word[8]^10}, n in 1..129](
    suite_id: S,
    salt: Word[8]^32,
    label_ikm: Word[8]^n,
  ) -> Word[8]^32 {
    hkdf::extract(salt, "HPKE-v1" ++ suite_id ++ label_ikm)
  }

  // Section 4: LabeledExpand(prk, label, info, L) is
  // Expand(prk, concat(I2OSP(L, 2), "HPKE-v1", suite_id, label, info), L),
  // with label || info one string as above (info is "" in DeriveKeyPair and
  // may be "" in Export). Every L here is at most Nh, so Expand's output is
  // the 32 bytes of T(1) (see `hkdf::expand`), whose first L bytes are the
  // result; a call with L = Nn keeps the first twelve.
  spec labeled_expand[S in {Word[8]^5, Word[8]^10}, n in 1..129](
    suite_id: S,
    prk: Word[8]^32,
    label_info: Word[8]^n,
    l: Word[16],
  ) -> Word[8]^32 {
    hkdf::expand(prk, (l as big Word[8]^2) ++ "HPKE-v1" ++ suite_id ++ label_info)
  }

  // Section 4.1, DHKEM(X25519, HKDF-SHA256). SerializePublicKey and
  // DeserializePublicKey are the identity for X25519 (7.1.1), so a public
  // key is its 32 bytes throughout.

  // Section 4.1: DH(skX, pkY) is X25519(skX, pkY) (7.1); its output is
  // Ndh = 32 bytes. Section 7.1.4 requires the recipient to reject an
  // all-zero output; this entry computes the sender's side and does not
  // write that check.
  spec dh(sk: Word[8]^32, pk: Word[8]^32) -> Word[8]^32 { curve25519::x25519(sk, pk) }

  // Section 3, pk(skX): the public key of a private key, X25519(sk, 9),
  // with the base point u = 9 of RFC 7748 section 6.1.
  spec pk(sk: Word[8]^32) -> Word[8]^32 { curve25519::x25519(sk, curve25519::base_point()) }

  // Section 4.1, ExtractAndExpand(dh, kem_context).
  spec extract_and_expand(dh: Word[8]^32, kem_context: Word[8]^64) -> Word[8]^32 {
    let eae_prk: Word[8]^32 = labeled_extract(kem_suite_id(), hkdf::empty_salt(), "eae_prk" ++ dh);
    labeled_expand(kem_suite_id(), eae_prk, "shared_secret" ++ kem_context, n_secret())
  }

  // Section 4.1, Encap(pkR), returning (shared_secret, enc). The RFC's
  // Encap draws the ephemeral pair (skE, pkE) from GenerateKeyPair; a
  // specification takes its randomness as an argument, so the pair is
  // given, as Appendix A.2 prints it.
  spec encap(skE: Word[8]^32, pkE: Word[8]^32, pkR: Word[8]^32) -> (Word[8]^32, Word[8]^32) {
    let dh_value: Word[8]^32 = dh(skE, pkR);
    let enc: Word[8]^32 = pkE;
    let pkRm: Word[8]^32 = pkR;
    let kem_context: Word[8]^64 = enc ++ pkRm;
    (extract_and_expand(dh_value, kem_context), enc)
  }

  // Section 7.1.3, DeriveKeyPair(ikm) for X25519, returning (sk, pk(sk)),
  // for an ikm of 32 bytes (the RFC asks for at least Nsk bytes; those of
  // Appendix A.2 are 32): dkp_prk = LabeledExtract("", "dkp_prk", ikm) and
  // sk = LabeledExpand(dkp_prk, "sk", "", Nsk).
  spec derive_key_pair(ikm: Word[8]^32) -> (Word[8]^32, Word[8]^32) {
    let dkp_prk: Word[8]^32 = labeled_extract(kem_suite_id(), hkdf::empty_salt(), "dkp_prk" ++ ikm);
    let sk: Word[8]^32 = labeled_expand(kem_suite_id(), dkp_prk, "sk", n_sk());
    (sk, pk(sk))
  }

  // Section 5: mode_base, 0x00.
  spec mode_base() -> Word[8] { 0x00 }

  // Section 5.1, KeySchedule for mode_base, for an info of 1 through 64
  // bytes. In mode_base psk and psk_id are the defaults "", for which
  // VerifyPSKInputs passes, so psk_id_hash is LabeledExtract("",
  // "psk_id_hash", "") and secret is LabeledExtract(shared_secret, "secret",
  // ""): the labels alone. The context starts at seq = 0.
  spec key_schedule[n in 1..65](shared_secret: Word[8]^32, info: Word[8]^n) -> Context {
    let suite_id: Word[8]^10 = hpke_suite_id();
    let empty: Word[8]^32 = hkdf::empty_salt();
    let psk_id_hash: Word[8]^32 = labeled_extract(suite_id, empty, "psk_id_hash");
    let info_hash: Word[8]^32 = labeled_extract(suite_id, empty, "info_hash" ++ info);
    let key_schedule_context: Word[8]^65 = [mode_base()] ++ psk_id_hash ++ info_hash;
    let secret: Word[8]^32 = labeled_extract(suite_id, shared_secret, "secret");
    let key: Word[8]^32 = labeled_expand(suite_id, secret, "key" ++ key_schedule_context, n_k());
    let base_nonce: Word[8]^12 =
      labeled_expand(suite_id, secret, "base_nonce" ++ key_schedule_context, n_n())[..12];
    let exporter_secret: Word[8]^32 =
      labeled_expand(suite_id, secret, "exp" ++ key_schedule_context, n_h());
    (key, base_nonce, 0, exporter_secret)
  }

  // Section 5.2, ComputeNonce(seq): xor(base_nonce, I2OSP(seq, Nn)), the
  // sequence number big-endian in Nn = 12 bytes.
  spec compute_nonce(base_nonce: Word[8]^12, seq: Int) -> Word[8]^12 {
    let seq_bytes: Word[8]^12 = seq as big Word[8]^12;
    for i in 0..12 with nonce: Word[8]^12 = base_nonce {
      nonce with [i] = base_nonce[i] ^ seq_bytes[i]
    }
  }

  // Section 5.2, IncrementSeq: seq + 1. The RFC first raises
  // MessageLimitReachedError when seq >= (1 << (8 * Nn)) - 1, so that no
  // nonce repeats; a spec has no errors to raise, and the check is not
  // written.
  spec increment_seq(context: Context) -> Context {
    (context.0, context.1, context.2 + 1, context.3)
  }

  // Section 5.2, ContextS.Seal(aad, pt): ct = Seal(key, ComputeNonce(seq),
  // aad, pt), RFC 8439's AEAD with the tag after the ciphertext, for the
  // lengths `chacha20poly1305::seal` is written for. The RFC's Seal then
  // calls IncrementSeq on its context; a tuple holds no tuple, so the spec
  // returns ct alone and the context of the next Seal is
  // increment_seq(context).
  spec seal[a in 7..10, n in 1..65](context: Context, aad: Word[8]^a, pt: Word[8]^n)
    -> Word[8]^(n + 16) {
    chacha20poly1305::seal(context.0, compute_nonce(context.1, context.2), aad, pt)
  }

  // Section 5.3, Context.Export(exporter_context, L) =
  // LabeledExpand(exporter_secret, "sec", exporter_context, L), for an
  // exporter_context of 1 through 64 bytes and L at most Nh = 32, whose
  // first L bytes are the exported value.
  spec export[n in 1..65](context: Context, exporter_context: Word[8]^n, l: Word[16])
    -> Word[8]^32 {
    labeled_expand(hpke_suite_id(), context.3, "sec" ++ exporter_context, l)
  }

  // Section 5.3, Export with the empty exporter_context "", which is no
  // array: the label alone.
  spec export_empty(context: Context, l: Word[16]) -> Word[8]^32 {
    labeled_expand(hpke_suite_id(), context.3, "sec", l)
  }

  // The vectors: RFC 9180 Appendix A.2, "DHKEM(X25519, HKDF-SHA256),
  // HKDF-SHA256, ChaCha20Poly1305", Base Setup Information (mode 0, kem_id
  // 32, kdf_id 1, aead_id 3). Every input is printed there: info "Ode on a
  // Grecian Urn", the plaintext "Beauty is truth, truth beauty", and the aad
  // "Count-n" of the encryption at sequence number n.

  // Appendix A.2's context, key, base_nonce and exporter_secret as printed,
  // at sequence number seq.
  spec a2_context(seq: Int) -> Context {
    (
      hex"ad2744de8e17f4ebba575b3f5f5a8fa1f69c2a07f6e7500bc60ca6e3e3ec1c91",
      hex"5c4d98150661b848853b547f",
      seq,
      hex"a3b010d4994890e2c6968a36f64470d3c824c8f5029942feb11e7a74b2921922",
    )
  }

  // Base Setup Information: ikmR 1ac01f18..., skRm (section 7.1.3).
  test "RFC 9180 A.2: DeriveKeyPair(ikmR) gives skRm" {
    let ikm_r: Word[8]^32 = hex"1ac01f181fdf9f352797655161c58b75c656a6cc2716dcb66372da835542e1df";
    derive_key_pair(ikm_r).0 ==
      hex"8057991eef8f1f1af18f4a9491d16a1ce333f695d4db8e38da75975c4478e0fb"
  }

  // Base Setup Information: ikmE 909a9b35..., skEm (section 7.1.3).
  test "RFC 9180 A.2: DeriveKeyPair(ikmE) gives skEm" {
    let ikm_e: Word[8]^32 = hex"909a9b35d3dc4713a5e72a4da274b55d3d3821a37e5d099e74a647db583a904b";
    derive_key_pair(ikm_e).0 ==
      hex"f4ec9b33b792c372c1d2c2063507b684ef925b8c75a42dbcbf57d63ccd381600"
  }

  // Base Setup Information: pkEm = pk(skEm) = X25519(skEm, 9), which is the
  // encapsulated key enc.
  test "RFC 9180 A.2: DeriveKeyPair(ikmE) gives pkEm, the enc" {
    let ikm_e: Word[8]^32 = hex"909a9b35d3dc4713a5e72a4da274b55d3d3821a37e5d099e74a647db583a904b";
    derive_key_pair(ikm_e).1 ==
      hex"1afa08d3dec047a643885163f1180476fa7ddb54c6a8029ea33f95796bf2ac4a"
  }

  // Base Setup Information: shared_secret = Encap(pkRm) with the ephemeral
  // pair (skEm, pkEm) (section 4.1).
  test "RFC 9180 A.2: Encap gives shared_secret" {
    let sk_em: Word[8]^32 = hex"f4ec9b33b792c372c1d2c2063507b684ef925b8c75a42dbcbf57d63ccd381600";
    let pk_em: Word[8]^32 = hex"1afa08d3dec047a643885163f1180476fa7ddb54c6a8029ea33f95796bf2ac4a";
    let pk_rm: Word[8]^32 = hex"4310ee97d88cc1f088a5576c77ab0cf5c3ac797f3d95139c6c84b5429c59662a";
    encap(sk_em, pk_em, pk_rm).0 ==
      hex"0bbe78490412b4bbea4812666f7916932b828bba79942424abb65244930d69a7"
  }

  // Base Setup Information: key, from shared_secret 0bbe7849... and the info
  // (section 5.1).
  test "RFC 9180 A.2: KeySchedule gives key" {
    let shared_secret: Word[8]^32 =
      hex"0bbe78490412b4bbea4812666f7916932b828bba79942424abb65244930d69a7";
    key_schedule(shared_secret, "Ode on a Grecian Urn").0 ==
      hex"ad2744de8e17f4ebba575b3f5f5a8fa1f69c2a07f6e7500bc60ca6e3e3ec1c91"
  }

  // Base Setup Information: base_nonce (section 5.1).
  test "RFC 9180 A.2: KeySchedule gives base_nonce" {
    let shared_secret: Word[8]^32 =
      hex"0bbe78490412b4bbea4812666f7916932b828bba79942424abb65244930d69a7";
    key_schedule(shared_secret, "Ode on a Grecian Urn").1 == hex"5c4d98150661b848853b547f"
  }

  // Base Setup Information: exporter_secret (section 5.1).
  test "RFC 9180 A.2: KeySchedule gives exporter_secret" {
    let shared_secret: Word[8]^32 =
      hex"0bbe78490412b4bbea4812666f7916932b828bba79942424abb65244930d69a7";
    key_schedule(shared_secret, "Ode on a Grecian Urn").3 ==
      hex"a3b010d4994890e2c6968a36f64470d3c824c8f5029942feb11e7a74b2921922"
  }

  // Encryptions, sequence number 0, through KeySchedule from shared_secret
  // (sections 5.1 and 5.2).
  test "RFC 9180 A.2: Seal at sequence number 0 from KeySchedule" {
    let shared_secret: Word[8]^32 =
      hex"0bbe78490412b4bbea4812666f7916932b828bba79942424abb65244930d69a7";
    let context: Context = key_schedule(shared_secret, "Ode on a Grecian Urn");
    seal(context, "Count-0", "Beauty is truth, truth beauty") == (
      hex"1c5250d8034ec2b784ba2cfd69dbdb8af406cfe3ff938e131f0def8c8b60b4db" ++
      hex"21993c62ce81883d2dd1b51a28"
    )
  }

  // Encryptions, sequence number 0, from the printed context: nonce
  // 5c4d98150661b848853b547f.
  test "RFC 9180 A.2: Seal at sequence number 0" {
    seal(a2_context(0), "Count-0", "Beauty is truth, truth beauty") == (
      hex"1c5250d8034ec2b784ba2cfd69dbdb8af406cfe3ff938e131f0def8c8b60b4db" ++
      hex"21993c62ce81883d2dd1b51a28"
    )
  }

  // Encryptions, sequence number 1: the second Seal of the context, whose
  // seq the first Seal advanced (IncrementSeq); nonce ...547e.
  test "RFC 9180 A.2: Seal at sequence number 1, after IncrementSeq" {
    seal(increment_seq(a2_context(0)), "Count-1", "Beauty is truth, truth beauty") == (
      hex"6b53c051e4199c518de79594e1c4ab18b96f081549d45ce015be002090bb119e" ++
      hex"85285337cc95ba5f59992dc98c"
    )
  }

  // Encryptions, sequence number 2: nonce ...547d.
  test "RFC 9180 A.2: Seal at sequence number 2" {
    seal(a2_context(2), "Count-2", "Beauty is truth, truth beauty") == (
      hex"71146bd6795ccc9c49ce25dda112a48f202ad220559502cef1f34271e0cb4b02" ++
      hex"b4f10ecac6f48c32f878fae86b"
    )
  }

  // Encryptions, sequence number 4: nonce ...547b.
  test "RFC 9180 A.2: Seal at sequence number 4" {
    seal(a2_context(4), "Count-4", "Beauty is truth, truth beauty") == (
      hex"63357a2aa291f5a4e5f27db6baa2af8cf77427c7c1a909e0b37214dd47db122b" ++
      hex"b153495ff0b02e9e54a50dbe16"
    )
  }

  // Encryptions, sequence number 255: nonce ...5480.
  test "RFC 9180 A.2: Seal at sequence number 255" {
    seal(a2_context(255), "Count-255", "Beauty is truth, truth beauty") == (
      hex"18ab939d63ddec9f6ac2b60d61d36a7375d2070c9b683861110757062c52b888" ++
      hex"0a5f6b3936da9cd6c23ef2a95c"
    )
  }

  // Encryptions, sequence number 256: nonce ...557f.
  test "RFC 9180 A.2: Seal at sequence number 256" {
    seal(a2_context(256), "Count-256", "Beauty is truth, truth beauty") == (
      hex"7a4a13e9ef23978e2c520fd4d2e757514ae160cd0cd05e556ef692370ca53076" ++
      hex"214c0c40d4c728d6ed9e727a5b"
    )
  }

  // Exported Values, first: exporter_context "", L = 32 (section 5.3).
  test "RFC 9180 A.2: Export with the empty exporter_context" {
    export_empty(a2_context(0), 32) ==
      hex"4bbd6243b8bb54cec311fac9df81841b6fd61f56538a775e7c80a9f40160606e"
  }

  // Exported Values, second: exporter_context 0x00, L = 32.
  test "RFC 9180 A.2: Export with exporter_context 00" {
    export(a2_context(0), hex"00", 32) ==
      hex"8c1df14732580e5501b00f82b10a1647b40713191b7c1240ac80e2b68808ba69"
  }

  // Exported Values, third: exporter_context "TestContext", L = 32.
  test "RFC 9180 A.2: Export with exporter_context TestContext" {
    export(a2_context(0), "TestContext", 32) ==
      hex"5acb09211139c43b3090489a9da433e8a30ee7188ba8b0a9a1ccf0c229283e53"
  }
}
