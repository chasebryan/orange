// SM4, the 128-bit block cipher of GB/T 32907-2016, "Information security
// technology: SM4 block cipher algorithm" (Chinese national standard, 2016;
// published as SMS4 in 2006), described in English in the IETF draft
// draft-ribose-cfrg-sm4, https://datatracker.ietf.org/doc/html/draft-ribose-cfrg-sm4,
// and used by the TLS 1.3 cipher suites of RFC 8998,
// https://www.rfc-editor.org/rfc/rfc8998. Written as the standard writes it:
// the round function F of clause 6 with the composite permutation T (the
// S-box tau, then the linear map L), the encryption and decryption of
// clause 7.1 and 7.2 as 32 rounds followed by the reverse transformation R,
// and the key expansion of clause 7.3 with the system parameter FK, the
// fixed parameters CK and the linear map L'. The S-box is the standard's
// table of 256 bytes, indexed by the byte it substitutes. The file
// reproduces example 1 of Appendix A in both directions and three cases of
// Botan's sm4.vec, one of them in both directions.
edition 2026;
module sm4 {
  // Clause 6.2, the S-box (Sbox) of the nonlinear transformation tau. The
  // standard gives it as a table; its structure (Liu, Ji, Hu, Ding and Lv,
  // 2007) is Sbox(x) = A(I(A(x) + c)) + c over GF(2): the affine map
  // A(x) + c with A the circulant matrix whose first row is 11010011 (so
  // A(x) = x + (x <<< 1) + (x <<< 3) + (x <<< 6) + (x <<< 7) on the byte)
  // and c = 0xd3, then inversion I in GF(2^8) modulo x^8 + x^7 + x^6 +
  // x^5 + x^4 + x^2 + 1 with I(0) = 0, then the same affine map again.
  // Each line below is one row of the table, read left to right: row i,
  // column j holds Sbox(16 i + j), so Sbox(0x00) = 0xd6 and
  // Sbox(0xff) = 0x48.
  spec sbox() -> Word[8]^256 {
    hex"d6 90 e9 fe cc e1 3d b7 16 b6 14 c2 28 fb 2c 05" ++
    hex"2b 67 9a 76 2a be 04 c3 aa 44 13 26 49 86 06 99" ++
    hex"9c 42 50 f4 91 ef 98 7a 33 54 0b 43 ed cf ac 62" ++
    hex"e4 b3 1c a9 c9 08 e8 95 80 df 94 fa 75 8f 3f a6" ++
    hex"47 07 a7 fc f3 73 17 ba 83 59 3c 19 e6 85 4f a8" ++
    hex"68 6b 81 b2 71 64 da 8b f8 eb 0f 4b 70 56 9d 35" ++
    hex"1e 24 0e 5e 63 58 d1 a2 25 22 7c 3b 01 21 78 87" ++
    hex"d4 00 46 57 9f d3 27 52 4c 36 02 e7 a0 c4 c8 9e" ++
    hex"ea bf 8a d2 40 c7 38 b5 a3 f7 f2 ce f9 61 15 a1" ++
    hex"e0 ae 5d a4 9b 34 1a 55 ad 93 32 30 f5 8c b1 e3" ++
    hex"1d f6 e2 2e 82 66 ca 60 c0 29 23 ab 0d 53 4e 6f" ++
    hex"d5 db 37 45 de fd 8e 2f 03 ff 6a 72 6d 6c 5b 51" ++
    hex"8d 1b af 92 bb dd bc 7f 11 d9 5c 41 1f 10 5a d8" ++
    hex"0a c1 31 88 a5 cd 7b bd 2d 74 d0 12 b8 e5 b4 b0" ++
    hex"89 69 97 4a 0c 96 77 7e 65 b9 f1 09 c5 6e c6 84" ++
    hex"18 f0 7d ec 3a dc 4d 20 79 ee 5f 3e d7 cb 39 48"
  }

  // Clause 6.2: the nonlinear transformation tau applies Sbox to each of
  // the four bytes of A = (a0, a1, a2, a3): B = (Sbox(a0), Sbox(a1),
  // Sbox(a2), Sbox(a3)). A 32-bit word is its four bytes with a0 the most
  // significant, as the examples of Appendix A show, hence `as big`.
  spec tau(a: Word[32]) -> Word[32] {
    let s: Word[8]^256 = sbox();
    let bytes: Word[8]^4 = a as big Word[8]^4;
    let b: Word[8]^4 = [s[bytes[0]], s[bytes[1]], s[bytes[2]], s[bytes[3]]];
    b as big Word[32]
  }

  // Clause 6.2: the linear transformation L of the round function,
  // C = L(B) = B + (B <<< 2) + (B <<< 10) + (B <<< 18) + (B <<< 24).
  spec linear_l(b: Word[32]) -> Word[32] { b ^ (b <<< 2) ^ (b <<< 10) ^ (b <<< 18) ^ (b <<< 24) }

  // Clause 7.3: the linear transformation L' of the key expansion,
  // L'(B) = B + (B <<< 13) + (B <<< 23).
  spec linear_l_prime(b: Word[32]) -> Word[32] { b ^ (b <<< 13) ^ (b <<< 23) }

  // Clause 6.2: the composite permutation T = L o tau, and clause 7.3: T',
  // which is T with L replaced by L'.
  spec composite_t(a: Word[32]) -> Word[32] { linear_l(tau(a)) }

  spec composite_t_prime(a: Word[32]) -> Word[32] { linear_l_prime(tau(a)) }

  // Clause 6.1: the round function
  // F(X0, X1, X2, X3, rk) = X0 + T(X1 + X2 + X3 + rk).
  spec round_f(x0: Word[32], x1: Word[32], x2: Word[32], x3: Word[32], rk: Word[32]) -> Word[32] {
    x0 ^ composite_t(x1 ^ x2 ^ x3 ^ rk)
  }

  // Clause 7.3: the system parameter FK = (FK0, FK1, FK2, FK3), in hex as
  // the standard prints it.
  spec system_parameter_fk() -> Word[32]^4 {
    hex"a3b1bac6 56aa3350 677d9197 b27022dc" as big Word[32]^4
  }

  // Clause 7.3: the fixed parameters CK0 through CK31, eight to a line.
  // Byte j of CK_i is ck_{i,j} = (4i + j) * 7 mod 256 (i from 0 through 31,
  // j from 0 through 3): CK0 = (0, 7, 14, 21) = 00070e15, CK1 =
  // (28, 35, 42, 49) = 1c232a31, and so on, wrapping modulo 256 at
  // CK9 = fc030a11.
  spec fixed_parameters_ck() -> Word[32]^32 {
    (
      hex"00070e15 1c232a31 383f464d 545b6269 70777e85 8c939aa1 a8afb6bd c4cbd2d9" ++
      hex"e0e7eef5 fc030a11 181f262d 343b4249 50575e65 6c737a81 888f969d a4abb2b9" ++
      hex"c0c7ced5 dce3eaf1 f8ff060d 141b2229 30373e45 4c535a61 686f767d 848b9299" ++
      hex"a0a7aeb5 bcc3cad1 d8dfe6ed f4fb0209 10171e25 2c333a41 484f565d 646b7279"
    ) as big Word[32]^32
  }

  // Clause 7.3: the key expansion. The encryption key MK = (MK0, MK1, MK2,
  // MK3) is four big-endian words; (K0, K1, K2, K3) = (MK0 + FK0,
  // MK1 + FK1, MK2 + FK2, MK3 + FK3) and, for i = 0 through 31,
  // rk_i = K_{i+4} = K_i + T'(K_{i+1} + K_{i+2} + K_{i+3} + CK_i). The 36
  // words K0 through K35 are one array, whose zeros after K3 are
  // placeholders that the recurrence replaces in order, and the round keys
  // are its last 32.
  spec key_expansion(mk: Word[8]^16) -> Word[32]^32 {
    let fk: Word[32]^4 = system_parameter_fk();
    let ck: Word[32]^32 = fixed_parameters_ck();
    let m: Word[32]^4 = mk as big Word[32]^4;
    let k0: Word[32]^4 = for i in 0..4 with k: Word[32]^4 = m { k with [i] = m[i] ^ fk[i] };
    let k: Word[32]^36 = for i in 0..32 with k: Word[32]^36 = k0 ++ [0; 32] {
      k with [i + 4] = k[i] ^ composite_t_prime(k[i + 1] ^ k[i + 2] ^ k[i + 3] ^ ck[i])
    };
    k[4..36]
  }

  // Clause 7.1: 32 rounds, X_{i+4} = F(X_i, X_{i+1}, X_{i+2}, X_{i+3}, rk_i),
  // then the reverse transformation R(A0, A1, A2, A3) = (A3, A2, A1, A0)
  // gives (Y0, Y1, Y2, Y3) = R(X32, X33, X34, X35). The loop carries the
  // four latest X as x. Clause 7.2: decryption is the same procedure with
  // the round keys in the reverse order, rk31 first, so both directions
  // call this spec.
  spec rounds(rk: Word[32]^32, input: Word[32]^4) -> Word[32]^4 {
    let x: Word[32]^4 = for i in 0..32 with x: Word[32]^4 = input {
      [x[1], x[2], x[3], round_f(x[0], x[1], x[2], x[3], rk[i])]
    };
    [x[3], x[2], x[1], x[0]]
  }

  // Clause 7.1: encryption of one block under the key MK. The plaintext
  // (X0, X1, X2, X3) and the ciphertext (Y0, Y1, Y2, Y3) are four
  // big-endian words each.
  spec encrypt(mk: Word[8]^16, plaintext: Word[8]^16) -> Word[8]^16 {
    rounds(key_expansion(mk), plaintext as big Word[32]^4) as big Word[8]^16
  }

  // Clause 7.2: decryption uses (rk31, rk30, ..., rk0).
  spec decrypt(mk: Word[8]^16, ciphertext: Word[8]^16) -> Word[8]^16 {
    let rk: Word[32]^32 = key_expansion(mk);
    let reversed: Word[32]^32 = for i in 0..32 with r: Word[32]^32 = rk {
      r with [i] = rk[31 - i]
    };
    rounds(reversed, ciphertext as big Word[32]^4) as big Word[8]^16
  }

  // GB/T 32907-2016 Appendix A, example 1: key and plaintext
  // 0123456789abcdeffedcba9876543210, ciphertext
  // 681edf34d206965e86b3e94f536e4246. The same case opens Botan's sm4.vec and
  // OpenSSL's evpciph_sm4.txt (SM4-ECB). Example 2 of the appendix encrypts
  // the same block 1,000,000 times under the same key: one key expansion
  // and 32,000,000 rounds, about 3.6 x 10^9 steps here, more than three
  // times the largest step budget the evaluator accepts (2^30), so it is not
  // reproduced.
  test "GB/T 32907-2016 Appendix A, example 1: encrypts" {
    encrypt(hex"01234567 89abcdef fedcba98 76543210", hex"01234567 89abcdef fedcba98 76543210")
      == hex"681edf34 d206965e 86b3e94f 536e4246"
  }

  // Appendix A, example 1, decrypted: the ciphertext under the same key
  // gives the plaintext back.
  test "GB/T 32907-2016 Appendix A, example 1: decrypts" {
    decrypt(hex"01234567 89abcdef fedcba98 76543210", hex"681edf34 d206965e 86b3e94f 536e4246")
      == hex"01234567 89abcdef fedcba98 76543210"
  }

  // Botan src/tests/data/block/sm4.vec, section [SM4], second case (the
  // first of the "Random tests generated by GmSSL"): key
  // 681edf34d206965e86b3e94f536e4246 and the first of its four blocks
  // (In = f42131b0..., Out = ec4b7b17...).
  test "Botan sm4.vec case 2, block 1: encrypts" {
    encrypt(hex"681edf34 d206965e 86b3e94f 536e4246", hex"f42131b0 02425b6f 5cf52a81 0682a09d")
      == hex"ec4b7b17 57fee9ce 455197e5 bf9c3a90"
  }

  // Botan sm4.vec, section [SM4], fourth case (the first of the "Random
  // tests generated by Botan"): key fd0c5fbdb30201222daea461486b2853, one
  // block 000102...0f.
  test "Botan sm4.vec case 4: encrypts" {
    encrypt(hex"fd0c5fbd b3020122 2daea461 486b2853", hex"00010203 04050607 08090a0b 0c0d0e0f")
      == hex"73f10297 7f15599c 61b15d13 d3da6064"
  }

  // The fourth case decrypted: its ciphertext under its key gives the block
  // 000102...0f back.
  test "Botan sm4.vec case 4: decrypts" {
    decrypt(hex"fd0c5fbd b3020122 2daea461 486b2853", hex"73f10297 7f15599c 61b15d13 d3da6064")
      == hex"00010203 04050607 08090a0b 0c0d0e0f"
  }

  // Botan sm4.vec, section [SM4], fifth case: key
  // e5ab67c47b9be83f1f37627532d91ab7 and the first of its two blocks
  // (000102...0f, Out = 03a595d9...).
  test "Botan sm4.vec case 5, block 1: encrypts" {
    encrypt(hex"e5ab67c4 7b9be83f 1f376275 32d91ab7", hex"00010203 04050607 08090a0b 0c0d0e0f")
      == hex"03a595d9 af32aa81 0aa0beb7 58462f2c"
  }
}
