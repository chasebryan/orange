// ML-KEM-512 of FIPS 203, "Module-Lattice-Based Key-Encapsulation Mechanism
// Standard", NIST, August 2024, https://doi.org/10.6028/NIST.FIPS.203.
// The file transcribes the hash functions of section 4.1 over the module
// `keccak` (FIPS 202), the encodings, compression and sampling of section
// 4.2 (Algorithms 3 to 8), the number-theoretic transform of section 4.3
// (Algorithms 9 to 12), K-PKE of section 5 (Algorithms 13 to 15) and the
// internal ML-KEM algorithms of section 6 (Algorithms 16 to 18), with the
// parameter set ML-KEM-512 of section 8: n = 256, q = 3329, k = 2,
// eta_1 = 3, eta_2 = 2, d_u = 10, d_v = 4. A polynomial is 256 residues
// modulo q, a vector k polynomials, and the matrix A-hat a k x k array of
// polynomials A[i][j], as the standard indexes them.
//
// It reproduces NIST's ACVP vectors for ML-KEM-512 (keyGen and
// encapDecap, internalProjection.json, vsId 42): key generation from
// (d, z), encapsulation from (ek, m), and decapsulation of a valid and of a
// modified ciphertext, and Wycheproof's mlkem_512_test.json tcId 1, a key
// pair from its 64-byte seed that rejects a ciphertext implicitly.
edition 2026;
module ml_kem {
  use keccak;

  type Zq = Mod[3329];
  type Poly = Zq^256;
  type Vector = Poly^2;
  type Matrix = Vector^2;

  // ---- Section 4.1: the hash functions, over FIPS 202 ----

  // PRF_eta(s, b) = SHAKE256(s || b, 8 * 64 * eta): the first 64 eta bytes
  // of as many 136-byte SHAKE256 blocks as they need.
  spec prf[eta in 2..4](s: Word[8]^32, b: Word[8]) -> Word[8]^(64 * eta) {
    keccak::squeeze[17, (64 * eta + 135) / 136](keccak::shake256(s ++ [b]))[..(64 * eta)]
  }

  // H(s) = SHA3-256(s), here of an encapsulation key.
  spec hash_h(s: Word[8]^800) -> Word[8]^32 { keccak::sha3_256(s) }

  // J(s) = SHAKE256(s, 8 * 32), here of z || c.
  spec hash_j(s: Word[8]^800) -> Word[8]^32 { keccak::squeeze[17, 1](keccak::shake256(s))[..32] }

  // G(c) = SHA3-512(c), split into its first and last 32 bytes; c is d || k
  // in K-PKE.KeyGen and m || h in encapsulation and decapsulation.
  spec hash_g[M in {Word[8]^33, Word[8]^64}](c: M) -> (Word[8]^32, Word[8]^32) {
    let out: Word[8]^64 = keccak::sha3_512(c);
    (out[..32], out[32..])
  }

  // ---- Section 4.2.1: conversion and compression ----

  // Algorithms 3 and 5: ByteEncode_d(F) writes the d bits of each F[i]
  // least significant first (bit i d + j is bit j of F[i]) and packs the
  // bits into bytes least significant first, so eight integers of d bits
  // fill d bytes, the little-endian form of F[8g] + F[8g + 1] 2^d + ... +
  // F[8g + 7] 2^(7d). The integers are elements of Z_m with m = 2^d for
  // d < 12, and of Z_q for d = 12 (`byte_encode_12`).
  spec byte_encode[d in 1..12](f: Mod[(1 << d)]^256) -> Word[8]^(32 * d) {
    let one: Word[16] = 1;
    let m: Int = (one << d) as Int;
    for g in 0..32 with b: Word[8]^(32 * d) = [0; (32 * d)] {
      let v: Int = for i in 0..8 with v: Int = 0 { v * m + (f[8 * g + 7 - i] as Int) };
      b with [d * g..d * g + d] = v as little Word[8]^d
    }
  }

  spec byte_encode_12(f: Poly) -> Word[8]^384 {
    for g in 0..32 with b: Word[8]^384 = [0; 384] {
      let v: Int = for i in 0..8 with v: Int = 0 { v * 4096 + (f[8 * g + 7 - i] as Int) };
      b with [12 * g..12 * g + 12] = v as little Word[8]^12
    }
  }

  // Algorithm 6: ByteDecode_d(B) reads the same groups back, F[8g + i] =
  // (the group's integer div 2^(d i)) mod 2^d, and reduces modulo m: for
  // d = 12 (`byte_decode_12`) a 12-bit value of q or more becomes its residue.
  spec byte_decode[d in 1..12](b: Word[8]^(32 * d)) -> Mod[(1 << d)]^256 {
    let one: Word[16] = 1;
    let m: Int = (one << d) as Int;
    for g in 0..32 with f: Mod[(1 << d)]^256 = [0; 256] {
      let v: Int = b[d * g..d * g + d] as little Int;
      let r: (Mod[(1 << d)]^256, Int) =
        for i in 0..8 with (h: Mod[(1 << d)]^256, rest: Int) = (f, v) {
          let bits: Int = rest % m;
          (h with [8 * g + i] = bits as Mod[(1 << d)], rest / m)
        };
      r.0
    }
  }

  spec byte_decode_12(b: Word[8]^384) -> Poly {
    for g in 0..32 with f: Poly = [0; 256] {
      let v: Int = b[12 * g..12 * g + 12] as little Int;
      let r: (Poly, Int) = for i in 0..8 with (h: Poly, rest: Int) = (f, v) {
        let bits: Int = rest % 4096;
        (h with [8 * g + i] = bits as Zq, rest / 4096)
      };
      r.0
    }
  }

  // Equation 4.7: Compress_d(x) = round((2^d / q) x) mod 2^d, rounding
  // halves up, which is floor((2^(d + 1) x + q) / 2q); applied to each
  // coefficient.
  spec compress[d in 1..12](f: Poly) -> Mod[(1 << d)]^256 {
    let one: Word[16] = 1;
    let m: Int = (one << (d + 1)) as Int;
    for i in 0..256 with c: Mod[(1 << d)]^256 = [0; 256] {
      let y: Int = (((f[i] as Int) * m) + 3329) / 6658;
      c with [i] = y as Mod[(1 << d)]
    }
  }

  // Equation 4.8: Decompress_d(y) = round((q / 2^d) y), which is
  // floor((q y + 2^(d - 1)) / 2^d).
  spec decompress[d in 1..12](c: Mod[(1 << d)]^256) -> Poly {
    let one: Word[16] = 1;
    let m: Int = (one << d) as Int;
    for i in 0..256 with f: Poly = [0; 256] {
      let x: Int = (((c[i] as Int) * 3329) + (m / 2)) / m;
      f with [i] = x as Zq
    }
  }

  // ---- Section 4.2.2: sampling ----

  // Algorithm 7, SampleNTT: each three bytes C0, C1, C2 of the SHAKE128
  // stream of rho || j || i give two candidates d1 = C0 + 256 (C1 mod 16)
  // and d2 = floor(C1 / 16) + 16 C2, kept while below q until 256
  // coefficients are written. Departure: the standard squeezes three bytes
  // at a time with no bound on the number of steps; here the stream is four
  // blocks of 168 bytes, 224 triples, squeezed at once. A triple keeps
  // about 1.6 candidates on average, so 256 coefficients take about 158
  // triples. Every ML-KEM-512 case of the two ACVP files completes within
  // 172 triples; keyGen tcId 20 below needs all 172, so its test reads the
  // fourth block. A matrix that did not complete within 224 would keep
  // zeros and fail its test.
  spec sample_ntt(b: Word[8]^34) -> Poly {
    let c: Word[8]^672 = keccak::squeeze[21, 4](keccak::shake128(b));
    let r: (Poly, Word[16]) = for t in 0..224 with (a: Poly, j: Word[16]) = ([0; 256], 0) {
      let c0: Word[16] = c[3 * t] as Word[16];
      let c1: Word[16] = c[3 * t + 1] as Word[16];
      let c2: Word[16] = c[3 * t + 2] as Word[16];
      let d1: Word[16] = c0 + 256 * (c1 % 16);
      let d2: Word[16] = (c1 / 16) + 16 * c2;
      let (a1: Poly, j1: Word[16]) =
        if (d1 < 3329) && (j < 256) { (a with [j as Word[8]] = d1 as Zq, j + 1) } else { (a, j) };
      if (d2 < 3329) && (j1 < 256) {
        (a1 with [j1 as Word[8]] = d2 as Zq, j1 + 1)
      } else {
        (a1, j1)
      }
    };
    r.0
  }

  // Algorithm 4 (section 4.2.1), BytesToBits: bit 8i + j of the result is
  // bit j of byte i, least significant first, one bit to an element; here
  // for the strings of 64 eta bytes that SamplePolyCBD reads.
  spec bytes_to_bits[eta in 2..4](b: Word[8]^(64 * eta)) -> Word[8]^(512 * eta) {
    for i in 0..(64 * eta) with bits: Word[8]^(512 * eta) = [0; (512 * eta)] {
      let c: Word[8] = b[i];
      bits with [8 * i..8 * i + 8] = [
        c & 1, (c >> 1) & 1, (c >> 2) & 1, (c >> 3) & 1,
        (c >> 4) & 1, (c >> 5) & 1, (c >> 6) & 1, c >> 7,
      ]
    }
  }

  // Algorithm 8, SamplePolyCBD_eta: coefficient i is x - y, where x sums
  // bits 2 i eta through 2 i eta + eta - 1 of B and y the next eta bits.
  spec sample_poly_cbd[eta in 2..4](b: Word[8]^(64 * eta)) -> Poly {
    let bits: Word[8]^(512 * eta) = bytes_to_bits[eta](b);
    for i in 0..256 with f: Poly = [0; 256] {
      let pair: Word[8]^(2 * eta) = bits[2 * eta * i..2 * eta * i + 2 * eta];
      let x: Word[8] = for j in 0..(eta) with x: Word[8] = 0 { x + pair[j] };
      let y: Word[8] = for j in 0..(eta) with y: Word[8] = 0 { y + pair[eta + j] };
      f with [i] = (x as Zq) - (y as Zq)
    }
  }

  // ---- Section 4.3: the number-theoretic transform ----

  // Appendix A: zeta^BitRev7(i) mod q for i = 0 through 127, with zeta = 17
  // and BitRev7(i) the 7-bit reversal of i; printed by a script from that
  // definition.
  spec zetas() -> Zq^128 {
    [
      1, 1729, 2580, 3289, 2642, 630, 1897, 848,
      1062, 1919, 193, 797, 2786, 3260, 569, 1746,
      296, 2447, 1339, 1476, 3046, 56, 2240, 1333,
      1426, 2094, 535, 2882, 2393, 2879, 1974, 821,
      289, 331, 3253, 1756, 1197, 2304, 2277, 2055,
      650, 1977, 2513, 632, 2865, 33, 1320, 1915,
      2319, 1435, 807, 452, 1438, 2868, 1534, 2402,
      2647, 2617, 1481, 648, 2474, 3110, 1227, 910,
      17, 2761, 583, 2649, 1637, 723, 2288, 1100,
      1409, 2662, 3281, 233, 756, 2156, 3015, 3050,
      1703, 1651, 2789, 1789, 1847, 952, 1461, 2687,
      939, 2308, 2437, 2388, 733, 2337, 268, 641,
      1584, 2298, 2037, 3220, 375, 2549, 2090, 1645,
      1063, 319, 2773, 757, 2099, 561, 2466, 2594,
      2804, 1092, 403, 1026, 1143, 2150, 2775, 886,
      1722, 1212, 1874, 1029, 2110, 2935, 885, 2154,
    ]
  }

  // Algorithm 9, NTT. The standard's layer len = 128, 64, ..., 2 walks the
  // blocks start = 0, 2 len, 4 len, ... with i counting up from 1; here
  // layer l has len = 128 / 2^l and its 128 butterflies m in one loop:
  // butterfly m is in block m div len, whose zeta is zetas[2^l + block],
  // and joins coefficients j = m + block len and j + len.
  spec ntt(f: Poly) -> Poly {
    let z: Zq^128 = zetas();
    let top: Word[8] = 128;
    for l in 0..7 with a: Poly = f {
      let len: Word[8] = top >> l;
      let first: Word[8] = top >> (7 - l);
      for m in 0..128 with b: Poly = a {
        let w: Word[8] = m as Word[8];
        let block: Word[8] = w / len;
        let j: Word[8] = w + block * len;
        let t: Zq = z[(first + block) & 0x7f] * b[j + len];
        (b with [j + len] = b[j] - t) with [j] = b[j] + t
      }
    }
  }

  // Algorithm 10, NTT^-1: the layers in reverse, len = 2 through 128, with
  // i counting down from 127, so block m div len of layer l takes
  // zetas[128 / 2^l - 1 - block]; then every coefficient times
  // 3303 = 128^-1 mod q.
  spec inverse_ntt(f: Poly) -> Poly {
    let z: Zq^128 = zetas();
    let top: Word[8] = 128;
    let two: Word[8] = 2;
    let unscaled: Poly = for l in 0..7 with a: Poly = f {
      let len: Word[8] = two << l;
      let last: Word[8] = (top >> l) - 1;
      for m in 0..128 with b: Poly = a {
        let w: Word[8] = m as Word[8];
        let block: Word[8] = w / len;
        let j: Word[8] = w + block * len;
        let t: Zq = b[j];
        (b with [j] = t + b[j + len])
          with [j + len] = z[(last - block) & 0x7f] * (b[j + len] - t)
      }
    };
    for k in 0..256 with g: Poly = unscaled { g with [k] = unscaled[k] * 3303 }
  }

  // Algorithms 11 and 12: MultiplyNTTs multiplies in each of the 128
  // quadratic factors, (a0 + a1 X)(b0 + b1 X) modulo X^2 - gamma, with
  // gamma = zeta^(2 BitRev7(i) + 1) = 17 (zeta^BitRev7(i))^2.
  spec base_case_multiply(a0: Zq, a1: Zq, b0: Zq, b1: Zq, gamma: Zq) -> (Zq, Zq) {
    (a0 * b0 + a1 * b1 * gamma, a0 * b1 + a1 * b0)
  }

  spec multiply_ntts(f: Poly, g: Poly) -> Poly {
    let z: Zq^128 = zetas();
    for i in 0..128 with h: Poly = [0; 256] {
      let (c0: Zq, c1: Zq) =
        base_case_multiply(f[2 * i], f[2 * i + 1], g[2 * i], g[2 * i + 1], 17 * z[i] * z[i]);
      (h with [2 * i] = c0) with [2 * i + 1] = c1
    }
  }

  spec add(f: Poly, g: Poly) -> Poly {
    for i in 0..256 with h: Poly = f { h with [i] = f[i] + g[i] }
  }

  spec subtract(f: Poly, g: Poly) -> Poly {
    for i in 0..256 with h: Poly = f { h with [i] = f[i] - g[i] }
  }

  // Section 2.4: the product u^T o v of two vectors in the NTT domain is
  // the sum of the products u[j] o v[j] (MultiplyNTTs).
  spec dot(u: Vector, v: Vector) -> Poly {
    for j in 0..2 with s: Poly = [0; 256] { add(s, multiply_ntts(u[j], v[j])) }
  }

  // ---- Section 5: K-PKE ----

  // Algorithm 13, lines 3 to 7 (and Algorithm 14, lines 4 to 8): A-hat[i][j]
  // is SampleNTT(rho || j || i).
  spec sample_matrix(rho: Word[8]^32) -> Matrix {
    for i in 0..2 with a: Matrix = [[[0; 256]; 2]; 2] {
      for j in 0..2 with b: Matrix = a {
        b with [i][j] = sample_ntt(rho ++ [j as Word[8], i as Word[8]])
      }
    }
  }

  // Algorithm 13, K-PKE.KeyGen(d): (rho, sigma) = G(d || k) with k = 2 as
  // one byte; s and e from PRF_eta1(sigma, N) for N = 0 through 3; t-hat =
  // A-hat o s-hat + e-hat; returns (ek_PKE, dk_PKE).
  spec k_pke_keygen(d: Word[8]^32) -> (Word[8]^800, Word[8]^768) {
    let (rho: Word[8]^32, sigma: Word[8]^32) = hash_g(d ++ hex"02");
    let a: Matrix = sample_matrix(rho);
    let s: Vector = for i in 0..2 with s: Vector = [[0; 256]; 2] {
      s with [i] = sample_poly_cbd[3](prf[3](sigma, i as Word[8]))
    };
    let e: Vector = for i in 0..2 with e: Vector = [[0; 256]; 2] {
      e with [i] = sample_poly_cbd[3](prf[3](sigma, (i as Word[8]) + 2))
    };
    let s_hat: Vector = [ntt(s[0]), ntt(s[1])];
    let e_hat: Vector = [ntt(e[0]), ntt(e[1])];
    let t_hat: Vector = for i in 0..2 with t: Vector = e_hat {
      t with [i] = add(dot(a[i], s_hat), e_hat[i])
    };
    (
      byte_encode_12(t_hat[0]) ++ byte_encode_12(t_hat[1]) ++ rho,
      byte_encode_12(s_hat[0]) ++ byte_encode_12(s_hat[1]),
    )
  }

  // Algorithm 14, K-PKE.Encrypt(ek_PKE, m, r): u = NTT^-1(A-hat^T o y-hat)
  // + e1 and v = NTT^-1(t-hat^T o y-hat) + e2 + mu, compressed to d_u = 10
  // and d_v = 4 bits.
  spec k_pke_encrypt(ek: Word[8]^800, m: Word[8]^32, r: Word[8]^32) -> Word[8]^768 {
    let t_hat: Vector = [byte_decode_12(ek[..384]), byte_decode_12(ek[384..768])];
    let a: Matrix = sample_matrix(ek[768..]);
    let y: Vector = for i in 0..2 with y: Vector = [[0; 256]; 2] {
      y with [i] = sample_poly_cbd[3](prf[3](r, i as Word[8]))
    };
    let e1: Vector = for i in 0..2 with e: Vector = [[0; 256]; 2] {
      e with [i] = sample_poly_cbd[2](prf[2](r, (i as Word[8]) + 2))
    };
    let e2: Poly = sample_poly_cbd[2](prf[2](r, 4));
    let y_hat: Vector = [ntt(y[0]), ntt(y[1])];
    let u: Vector = for i in 0..2 with u: Vector = e1 {
      let column: Vector = [a[0][i], a[1][i]];
      u with [i] = add(inverse_ntt(dot(column, y_hat)), e1[i])
    };
    let mu: Poly = decompress[1](byte_decode[1](m));
    let v: Poly = add(add(inverse_ntt(dot(t_hat, y_hat)), e2), mu);
    byte_encode[10](compress[10](u[0])) ++ byte_encode[10](compress[10](u[1]))
      ++ byte_encode[4](compress[4](v))
  }

  // Algorithm 15, K-PKE.Decrypt(dk_PKE, c): w = v' - NTT^-1(s-hat^T o
  // NTT(u')), and m = ByteEncode_1(Compress_1(w)).
  spec k_pke_decrypt(dk: Word[8]^768, c: Word[8]^768) -> Word[8]^32 {
    let u: Vector = [
      decompress[10](byte_decode[10](c[..320])),
      decompress[10](byte_decode[10](c[320..640])),
    ];
    let v: Poly = decompress[4](byte_decode[4](c[640..]));
    let s_hat: Vector = [byte_decode_12(dk[..384]), byte_decode_12(dk[384..])];
    let w: Poly = subtract(v, inverse_ntt(dot(s_hat, [ntt(u[0]), ntt(u[1])])));
    byte_encode[1](compress[1](w))
  }

  // ---- Section 6: ML-KEM, the internal algorithms ----

  // Algorithm 16, ML-KEM.KeyGen_internal(d, z): returns (ek, dk) with
  // dk = dk_PKE || ek || H(ek) || z.
  spec keygen_internal(d: Word[8]^32, z: Word[8]^32) -> (Word[8]^800, Word[8]^1632) {
    let (ek: Word[8]^800, dk_pke: Word[8]^768) = k_pke_keygen(d);
    (ek, dk_pke ++ ek ++ hash_h(ek) ++ z)
  }

  // Algorithm 17, ML-KEM.Encaps_internal(ek, m): (K, r) = G(m || H(ek)),
  // and returns (K, c).
  spec encaps_internal(ek: Word[8]^800, m: Word[8]^32) -> (Word[8]^32, Word[8]^768) {
    let (k: Word[8]^32, r: Word[8]^32) = hash_g(m ++ hash_h(ek));
    (k, k_pke_encrypt(ek, m, r))
  }

  // Algorithm 18, ML-KEM.Decaps_internal(dk, c): decrypts, re-encrypts
  // under the recovered coins, and returns K' when the ciphertexts agree and
  // the implicit-rejection key K-bar = J(z || c) when they do not.
  spec decaps_internal(dk: Word[8]^1632, c: Word[8]^768) -> Word[8]^32 {
    let dk_pke: Word[8]^768 = dk[..768];
    let ek_pke: Word[8]^800 = dk[768..1568];
    let h: Word[8]^32 = dk[1568..1600];
    let z: Word[8]^32 = dk[1600..];
    let m: Word[8]^32 = k_pke_decrypt(dk_pke, c);
    let (k: Word[8]^32, r: Word[8]^32) = hash_g(m ++ h);
    let k_bar: Word[8]^32 = hash_j(z ++ c);
    let c_prime: Word[8]^768 = k_pke_encrypt(ek_pke, m, r);
    if c == c_prime { k } else { k_bar }
  }

  // ---- Vectors ----

  // NIST ACVP, ML-KEM keyGen, revision FIPS203, vsId 42,
  // internalProjection.json, tgId 1 (ML-KEM-512, AFT): ML-KEM.KeyGen_internal
  // of the seeds d and z gives the encapsulation key ek and the
  // decapsulation key dk.
  test "ACVP keyGen tcId 1: KeyGen_internal(d, z)" {
    let d: Word[8]^32 =
      hex"47b89347 4672ba92 e4b12ee4 4fb32953 af8e8503 b5fb471d 1614fb8a 021a660a";
    let z: Word[8]^32 =
      hex"1f8cb39e 9e30bc45 8a0dc540 8884b118 7fb21701 8df760fa 57317703 b844a0a9";
    let ek: Word[8]^800 =
      hex"28266a08 8b348243 9bca01af b7ca5c61 36a979b5 159985a9 484b36b6 79a5f7b9"
      ++ hex"819eb635 77891f7b b9cb9841 3ccc434a dc79a16d 6ab30765 69ce6291 c59b5d64"
      ++ hex"612a7fb0 c1501320 0bc8bebb 03a57017 4b5e4363 aed86eb0 2a220d28 1fb5457f"
      ++ hex"0a549fc5 051d49a6 b2015259 a2c3084f 405e1769 95226067 5586a584 90405927"
      ++ hex"5a265234 ef3abf88 c171a808 98fc7833 58bbc980 3c878902 7d917c9e bacbc568"
      ++ hex"cc18de84 c85454b9 4249586c 0c6e2b8a 16fa789c 51212dd1 728ee9b8 c6c40528"
      ++ hex"bf93826f a8236841 9623032a f27b5694 30581681 1d3ca858 05100e9c 1a9621e5"
      ++ hex"089e54cb 47f5a8fe a0b49ef8 1c6b5187 f48924c7 947d6b61 697a4a8a 18452ef8"
      ++ hex"03336ad4 be503275 bcacc03c 181405f7 b1dc9b47 fb169eb3 7bbe27e2 9c763a4e"
      ++ hex"52b9a425 20388cf0 9b8edbcd f41ccf65 37190e61 56c37cc1 aac63c0f 90ce78d0"
      ++ hex"b9b190c5 48d71b6f 26cc8f58 5ea14004 b5b30aaa 100b2adc 12638288 33b24e46"
      ++ hex"163b4144 6f98c882 092a3994 1867b806 32e20976 74a79393 5227db0b 8577e03a"
      ++ hex"69c50a51 4c7473c8 92e3fba7 c4316bda bc952a70 64417668 7d419132 3bad93d8"
      ++ hex"5a3ca250 868c0747 e6c44f61 26c874af bec0bdd4 503cb2c5 9a69816e 7d410994"
