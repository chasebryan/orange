  // Wycheproof, mlkem_512_test.json, tcId 1 (source CCTV/strcmp, flag
  // Strcmp, result valid): the key pair comes from the 64-byte seed d || z,
  // its ek is the one the case prints, and decapsulating c must take the
  // implicit-rejection path. c and its re-encryption c' both begin with a
  // zero byte and differ after it, so a comparison that stopped at a zero
  // byte, as strcmp does, would find them equal.
  test "Wycheproof tcId 1: key pair from the seed, implicit rejection" {
    let seed: Word[8]^64 =
      hex"a3896e30 892230a6 c1dff667 f8caee75 9ff84a08 e3462ae4 84fcbca9 971d7959"
      ++ hex"cdc6c5ec 65f10a5a 24b5145a ac863232 ee3b2229 ca3a6c4b 9c8a2daf c315d9d4";
    let ek: Word[8]^800 =
      hex"871b108f d9801087 68612345 f2fc7317 216f5557 6f914c3e de67878e a89046d6"
      ++ hex"36572ca7 8fd67a4e fc9b68e4 62853b2a e8dab001 b6059c39 0916fccf 45bba50b"
      ++ hex"85b7e125 04ef931c 52030a4e fb31ce97 8866ea0b ece660b1 6700d9ca 4fb8eca3"
