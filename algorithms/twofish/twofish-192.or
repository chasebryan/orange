// Twofish, the 128-bit block cipher of "Twofish: A 128-Bit Block Cipher"
// (Schneier, Kelsey, Whiting, Wagner, Hall, Ferguson; Counterpane, 15 June
// 1998), https://www.schneier.com/academic/twofish/, one of the five AES
// finalists, written the way the paper writes it: the 16-round Feistel
// network of section 4 with input and output whitening, the function F of
// section 4.1 with its pseudo-Hadamard transform and 1-bit rotations, the
// function g of section 4.2 with the MDS matrix over GF(2^8) modulo
// x^8 + x^6 + x^5 + x^3 + 1, the key schedule of section 4.3 with the RS
// matrix over GF(2^8) modulo x^8 + x^6 + x^3 + x^2 + 1, the function h and
// the expanded key words, and the permutations q0 and q1 of section 4.3.5
// built from their 4-bit tables. Encryption and decryption for 128-, 192-
// and 256-bit keys reproduce cases of the submission's ecb_tbl set as
// carried in Botan's twofish.vec.
//
// One block costs about 270,000 (128-bit key), 345,000 (192-bit) or 420,000
// (256-bit) of the 1,048,576 steps of a file, so the vectors are split by
// key size: twofish.or holds the 128-bit cases, twofish-192.or the 192-bit
// cases and twofish-256.or the 256-bit cases. The algorithm part of the
// three files is the same text; only the vector specs differ.
// This file reproduces ecb_tbl KEYSIZE=192 I=1, and I=3 decrypted.
edition 2026;
module twofish {
  // Bytes and words. Twofish reads its key and its blocks little-endian
  // (section 4: P_i is the sum of p_(4i+j) 2^(8j)).
  spec load_le32(b0: Word[8], b1: Word[8], b2: Word[8], b3: Word[8]) -> Word[32] {
    (b0 as Word[32]) | ((b1 as Word[32]) << 8) | ((b2 as Word[32]) << 16)
      | ((b3 as Word[32]) << 24)
  }

  spec le_bytes(x: Word[32]) -> Word[8]^4 {
    [x as Word[8], (x >> 8) as Word[8], (x >> 16) as Word[8], (x >> 24) as Word[8]]
  }

  spec block_words(b: Word[8]^16) -> Word[32]^4 {
    [
      load_le32(b[0], b[1], b[2], b[3]), load_le32(b[4], b[5], b[6], b[7]),
      load_le32(b[8], b[9], b[10], b[11]), load_le32(b[12], b[13], b[14], b[15]),
    ]
  }

  spec block_bytes(w: Word[32]^4) -> Word[8]^16 {
    let w0: Word[8]^4 = le_bytes(w[0]);
    let w1: Word[8]^4 = le_bytes(w[1]);
    let w2: Word[8]^4 = le_bytes(w[2]);
    let w3: Word[8]^4 = le_bytes(w[3]);
    [
      w0[0], w0[1], w0[2], w0[3], w1[0], w1[1], w1[2], w1[3],
      w2[0], w2[1], w2[2], w2[3], w3[0], w3[1], w3[2], w3[3],
    ]
  }

  // Section 4.3.5: the permutations q0 and q1. Each is built from four
  // 4-bit permutations t0 to t3; here each t is one Word[64] holding its
  // sixteen entries, the entry for 0 in the most significant nibble, so
  // that each literal reads as the paper's row (0x817d6f320b59eca4 is
  // 8 1 7 D 6 F 3 2 0 B 5 9 E C A 4, the t0 of q0).
  spec q0_tables() -> Word[64]^4 {
    [0x817d6f320b59eca4, 0xecb81235f4a6709d, 0xba5e6d90c8f32471, 0xd7f4126e9b3085ca]
  }

  spec q1_tables() -> Word[64]^4 {
    [0x28bdf76e31940ac5, 0x1e2b4c376da5f908, 0x4c75169a0ed82b3f, 0xb951c3de647f208a]
  }

  // Entry k of a 4-bit table packed sixteen nibbles to a word. A 4-bit index
  // may select a table of 16 entries; this rendering selects the entry with
  // a conditional on k.
  spec nibble_at(t: Word[64], k: Word[8]) -> Word[8] {
    if k == 0 { ((t >> 60) as Word[8]) & 15 }
    else if k == 1 { ((t >> 56) as Word[8]) & 15 }
    else if k == 2 { ((t >> 52) as Word[8]) & 15 }
    else if k == 3 { ((t >> 48) as Word[8]) & 15 }
    else if k == 4 { ((t >> 44) as Word[8]) & 15 }
    else if k == 5 { ((t >> 40) as Word[8]) & 15 }
    else if k == 6 { ((t >> 36) as Word[8]) & 15 }
    else if k == 7 { ((t >> 32) as Word[8]) & 15 }
    else if k == 8 { ((t >> 28) as Word[8]) & 15 }
    else if k == 9 { ((t >> 24) as Word[8]) & 15 }
    else if k == 10 { ((t >> 20) as Word[8]) & 15 }
    else if k == 11 { ((t >> 16) as Word[8]) & 15 }
    else if k == 12 { ((t >> 12) as Word[8]) & 15 }
    else if k == 13 { ((t >> 8) as Word[8]) & 15 }
    else if k == 14 { ((t >> 4) as Word[8]) & 15 }
    else { (t as Word[8]) & 15 }
  }

  // ROR4: a 4-bit value rotated right by one.
  spec ror4(x: Word[8]) -> Word[8] { ((x >> 1) | (x << 3)) & 15 }

  // Section 4.3.5: a byte through a q permutation. The byte splits into
  // the nibbles a0 (high) and b0 (low); each of two stages forms
  // a' = a xor b and b' = a xor ROR4(b, 1) xor 8a mod 16 and passes the
  // pair through two of the tables; the last pair is reassembled with b
  // high.
  spec q(t: Word[64]^4, x: Word[8]) -> Word[8] {
    let a0: Word[8] = x >> 4;
    let b0: Word[8] = x & 15;
    let a1: Word[8] = a0 ^ b0;
    let b1: Word[8] = a0 ^ ror4(b0) ^ ((a0 << 3) & 15);
    let a2: Word[8] = nibble_at(t[0], a1);
    let b2: Word[8] = nibble_at(t[1], b1);
    let a3: Word[8] = a2 ^ b2;
    let b3: Word[8] = a2 ^ ror4(b2) ^ ((a2 << 3) & 15);
    let a4: Word[8] = nibble_at(t[2], a3);
    let b4: Word[8] = nibble_at(t[3], b3);
    (b4 << 4) | a4
  }

  spec q0(x: Word[8]) -> Word[8] { q(q0_tables(), x) }
  spec q1(x: Word[8]) -> Word[8] { q(q1_tables(), x) }

  // GF(2^8) arithmetic. Twofish uses two representations of the field: the
  // MDS matrix works modulo v(x) = x^8 + x^6 + x^5 + x^3 + 1 (section 4.2)
  // and the RS matrix modulo w(x) = x^8 + x^6 + x^3 + x^2 + 1 (section
  // 4.3). A polynomial is named by its low byte, the value added when an
  // x^8 term is reduced.
  spec v_polynomial() -> Word[8] { 0x69 }
  spec w_polynomial() -> Word[8] { 0x4d }

  // Multiplication by x modulo the named polynomial.
  spec xtime(a: Word[8], polynomial: Word[8]) -> Word[8] {
    (a << 1) ^ (if (a & 0x80) != 0 { polynomial } else { 0 })
  }

  // The product a b in GF(2^8) modulo the named polynomial: eight steps of
  // shift and conditional add over [a, b, product]. The RS matrix, with its
  // twenty distinct coefficients, uses it; the MDS matrix has two
  // coefficients and writes their products out below.
  spec gf_mul(a: Word[8], b: Word[8], polynomial: Word[8]) -> Word[8] {
    let s: Word[8]^3 = for i in 0..8 with s: Word[8]^3 = [a, b, 0] {
      [xtime(s[0], polynomial), s[1] >> 1, if (s[1] & 1) != 0 { s[2] ^ s[0] } else { s[2] }]
    };
    s[2]
  }

  // Section 4.2: the two MDS coefficients as polynomials over GF(2),
  // EF = x^7 + x^6 + x^5 + x^3 + x^2 + x + 1 and 5B = x^6 + x^4 + x^3 + x + 1.
  // The products EF a and 5B a are the sums of a x^i over each
  // coefficient's terms, the powers a x^i computed by repeated xtime modulo
  // v(x); both products share one chain. The result is [EF a, 5B a].
  spec mds_products(a: Word[8]) -> Word[8]^2 {
    let v: Word[8] = v_polynomial();
    let ax1: Word[8] = xtime(a, v);
    let ax2: Word[8] = xtime(ax1, v);
    let ax3: Word[8] = xtime(ax2, v);
    let ax4: Word[8] = xtime(ax3, v);
    let ax5: Word[8] = xtime(ax4, v);
    let ax6: Word[8] = xtime(ax5, v);
    let ax7: Word[8] = xtime(ax6, v);
    [ax7 ^ ax6 ^ ax5 ^ ax3 ^ ax2 ^ ax1 ^ a, ax6 ^ ax4 ^ ax3 ^ ax1 ^ a]
  }

  // Section 4.2: the MDS matrix
  //   [ 01 EF 5B 5B ]
  //   [ 5B EF EF 01 ]
  //   [ EF 5B 01 EF ]
  //   [ EF 01 EF 5B ]
  // applied over GF(2^8) modulo v(x) to the column (y0, y1, y2, y3) gives
  // (z0, z1, z2, z3), and Z is the sum of z_i 2^(8i). Each byte is
  // multiplied by EF and by 5B once; the four rows combine the products.
  spec mds(y: Word[8]^4) -> Word[32] {
    let p0: Word[8]^2 = mds_products(y[0]);
    let p1: Word[8]^2 = mds_products(y[1]);
    let p2: Word[8]^2 = mds_products(y[2]);
    let p3: Word[8]^2 = mds_products(y[3]);
    load_le32(
      y[0] ^ p1[0] ^ p2[1] ^ p3[1],
      p0[1] ^ p1[0] ^ p2[0] ^ y[3],
      p0[0] ^ p1[1] ^ y[2] ^ p3[0],
      p0[0] ^ y[1] ^ p2[0] ^ p3[1],
    )
  }

  // Section 4.3: the RS matrix
  //   [ 01 A4 55 87 5A 58 DB 9E ]
  //   [ A4 56 82 F3 1E C6 68 E5 ]
  //   [ 02 A1 FC C1 47 AE 3D 19 ]
  //   [ A4 55 87 5A 58 DB 9E 03 ]
  // applied over GF(2^8) modulo w(x) to eight key bytes m_0 to m_7 gives
  // the four bytes s_0 to s_3 of one S-box key word S = sum of s_j 2^(8j).
  spec rs(m: Word[8]^8) -> Word[32] {
    let w: Word[8] = w_polynomial();
    let row0: Word[8]^8 = [0x01, 0xa4, 0x55, 0x87, 0x5a, 0x58, 0xdb, 0x9e];
    let row1: Word[8]^8 = [0xa4, 0x56, 0x82, 0xf3, 0x1e, 0xc6, 0x68, 0xe5];
    let row2: Word[8]^8 = [0x02, 0xa1, 0xfc, 0xc1, 0x47, 0xae, 0x3d, 0x19];
    let row3: Word[8]^8 = [0xa4, 0x55, 0x87, 0x5a, 0x58, 0xdb, 0x9e, 0x03];
    load_le32(
      for j in 0..8 with s: Word[8] = 0 { s ^ gf_mul(row0[j], m[j], w) },
      for j in 0..8 with s: Word[8] = 0 { s ^ gf_mul(row1[j], m[j], w) },
      for j in 0..8 with s: Word[8] = 0 { s ^ gf_mul(row2[j], m[j], w) },
      for j in 0..8 with s: Word[8] = 0 { s ^ gf_mul(row3[j], m[j], w) },
    )
  }

  // Section 4.3.2: the function h. The word X is split into the bytes
  // x_j, which pass through k stages, each a fixed permutation q0 or q1
  // followed by an xor with the bytes l_(i,j) of the list
  // L = (L_0, ..., L_(k-1)), the word L_(k-1) at the first stage and L_0 at
  // the last, then through one more fixed permutation and the MDS matrix.
  // L is padded to four words; k is 2, 3 or 4 for 128-, 192- and 256-bit
  // keys, and the stages for k = 4 and k >= 3 are skipped when k is
  // smaller, as the paper's definition skips them.
  spec h(x: Word[32], l: Word[32]^4, k: Int) -> Word[32] {
    let x_bytes: Word[8]^4 = le_bytes(x);
    let l0: Word[8]^4 = le_bytes(l[0]);
    let l1: Word[8]^4 = le_bytes(l[1]);
    let l2: Word[8]^4 = le_bytes(l[2]);
    let l3: Word[8]^4 = le_bytes(l[3]);
    let y3: Word[8]^4 = if k == 4 {
      [
        q1(x_bytes[0]) ^ l3[0], q0(x_bytes[1]) ^ l3[1],
        q0(x_bytes[2]) ^ l3[2], q1(x_bytes[3]) ^ l3[3],
      ]
    } else { x_bytes };
    let y2: Word[8]^4 = if k >= 3 {
      [q1(y3[0]) ^ l2[0], q1(y3[1]) ^ l2[1], q0(y3[2]) ^ l2[2], q0(y3[3]) ^ l2[3]]
    } else { y3 };
    mds([
      q1(q0(q0(y2[0]) ^ l1[0]) ^ l0[0]),
      q0(q0(q1(y2[1]) ^ l1[1]) ^ l0[1]),
      q1(q1(q0(y2[2]) ^ l1[2]) ^ l0[2]),
      q0(q1(q1(y2[3]) ^ l1[3]) ^ l0[3]),
    ])
  }

  // Section 4.3.4: the expanded key words. With rho = 2^24 + 2^16 + 2^8 + 1,
  // A_i = h(2 i rho, Me), B_i = ROL(h((2 i + 1) rho, Mo), 8),
  // K_(2i) = A_i + B_i and K_(2i+1) = ROL(A_i + 2 B_i, 9) for i from 0
  // through 19.
  spec expanded_key_words(me: Word[32]^4, mo: Word[32]^4, k: Int) -> Word[32]^40 {
    let rho: Word[32] = 0x01010101;
    let a: Word[32]^20 = for i in 0..20 with a: Word[32]^20 = [0; 20] {
      a with [i] = h(((2 * i) as Word[32]) * rho, me, k)
    };
    let b: Word[32]^20 = for i in 0..20 with b: Word[32]^20 = [0; 20] {
      b with [i] = h(((2 * i + 1) as Word[32]) * rho, mo, k) <<< 8
    };
    for i in 0..20 with kw: Word[32]^40 = [0; 40] {
      (kw with [2 * i] = a[i] + b[i]) with [2 * i + 1] = (a[i] + 2 * b[i]) <<< 9
    }
  }

  // The result of the key schedule in this file: the forty expanded key
  // words K_0 to K_39, then the S-box key words in the order g takes them,
  // (S_(k-1), ..., S_0), padded to four.
  spec with_sbox_keys(kw: Word[32]^40, s: Word[32]^4) -> Word[32]^44 {
    let head: Word[32]^44 = for j in 0..40 with ek: Word[32]^44 = [0; 44] { ek with [j] = kw[j] };
    for j in 0..4 with ek: Word[32]^44 = head { ek with [40 + j] = s[j] }
  }

  // Section 4.3 for a 128-bit key (k = 2): the key bytes form the words
  // M_0 to M_3, Me = (M_0, M_2) and Mo = (M_1, M_3); S_0 and S_1 are the RS
  // products of the first and second eight key bytes, and section 4.3.3
  // orders them (S_1, S_0) for g.
  spec key_schedule_128(key: Word[8]^16) -> Word[32]^44 {
    let m0: Word[32] = load_le32(key[0], key[1], key[2], key[3]);
    let m1: Word[32] = load_le32(key[4], key[5], key[6], key[7]);
    let m2: Word[32] = load_le32(key[8], key[9], key[10], key[11]);
    let m3: Word[32] = load_le32(key[12], key[13], key[14], key[15]);
    let s0: Word[32] = rs([key[0], key[1], key[2], key[3], key[4], key[5], key[6], key[7]]);
    let s1: Word[32] = rs([key[8], key[9], key[10], key[11], key[12], key[13], key[14], key[15]]);
    with_sbox_keys(expanded_key_words([m0, m2, 0, 0], [m1, m3, 0, 0], 2), [s1, s0, 0, 0])
  }

  // Section 4.3 for a 192-bit key (k = 3): M_0 to M_5, Me = (M_0, M_2, M_4),
  // Mo = (M_1, M_3, M_5), and S = (S_2, S_1, S_0).
  spec key_schedule_192(key: Word[8]^24) -> Word[32]^44 {
    let m0: Word[32] = load_le32(key[0], key[1], key[2], key[3]);
    let m1: Word[32] = load_le32(key[4], key[5], key[6], key[7]);
    let m2: Word[32] = load_le32(key[8], key[9], key[10], key[11]);
    let m3: Word[32] = load_le32(key[12], key[13], key[14], key[15]);
    let m4: Word[32] = load_le32(key[16], key[17], key[18], key[19]);
    let m5: Word[32] = load_le32(key[20], key[21], key[22], key[23]);
    let s0: Word[32] = rs([key[0], key[1], key[2], key[3], key[4], key[5], key[6], key[7]]);
    let s1: Word[32] = rs([key[8], key[9], key[10], key[11], key[12], key[13], key[14], key[15]]);
    let s2: Word[32] = rs([key[16], key[17], key[18], key[19], key[20], key[21], key[22], key[23]]);
    with_sbox_keys(expanded_key_words([m0, m2, m4, 0], [m1, m3, m5, 0], 3), [s2, s1, s0, 0])
  }

  // Section 4.3 for a 256-bit key (k = 4): M_0 to M_7,
  // Me = (M_0, M_2, M_4, M_6), Mo = (M_1, M_3, M_5, M_7), and
  // S = (S_3, S_2, S_1, S_0).
  spec key_schedule_256(key: Word[8]^32) -> Word[32]^44 {
    let m0: Word[32] = load_le32(key[0], key[1], key[2], key[3]);
    let m1: Word[32] = load_le32(key[4], key[5], key[6], key[7]);
    let m2: Word[32] = load_le32(key[8], key[9], key[10], key[11]);
    let m3: Word[32] = load_le32(key[12], key[13], key[14], key[15]);
    let m4: Word[32] = load_le32(key[16], key[17], key[18], key[19]);
    let m5: Word[32] = load_le32(key[20], key[21], key[22], key[23]);
    let m6: Word[32] = load_le32(key[24], key[25], key[26], key[27]);
    let m7: Word[32] = load_le32(key[28], key[29], key[30], key[31]);
    let s0: Word[32] = rs([key[0], key[1], key[2], key[3], key[4], key[5], key[6], key[7]]);
    let s1: Word[32] = rs([key[8], key[9], key[10], key[11], key[12], key[13], key[14], key[15]]);
    let s2: Word[32] = rs([key[16], key[17], key[18], key[19], key[20], key[21], key[22], key[23]]);
    let s3: Word[32] = rs([key[24], key[25], key[26], key[27], key[28], key[29], key[30], key[31]]);
    with_sbox_keys(
      expanded_key_words([m0, m2, m4, m6], [m1, m3, m5, m7], 4),
      [s3, s2, s1, s0],
    )
  }

  // Sections 4.2 and 4.3.3: g(X) = h(X, S), the key-dependent S-boxes
  // applied to the four bytes of X and mixed by the MDS matrix. S is the
  // last four words of the expanded key.
  spec g(x: Word[32], ek: Word[32]^44, k: Int) -> Word[32] {
    h(x, [ek[40], ek[41], ek[42], ek[43]], k)
  }

  // Section 4.1: the function F. T_0 = g(R_0) and T_1 = g(ROL(R_1, 8));
  // the pseudo-Hadamard transform and the two round subkeys give
  // F_0 = T_0 + T_1 + K_(2r+8) and F_1 = T_0 + 2 T_1 + K_(2r+9).
  spec f(
    r0: Word[32], r1: Word[32], ek: Word[32]^44, k: Int, k2r8: Word[32], k2r9: Word[32],
  ) -> Word[32]^2 {
    let t0: Word[32] = g(r0, ek, k);
    let t1: Word[32] = g(r1 <<< 8, ek, k);
    [t0 + t1 + k2r8, t0 + 2 * t1 + k2r9]
  }

  // Section 4: one round on the state (R_0, R_1, R_2, R_3). F of the first
  // two words is xored into the other two, R_2 rotated right by one after
  // the xor and R_3 rotated left by one before it, and the halves swap.
  spec round(
    s: Word[32]^4, ek: Word[32]^44, k: Int, k2r8: Word[32], k2r9: Word[32],
  ) -> Word[32]^4 {
    let fr: Word[32]^2 = f(s[0], s[1], ek, k, k2r8, k2r9);
    [(s[2] ^ fr[0]) >>> 1, (s[3] <<< 1) ^ fr[1], s[0], s[1]]
  }

  // Section 4: input whitening with K_0 to K_3, sixteen rounds with K_8 to
  // K_39, the swap of the last round undone, and output whitening with K_4
  // to K_7: C_i = R_(16, (i+2) mod 4) xor K_(i+4).
  spec encrypt(ek: Word[32]^44, k: Int, p: Word[8]^16) -> Word[8]^16 {
    let pw: Word[32]^4 = block_words(p);
    let r0: Word[32]^4 = [pw[0] ^ ek[0], pw[1] ^ ek[1], pw[2] ^ ek[2], pw[3] ^ ek[3]];
    let r16: Word[32]^4 = for r in 0..16 with s: Word[32]^4 = r0 {
      round(s, ek, k, ek[2 * r + 8], ek[2 * r + 9])
    };
    block_bytes([r16[2] ^ ek[4], r16[3] ^ ek[5], r16[0] ^ ek[6], r16[1] ^ ek[7]])
  }

  // Decryption undoes one round: F is recomputed from the words that were
  // R_0 and R_1, the rotations are taken back, and the halves swap.
  spec inverse_round(
    s: Word[32]^4, ek: Word[32]^44, k: Int, k2r8: Word[32], k2r9: Word[32],
  ) -> Word[32]^4 {
    let fr: Word[32]^2 = f(s[2], s[3], ek, k, k2r8, k2r9);
    [s[2], s[3], (s[0] <<< 1) ^ fr[0], (s[1] ^ fr[1]) >>> 1]
  }

  // Decryption: the output whitening removed, the sixteen rounds undone
  // from the last (subkeys K_38, K_39) to the first (K_8, K_9), and the
  // input whitening removed.
  spec decrypt(ek: Word[32]^44, k: Int, c: Word[8]^16) -> Word[8]^16 {
    let cw: Word[32]^4 = block_words(c);
    let r16: Word[32]^4 = [cw[2] ^ ek[6], cw[3] ^ ek[7], cw[0] ^ ek[4], cw[1] ^ ek[5]];
    let r0: Word[32]^4 = for r in 0..16 with s: Word[32]^4 = r16 {
      inverse_round(s, ek, k, ek[38 - 2 * r], ek[39 - 2 * r])
    };
    block_bytes([r0[0] ^ ek[0], r0[1] ^ ek[1], r0[2] ^ ek[2], r0[3] ^ ek[3]])
  }

  spec encrypt_128(key: Word[8]^16, p: Word[8]^16) -> Word[8]^16 {
    encrypt(key_schedule_128(key), 2, p)
  }
  spec decrypt_128(key: Word[8]^16, c: Word[8]^16) -> Word[8]^16 {
    decrypt(key_schedule_128(key), 2, c)
  }
  spec encrypt_192(key: Word[8]^24, p: Word[8]^16) -> Word[8]^16 {
    encrypt(key_schedule_192(key), 3, p)
  }
  spec decrypt_192(key: Word[8]^24, c: Word[8]^16) -> Word[8]^16 {
    decrypt(key_schedule_192(key), 3, c)
  }
  spec encrypt_256(key: Word[8]^32, p: Word[8]^16) -> Word[8]^16 {
    encrypt(key_schedule_256(key), 4, p)
  }
  spec decrypt_256(key: Word[8]^32, c: Word[8]^16) -> Word[8]^16 {
    decrypt(key_schedule_256(key), 4, c)
  }

  spec zero_block() -> Word[8]^16 {
    [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
  }

  // Botan src/tests/data/block/twofish.vec, record 49, first block; the
  // submission's ecb_tbl.txt, KEYSIZE=192, I=1: the zero key on the zero
  // block gives efa71f788965bd4453f860178fc19101.
  spec ecb_tbl_192_i1() -> Word[8]^16 {
    encrypt_192(
      [
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      ],
      zero_block(),
    )
  }
  spec ecb_tbl_192_i1_expected() -> Word[8]^16 {
    [0xef, 0xa7, 0x1f, 0x78, 0x89, 0x65, 0xbd, 0x44, 0x53, 0xf8, 0x60, 0x17, 0x8f, 0xc1, 0x91, 0x01]
  }

  // Botan twofish.vec, record 50; ecb_tbl.txt KEYSIZE=192, I=3, decrypted:
  // under the key efa71f788965bd4453f860178fc19101 (the I=1 ciphertext)
  // followed by 8 zero bytes, the ciphertext
  // 39da69d6ba4997d585b6dc073ca341b2 gives back the plaintext
  // 88b2b2706b105e36b446bb6d731a1e88 (the I=2 ciphertext).
  spec ecb_tbl_192_i3_decrypt() -> Word[8]^16 {
    decrypt_192(
      [
        0xef, 0xa7, 0x1f, 0x78, 0x89, 0x65, 0xbd, 0x44, 0x53, 0xf8, 0x60, 0x17, 0x8f, 0xc1, 0x91, 0x01,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      ],
      [0x39, 0xda, 0x69, 0xd6, 0xba, 0x49, 0x97, 0xd5, 0x85, 0xb6, 0xdc, 0x07, 0x3c, 0xa3, 0x41, 0xb2],
    )
  }
  spec ecb_tbl_192_i3_decrypt_expected() -> Word[8]^16 {
    [0x88, 0xb2, 0xb2, 0x70, 0x6b, 0x10, 0x5e, 0x36, 0xb4, 0x46, 0xbb, 0x6d, 0x73, 0x1a, 0x1e, 0x88]
  }
}
