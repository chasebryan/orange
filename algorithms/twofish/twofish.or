// Twofish, the 128-bit block cipher of "Twofish: A 128-Bit Block Cipher"
// (Schneier, Kelsey, Whiting, Wagner, Hall, Ferguson; Counterpane, 15 June
// 1998), https://www.schneier.com/academic/twofish/, one of the five AES
// finalists, written the way the paper writes it: the 16-round Feistel
// network of section 4 with input and output whitening, the function F of
// section 4.1 with its pseudo-Hadamard transform and 1-bit rotations, the
// function g of section 4.2 with the MDS matrix over GF(2^8) modulo
// x^8 + x^6 + x^5 + x^3 + 1, the key schedule of section 4.3 with the RS
// matrix over GF(2^8) modulo x^8 + x^6 + x^3 + x^2 + 1, the function h and
// the expanded key words, and the permutations q0 and q1 of section 4.3.5
// built from their 4-bit tables. One key schedule serves the three key
// lengths of the paper, N = 128, 192 and 256 bits, through the size
// k = N / 64, and every spec that takes the S-box key words takes their
// k as well.
//
// The file reproduces cases of the submission's ecb_tbl set as carried in
// Botan's twofish.vec: KEYSIZE=128 I=1 and I=3 encrypted and I=3
// decrypted, and KEYSIZE=192 and KEYSIZE=256 I=1 encrypted and I=3
// decrypted.
edition 2026;
module twofish {
  // Section 4.3.5: a 4-bit permutation t_i, entry n at index n, one entry
  // per byte; q0 and q1 are each built from four of them, t0 to t3.
  type Nibbles = Word[8]^16;
  type QTables = Nibbles^4;

  // Section 4.2: the 4 x 4 MDS matrix. Section 4.3: the 4 x 8 RS matrix.
  type MdsRow = Word[8]^4;
  type MdsMatrix = MdsRow^4;
  type RsRow = Word[8]^8;
  type RsMatrix = RsRow^4;

  // Section 4.3.5: the tables of q0 and q1 as the paper prints them, the
  // entry for 0 first (t0 of q0 is 8 1 7 D 6 F 3 2 0 B 5 9 E C A 4).
  spec q0_tables() -> QTables {
    [
      hex"08 01 07 0D 06 0F 03 02 00 0B 05 09 0E 0C 0A 04",
      hex"0E 0C 0B 08 01 02 03 05 0F 04 0A 06 07 00 09 0D",
      hex"0B 0A 05 0E 06 0D 09 00 0C 08 0F 03 02 04 07 01",
      hex"0D 07 0F 04 01 02 06 0E 09 0B 03 00 08 05 0C 0A",
    ]
  }

  spec q1_tables() -> QTables {
    [
      hex"02 08 0B 0D 0F 07 06 0E 03 01 09 04 00 0A 0C 05",
      hex"01 0E 02 0B 04 0C 03 07 06 0D 0A 05 0F 09 00 08",
      hex"04 0C 07 05 01 06 09 0A 00 0E 0D 08 02 0B 03 0F",
      hex"0B 09 05 01 0C 03 0D 0E 06 04 07 0F 02 00 08 0A",
    ]
  }

  // Section 4.3.5: ROR4(x, 1), a 4-bit value rotated right by one bit.
  spec ror4(x: Word[8]) -> Word[8] { ((x >> 1) | (x << 3)) & 15 }

  // Section 4.3.5: a byte x through a q permutation. The byte splits into
  // the nibbles a0 (high) and b0 (low); each of two stages forms
  // a' = a xor b and b' = a xor ROR4(b, 1) xor 8a mod 16 and passes the
  // pair through two of the tables t0 to t3; the last pair is reassembled
  // with b high. Nibbles are held in bytes; each table lookup reduces its
  // index mod 16, which the paper's nibbles already are, so that the
  // checker can prove it below 16.
  spec q(t: QTables, x: Word[8]) -> Word[8] {
    let a0: Word[8] = x / 16;
    let b0: Word[8] = x % 16;
    let a1: Word[8] = a0 ^ b0;
    let b1: Word[8] = a0 ^ ror4(b0) ^ ((8 * a0) % 16);
    let a2: Word[8] = t[0][a1 % 16];
    let b2: Word[8] = t[1][b1 % 16];
    let a3: Word[8] = a2 ^ b2;
    let b3: Word[8] = a2 ^ ror4(b2) ^ ((8 * a2) % 16);
    let a4: Word[8] = t[2][a3 % 16];
    let b4: Word[8] = t[3][b3 % 16];
    (16 * b4) + a4
  }

  spec q0(x: Word[8]) -> Word[8] { q(q0_tables(), x) }
  spec q1(x: Word[8]) -> Word[8] { q(q1_tables(), x) }

  // GF(2^8). Twofish uses two representations of the field: the MDS matrix
  // works modulo v(x) = x^8 + x^6 + x^5 + x^3 + 1 = 0x169 (section 4.2) and
  // the RS matrix modulo w(x) = x^8 + x^6 + x^3 + x^2 + 1 = 0x14D (section
  // 4.3). A byte is the polynomial whose coefficients are its bits.

  // Multiplication by x modulo the polynomial p, of degree 8.
  spec times_x(a: Word[8], p: Word[16]) -> Word[8] {
    let t: Word[16] = (a as Word[16]) << 1;
    let r: Word[16] = if (t & 0x100) != 0 { t ^ p } else { t };
    r as Word[8]
  }

  // The product a b modulo p: a x^i added for each bit i of b. The loop
  // carries the sum s and the power m = a x^i; the product is the sum.
  spec gf_mul(a: Word[8], b: Word[8], p: Word[16]) -> Word[8] {
    let r: (Word[8], Word[8]) = for i in 0..8 with (s: Word[8], m: Word[8]) = (0, a) {
      (if ((b >> i) & 1) == 1 { s ^ m } else { s }, times_x(m, p))
    };
    r.0
  }

  // Section 4.2: the MDS matrix, applied over GF(2^8) modulo v(x) to the
  // column (y_0, y_1, y_2, y_3), gives (z_0, z_1, z_2, z_3), and
  // Z = sum of z_i 2^(8i), the bytes read little-endian.
  spec mds_matrix() -> MdsMatrix {
    [hex"01 EF 5B 5B", hex"5B EF EF 01", hex"EF 5B 01 EF", hex"EF 01 EF 5B"]
  }

  spec mds(y: Word[8]^4) -> Word[32] {
    let m: MdsMatrix = mds_matrix();
    let z: Word[8]^4 = for i in 0..4 with z: Word[8]^4 = [0; 4] {
      z with [i] = for j in 0..4 with s: Word[8] = 0 { s ^ gf_mul(m[i][j], y[j], 0x169) }
    };
    z as little Word[32]
  }

  // Section 4.3: the RS matrix, applied over GF(2^8) modulo w(x) to eight
  // key bytes m_(8i) to m_(8i+7), gives the four bytes s_(i,0) to s_(i,3)
  // of the S-box key word S_i = sum of s_(i,j) 2^(8j).
  spec rs_matrix() -> RsMatrix {
    [
      hex"01 A4 55 87 5A 58 DB 9E",
      hex"A4 56 82 F3 1E C6 68 E5",
      hex"02 A1 FC C1 47 AE 3D 19",
      hex"A4 55 87 5A 58 DB 9E 03",
    ]
  }

  spec rs(m: Word[8]^8) -> Word[32] {
    let r: RsMatrix = rs_matrix();
    let s: Word[8]^4 = for i in 0..4 with s: Word[8]^4 = [0; 4] {
      s with [i] = for j in 0..8 with t: Word[8] = 0 { t ^ gf_mul(r[i][j], m[j], 0x14d) }
    };
    s as little Word[32]
  }

  // Section 4.3.2: one stage of h. The four bytes pass through q0 or q1,
  // as the equations of h choose for each byte at the stage of L_i, and
  // are xored with the bytes l_(i,j) of L_i.
  spec stage(i: Int, y: Word[8]^4, l: Word[8]^4) -> Word[8]^4 {
    if i == 3 { [q1(y[0]) ^ l[0], q0(y[1]) ^ l[1], q0(y[2]) ^ l[2], q1(y[3]) ^ l[3]] }
    else if i == 2 { [q1(y[0]) ^ l[0], q1(y[1]) ^ l[1], q0(y[2]) ^ l[2], q0(y[3]) ^ l[3]] }
    else if i == 1 { [q0(y[0]) ^ l[0], q1(y[1]) ^ l[1], q0(y[2]) ^ l[2], q1(y[3]) ^ l[3]] }
    else { [q0(y[0]) ^ l[0], q0(y[1]) ^ l[1], q1(y[2]) ^ l[2], q1(y[3]) ^ l[3]] }
  }

  // Section 4.3.2: the function h(X, L) for a list L = (L_0, ..., L_(k-1)).
  // The bytes x_j of X pass through the stages of L_(k-1) down to L_0 (the
  // stage of L_3 only when k = 4, that of L_2 only when k >= 3, as the
  // paper's definition skips them), then through one more fixed
  // permutation each, q1, q0, q1, q0, and the MDS matrix.
  spec h[k in 2..5](x: Word[32], l: Word[32]^k) -> Word[32] {
    let y: Word[8]^4 = for s in 0..(k) with v: Word[8]^4 = x as little Word[8]^4 {
      stage(k - 1 - s, v, l[k - 1 - s] as little Word[8]^4)
    };
    mds([q1(y[0]), q0(y[1]), q1(y[2]), q0(y[3])])
  }

  // Section 4.3: the key schedule for a key of N = 64 k bits. The key bytes
  // form the words M_0 to M_(2k-1), little-endian; Me = (M_0, M_2, ...)
  // and Mo = (M_1, M_3, ...). S_i is the RS product of key bytes 8i to
  // 8i + 7, and section 4.3 lists them (S_(k-1), ..., S_0), which 4.3.3 gives to g.
  // Section 4.3.4: with rho = 2^24 + 2^16 + 2^8 + 1, A_i = h(2 i rho, Me),
  // B_i = ROL(h((2 i + 1) rho, Mo), 8), K_(2i) = A_i + B_i and
  // K_(2i+1) = ROL(A_i + 2 B_i, 9) for i from 0 through 19. The result is
  // the expanded key words K_0 to K_39 and the S-box key words.
  spec key_schedule[k in 2..5](key: Word[8]^(8 * k)) -> (Word[32]^40, Word[32]^k) {
    let m: Word[32]^(2 * k) = key as little Word[32]^(2 * k);
    let me: Word[32]^k = for i in 0..(k) with e: Word[32]^k = [0; k] { e with [i] = m[2 * i] };
    let mo: Word[32]^k = for i in 0..(k) with o: Word[32]^k = [0; k] {
      o with [i] = m[2 * i + 1]
    };
    let s: Word[32]^k = for i in 0..(k) with t: Word[32]^k = [0; k] {
      t with [k - 1 - i] = rs(key[8 * i..8 * i + 8])
    };
    let rho: Word[32] = 0x01010101;
    let kw: Word[32]^40 = for i in 0..20 with w: Word[32]^40 = [0; 40] {
      let a: Word[32] = h(((2 * i) as Word[32]) * rho, me);
      let b: Word[32] = h(((2 * i + 1) as Word[32]) * rho, mo) <<< 8;
      (w with [2 * i] = a + b) with [2 * i + 1] = (a + 2 * b) <<< 9
    };
    (kw, s)
  }

  // Sections 4.2 and 4.3.3: g(X) = h(X, S), the key-dependent S-boxes
  // applied to the four bytes of X and mixed by the MDS matrix.
  spec g[k in 2..5](x: Word[32], s: Word[32]^k) -> Word[32] { h(x, s) }

  // Section 4.1: the function F of round r, given its subkeys K_(2r+8) and
  // K_(2r+9). T_0 = g(R_0) and T_1 = g(ROL(R_1, 8)); the pseudo-Hadamard
  // transform and the subkeys give F_0 = T_0 + T_1 + K_(2r+8) and
  // F_1 = T_0 + 2 T_1 + K_(2r+9).
  spec f[k in 2..5](
    r0: Word[32], r1: Word[32], s: Word[32]^k, k2r8: Word[32], k2r9: Word[32],
  ) -> (Word[32], Word[32]) {
    let t0: Word[32] = g(r0, s);
    let t1: Word[32] = g(r1 <<< 8, s);
    (t0 + t1 + k2r8, t0 + 2 * t1 + k2r9)
  }

  // Section 4: one round on (R_(r,0), R_(r,1), R_(r,2), R_(r,3)). F of the
  // first two words is xored into the other two, R_(r,2) rotated right by
  // one after the xor and R_(r,3) rotated left by one before it, and the
  // halves swap.
  spec round[k in 2..5](
    r: Word[32]^4, s: Word[32]^k, k2r8: Word[32], k2r9: Word[32],
  ) -> Word[32]^4 {
    let (f0: Word[32], f1: Word[32]) = f(r[0], r[1], s, k2r8, k2r9);
    [(r[2] ^ f0) >>> 1, (r[3] <<< 1) ^ f1, r[0], r[1]]
  }

  // Decryption undoes one round: F is recomputed from the words that were
  // R_(r,0) and R_(r,1), the rotations are taken back, and the halves swap.
  spec inverse_round[k in 2..5](
    r: Word[32]^4, s: Word[32]^k, k2r8: Word[32], k2r9: Word[32],
  ) -> Word[32]^4 {
    let (f0: Word[32], f1: Word[32]) = f(r[2], r[3], s, k2r8, k2r9);
    [r[2], r[3], (r[0] <<< 1) ^ f0, (r[1] ^ f1) >>> 1]
  }

  // Section 4: the plaintext is read as four little-endian words P_i;
  // input whitening R_(0,i) = P_i xor K_i; sixteen rounds with K_8 to K_39;
  // output whitening C_i = R_(16,(i+2) mod 4) xor K_(i+4), which undoes the
  // swap of the last round; the C_i are written back little-endian.
  spec encrypt[k in 2..5](key: Word[8]^(8 * k), p: Word[8]^16) -> Word[8]^16 {
    let (kw: Word[32]^40, s: Word[32]^k) = key_schedule(key);
    let pw: Word[32]^4 = p as little Word[32]^4;
    let r0: Word[32]^4 = for i in 0..4 with w: Word[32]^4 = pw { w with [i] = pw[i] ^ kw[i] };
    let r16: Word[32]^4 = for r in 0..16 with v: Word[32]^4 = r0 {
      round(v, s, kw[2 * r + 8], kw[2 * r + 9])
    };
    let c: Word[32]^4 = for i in 0..4 with w: Word[32]^4 = r16 {
      w with [i] = r16[(i + 2) % 4] ^ kw[i + 4]
    };
    c as little Word[8]^16
  }

  // Decryption: the output whitening removed, the sixteen rounds undone
  // from the last (subkeys K_38, K_39) to the first (K_8, K_9), and the
  // input whitening removed.
  spec decrypt[k in 2..5](key: Word[8]^(8 * k), c: Word[8]^16) -> Word[8]^16 {
    let (kw: Word[32]^40, s: Word[32]^k) = key_schedule(key);
    let cw: Word[32]^4 = c as little Word[32]^4;
    let r16: Word[32]^4 = for i in 0..4 with w: Word[32]^4 = cw {
      w with [(i + 2) % 4] = cw[i] ^ kw[i + 4]
    };
    let r0: Word[32]^4 = for r in 0..16 with v: Word[32]^4 = r16 {
      inverse_round(v, s, kw[38 - 2 * r], kw[39 - 2 * r])
    };
    let pw: Word[32]^4 = for i in 0..4 with w: Word[32]^4 = r0 { w with [i] = r0[i] ^ kw[i] };
    pw as little Word[8]^16
  }

  // The vectors: Botan src/tests/data/block/twofish.vec, which carries the
  // submission's ecb_tbl.txt. In each key size, I=1 is the zero key on the
  // zero block; each later plaintext is the ciphertext before it, and each
  // key the ciphertext before that, padded with zero bytes.

  // Botan twofish.vec, record 1, first block; ecb_tbl.txt KEYSIZE=128, I=1.
  test "ecb_tbl KEYSIZE=128 I=1: encrypt" {
    encrypt([0; 16], [0; 16]) == hex"9F589F5CF6122C32B6BFEC2F2AE8C35A"
  }

  // Botan twofish.vec, record 2; ecb_tbl.txt KEYSIZE=128, I=3: the key is
  // the I=1 ciphertext and the plaintext the I=2 ciphertext.
  test "ecb_tbl KEYSIZE=128 I=3: encrypt" {
    encrypt(hex"9F589F5CF6122C32B6BFEC2F2AE8C35A", hex"D491DB16E7B1C39E86CB086B789F5419")
      == hex"019F9809DE1711858FAAC3A3BA20FBC3"
  }

  // The same case decrypted: the I=3 ciphertext under the I=3 key gives
  // the I=3 plaintext back.
  test "ecb_tbl KEYSIZE=128 I=3: decrypt" {
    decrypt(hex"9F589F5CF6122C32B6BFEC2F2AE8C35A", hex"019F9809DE1711858FAAC3A3BA20FBC3")
      == hex"D491DB16E7B1C39E86CB086B789F5419"
  }

  // Botan twofish.vec, record 49, first block; ecb_tbl.txt KEYSIZE=192, I=1.
  test "ecb_tbl KEYSIZE=192 I=1: encrypt" {
    encrypt([0; 24], [0; 16]) == hex"EFA71F788965BD4453F860178FC19101"
  }

  // Botan twofish.vec, record 50; ecb_tbl.txt KEYSIZE=192, I=3, decrypted:
  // under the I=1 ciphertext followed by 8 zero bytes, the I=3 ciphertext
  // gives back the plaintext, the I=2 ciphertext.
  test "ecb_tbl KEYSIZE=192 I=3: decrypt" {
    let key: Word[8]^24 = hex"EFA71F788965BD4453F860178FC19101" ++ [0; 8];
    decrypt(key, hex"39DA69D6BA4997D585B6DC073CA341B2") == hex"88B2B2706B105E36B446BB6D731A1E88"
  }

  // Botan twofish.vec, record 97, first block; ecb_tbl.txt KEYSIZE=256, I=1.
  test "ecb_tbl KEYSIZE=256 I=1: encrypt" {
    encrypt([0; 32], [0; 16]) == hex"57FF739D4DC92C1BD7FC01700CC8216F"
  }

  // Botan twofish.vec, record 98; ecb_tbl.txt KEYSIZE=256, I=3, decrypted:
  // under the I=1 ciphertext followed by 16 zero bytes, the I=3 ciphertext
  // gives back the plaintext, the I=2 ciphertext.
  test "ecb_tbl KEYSIZE=256 I=3: decrypt" {
    let key: Word[8]^32 = hex"57FF739D4DC92C1BD7FC01700CC8216F" ++ [0; 16];
    decrypt(key, hex"90AFE91BB288544F2C32DC239B2635E6") == hex"D43BB7556EA32E46F2A282B7D45B4E0D"
  }
}
