  // Project Wycheproof, testvectors_v1/hkdf_sha256_test.json, tcId 69: a
  // 32-byte IKM, a salt of exactly 64 bytes (the block size, so it is used
  // as the key without hashing), 20 bytes of info, 42 bytes of output; the
  // okm as printed there (also cryptography's HKDF).
  spec wycheproof_hkdf_tc_69() -> Word[8]^42 {
    let prk: Word[32]^8 = hkdf_extract(
      words_16([
        0xe365c68a, 0x08cc9a36, 0xd6044c5e, 0x108d784e, 0x801da10f, 0x66ae266f, 0xec614d63, 0xc68caf22,
        0x2ba75ac7, 0x699befa2, 0xe9f30303, 0x8d0e2d07, 0xfe3818ff, 0xf864068d, 0x2b714f17, 0x58a5f11d,
      ]), 64,
      words_8([
        0x5e4c5e30, 0x0cd1337f, 0x3b833ce4, 0xd3a0bc13, 0xb5a45757, 0x7e157a94, 0x715b0418, 0x33882fc2,
      ]), 32,
    );
    hkdf_expand_42(prk, words_5([0x496eb608, 0x8ebcfd20, 0xd1611bd1, 0x8ae36ea8, 0xb6a6259e]), 20)
  }
  spec wycheproof_hkdf_tc_69_expected() -> Word[8]^42 {
