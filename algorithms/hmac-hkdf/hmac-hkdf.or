// HMAC with SHA-256 and HKDF, written as their standards write them. HMAC is
// the keyed hash of FIPS 198-1, The Keyed-Hash Message Authentication Code
// (2008, https://doi.org/10.6028/NIST.FIPS.198-1), sections 4 and 5, first
// published as RFC 2104 (1997, https://www.rfc-editor.org/rfc/rfc2104):
// H((K0 xor opad) || H((K0 xor ipad) || text)) with the pads 0x5c and 0x36
// and a key hashed first when it is longer than the block. HKDF is the
// extract-then-expand key derivation of RFC 5869 (2010,
// https://www.rfc-editor.org/rfc/rfc5869), sections 2.2 and 2.3, with HMAC
// as its pseudorandom function. H is the SHA-256 of FIPS 180-4
// (https://doi.org/10.6028/NIST.FIPS.180-4) in the module `sha256`, for
// messages of 1 through 256 bytes.
//
// Byte strings are byte arrays and their lengths are sizes: `k0` takes a
// key of any length from 1 through 256 bytes, `hmac` a text of 1 through
// 192, `hkdf_extract` an IKM of 1 through 192 and `hkdf_expand` an info of
// 1 through 80 bytes and N = 1 through 3 blocks of output.
//
// This file reproduces the seven HMAC-SHA-256 test cases of RFC 4231
// section 4 (https://www.rfc-editor.org/rfc/rfc4231), test case 5 also
// truncated to 128 bits; the PRK and OKM of the three SHA-256 test cases of
// RFC 5869 appendix A; and one HMAC and one HKDF case of Project
// Wycheproof.
edition 2026;
module hmac_hkdf {
  use sha256;

  // FIPS 198-1 section 4: with H = SHA-256 the block size is B = 64 bytes
  // and the output L = 32; ipad is the byte 0x36 and opad the byte 0x5c,
  // each repeated B times.
  spec ipad() -> Word[8]^64 { [0x36; 64] }
  spec opad() -> Word[8]^64 { [0x5c; 64] }

  // FIPS 198-1 section 4, steps 1 to 3: K0, the key K brought to B bytes. A
  // key of B bytes is K0 itself (step 1); a longer key is hashed to L = 32
  // bytes and B - L zeros are appended (step 2); a shorter key has B - K
  // zeros appended (step 3). Steps 1 and 3 are one expression: the key
  // followed by B zeros, cut to its first B bytes. The key length key_len
  // is a size, so the comparison with B is fixed for each instance, and only
  // the chosen branch is evaluated: a short key is never hashed, and a long
  // one is never padded.
  spec k0[key_len in 1..257](key: Word[8]^key_len) -> Word[8]^64 {
    if key_len > 64 { sha256::digest(key) ++ [0; 32] } else {
      let padded: Word[8]^(key_len + 64) = key ++ [0; 64];
      padded[..64]
    }
  }

  // FIPS 198-1 section 4, steps 4 and 7: K0 xor ipad and K0 xor opad, byte
  // by byte.
  spec xor(a: Word[8]^64, b: Word[8]^64) -> Word[8]^64 {
    for i in 0..64 with x: Word[8]^64 = a { x with [i] = a[i] ^ b[i] }
  }

  // FIPS 198-1 section 4, steps 4 to 9:
  // HMAC(K, text) = H((K0 xor opad) || H((K0 xor ipad) || text)).
  // Step 5 appends the text, of n bytes, to the 64-byte inner pad, and step
  // 8 the 32-byte inner hash to the outer pad, a 96-byte message. The key
  // enters as K0 (the parameter k0), from `k0`: a function has at most 256
  // instances, counting every combination of its sizes, and the vectors'
  // keys (4 through 131 bytes) and texts (1 through 152) together need far
  // more, so steps 1 to 3 and steps 4 to 9 are two functions with one size
  // each, and a test writes HMAC(K, text) as `hmac(k0(key), text)`. The
  // full L = 32 bytes are returned; the truncation of section 5 is a slice
  // at the caller.
  spec hmac[text_len in 1..193](k0: Word[8]^64, text: Word[8]^text_len) -> Word[8]^32 {
    let inner: Word[8]^32 = sha256::digest(xor(k0, ipad()) ++ text);
    sha256::digest(xor(k0, opad()) ++ inner)
  }

  // RFC 5869 section 2.2: PRK = HMAC-Hash(salt, IKM), HashLen = 32. The salt
  // is the HMAC key, so it enters as K0, as for `hmac`: the parameter k0 is
  // K0 of the salt, and a caller writes `hkdf_extract(k0(salt), ikm)`.
  spec hkdf_extract[ikm_len in 1..193](k0: Word[8]^64, ikm: Word[8]^ikm_len) -> Word[8]^32 {
    hmac(k0, ikm)
  }

  // RFC 5869 section 2.2: a salt that is not provided is a string of
  // HashLen zeros.
  spec no_salt() -> Word[8]^32 { [0; 32] }

  // RFC 5869 section 2.3: T = T(1) || T(2) || ... || T(N), with T(0) the
  // empty string and T(i) = HMAC-Hash(PRK, T(i-1) || info || i), i a single
  // octet. The loop index j runs from 0 to N - 1, so i = j + 1. The loop
  // carries T and the last block T(i-1); T(0) has no array of its own (an
  // array has at least one element), so the first step, i = 1, hashes
  // info || 0x01 alone, and the 32 zeros that start the carried block are
  // never read. The PRK is the HMAC key, HashLen = 32 bytes, brought to K0
  // once.
  //
  // The output length L is not a size here: a function has at most 256
  // instances, counting every combination of its sizes, and L from 42 to 82
  // beside an info of 1 to 80 bytes would need 3,280. The spec's sizes are
  // N = ceiling(L / HashLen), here nb, and the info length info_len, 240
  // instances; it returns all of T, N HashLen octets, and the caller keeps
  // the first L octets, OKM, with a slice.
  spec hkdf_expand[nb in 1..4, info_len in 1..81](prk: Word[8]^32, info: Word[8]^info_len)
    -> Word[8]^(32 * nb) {
    let key: Word[8]^64 = k0(prk);
    let r: (Word[8]^(32 * nb), Word[8]^32) =
      for j in 0..(nb) with (t: Word[8]^(32 * nb), previous: Word[8]^32) =
        ([0; (32 * nb)], [0; 32]) {
        let counter: Word[8] = j as Word[8];
        let octet: Word[8]^1 = [counter + 1];
        let block: Word[8]^32 = if j == 0 { hmac(key, info ++ octet) }
          else { hmac(key, previous ++ info ++ octet) };
        (t with [32 * j..32 * j + 32] = block, block)
      };
    r.0
  }

  // RFC 5869 section 2.3 with info the zero-length string, which the RFC
  // allows and A.3 uses: T(1) = HMAC-Hash(PRK, 0x01) and
  // T(i) = HMAC-Hash(PRK, T(i-1) || i). An empty info has no array, so this
  // is `hkdf_expand` with info left out; the two loops must stay identical
  // apart from info.
  spec hkdf_expand_no_info[nb in 1..4](prk: Word[8]^32) -> Word[8]^(32 * nb) {
    let key: Word[8]^64 = k0(prk);
    let r: (Word[8]^(32 * nb), Word[8]^32) =
      for j in 0..(nb) with (t: Word[8]^(32 * nb), previous: Word[8]^32) =
        ([0; (32 * nb)], [0; 32]) {
        let counter: Word[8] = j as Word[8];
        let octet: Word[8]^1 = [counter + 1];
        let block: Word[8]^32 = if j == 0 { hmac(key, octet) }
          else { hmac(key, previous ++ octet) };
        (t with [32 * j..32 * j + 32] = block, block)
      };
    r.0
  }

  // RFC 4231 section 4.2, test case 1: key 0x0b repeated 20 times, data
  // "Hi There". The value as printed in Go's crypto/hmac/hmac_test.go,
  // which copies the RFC's SHA-256 cases (also Python's hmac).
  test "RFC 4231 4.2: test case 1" {
    hmac(k0([0x0b; 20]), "Hi There") ==
      hex"b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"
  }

  // RFC 4231 section 4.3, test case 2: key "Jefe", data "what do ya want
  // for nothing?"; a key shorter than the block. The value as printed in
  // Botan's hmac.vec, [HMAC(SHA-256)], and Go's hmac_test.go (also
  // Python's hmac).
  test "RFC 4231 4.3: test case 2" {
    hmac(k0("Jefe"), "what do ya want for nothing?") ==
      hex"5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
  }

  // RFC 4231 section 4.4, test case 3: key 0xaa repeated 20 times, data
  // 0xdd repeated 50 times. The value as printed in Go's hmac_test.go
  // (also Python's hmac).
  test "RFC 4231 4.4: test case 3" {
    hmac(k0([0xaa; 20]), [0xdd; 50]) ==
      hex"773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe"
  }

  // RFC 4231 section 4.5, test case 4: key 0x01, 0x02, ..., 0x19 (25
  // bytes), data 0xcd repeated 50 times. The value as printed in Go's
  // hmac_test.go (also Python's hmac).
  test "RFC 4231 4.5: test case 4" {
    hmac(k0(hex"0102030405060708090a0b0c0d0e0f10111213141516171819"), [0xcd; 50]) ==
      hex"82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b"
  }

  // RFC 4231 section 4.6, test case 5: key 0x0c repeated 20 times, data
  // "Test With Truncation"; the RFC prints only the MAC truncated to 128
  // bits. No fetched file carries this case, so the full MAC is from
  // Python's hmac; the RFC's printed value is its first 16 bytes.
  test "RFC 4231 4.6: test case 5, the full MAC" {
    hmac(k0([0x0c; 20]), "Test With Truncation") ==
      hex"a3b6167473100ee06e0c796c2955552bfa6f7c0a6a8aef8b93f860aab0cd20c5"
  }

  // RFC 4231 section 4.6, test case 5 as the RFC prints it: the truncated
  // output of FIPS 198-1 section 5 and RFC 2104 section 5, the leftmost
  // t = 128 bits of the MAC, which RFC 4231 calls a truncation of output.
  test "RFC 4231 4.6: test case 5, truncated to 128 bits" {
    hmac(k0([0x0c; 20]), "Test With Truncation")[..16] ==
      hex"a3b6167473100ee06e0c796c2955552b"
  }

  // RFC 4231 section 4.7, test case 6: key 0xaa repeated 131 times, longer
  // than the block, so it is hashed first; data "Test Using Larger Than
  // Block-Size Key - Hash Key First". The value as printed in Botan's
  // hmac.vec and Go's hmac_test.go (also Python's hmac).
  test "RFC 4231 4.7: test case 6" {
    hmac(k0([0xaa; 131]), "Test Using Larger Than Block-Size Key - Hash Key First") ==
      hex"60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"
  }

  // RFC 4231 section 4.8, test case 7: the same 131-byte key and 152 bytes
  // of data. The value as printed in Botan's hmac.vec and Go's hmac_test.go
  // (also Python's hmac).
  test "RFC 4231 4.8: test case 7" {
    let data: Word[8]^152 =
      "This is a test using a larger than block-size key and a larger than " ++
      "block-size data. The key needs to be hashed before being used by the " ++
      "HMAC algorithm.";
    hmac(k0([0xaa; 131]), data) ==
      hex"9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2"
  }

  // Project Wycheproof, testvectors_v1/hmac_sha256_test.json, tcId 171,
  // "long key": a 65-byte key, one byte over the block, and a 32-byte
  // message; the tag as printed there (also Python's hmac).
  test "Wycheproof hmac_sha256_test tcId 171" {
    let key: Word[8]^65 =
      hex"21178e26bc28ffc27c06f762ba190a627075856d7ca6feab79ac63149b17126e" ++
      hex"34fd9e5590e0e90aac801df09505d8af2dd0a2703b352c573ac9d2cb063927f2" ++
      hex"af";
    let msg: Word[8]^32 =
      hex"7d5f1d6b993452b1b53a4375760d10a20d46a0ab9ec3943fc4b07a2ce735e731";
    hmac(k0(key), msg) ==
      hex"e542ac8ac8f364bae4b7da8b7a0777df350f001de4e8cfa2d9ef0b15019496ec"
  }

  // Project Wycheproof, testvectors_v1/hkdf_sha256_test.json, tcId 69: a
  // 32-byte IKM, a salt of exactly 64 bytes (the block size, so it is used
  // as the key without hashing), 20 bytes of info, L = 42 (N = 2); the okm
  // as printed there (also cryptography's HKDF).
  test "Wycheproof hkdf_sha256_test tcId 69" {
    let ikm: Word[8]^32 =
      hex"5e4c5e300cd1337f3b833ce4d3a0bc13b5a457577e157a94715b041833882fc2";
    let salt: Word[8]^64 =
      hex"e365c68a08cc9a36d6044c5e108d784e801da10f66ae266fec614d63c68caf22" ++
      hex"2ba75ac7699befa2e9f303038d0e2d07fe3818fff864068d2b714f1758a5f11d";
    let info: Word[8]^20 = hex"496eb6088ebcfd20d1611bd18ae36ea8b6a6259e";
    let prk: Word[8]^32 = hkdf_extract(k0(salt), ikm);
    hkdf_expand[2, 20](prk, info)[..42] == (
      hex"c176a8a149a593bc9a11f25a0c41ad120ce3a0aa3eb759fbfcee09ade53e4e29" ++
      hex"92776ffc5a3353a05c4b"
    )
  }

  // RFC 5869 appendix A.1, test case 1: IKM 0x0b repeated 22 times, salt
  // 0x00 to 0x0c, info 0xf0 to 0xf9, L = 42 (N = 2). PRK as printed in
  // Botan's hkdf.vec, [HKDF-Extract(HMAC(SHA-256))], OpenSSL's
  // evpkdf_hkdf.txt and pyca/cryptography's rfc-5869-HKDF-SHA256.txt (also
  // Python's hmac); OKM as printed in the same three files, Botan's under
  // [HKDF(HMAC(SHA-256))], and in Wycheproof's hkdf_sha256_test.json tcId 1
  // (also cryptography's HKDF).
  test "RFC 5869 A.1: PRK" {
    hkdf_extract(k0(hex"000102030405060708090a0b0c"), [0x0b; 22]) ==
      hex"077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"
  }

  test "RFC 5869 A.1: OKM" {
    let prk: Word[8]^32 = hkdf_extract(k0(hex"000102030405060708090a0b0c"), [0x0b; 22]);
    hkdf_expand[2, 10](prk, hex"f0f1f2f3f4f5f6f7f8f9")[..42] == (
      hex"3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf" ++
      hex"34007208d5b887185865"
    )
  }

  // RFC 5869 appendix A.2, test case 2: IKM 0x00 to 0x4f, salt 0x60 to
  // 0xaf and info 0xb0 to 0xff, 80 bytes each, L = 82. The salt is longer
  // than the block, so HMAC hashes it first, and N = 3. PRK and OKM from
  // the same files as A.1 (Wycheproof tcId 3).
  test "RFC 5869 A.2: PRK" {
    let ikm: Word[8]^80 =
      hex"000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f" ++
      hex"202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f" ++
      hex"404142434445464748494a4b4c4d4e4f";
    let salt: Word[8]^80 =
      hex"606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f" ++
      hex"808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f" ++
      hex"a0a1a2a3a4a5a6a7a8a9aaabacadaeaf";
    hkdf_extract(k0(salt), ikm) ==
      hex"06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244"
  }

  test "RFC 5869 A.2: OKM" {
    let ikm: Word[8]^80 =
      hex"000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f" ++
      hex"202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f" ++
      hex"404142434445464748494a4b4c4d4e4f";
    let salt: Word[8]^80 =
      hex"606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f" ++
      hex"808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f" ++
      hex"a0a1a2a3a4a5a6a7a8a9aaabacadaeaf";
    let info: Word[8]^80 =
      hex"b0b1b2b3b4b5b6b7b8b9babbbcbdbebfc0c1c2c3c4c5c6c7c8c9cacbcccdcecf" ++
      hex"d0d1d2d3d4d5d6d7d8d9dadbdcdddedfe0e1e2e3e4e5e6e7e8e9eaebecedeeef" ++
      hex"f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff";
    let prk: Word[8]^32 = hkdf_extract(k0(salt), ikm);
    hkdf_expand[3, 80](prk, info)[..82] == (
      hex"b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c" ++
      hex"59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71" ++
      hex"cc30c58179ec3e87c14c01d5c1f3434f1d87"
    )
  }

  // RFC 5869 appendix A.3, test case 3: the IKM of A.1 with the salt and
  // info both zero-length, L = 42; the salt is not provided, so it is
  // HashLen zeros, and the info is left out. PRK and OKM from the same files
  // as A.1 (Wycheproof tcId 2).
  test "RFC 5869 A.3: PRK" {
    hkdf_extract(k0(no_salt()), [0x0b; 22]) ==
      hex"19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04"
  }

  test "RFC 5869 A.3: OKM" {
    let prk: Word[8]^32 = hkdf_extract(k0(no_salt()), [0x0b; 22]);
    hkdf_expand_no_info[2](prk)[..42] == (
      hex"8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d" ++
      hex"9d201395faa4b61a96c8"
    )
  }
}
