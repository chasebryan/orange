      0x60e43159, 0x1ee0b67f, 0x0d8a26aa, 0xcbf5b77f, 0x8e0bc621, 0x3728c514, 0x0546040f, 0x0ee37f54,
    ]
  }

  // RFC 4231 section 4.8, test case 7: the same 131-byte key and 152 bytes
