  // RFC 8439 appendix A.3, test vector 1: the zero key over 64 zero bytes; r =
  // 0 and s = 0 give the zero tag.
  spec rfc8439_a3_1() -> Word[8]^16 {
    let msg: Word[8]^64 = [0; 64];
    let key: Word[8]^32 = [0; 32];
    let buffer: Word[8]^256 = for i in 0..64 with m: Word[8]^256 = [0; 256] {
      m with [i] = msg[i]
    };
    poly1305_mac(buffer, 64, key)
  }

  spec rfc8439_a3_1_expected() -> Word[8]^16 { [0; 16] }

  // RFC 8439 appendix A.3, test vector 2: r = 0 over the 375-byte text; the
  // tag is s.
  spec rfc8439_a3_2() -> Word[8]^16 {
    let key: Word[8]^32 = [
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x36, 0xe5, 0xf6, 0xb5, 0xc5, 0xe0, 0x60, 0x70, 0xf0, 0xef, 0xca, 0x96, 0x22, 0x7a, 0x86, 0x3e,
    ];
    let text: Word[8]^119 = ietf_text_tail();
    let tail: Word[8]^256 = for i in 0..119 with m: Word[8]^256 = [0; 256] {
      m with [i] = text[i]
    };
    poly1305_mac_long(ietf_text_head(), tail, 375, key)
  }

  spec rfc8439_a3_2_expected() -> Word[8]^16 {
    [
      0x36, 0xe5, 0xf6, 0xb5, 0xc5, 0xe0, 0x60, 0x70, 0xf0, 0xef, 0xca, 0x96, 0x22, 0x7a, 0x86, 0x3e,
    ]
  }

  // RFC 8439 appendix A.3, test vector 3: the same text under r = 36e5f6b5...
  // (before clamping) and s = 0; the tag is the reduced polynomial alone.
  spec rfc8439_a3_3() -> Word[8]^16 {
    let key: Word[8]^32 = [
      0x36, 0xe5, 0xf6, 0xb5, 0xc5, 0xe0, 0x60, 0x70, 0xf0, 0xef, 0xca, 0x96, 0x22, 0x7a, 0x86, 0x3e,
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    ];
    let text: Word[8]^119 = ietf_text_tail();
    let tail: Word[8]^256 = for i in 0..119 with m: Word[8]^256 = [0; 256] {
      m with [i] = text[i]
    };
    poly1305_mac_long(ietf_text_head(), tail, 375, key)
  }

  spec rfc8439_a3_3_expected() -> Word[8]^16 {
