    poly1305_mac(buffer, 48, key)
  }

  spec rfc8439_a3_8_expected() -> Word[8]^16 { [0; 16] }

  // RFC 8439 appendix A.3, test vector 9: r = 2, s = 0 and one block whose
  // doubled number is p - 1; the tag is its low 128 bits, fa ff ... ff.
  spec rfc8439_a3_9() -> Word[8]^16 {
    let msg: Word[8]^16 = [
      0xfd, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
