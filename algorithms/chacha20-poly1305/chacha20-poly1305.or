  // RFC 8439 appendix A.3, test vector 5: r = 2, s = 0 and one block of 0xff
  // bytes, whose number 2^129 - 1 doubled is 2^130 - 2, which reduces to 3.
  spec rfc8439_a3_5() -> Word[8]^16 {
    let msg: Word[8]^16 = [0xff; 16];
    let key: Word[8]^32 = [0; 32] with [0] = 0x02;
    let buffer: Word[8]^256 = for i in 0..16 with m: Word[8]^256 = [0; 256] {
      m with [i] = msg[i]
    };
    poly1305_mac(buffer, 16, key)
  }

  spec rfc8439_a3_5_expected() -> Word[8]^16 { [0; 16] with [0] = 0x03 }

  // RFC 8439 appendix A.3, test vector 6: r = 2, s = 2^128 - 1 and one block
  // whose number is 2^128 + 2; a + s is 3 * 2^128 + 3 and only its low 128
  // bits are kept.
  spec rfc8439_a3_6() -> Word[8]^16 {
    let msg: Word[8]^16 = [0; 16] with [0] = 0x02;
    let key: Word[8]^32 = [
      0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    ];
    let buffer: Word[8]^256 = for i in 0..16 with m: Word[8]^256 = [0; 256] {
      m with [i] = msg[i]
    };
    poly1305_mac(buffer, 16, key)
  }

  spec rfc8439_a3_6_expected() -> Word[8]^16 { [0; 16] with [0] = 0x03 }

  // RFC 8439 appendix A.3, test vector 7: r = 1, s = 0 and three blocks whose
  // running sum passes p; the final accumulator 2^128 + 5 is truncated to 5.
  spec rfc8439_a3_7() -> Word[8]^16 {
    let msg: Word[8]^48 = [
      0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
      0xf0, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
      0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
