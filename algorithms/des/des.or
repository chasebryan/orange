// DES and Triple DES. The Data Encryption Algorithm of FIPS 46-3, "Data
// Encryption Standard (DES)" (NIST, 1999; withdrawn 2005),
// https://csrc.nist.gov/pubs/fips/46-3/final, written as the standard writes
// it: the initial permutation IP and its inverse, the sixteen iterations of
// the cipher function f with the bit-selection table E, the selection
// functions S1 through S8 and the permutation P, and the key schedule KS with
// PC-1, PC-2 and the schedule of left shifts, every permutation a table of
// the standard's own bit numbers and every S-box its table of four rows and
// sixteen columns. On it, the Triple Data Encryption Algorithm of NIST
// SP 800-67 rev. 2, "Recommendation for the Triple Data Encryption Algorithm
// (TDEA) Block Cipher" (2017), https://doi.org/10.6028/NIST.SP.800-67r2,
// section 3: the forward transformation E_K3(D_K2(E_K1(I))), the inverse
// D_K1(E_K2(D_K3(I))), and keying options 1 (three independent keys) and 2
// (K3 = K1).
//
// The file reproduces the SP 800-67 rev. 2 Appendix B example, the
// single-DES and TDEA cases of Botan's des.vec, three DES-ECB cases of
// OpenSSL's evpciph_des.txt, the DES-EDE3-ECB and DES-EDE-ECB cases of
// OpenSSL's evpciph_des3_common.txt, the complementation property on a
// Botan case, and the involution under a weak key: thirteen vectors in all.
// FIPS 46-3 does not number the sections of its body; the comments name its
// headings.
edition 2026;
module des {
  // The selection functions: an S-box is four rows of sixteen four-bit
  // entries, and S1 through S8 are eight of them.
  type Row = Word[8]^16;
  type SBox = Row^4;
  type SBoxes = SBox^8;

  // FIPS 46-3 numbers the bits of a block 1 through 64 from the left, and
  // every permutation of the standard is a table of those numbers: bit i of
  // the output is the bit of the input that entry i names. Here a block of w
  // bits is a word holding them in its low w bits, bit 1 the most
  // significant, so bit n of the input is (x >> (w - n)) & 1, and the output
  // is built from its bit 1 down. The same spec serves the permutations IP,
  // IP^-1 and P, the bit-selection table E (48 entries over 32 bits, some
  // named twice) and the permuted choices PC-1 and PC-2 (56 of 64 bits and 48
  // of 56).
  spec permute[n in 32..65](t: Word[8]^n, x: Word[64], w: Int) -> Word[64] {
    for i in 0..(n) with out: Word[64] = 0 { (out << 1) | ((x >> (w - (t[i] as Int))) & 1) }
  }

  // Enciphering: the initial permutation IP, in the standard's eight rows;
  // bit 1 of the permuted block is bit 58 of the input.
  spec initial_permutation() -> Word[8]^64 {
    [
      58, 50, 42, 34, 26, 18, 10,  2,
      60, 52, 44, 36, 28, 20, 12,  4,
      62, 54, 46, 38, 30, 22, 14,  6,
      64, 56, 48, 40, 32, 24, 16,  8,
      57, 49, 41, 33, 25, 17,  9,  1,
      59, 51, 43, 35, 27, 19, 11,  3,
      61, 53, 45, 37, 29, 21, 13,  5,
      63, 55, 47, 39, 31, 23, 15,  7,
    ]
  }

  // Enciphering: the inverse initial permutation IP^-1, applied to the
  // preoutput block R16 L16.
  spec inverse_initial_permutation() -> Word[8]^64 {
    [
      40,  8, 48, 16, 56, 24, 64, 32,
      39,  7, 47, 15, 55, 23, 63, 31,
      38,  6, 46, 14, 54, 22, 62, 30,
      37,  5, 45, 13, 53, 21, 61, 29,
      36,  4, 44, 12, 52, 20, 60, 28,
      35,  3, 43, 11, 51, 19, 59, 27,
      34,  2, 42, 10, 50, 18, 58, 26,
      33,  1, 41,  9, 49, 17, 57, 25,
    ]
  }

  // The Cipher Function f: the bit-selection table E takes the 32 bits of R
  // to 48, each row of four becoming a row of six that borrows the bit on
  // either side.
  spec bit_selection() -> Word[8]^48 {
    [
      32,  1,  2,  3,  4,  5,
       4,  5,  6,  7,  8,  9,
       8,  9, 10, 11, 12, 13,
      12, 13, 14, 15, 16, 17,
      16, 17, 18, 19, 20, 21,
      20, 21, 22, 23, 24, 25,
      24, 25, 26, 27, 28, 29,
      28, 29, 30, 31, 32,  1,
    ]
  }

  // The Cipher Function f: the permutation function P.
  spec permutation() -> Word[8]^32 {
    [
      16,  7, 20, 21,
      29, 12, 28, 17,
       1, 15, 23, 26,
       5, 18, 31, 10,
       2,  8, 24, 14,
      32, 27,  3,  9,
      19, 13, 30,  6,
      22, 11,  4, 25,
    ]
  }

  // The Cipher Function f, and Appendix 1 (Primitive Functions for the Data
  // Encryption Algorithm): the selection functions S1 through S8, each the
  // standard's table, row 0 first and column 0 leftmost.
  spec s1() -> SBox {
    [
      [14,  4, 13,  1,  2, 15, 11,  8,  3, 10,  6, 12,  5,  9,  0,  7],
      [ 0, 15,  7,  4, 14,  2, 13,  1, 10,  6, 12, 11,  9,  5,  3,  8],
      [ 4,  1, 14,  8, 13,  6,  2, 11, 15, 12,  9,  7,  3, 10,  5,  0],
      [15, 12,  8,  2,  4,  9,  1,  7,  5, 11,  3, 14, 10,  0,  6, 13],
    ]
  }

  spec s2() -> SBox {
    [
      [15,  1,  8, 14,  6, 11,  3,  4,  9,  7,  2, 13, 12,  0,  5, 10],
      [ 3, 13,  4,  7, 15,  2,  8, 14, 12,  0,  1, 10,  6,  9, 11,  5],
      [ 0, 14,  7, 11, 10,  4, 13,  1,  5,  8, 12,  6,  9,  3,  2, 15],
      [13,  8, 10,  1,  3, 15,  4,  2, 11,  6,  7, 12,  0,  5, 14,  9],
    ]
  }

  spec s3() -> SBox {
    [
      [10,  0,  9, 14,  6,  3, 15,  5,  1, 13, 12,  7, 11,  4,  2,  8],
      [13,  7,  0,  9,  3,  4,  6, 10,  2,  8,  5, 14, 12, 11, 15,  1],
      [13,  6,  4,  9,  8, 15,  3,  0, 11,  1,  2, 12,  5, 10, 14,  7],
      [ 1, 10, 13,  0,  6,  9,  8,  7,  4, 15, 14,  3, 11,  5,  2, 12],
    ]
  }

  spec s4() -> SBox {
    [
      [ 7, 13, 14,  3,  0,  6,  9, 10,  1,  2,  8,  5, 11, 12,  4, 15],
      [13,  8, 11,  5,  6, 15,  0,  3,  4,  7,  2, 12,  1, 10, 14,  9],
      [10,  6,  9,  0, 12, 11,  7, 13, 15,  1,  3, 14,  5,  2,  8,  4],
      [ 3, 15,  0,  6, 10,  1, 13,  8,  9,  4,  5, 11, 12,  7,  2, 14],
    ]
  }

  spec s5() -> SBox {
    [
      [ 2, 12,  4,  1,  7, 10, 11,  6,  8,  5,  3, 15, 13,  0, 14,  9],
      [14, 11,  2, 12,  4,  7, 13,  1,  5,  0, 15, 10,  3,  9,  8,  6],
      [ 4,  2,  1, 11, 10, 13,  7,  8, 15,  9, 12,  5,  6,  3,  0, 14],
      [11,  8, 12,  7,  1, 14,  2, 13,  6, 15,  0,  9, 10,  4,  5,  3],
    ]
  }

  spec s6() -> SBox {
    [
      [12,  1, 10, 15,  9,  2,  6,  8,  0, 13,  3,  4, 14,  7,  5, 11],
      [10, 15,  4,  2,  7, 12,  9,  5,  6,  1, 13, 14,  0, 11,  3,  8],
      [ 9, 14, 15,  5,  2,  8, 12,  3,  7,  0,  4, 10,  1, 13, 11,  6],
      [ 4,  3,  2, 12,  9,  5, 15, 10, 11, 14,  1,  7,  6,  0,  8, 13],
    ]
  }

  spec s7() -> SBox {
    [
      [ 4, 11,  2, 14, 15,  0,  8, 13,  3, 12,  9,  7,  5, 10,  6,  1],
      [13,  0, 11,  7,  4,  9,  1, 10, 14,  3,  5, 12,  2, 15,  8,  6],
      [ 1,  4, 11, 13, 12,  3,  7, 14, 10, 15,  6,  8,  0,  5,  9,  2],
      [ 6, 11, 13,  8,  1,  4, 10,  7,  9,  5,  0, 15, 14,  2,  3, 12],
    ]
  }

  spec s8() -> SBox {
    [
      [13,  2,  8,  4,  6, 15, 11,  1, 10,  9,  3, 14,  5,  0, 12,  7],
      [ 1, 15, 13,  8, 10,  3,  7,  4, 12,  5,  6, 11,  0, 14,  9,  2],
      [ 7, 11,  4,  1,  9, 12, 14,  2,  0,  6, 10, 13, 15,  3,  5,  8],
      [ 2,  1, 14,  7,  4, 10,  8, 13, 15, 12,  9,  0,  3,  5,  6, 11],
    ]
  }

  spec selection_functions() -> SBoxes { [s1(), s2(), s3(), s4(), s5(), s6(), s7(), s8()] }

  // The Cipher Function f: f(R, K) = P(S1(B1) S2(B2) ... S8(B8)), where
  // B1 B2 ... B8 = K xor E(R), each B_j six bits b1 b2 b3 b4 b5 b6. The first
  // and last bits, b1 b6, name the row of S_j, and the middle four,
  // b2 b3 b4 b5, the column; the entry's four bits follow those of S_(j-1).
  // The masks & 3 and & 15 at the lookup change no value: row and column
  // are already that small, and the masks show the checker so.
  spec f(s: SBoxes, r: Word[32], k: Word[64]) -> Word[32] {
    let b: Word[64] = k ^ permute(bit_selection(), r as Word[64], 32);
    let out: Word[32] = for j in 0..8 with out: Word[32] = 0 {
      let bj: Word[64] = (b >> (42 - (6 * j))) & 63;
      let row: Word[8] = (((bj >> 4) & 2) | (bj & 1)) as Word[8];
      let column: Word[8] = ((bj >> 1) & 15) as Word[8];
      (out << 4) | (s[j][row & 3][column & 15] as Word[32])
    };
    permute(permutation(), out as Word[64], 32) as Word[32]
  }

  // Key Schedule Calculation: PC-1 takes the 64-bit KEY to C0 (its first 28
  // outputs) and D0 (the last 28), passing over the parity bits 8, 16, ...,
  // 64, which no row of the table names.
  spec permuted_choice_1() -> Word[8]^56 {
    [
      57, 49, 41, 33, 25, 17,  9,
       1, 58, 50, 42, 34, 26, 18,
      10,  2, 59, 51, 43, 35, 27,
      19, 11,  3, 60, 52, 44, 36,
      63, 55, 47, 39, 31, 23, 15,
       7, 62, 54, 46, 38, 30, 22,
      14,  6, 61, 53, 45, 37, 29,
      21, 13,  5, 28, 20, 12,  4,
    ]
  }

  // Key Schedule Calculation: PC-2 selects the 48 bits of K_n from the 56
  // bits of C_n D_n.
  spec permuted_choice_2() -> Word[8]^48 {
    [
      14, 17, 11, 24,  1,  5,
       3, 28, 15,  6, 21, 10,
      23, 19, 12,  4, 26,  8,
      16,  7, 27, 20, 13,  2,
      41, 52, 31, 37, 47, 55,
      30, 40, 51, 45, 33, 48,
      44, 49, 39, 56, 34, 53,
      46, 42, 50, 36, 29, 32,
    ]
  }

  // Key Schedule Calculation: the schedule of left shifts, the number of
  // places C and D turn at iterations 1 through 16.
  spec left_shifts() -> Int^16 { [1, 1, 2, 2, 2, 2, 2, 2, 1, 2, 2, 2, 2, 2, 2, 1] }

  // LS_n: a circular left shift of a 28-bit block by one or two places.
  spec left_shift(c: Word[64], places: Int) -> Word[64] {
    ((c << places) | (c >> (28 - places))) & 0x0fffffff
  }

  // KS(n, KEY): the sixteen 48-bit subkeys K1 through K16 of a 64-bit KEY
  // (56 key bits and eight parity bits, which PC-1 drops). C_n = LS_n(C_{n-1}),
  // D_n = LS_n(D_{n-1}), and K_n = PC-2(C_n D_n), stored at position n - 1.
  spec key_schedule(key: Word[8]^8) -> Word[64]^16 {
    let cd0: Word[64] = permute(permuted_choice_1(), key as big Word[64], 64);
    let shifts: Int^16 = left_shifts();
    let ks: (Word[64], Word[64], Word[64]^16) =
      for n in 0..16 with (c: Word[64], d: Word[64], k: Word[64]^16) =
        (cd0 >> 28, cd0 & 0x0fffffff, [0; 16]) {
        let cn: Word[64] = left_shift(c, shifts[n]);
        let dn: Word[64] = left_shift(d, shifts[n]);
        (cn, dn, k with [n] = permute(permuted_choice_2(), (cn << 28) | dn, 56))
      };
    ks.2
  }

  // Enciphering: IP; sixteen iterations on L R, L_n = R_{n-1} and
  // R_n = L_{n-1} xor f(R_{n-1}, K_n); the preoutput block R16 L16, the halves
  // exchanged once after the last iteration; and IP^-1. The block is read
  // as a 64-bit word, bit 1 its most significant, and L and R are the two
  // halves of the permuted word, read big-endian.
  spec dea(ks: Word[64]^16, input: Word[8]^8) -> Word[8]^8 {
    let s: SBoxes = selection_functions();
    let lr0: Word[32]^2 =
      permute(initial_permutation(), input as big Word[64], 64) as big Word[32]^2;
    let lr16: Word[32]^2 = for n in 0..16 with lr: Word[32]^2 = lr0 {
      [lr[1], lr[0] ^ f(s, lr[1], ks[n])]
    };
    let preoutput: Word[32]^2 = [lr16[1], lr16[0]];
    permute(inverse_initial_permutation(), preoutput as big Word[64], 64) as big Word[8]^8
  }

  // Deciphering: the same algorithm with the subkeys taken in the reverse
  // order, K16 at the first iteration and K1 at the last.
  spec reversed_schedule(ks: Word[64]^16) -> Word[64]^16 {
    for n in 0..16 with r: Word[64]^16 = ks { r with [n] = ks[15 - n] }
  }

  spec encrypt(key: Word[8]^8, block: Word[8]^8) -> Word[8]^8 { dea(key_schedule(key), block) }

  spec decrypt(key: Word[8]^8, block: Word[8]^8) -> Word[8]^8 {
    dea(reversed_schedule(key_schedule(key)), block)
  }

  // SP 800-67 rev. 2, section 3: the TDEA forward transformation of a block
  // I under the key bundle (K1, K2, K3), O = E_K3(D_K2(E_K1(I))), and the
  // inverse transformation O = D_K1(E_K2(D_K3(I))). Keying option 1 is three
  // independent keys; keying option 2 is K3 = K1, and is written here by
  // passing K1 again as the third key.
  spec tdea_encrypt(k1: Word[8]^8, k2: Word[8]^8, k3: Word[8]^8, block: Word[8]^8) -> Word[8]^8 {
    encrypt(k3, decrypt(k2, encrypt(k1, block)))
  }

  spec tdea_decrypt(k1: Word[8]^8, k2: Word[8]^8, k3: Word[8]^8, block: Word[8]^8) -> Word[8]^8 {
    decrypt(k1, encrypt(k2, decrypt(k3, block)))
  }

  // SP 800-67 rev. 2, Appendix B, applies the forward transformation to
  // consecutive blocks (the ECB mode of SP 800-38A): here n blocks of eight
  // bytes, n from 1 through 3. Each key's schedule is computed once for all
  // the blocks.
  spec tdea_encrypt_ecb[n in 1..4](
    k1: Word[8]^8, k2: Word[8]^8, k3: Word[8]^8, m: Word[8]^(8 * n),
  ) -> Word[8]^(8 * n) {
    let ks1: Word[64]^16 = key_schedule(k1);
    let ks2: Word[64]^16 = reversed_schedule(key_schedule(k2));
    let ks3: Word[64]^16 = key_schedule(k3);
    for i in 0..(n) with c: Word[8]^(8 * n) = m {
      c with [8 * i..8 * i + 8] = dea(ks3, dea(ks2, dea(ks1, m[8 * i..8 * i + 8])))
    }
  }

  // The vectors. Keys, blocks and expected values are written in hex as the
  // sources print them.

  // SP 800-67 rev. 2, Appendix B: the three blocks of "The qufck brown fox
  // jump" (the standard's own spelling) under Key1 = 0123456789abcdef,
  // Key2 = 23456789abcdef01, Key3 = 456789abcdef0123, in ECB. The expected
  // value is pycryptodome DES3's, confirmed by the cryptography package.
  test "SP 800-67r2 Appendix B: three-key TDEA of three blocks in ECB" {
    tdea_encrypt_ecb(
      hex"0123456789abcdef", hex"23456789abcdef01", hex"456789abcdef0123",
      "The qufck brown fox jump",
    ) == hex"a826fd8ce53b855f cce21c8112256fe6 68d5c05dd9b6b900"
  }

  // Botan src/tests/data/block/des.vec, section [DES], second case (lines 6
  // to 8): the key 0123456789abcdef and the block "Now is t", the first block
  // of the FIPS 81 example message "Now is the time for all ".
  test "Botan des.vec [DES] case 2: DES encrypts" {
    encrypt(hex"0123456789abcdef", hex"4e6f772069732074") == hex"3fa40e8a984d4815"
  }

  // Botan des.vec, section [DES], first case (lines 2 to 4), decrypted: the
  // ciphertext under the key gives the case's input block.
  test "Botan des.vec [DES] case 1: DES decrypts" {
    decrypt(hex"0113b970fd34f2ce", hex"86a560f10ec6d85b") == hex"059b5e0851cf143a"
  }

  // OpenSSL test/recipes/30-test_evp_data/evpciph_des.txt, DES-ECB case 1
  // (lines 12 to 15).
  test "OpenSSL evpciph_des.txt DES-ECB case 1" {
    encrypt(hex"0000000000000000", hex"0000000000000000") == hex"8ca64de9c1b123a7"
  }

  // OpenSSL evpciph_des.txt, DES-ECB case 2 (lines 18 to 21).
  test "OpenSSL evpciph_des.txt DES-ECB case 2" {
    encrypt(hex"ffffffffffffffff", hex"ffffffffffffffff") == hex"7359b2163e4edc58"
  }

  // OpenSSL evpciph_des.txt, DES-ECB case 7 (lines 48 to 51).
  test "OpenSSL evpciph_des.txt DES-ECB case 7" {
    encrypt(hex"fedcba9876543210", hex"0123456789abcdef") == hex"ed39d950fa74bcc4"
  }

  // The complementation property DES(~K, ~P) = ~DES(K, P) on Botan des.vec,
  // [DES], second case (lines 6 to 8): the complemented key and block; the
  // expected value is the complement of the case's output, and pycryptodome
  // confirms it.
  test "Botan des.vec [DES] case 2 complemented: the complementation property" {
    encrypt(hex"fedcba9876543210", hex"b19088df968cdf8b") == hex"c05bf17567b2b7ea"
  }

  // The weak key K = 0101010101010101 (FIPS 74; SP 800-67 rev. 2): C0 and D0
  // are all zero, the sixteen subkeys are equal, and enciphering twice gives
  // the block back. The block is that of Botan des.vec, [DES], second case,
  // "Now is t"; pycryptodome confirms the involution.
  test "Weak key 0101010101010101: enciphering twice is the identity" {
    let k: Word[8]^8 = hex"0101010101010101";
    encrypt(k, encrypt(k, hex"4e6f772069732074")) == hex"4e6f772069732074"
  }

  // Botan des.vec, section [TripleDES], first case (lines 1036 to 1038): a
  // two-key bundle (keying option 2), K1 = 0123456789abcdef,
  // K2 = fedcba9876543210, K3 = K1.
  test "Botan des.vec [TripleDES] case 1: two-key TDEA encrypts" {
    tdea_encrypt(
      hex"0123456789abcdef", hex"fedcba9876543210", hex"0123456789abcdef",
      hex"0123456789abcde7",
    ) == hex"7f1d0a77826b8aff"
  }

  // Botan des.vec, section [TripleDES], case 20 (lines 1112 to 1114): three
  // independent keys (keying option 1), the forward transformation of
  // "somedata".
  test "Botan des.vec [TripleDES] case 20: three-key TDEA encrypts" {
    tdea_encrypt(
      hex"0123456789abcdef", hex"5555555555555555", hex"fedcba9876543210",
      hex"736f6d6564617461",
    ) == hex"18d748e563620572"
  }

  // The same case decrypted with the inverse transformation.
  test "Botan des.vec [TripleDES] case 20: three-key TDEA decrypts" {
    tdea_decrypt(
      hex"0123456789abcdef", hex"5555555555555555", hex"fedcba9876543210",
      hex"18d748e563620572",
    ) == hex"736f6d6564617461"
  }

  // OpenSSL evpciph_des3_common.txt, DES-EDE3-ECB (lines 29 to 32), the first
  // of its four blocks: the key 0123456789abcdef f1e0d3c2b5a49786
  // fedcba9876543210 and the plaintext "7654321 ".
  test "OpenSSL evpciph_des3_common.txt DES-EDE3-ECB: block 1" {
    tdea_encrypt(
      hex"0123456789abcdef", hex"f1e0d3c2b5a49786", hex"fedcba9876543210",
      hex"3736353433323120",
    ) == hex"62c10cc9efbf15aa"
  }

  // OpenSSL evpciph_des3_common.txt, DES-EDE-ECB (lines 36 to 39), the first
  // of its four blocks decrypted: the two-key bundle 0123456789abcdef
  // fedcba9876543210 and the inverse transformation give back "7654321 ".
  test "OpenSSL evpciph_des3_common.txt DES-EDE-ECB: block 1 decrypts" {
    tdea_decrypt(
      hex"0123456789abcdef", hex"fedcba9876543210", hex"0123456789abcdef",
      hex"4d1332e49f380e23",
    ) == hex"3736353433323120"
  }
}
