// RC6 of "The RC6 Block Cipher" (Rivest, Robshaw, Sidney, Yin; RSA
// Laboratories, version 1.1, 20 August 1998;
// https://people.csail.mit.edu/rivest/pubs/RRSY98.pdf), the cipher RSA
// Laboratories submitted to NIST's AES process, one of the five finalists.
// The file carries RC6-32/20/b with the AES parameters: 32-bit words, 20
// rounds, and a 16-, 24- or 32-byte key. It transcribes the key schedule of
// the paper's "Key schedule" (P32, Q32, and the three-pass mixing loop that
// yields S[0..43]), the encryption of "Encryption and decryption" with
// f(x) = x(2x + 1) <<< 5 and the rotations by the low five bits of a data
// word, and the decryption that undoes it. The six test vectors appended to
// the paper (two per key length, as carried by Crypto++'s
// TestData/rc6val.dat) are reproduced, three of them also decrypted, with
// three of the AES-submission known-answer tests carried by Bouncy Castle's
// RC6Test.java and by Botan 1.11's src/tests/data/block/rc6.vec.
edition 2026;
module rc6 {
  // "Details of RC6": a word is w = 32 bits, and bytes are read into words
  // little-endian, the first byte least significant, for both the key and
  // the block; that is `as little` wherever bytes become words or words
  // bytes. "a <<< b" rotates the word a left by the amount given by the
  // least significant lg w = 5 bits of b, and "a >>> b" right; a rotation
  // by a computed amount turns by that amount modulo 32, which is the same
  // thing, so the paper's rotations by data words are written as it writes
  // them.

  // "Key schedule": the magic constants for w = 32,
  //   P32 = Odd((e - 2) 2^32) = b7e15163 and Q32 = Odd((phi - 1) 2^32) = 9e3779b9,
  // with e the base of natural logarithms and phi the golden ratio.
  spec p32() -> Word[32] { 0xb7e15163 }
  spec q32() -> Word[32] { 0x9e3779b9 }

  // "Key schedule". The b key bytes are loaded into c = b / 4 words
  // L[0..c-1], little-endian. S[0] = P32 and S[i] = S[i - 1] + Q32 for
  // i = 1, ..., 2r + 3, 44 words. Then, with A = B = i = j = 0, the loop
  // runs v = 3 max(c, 2r + 4) = 132 times:
  //   A = S[i] = (S[i] + A + B) <<< 3
  //   B = L[j] = (L[j] + A + B) <<< (A + B)
  //   i = (i + 1) mod (2r + 4)
  //   j = (j + 1) mod c
  // The loop counter k stands for both indices: at step k, i = k mod 44
  // and j = k mod c. The size c runs over 4 through 8, the keys of 16
  // through 32 bytes whose length is a multiple of four; the AES
  // parameters are c = 4, 6 and 8, and c = 5 and 7 are accepted but no
  // vector here uses them. The paper also admits key lengths that are not
  // a multiple of four, padded with zero bytes into the last word, and
  // keys up to 255 bytes; the count 3 max(c, 44) is the 132 written here
  // only while c <= 44, so keys over 176 bytes would run longer. This file
  // carries neither, and no vector here has one.
  spec key_schedule[c in 4..9](key: Word[8]^(4 * c)) -> Word[32]^44 {
    let l0: Word[32]^c = key as little Word[32]^c;
    let s0: Word[32]^44 = for i in 1..44 with s: Word[32]^44 = ([0; 44] with [0] = p32()) {
      s with [i] = s[i - 1] + q32()
    };
    let mixed: (Word[32]^44, Word[32]^c, Word[32], Word[32]) =
      for k in 0..132 with (s: Word[32]^44, l: Word[32]^c, a: Word[32], b: Word[32]) =
        (s0, l0, 0, 0) {
        let a1: Word[32] = (s[k % 44] + a + b) <<< 3;
        let b1: Word[32] = (l[k % c] + a1 + b) <<< (a1 + b);
        (s with [k % 44] = a1, l with [k % c] = b1, a1, b1)
      };
    mixed.0
  }

  // "Encryption and decryption": the quadratic function
  //   f(x) = (x (2x + 1)) <<< lg w, with lg w = 5.
  // The rotation by lg w brings the five high-order bits of x (2x + 1), which
  // depend on every bit of x, down to the low five positions that the
  // data-dependent rotations of the round read.
  spec f(x: Word[32]) -> Word[32] { (x * (2 * x + 1)) <<< 5 }

  // Encryption with RC6-w/r/b, the plaintext in the registers A, B, C, D
  // and the round keys S[0..2r+3]:
  //   B = B + S[0]; D = D + S[1]
  //   for i = 1 to r:
  //     t = (B (2B + 1)) <<< lg w; u = (D (2D + 1)) <<< lg w
  //     A = ((A ^ t) <<< u) + S[2i]
  //     C = ((C ^ u) <<< t) + S[2i + 1]
  //     (A, B, C, D) = (B, C, D, A)
  //   A = A + S[2r + 2]; C = C + S[2r + 3]
  // The loop's step returns the new (A, B, C, D) = (B, C', D, A') in one
  // tuple, so the register rotation is the order of the tuple.
  spec encrypt(s: Word[32]^44, plaintext: Word[8]^16) -> Word[8]^16 {
    let x: Word[32]^4 = plaintext as little Word[32]^4;
    let y: (Word[32], Word[32], Word[32], Word[32]) =
      for i in 1..21 with (a: Word[32], b: Word[32], c: Word[32], d: Word[32]) =
        (x[0], x[1] + s[0], x[2], x[3] + s[1]) {
        let t: Word[32] = f(b);
        let u: Word[32] = f(d);
        let a1: Word[32] = ((a ^ t) <<< u) + s[2 * i];
        let c1: Word[32] = ((c ^ u) <<< t) + s[2 * i + 1];
        (b, c1, d, a1)
      };
    let out: Word[32]^4 = [y.0 + s[42], y.1, y.2 + s[43], y.3];
    out as little Word[8]^16
  }

  // Decryption with RC6-w/r/b, the ciphertext in A, B, C, D:
  //   C = C - S[2r + 3]; A = A - S[2r + 2]
  //   for i = r downto 1:
  //     (A, B, C, D) = (D, A, B, C)
  //     u = (D (2D + 1)) <<< lg w; t = (B (2B + 1)) <<< lg w
  //     C = ((C - S[2i + 1]) >>> t) ^ u
  //     A = ((A - S[2i]) >>> u) ^ t
  //   D = D - S[1]; B = B - S[0]
  // The loop counter k runs up from 0, so i = r - k = 20 - k. With (a, b,
  // c, d) the registers before the swap, the swapped A is d, B is a, C is
  // b and D is c, and the step returns (A', a, C', c).
  spec decrypt(s: Word[32]^44, ciphertext: Word[8]^16) -> Word[8]^16 {
    let x: Word[32]^4 = ciphertext as little Word[32]^4;
    let y: (Word[32], Word[32], Word[32], Word[32]) =
      for k in 0..20 with (a: Word[32], b: Word[32], c: Word[32], d: Word[32]) =
        (x[0] - s[42], x[1], x[2] - s[43], x[3]) {
        let u: Word[32] = f(c);
        let t: Word[32] = f(a);
        let c1: Word[32] = ((b - s[41 - 2 * k]) >>> t) ^ u;
        let a1: Word[32] = ((d - s[40 - 2 * k]) >>> u) ^ t;
        (a1, a, c1, c)
      };
    let out: Word[32]^4 = [y.0, y.1 - s[0], y.2, y.3 - s[1]];
    out as little Word[8]^16
  }

  // The paper's test vectors, two for each key length, in the order and
  // with the values of Crypto++'s TestData/rc6val.dat (key, plaintext,
  // ciphertext): every one encrypted, and the second of each key length
  // also decrypted back to its plaintext. The four 192- and 256-bit entries
  // are also in Botan's rc6.vec.

  // rc6val.dat entry 1, RC6-32/20/16, the zero key and the zero block.
  test "RC6 paper, rc6val.dat entry 1: RC6-32/20/16 encrypts" {
    encrypt(
      key_schedule(hex"00000000 00000000 00000000 00000000"),
      hex"00000000 00000000 00000000 00000000",
    ) == hex"8fc3a536 56b1f778 c129df4e 9848a41e"
  }

  // rc6val.dat entry 2, RC6-32/20/16.
  test "RC6 paper, rc6val.dat entry 2: RC6-32/20/16 encrypts" {
    encrypt(
      key_schedule(hex"01234567 89abcdef 01122334 45566778"),
      hex"02132435 46576879 8a9bacbd cedfe0f1",
    ) == hex"524e192f 4715c623 1f51f636 7ea43f18"
  }

  // The same entry decrypted: under the same key, the ciphertext gives the
  // plaintext back.
  test "RC6 paper, rc6val.dat entry 2: RC6-32/20/16 decrypts" {
    decrypt(
      key_schedule(hex"01234567 89abcdef 01122334 45566778"),
      hex"524e192f 4715c623 1f51f636 7ea43f18",
    ) == hex"02132435 46576879 8a9bacbd cedfe0f1"
  }

  // rc6val.dat entry 3 (also in Botan's rc6.vec), RC6-32/20/24, the zero
  // key and the zero block.
  test "RC6 paper, rc6val.dat entry 3: RC6-32/20/24 encrypts" {
    encrypt(
      key_schedule(hex"00000000 00000000 00000000 00000000 00000000 00000000"),
      hex"00000000 00000000 00000000 00000000",
    ) == hex"6cd61bcb 190b3038 4e8a3f16 8690ae82"
  }

  // rc6val.dat entry 4 (also in Botan's rc6.vec), RC6-32/20/24.
  test "RC6 paper, rc6val.dat entry 4: RC6-32/20/24 encrypts" {
    encrypt(
      key_schedule(hex"01234567 89abcdef 01122334 45566778 899aabbc cddeeff0"),
      hex"02132435 46576879 8a9bacbd cedfe0f1",
    ) == hex"688329d0 19e50504 1e52e92a f95291d4"
  }

  // The same entry decrypted.
  test "RC6 paper, rc6val.dat entry 4: RC6-32/20/24 decrypts" {
    decrypt(
      key_schedule(hex"01234567 89abcdef 01122334 45566778 899aabbc cddeeff0"),
      hex"688329d0 19e50504 1e52e92a f95291d4",
    ) == hex"02132435 46576879 8a9bacbd cedfe0f1"
  }

  // rc6val.dat entry 5 (also in Botan's rc6.vec), RC6-32/20/32, the zero
  // key and the zero block.
  test "RC6 paper, rc6val.dat entry 5: RC6-32/20/32 encrypts" {
    let key: Word[8]^32 =
      hex"00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000";
    encrypt(key_schedule(key), hex"00000000 00000000 00000000 00000000")
      == hex"8f5fbd05 10d15fa8 93fa3fda 6e857ec2"
  }

  // rc6val.dat entry 6 (also in Botan's rc6.vec), RC6-32/20/32.
  test "RC6 paper, rc6val.dat entry 6: RC6-32/20/32 encrypts" {
    let key: Word[8]^32 =
      hex"01234567 89abcdef 01122334 45566778 899aabbc cddeeff0 10325476 98badcfe";
    encrypt(key_schedule(key), hex"02132435 46576879 8a9bacbd cedfe0f1")
      == hex"c8241816 f0d7e489 20ad16a1 674e5d48"
  }

  // The same entry decrypted.
  test "RC6 paper, rc6val.dat entry 6: RC6-32/20/32 decrypts" {
    let key: Word[8]^32 =
      hex"01234567 89abcdef 01122334 45566778 899aabbc cddeeff0 10325476 98badcfe";
    decrypt(key_schedule(key), hex"c8241816 f0d7e489 20ad16a1 674e5d48")
      == hex"02132435 46576879 8a9bacbd cedfe0f1"
  }

  // Known-answer tests of the AES submission's reference implementation
  // (rc6-unix-refc), as carried by Bouncy Castle's
  // core/src/test/java/org/bouncycastle/crypto/test/RC6Test.java and, among
  // 1,219 such cases, by Botan 1.11's src/tests/data/block/rc6.vec: a single
  // set bit in the plaintext or the key.

  // RC6Test.java test 0, RC6-32/20/16: the zero key, plaintext 80 00...00.
  test "Bouncy Castle RC6Test.java test 0: RC6-32/20/16 encrypts" {
    encrypt(
      key_schedule(hex"00000000 00000000 00000000 00000000"),
      hex"80000000 00000000 00000000 00000000",
    ) == hex"f71f65e7 b80c0c69 66fee607 984b5cdf"
  }

  // RC6Test.java test 1, RC6-32/20/24: key byte 16 is 80, the rest zero;
  // the zero block.
  test "Bouncy Castle RC6Test.java test 1: RC6-32/20/24 encrypts" {
    encrypt(
      key_schedule(hex"00000000 00000000 00000000 00000000 80000000 00000000"),
      hex"00000000 00000000 00000000 00000000",
    ) == hex"dd04c176 440bbc66 86c90aee 775bd368"
  }

  // RC6Test.java test 4, RC6-32/20/32: key byte 0 is 10, the rest zero;
  // the zero block.
  test "Bouncy Castle RC6Test.java test 4: RC6-32/20/32 encrypts" {
    let key: Word[8]^32 =
      hex"10000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000";
    encrypt(key_schedule(key), hex"00000000 00000000 00000000 00000000")
      == hex"11395d4b fe4c8258 979ee2bf 2d24dff4"
  }
}
