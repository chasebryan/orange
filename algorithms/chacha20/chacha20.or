// ChaCha20 and XChaCha20. ChaCha20 is the stream cipher of RFC 8439 (2018),
// "ChaCha20 and Poly1305 for IETF Protocols",
// https://www.rfc-editor.org/rfc/rfc8439: the quarter round (section 2.1),
// the block function with its 32-bit block counter and 96-bit nonce (2.3),
// and the encryption function (2.4). XChaCha20 is the extended-nonce form of
// draft-irtf-cfrg-xchacha-03 (Arciszewski, 2020),
// https://datatracker.ietf.org/doc/html/draft-irtf-cfrg-xchacha: HChaCha20
// (section 2.2) and XChaCha20 with a 192-bit nonce (2.3). The file reproduces
// the RFC's vectors of sections 2.1.1, 2.2.1, 2.3.2 and 2.4.2 and of appendix
// A.1 (1 to 5) and A.2 (1 to 3), the draft's HChaCha20 vector of section
// 2.2.1 and its XChaCha20 example of appendix A.2.1, and the third XChaCha20
// case of Botan's chacha.vec.
edition 2026;
module chacha20 {
  // Section 2.1: the quarter round on four 32-bit words a, b, c, d.
  spec quarter_round(a: Word[32], b: Word[32], c: Word[32], d: Word[32]) -> Word[32]^4 {
    let a1: Word[32] = a + b;
    let d1: Word[32] = (d ^ a1) <<< 16;
    let c1: Word[32] = c + d1;
    let b1: Word[32] = (b ^ c1) <<< 12;
    let a2: Word[32] = a1 + b1;
    let d2: Word[32] = (d1 ^ a2) <<< 8;
    let c2: Word[32] = c1 + d2;
    let b2: Word[32] = (b1 ^ c2) <<< 7;
    [a2, b2, c2, d2]
  }

  // Sections 2.2 and 2.3: the eight quarter rounds of inner_block, a column
  // round QUARTERROUND(0, 4, 8, 12) through (3, 7, 11, 15) and a diagonal
  // round QUARTERROUND(0, 5, 10, 15) through (3, 4, 9, 14). Each quarter
  // round returns its four words, which are placed back into the state.
  spec inner_block(x: Word[32]^16) -> Word[32]^16 {
    let q0: Word[32]^4 = quarter_round(x[0], x[4], x[8], x[12]);
    let q1: Word[32]^4 = quarter_round(x[1], x[5], x[9], x[13]);
    let q2: Word[32]^4 = quarter_round(x[2], x[6], x[10], x[14]);
    let q3: Word[32]^4 = quarter_round(x[3], x[7], x[11], x[15]);
    let d0: Word[32]^4 = quarter_round(q0[0], q1[1], q2[2], q3[3]);
    let d1: Word[32]^4 = quarter_round(q1[0], q2[1], q3[2], q0[3]);
    let d2: Word[32]^4 = quarter_round(q2[0], q3[1], q0[2], q1[3]);
    let d3: Word[32]^4 = quarter_round(q3[0], q0[1], q1[2], q2[3]);
    [
      d0[0], d1[0], d2[0], d3[0],
      d3[1], d0[1], d1[1], d2[1],
      d2[2], d3[2], d0[2], d1[2],
      d1[3], d2[3], d3[3], d0[3],
    ]
  }

  spec load_le32(b0: Word[8], b1: Word[8], b2: Word[8], b3: Word[8]) -> Word[32] {
    (b0 as Word[32]) | ((b1 as Word[32]) << 8) | ((b2 as Word[32]) << 16)
      | ((b3 as Word[32]) << 24)
  }

  spec le_bytes(x: Word[32]) -> Word[8]^4 {
    [x as Word[8], (x >> 8) as Word[8], (x >> 16) as Word[8], (x >> 24) as Word[8]]
  }

  // Section 2.3: the 256-bit key as eight little-endian words.
  spec key_words(key: Word[8]^32) -> Word[32]^8 {
    for i in 0..8 with k: Word[32]^8 = [0; 8] {
      k with [i] = load_le32(key[4 * i], key[4 * i + 1], key[4 * i + 2], key[4 * i + 3])
    }
  }

  // Section 2.3: the state as it is set up. Words 0 to 3 are the constants
  // "expand 32-byte k", 4 to 11 the key, 12 the block counter, and 13 to 15
  // the nonce. The counter is the 32-bit word of RFC 8439; Bernstein's
  // ChaCha (2008) kept a 64-bit counter in words 12 and 13 and a 64-bit
  // nonce in words 14 and 15.
  spec initial_state(key: Word[8]^32, counter: Word[32], nonce: Word[8]^12) -> Word[32]^16 {
    let k: Word[32]^8 = key_words(key);
    [
      0x61707865, 0x3320646e, 0x79622d32, 0x6b206574,
      k[0], k[1], k[2], k[3],
      k[4], k[5], k[6], k[7],
      counter,
      load_le32(nonce[0], nonce[1], nonce[2], nonce[3]),
      load_le32(nonce[4], nonce[5], nonce[6], nonce[7]),
      load_le32(nonce[8], nonce[9], nonce[10], nonce[11]),
    ]
  }

  // Section 2.3: the block function before serialization. Ten iterations of
  // inner_block are the 20 rounds; then the initial state is added word by
  // word.
  spec block(key: Word[8]^32, counter: Word[32], nonce: Word[8]^12) -> Word[32]^16 {
    let initial: Word[32]^16 = initial_state(key, counter, nonce);
    let mixed: Word[32]^16 = for i in 0..10 with s: Word[32]^16 = initial { inner_block(s) };
    for i in 0..16 with s: Word[32]^16 = mixed { s with [i] = s[i] + initial[i] }
  }

  // Section 2.3: the state serialized as 64 little-endian bytes.
  spec serialize(s: Word[32]^16) -> Word[8]^64 {
    for i in 0..16 with bytes: Word[8]^64 = [0; 64] {
      for j in 0..4 with b: Word[8]^64 = bytes { b with [4 * i + j] = le_bytes(s[i])[j] }
    }
  }

  // Section 2.3.1: chacha20_block, one 64-byte keystream block.
  spec chacha20_block(key: Word[8]^32, counter: Word[32], nonce: Word[8]^12) -> Word[8]^64 {
    serialize(block(key, counter, nonce))
  }

  // Section 2.4: keystream block j is XORed into bytes 64j through 64j + 63
  // of the message. A spec parameter cannot index an array, so the block's
  // position is chosen by a conditional on j.
  spec xor_block(c: Word[8]^256, m: Word[8]^256, j: Int, key_stream: Word[8]^64) -> Word[8]^256 {
    if j == 0 {
      for i in 0..64 with out: Word[8]^256 = c { out with [i] = m[i] ^ key_stream[i] }
    } else if j == 1 {
      for i in 0..64 with out: Word[8]^256 = c { out with [64 + i] = m[64 + i] ^ key_stream[i] }
    } else if j == 2 {
      for i in 0..64 with out: Word[8]^256 = c { out with [128 + i] = m[128 + i] ^ key_stream[i] }
    } else {
      for i in 0..64 with out: Word[8]^256 = c { out with [192 + i] = m[192 + i] ^ key_stream[i] }
    }
  }

  // Section 2.4.1: chacha20_encrypt over whole blocks, here four of them,
  // block j under block counter counter + j. Longer messages are passed as
  // several arrays, each encrypted from the counter its first block has.
  spec encrypt(key: Word[8]^32, counter: Word[32], nonce: Word[8]^12, plaintext: Word[8]^256) -> Word[8]^256 {
    for j in 0..4 with c: Word[8]^256 = plaintext {
      xor_block(c, plaintext, j, chacha20_block(key, counter + (j as Word[32]), nonce))
    }
  }

  // Section 2.4.1 for two whole blocks.
  spec encrypt_128(key: Word[8]^32, counter: Word[32], nonce: Word[8]^12, plaintext: Word[8]^128) -> Word[8]^128 {
    let first: Word[8]^64 = chacha20_block(key, counter, nonce);
    let second: Word[8]^64 = chacha20_block(key, counter + 1, nonce);
    let head: Word[8]^128 = for i in 0..64 with c: Word[8]^128 = plaintext {
      c with [i] = plaintext[i] ^ first[i]
    };
    for i in 64..128 with c: Word[8]^128 = head { c with [i] = plaintext[i] ^ second[i - 64] }
  }

  // Section 2.4.1 for one whole block and a partial block of 63 bytes: the
  // extra keystream of the last block is discarded.
  spec encrypt_127(key: Word[8]^32, counter: Word[32], nonce: Word[8]^12, plaintext: Word[8]^127) -> Word[8]^127 {
    let first: Word[8]^64 = chacha20_block(key, counter, nonce);
    let second: Word[8]^64 = chacha20_block(key, counter + 1, nonce);
    let head: Word[8]^127 = for i in 0..64 with c: Word[8]^127 = plaintext {
      c with [i] = plaintext[i] ^ first[i]
    };
    for i in 64..127 with c: Word[8]^127 = head { c with [i] = plaintext[i] ^ second[i - 64] }
  }

  // Section 2.4.1 for one whole block and a partial block of 55 bytes.
  spec encrypt_119(key: Word[8]^32, counter: Word[32], nonce: Word[8]^12, plaintext: Word[8]^119) -> Word[8]^119 {
    let first: Word[8]^64 = chacha20_block(key, counter, nonce);
    let second: Word[8]^64 = chacha20_block(key, counter + 1, nonce);
    let head: Word[8]^119 = for i in 0..64 with c: Word[8]^119 = plaintext {
      c with [i] = plaintext[i] ^ first[i]
    };
    for i in 64..119 with c: Word[8]^119 = head { c with [i] = plaintext[i] ^ second[i - 64] }
  }

  // Section 2.4.1 for one whole block and a partial block of 50 bytes, the
  // shape of the 114-byte message of section 2.4.2.
  spec encrypt_114(key: Word[8]^32, counter: Word[32], nonce: Word[8]^12, plaintext: Word[8]^114) -> Word[8]^114 {
    let first: Word[8]^64 = chacha20_block(key, counter, nonce);
    let second: Word[8]^64 = chacha20_block(key, counter + 1, nonce);
    let head: Word[8]^114 = for i in 0..64 with c: Word[8]^114 = plaintext {
      c with [i] = plaintext[i] ^ first[i]
    };
    for i in 64..114 with c: Word[8]^114 = head { c with [i] = plaintext[i] ^ second[i - 64] }
  }

  // Section 2.4.1 for exactly one block.
  spec encrypt_64(key: Word[8]^32, counter: Word[32], nonce: Word[8]^12, plaintext: Word[8]^64) -> Word[8]^64 {
    let key_stream: Word[8]^64 = chacha20_block(key, counter, nonce);
    for i in 0..64 with c: Word[8]^64 = plaintext { c with [i] = plaintext[i] ^ key_stream[i] }
  }

  // Section 2.4.1 for a single partial block of 48 bytes.
  spec encrypt_48(key: Word[8]^32, counter: Word[32], nonce: Word[8]^12, plaintext: Word[8]^48) -> Word[8]^48 {
    let key_stream: Word[8]^64 = chacha20_block(key, counter, nonce);
    for i in 0..48 with c: Word[8]^48 = plaintext { c with [i] = plaintext[i] ^ key_stream[i] }
  }

  // draft-irtf-cfrg-xchacha-03, section 2.2: HChaCha20. The state is set up
  // as for ChaCha20 except that words 12 to 15 hold a 128-bit nonce and
  // there is no counter; after the 20 rounds, and without the final
  // addition, words 0 to 3 and 12 to 15 are the 256-bit subkey, little-endian.
  spec hchacha20(key: Word[8]^32, nonce: Word[8]^16) -> Word[8]^32 {
    let k: Word[32]^8 = key_words(key);
    let initial: Word[32]^16 = [
      0x61707865, 0x3320646e, 0x79622d32, 0x6b206574,
      k[0], k[1], k[2], k[3],
      k[4], k[5], k[6], k[7],
      load_le32(nonce[0], nonce[1], nonce[2], nonce[3]),
      load_le32(nonce[4], nonce[5], nonce[6], nonce[7]),
      load_le32(nonce[8], nonce[9], nonce[10], nonce[11]),
      load_le32(nonce[12], nonce[13], nonce[14], nonce[15]),
    ];
    let mixed: Word[32]^16 = for i in 0..10 with s: Word[32]^16 = initial { inner_block(s) };
    let rows: Word[32]^8 = [
      mixed[0], mixed[1], mixed[2], mixed[3],
      mixed[12], mixed[13], mixed[14], mixed[15],
    ];
    for i in 0..8 with bytes: Word[8]^32 = [0; 32] {
      for j in 0..4 with b: Word[8]^32 = bytes { b with [4 * i + j] = le_bytes(rows[i])[j] }
    }
  }

  // Section 2.3, step 1: the subkey from the key and the first 16 bytes of
  // the 24-byte nonce.
  spec subkey(key: Word[8]^32, nonce: Word[8]^24) -> Word[8]^32 {
    hchacha20(key, for i in 0..16 with n: Word[8]^16 = [0; 16] { n with [i] = nonce[i] })
  }

  // Section 2.3, step 2: the ChaCha20 nonce, four zero bytes followed by the
  // last 8 bytes of the 24-byte nonce.
  spec chacha20_nonce(nonce: Word[8]^24) -> Word[8]^12 {
    [
      0, 0, 0, 0,
      nonce[16], nonce[17], nonce[18], nonce[19], nonce[20], nonce[21], nonce[22], nonce[23],
    ]
  }

  // Section 2.3.1: xchacha20_encrypt, for a message of four whole blocks;
  // other lengths call the matching encrypt_ spec with the same subkey and
  // nonce.
  spec xchacha20_encrypt(key: Word[8]^32, nonce: Word[8]^24, plaintext: Word[8]^256, counter: Word[32]) -> Word[8]^256 {
    encrypt(subkey(key, nonce), counter, chacha20_nonce(nonce), plaintext)
  }

  // The key 00:01:...:1f of RFC 8439 sections 2.3.2 and 2.4.2, of the
  // draft's section 2.2.1, and of Botan's third XChaCha20 case.
  spec sequential_key() -> Word[8]^32 {
    [
      0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
      0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
    ]
  }

  // RFC 8439, section 2.1.1: the quarter round on a = 0x11111111,
  // b = 0x01020304, c = 0x9b8d6f43, d = 0x01234567.
  spec rfc8439_2_1_1() -> Word[32]^4 {
    quarter_round(0x11111111, 0x01020304, 0x9b8d6f43, 0x01234567)
  }

  spec rfc8439_2_1_1_expected() -> Word[32]^4 {
    [
      0xea2a92f4, 0xcb1cf8ce, 0x4581472e, 0x5881c4bb,
    ]
  }

  // RFC 8439, section 2.2.1: QUARTERROUND(2, 7, 8, 13) on the sample state;
  // only the four positions change.
  spec rfc8439_2_2_1() -> Word[32]^16 {
    let s: Word[32]^16 = [
      0x879531e0, 0xc5ecf37d, 0x516461b1, 0xc9a62f8a,
      0x44c20ef3, 0x3390af7f, 0xd9fc690b, 0x2a5f714c,
      0x53372767, 0xb00a5631, 0x974c541a, 0x359e9963,
      0x5c971061, 0x3d631689, 0x2098d9d6, 0x91dbd320,
    ];
    let q: Word[32]^4 = quarter_round(s[2], s[7], s[8], s[13]);
    (((s with [2] = q[0]) with [7] = q[1]) with [8] = q[2]) with [13] = q[3]
  }

  spec rfc8439_2_2_1_expected() -> Word[32]^16 {
    [
      0x879531e0, 0xc5ecf37d, 0xbdb886dc, 0xc9a62f8a,
      0x44c20ef3, 0x3390af7f, 0xd9fc690b, 0xcfacafd2,
      0xe46bea80, 0xb00a5631, 0x974c541a, 0x359e9963,
      0x5c971061, 0xccc07c79, 0x2098d9d6, 0x91dbd320,
    ]
  }

  // RFC 8439, section 2.3.2: the block function on the key 00:01:...:1f,
  // nonce 00:00:00:09:00:00:00:4a:00:00:00:00, block count 1: the state at
  // the end of the operation, then the serialized block.
  spec rfc8439_2_3_2_nonce() -> Word[8]^12 {
    [0x00, 0x00, 0x00, 0x09, 0x00, 0x00, 0x00, 0x4a, 0x00, 0x00, 0x00, 0x00]
  }

  spec rfc8439_2_3_2_state() -> Word[32]^16 {
    block(sequential_key(), 1, rfc8439_2_3_2_nonce())
  }

  spec rfc8439_2_3_2_state_expected() -> Word[32]^16 {
    [
      0xe4e7f110, 0x15593bd1, 0x1fdd0f50, 0xc47120a3,
      0xc7f4d1c7, 0x0368c033, 0x9aaa2204, 0x4e6cd4c3,
      0x466482d2, 0x09aa9f07, 0x05d7c214, 0xa2028bd9,
      0xd19c12b5, 0xb94e16de, 0xe883d0cb, 0x4e3c50a2,
    ]
  }

  spec rfc8439_2_3_2() -> Word[8]^64 {
    chacha20_block(sequential_key(), 1, rfc8439_2_3_2_nonce())
  }

  spec rfc8439_2_3_2_expected() -> Word[8]^64 {
    [
      0x10, 0xf1, 0xe7, 0xe4, 0xd1, 0x3b, 0x59, 0x15, 0x50, 0x0f, 0xdd, 0x1f, 0xa3, 0x20, 0x71, 0xc4,
      0xc7, 0xd1, 0xf4, 0xc7, 0x33, 0xc0, 0x68, 0x03, 0x04, 0x22, 0xaa, 0x9a, 0xc3, 0xd4, 0x6c, 0x4e,
      0xd2, 0x82, 0x64, 0x46, 0x07, 0x9f, 0xaa, 0x09, 0x14, 0xc2, 0xd7, 0x05, 0xd9, 0x8b, 0x02, 0xa2,
      0xb5, 0x12, 0x9c, 0xd1, 0xde, 0x16, 0x4e, 0xb9, 0xcb, 0xd0, 0x83, 0xe8, 0xa2, 0x50, 0x3c, 0x4e,
    ]
  }

  // RFC 8439, section 2.4.2: the 114-byte "sunscreen" plaintext under the
  // key 00:01:...:1f, nonce 00:00:00:00:00:00:00:4a:00:00:00:00, initial
  // counter 1.
  spec sunscreen() -> Word[8]^114 {
    [
      0x4c, 0x61, 0x64, 0x69, 0x65, 0x73, 0x20, 0x61, 0x6e, 0x64, 0x20, 0x47, 0x65, 0x6e, 0x74, 0x6c,
      0x65, 0x6d, 0x65, 0x6e, 0x20, 0x6f, 0x66, 0x20, 0x74, 0x68, 0x65, 0x20, 0x63, 0x6c, 0x61, 0x73,
      0x73, 0x20, 0x6f, 0x66, 0x20, 0x27, 0x39, 0x39, 0x3a, 0x20, 0x49, 0x66, 0x20, 0x49, 0x20, 0x63,
      0x6f, 0x75, 0x6c, 0x64, 0x20, 0x6f, 0x66, 0x66, 0x65, 0x72, 0x20, 0x79, 0x6f, 0x75, 0x20, 0x6f,
      0x6e, 0x6c, 0x79, 0x20, 0x6f, 0x6e, 0x65, 0x20, 0x74, 0x69, 0x70, 0x20, 0x66, 0x6f, 0x72, 0x20,
      0x74, 0x68, 0x65, 0x20, 0x66, 0x75, 0x74, 0x75, 0x72, 0x65, 0x2c, 0x20, 0x73, 0x75, 0x6e, 0x73,
      0x63, 0x72, 0x65, 0x65, 0x6e, 0x20, 0x77, 0x6f, 0x75, 0x6c, 0x64, 0x20, 0x62, 0x65, 0x20, 0x69,
      0x74, 0x2e,
    ]
  }

  spec rfc8439_2_4_2() -> Word[8]^114 {
    encrypt_114(
      sequential_key(),
      1,
      [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x4a, 0x00, 0x00, 0x00, 0x00],
      sunscreen(),
    )
  }

  spec rfc8439_2_4_2_expected() -> Word[8]^114 {
    [
      0x6e, 0x2e, 0x35, 0x9a, 0x25, 0x68, 0xf9, 0x80, 0x41, 0xba, 0x07, 0x28, 0xdd, 0x0d, 0x69, 0x81,
      0xe9, 0x7e, 0x7a, 0xec, 0x1d, 0x43, 0x60, 0xc2, 0x0a, 0x27, 0xaf, 0xcc, 0xfd, 0x9f, 0xae, 0x0b,
      0xf9, 0x1b, 0x65, 0xc5, 0x52, 0x47, 0x33, 0xab, 0x8f, 0x59, 0x3d, 0xab, 0xcd, 0x62, 0xb3, 0x57,
      0x16, 0x39, 0xd6, 0x24, 0xe6, 0x51, 0x52, 0xab, 0x8f, 0x53, 0x0c, 0x35, 0x9f, 0x08, 0x61, 0xd8,
      0x07, 0xca, 0x0d, 0xbf, 0x50, 0x0d, 0x6a, 0x61, 0x56, 0xa3, 0x8e, 0x08, 0x8a, 0x22, 0xb6, 0x5e,
      0x52, 0xbc, 0x51, 0x4d, 0x16, 0xcc, 0xf8, 0x06, 0x81, 0x8c, 0xe9, 0x1a, 0xb7, 0x79, 0x37, 0x36,
      0x5a, 0xf9, 0x0b, 0xbf, 0x74, 0xa3, 0x5b, 0xe6, 0xb4, 0x0b, 0x8e, 0xed, 0xf2, 0x78, 0x5e, 0x42,
      0x87, 0x4d,
    ]
  }

  // RFC 8439, appendix A.1, test vector 1: all-zero key and nonce, block
  // counter 0.
  spec rfc8439_a1_1() -> Word[8]^64 { chacha20_block([0; 32], 0, [0; 12]) }

  spec rfc8439_a1_1_expected() -> Word[8]^64 {
    [
      0x76, 0xb8, 0xe0, 0xad, 0xa0, 0xf1, 0x3d, 0x90, 0x40, 0x5d, 0x6a, 0xe5, 0x53, 0x86, 0xbd, 0x28,
      0xbd, 0xd2, 0x19, 0xb8, 0xa0, 0x8d, 0xed, 0x1a, 0xa8, 0x36, 0xef, 0xcc, 0x8b, 0x77, 0x0d, 0xc7,
      0xda, 0x41, 0x59, 0x7c, 0x51, 0x57, 0x48, 0x8d, 0x77, 0x24, 0xe0, 0x3f, 0xb8, 0xd8, 0x4a, 0x37,
      0x6a, 0x43, 0xb8, 0xf4, 0x15, 0x18, 0xa1, 0x1c, 0xc3, 0x87, 0xb6, 0x69, 0xb2, 0xee, 0x65, 0x86,
    ]
  }

  // Appendix A.1, test vector 2: all-zero key and nonce, block counter 1.
  spec rfc8439_a1_2() -> Word[8]^64 { chacha20_block([0; 32], 1, [0; 12]) }

  spec rfc8439_a1_2_expected() -> Word[8]^64 {
    [
