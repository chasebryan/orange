  // under the key 00:01:...:1f and the nonce 00:01:...:17, block counter 0.
  spec botan_xchacha_3() -> Word[8]^128 {
    let nonce: Word[8]^24 = [
      0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
      0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
    ];
    encrypt_128(subkey(sequential_key(), nonce), 0, chacha20_nonce(nonce), [0; 128])
  }

