// Ascon-Hash256 of NIST SP 800-232, "Ascon-Based Lightweight Cryptography
// Standards for Constrained Devices: Authenticated Encryption, Hash, and
// Extendable Output Functions" (final, August 2025,
// https://doi.org/10.6028/NIST.SP.800-232), section 5: the sponge over
// Ascon-p[12] with a 64-bit rate and a 256-bit digest. The permutation of
// section 3 is the module permutation, in permutation.or beside this file,
// which ascon.or reads too. The file reproduces five entries of the
// designers' known-answer file LWC_HASH_KAT_128_256.txt (ascon-c, the
// reference implementation of SP 800-232), for messages of 0, 1, 8, 32 and
// 64 bytes.
edition 2026;
module ascon_hash256 {
  use permutation;

  // Section 3: the state S0 through S4. The rate of Ascon-Hash256 is S0.
  type State = Word[64]^5;

  // Section 5: the initial value of Ascon-Hash256, 0x0000080100CC0002,
  // which encodes the algorithm identifier 2, the round numbers 12 and 12,
  // the digest length 256 and the rate 8 bytes (constants.h of the
  // reference implementation builds it from those fields).
  spec iv() -> Word[64] { 0x0000080100cc0002 }

  // Section 2, padding: a message M of len bytes becomes M || 0x01 || 0^*,
  // the smallest multiple of the 8-byte rate longer than M. padding[len]()
  // is what is appended, 8 (len / 8 + 1) - len bytes; the empty message has
  // no array, and its padded form is padding[0]() alone, one block.
  spec padding[len in 0..65]() -> Word[8]^(8 * ((len / 8) + 1) - len) {
    [0; (8 * ((len / 8) + 1) - len)] with [0] = 0x01
  }

  // Section 5, Algorithm 3, Ascon-Hash256 of a padded message of b blocks:
  // S <- Ascon-p[12](IV || 0^256); each block M_i enters the rate as a
  // little-endian word, S0 <- S0 ^ M_i, followed by Ascon-p[12]; then the
  // 256-bit digest H is squeezed as four 64-bit words S0, with Ascon-p[12]
  // between them, and read back to bytes little-endian.
  spec hash[b in 1..10](x: Word[8]^(8 * b)) -> Word[8]^32 {
    let initial: State = permutation::ascon_p[12]([iv(), 0, 0, 0, 0]);
    let absorbed: State = for i in 0..(b) with s: State = initial {
      let m: Word[64] = x[8 * i..8 * i + 8] as little Word[64];
      permutation::ascon_p[12](s with [0] = s[0] ^ m)
    };
    let squeezed: (State, Word[64]^4) =
      for i in 0..4 with (s: State, h: Word[64]^4) = (absorbed, [0; 4]) {
        (if i < 3 { permutation::ascon_p[12](s) } else { s }, h with [i] = s[0])
      };
    squeezed.1 as little Word[8]^32
  }

  // Ascon-Hash256 of a message of 1 through 64 bytes.
  spec hash256[len in 1..65](m: Word[8]^len) -> Word[8]^32 { hash(m ++ padding[len]()) }

  // The message of LWC_HASH_KAT_128_256.txt (generated by
  // tests/genkat_hash.c of ascon-c): for Count = n + 1, the n bytes
  // 00 01 02 ...; each test writes it as the file prints it.

  test "LWC_HASH_KAT_128_256 Count 1: the empty message" {
    hash(padding[0]()) ==
      hex"0b3be5850f2f6b98caf29f8fdea89b64a1fa70aa249b8f839bd53baa304d92b2"
  }

  test "LWC_HASH_KAT_128_256 Count 2: the one-byte message 00" {
    hash256(hex"00") ==
      hex"0728621035af3ed2bca03bf6fde900f9456f5330e4b5ee23e7f6a1e70291bc80"
  }

  test "LWC_HASH_KAT_128_256 Count 9: 8 bytes, one whole block" {
    hash256(hex"0001020304050607") ==
      hex"b88e497ae8e6fb641b87ef622eb8f2fca0ed95383f7ffebe167acf1099ba764f"
  }

  test "LWC_HASH_KAT_128_256 Count 33: 32 bytes, four blocks" {
    let m: Word[8]^32 = hex"000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f";
    hash256(m) == hex"bd9d3d60a66b53868eab2a5c74539a518a1f60f01eb176c60e43dee81680b33e"
  }

  test "LWC_HASH_KAT_128_256 Count 65: 64 bytes, eight blocks" {
    let m: Word[8]^64 =
      hex"000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f" ++
      hex"202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f";
    hash256(m) == hex"a6f241bea5d16405812c06019d9f72d60132bd7c089c60549b2e56bb01c64f48"
  }
}
