// Ascon-Hash256 of NIST SP 800-232, "Ascon-Based Lightweight Cryptography
// Standards for Constrained Devices: Authenticated Encryption, Hash, and
// Extendable Output Functions" (final, August 2025,
// https://doi.org/10.6028/NIST.SP.800-232), section 5: the sponge over
// Ascon-p[12] with a 64-bit rate and a 256-bit digest. The permutation of
// section 3 is the one of ascon.or, carried again here because a module
// has no imports. The file reproduces five entries of the designers'
// known-answer file LWC_HASH_KAT_128_256.txt (ascon-c, the reference
// implementation of SP 800-232), for messages of 0, 1, 8, 32 and 64 bytes.
edition 2026;
module ascon_hash256 {
  // Section 2: bytes enter a 64-bit word little-endian, the first byte in
  // the least significant position.
  spec load_le64(
    b0: Word[8], b1: Word[8], b2: Word[8], b3: Word[8],
    b4: Word[8], b5: Word[8], b6: Word[8], b7: Word[8],
  ) -> Word[64] {
    (b0 as Word[64]) | ((b1 as Word[64]) << 8) | ((b2 as Word[64]) << 16)
      | ((b3 as Word[64]) << 24) | ((b4 as Word[64]) << 32) | ((b5 as Word[64]) << 40)
      | ((b6 as Word[64]) << 48) | ((b7 as Word[64]) << 56)
  }

  spec le_bytes64(x: Word[64]) -> Word[8]^8 {
    [
      x as Word[8], (x >> 8) as Word[8], (x >> 16) as Word[8], (x >> 24) as Word[8],
      (x >> 32) as Word[8], (x >> 40) as Word[8], (x >> 48) as Word[8], (x >> 56) as Word[8],
    ]
  }

  // Section 3.1, the constant-addition layer p_C: the round constants of
  // the twelve rounds of Ascon-p[12], c_i = ((0xf - i) << 4) | i, as in
  // ascon.or.
  spec round_constants() -> Word[8]^12 {
    [0xf0, 0xe1, 0xd2, 0xc3, 0xb4, 0xa5, 0x96, 0x87, 0x78, 0x69, 0x5a, 0x4b]
  }

  // Section 3.1: S2 <- S2 ^ c_i.
  spec constant_addition(s: Word[64]^5, c: Word[8]) -> Word[64]^5 {
    s with [2] = s[2] ^ (c as Word[64])
  }

  // Section 3.2, the substitution layer p_S, in the standard's bitsliced
  // form.
  spec substitution_layer(s: Word[64]^5) -> Word[64]^5 {
    let x0: Word[64] = s[0] ^ s[4];
    let x1: Word[64] = s[1];
    let x2: Word[64] = s[2] ^ s[1];
    let x3: Word[64] = s[3];
    let x4: Word[64] = s[4] ^ s[3];
    let t0: Word[64] = x0 ^ (~x1 & x2);
    let t1: Word[64] = x1 ^ (~x2 & x3);
    let t2: Word[64] = x2 ^ (~x3 & x4);
    let t3: Word[64] = x3 ^ (~x4 & x0);
    let t4: Word[64] = x4 ^ (~x0 & x1);
    [t0 ^ t4, t1 ^ t0, ~t2, t3 ^ t2, t4]
  }

  // Section 3.3, the linear diffusion layer p_L, rotations to the right.
  spec linear_diffusion_layer(s: Word[64]^5) -> Word[64]^5 {
    [
      s[0] ^ (s[0] >>> 19) ^ (s[0] >>> 28),
      s[1] ^ (s[1] >>> 61) ^ (s[1] >>> 39),
      s[2] ^ (s[2] >>> 1) ^ (s[2] >>> 6),
      s[3] ^ (s[3] >>> 10) ^ (s[3] >>> 17),
      s[4] ^ (s[4] >>> 7) ^ (s[4] >>> 41),
    ]
  }

  // Section 3: one round p = p_L o p_S o p_C, and Ascon-p[12].
  spec round(s: Word[64]^5, c: Word[8]) -> Word[64]^5 {
    linear_diffusion_layer(substitution_layer(constant_addition(s, c)))
  }

  spec ascon_p12(s: Word[64]^5) -> Word[64]^5 {
    let c: Word[8]^12 = round_constants();
    for i in 0..12 with t: Word[64]^5 = s { round(t, c[i]) }
  }

  // Section 5: the initial value of Ascon-Hash256, 0x0000080100CC0002,
  // which encodes the algorithm identifier 2, the round numbers 12 and 12,
  // the digest length 256 and the rate 8 bytes (constants.h of the
  // reference implementation builds it from those fields).
  spec iv() -> Word[64] { 0x0000080100cc0002 }

  // Section 2, padding: a message M of n bytes, n <= 64, becomes
  // M || 0x01 || 0^*, the smallest multiple of the 8-byte rate longer than
  // M, so at most nine blocks; n is a value, so the 0x01 byte is placed by
  // comparing the loop index with n.
  spec pad(m: Word[8]^64, n: Int) -> Word[8]^72 {
    let copied: Word[8]^72 = for i in 0..64 with p: Word[8]^72 = [0; 72] {
      if i < n { p with [i] = m[i] } else { p }
    };
    for i in 0..72 with p: Word[8]^72 = copied {
      if i == n { p with [i] = 0x01 } else { p }
    }
  }

  // Section 2: the nine padded 64-bit blocks as words.
  spec blocks(m: Word[8]^72) -> Word[64]^9 {
    for i in 0..9 with w: Word[64]^9 = [0; 9] {
      w with [i] = load_le64(
        m[8 * i], m[8 * i + 1], m[8 * i + 2], m[8 * i + 3],
        m[8 * i + 4], m[8 * i + 5], m[8 * i + 6], m[8 * i + 7],
      )
    }
  }

  // Section 5, Algorithm 3, Ascon-Hash256: S <- Ascon-p[12](IV || 0^256);
  // each block M_i of the padded message, n / 8 + 1 of them, enters the
  // rate, S0 <- S0 ^ M_i, followed by Ascon-p[12]; then the 256-bit digest
  // H is squeezed as four 64-bit words S0, with Ascon-p[12] between them.
  spec ascon_hash256(m: Word[8]^64, n: Int) -> Word[8]^32 {
    let w: Word[64]^9 = blocks(pad(m, n));
    let absorbed: Word[64]^5 = for i in 0..9 with s: Word[64]^5 = ascon_p12([iv(), 0, 0, 0, 0]) {
      if i <= (n / 8) { ascon_p12(s with [0] = s[0] ^ w[i]) } else { s }
    };
    let squeezed: Word[64]^9 = for i in 0..4 with sh: Word[64]^9 =
      [absorbed[0], absorbed[1], absorbed[2], absorbed[3], absorbed[4], 0, 0, 0, 0] {
      squeeze(sh with [5 + i] = sh[0], i < 3)
    };
    for i in 0..32 with h: Word[8]^32 = [0; 32] {
      h with [i] = le_bytes64(squeezed[5 + (i / 8)])[i % 8]
    }
  }

  // Section 5, Algorithm 3, squeezing: the caller records H_i = S0 in words
  // 5 through 8 of sh, and the permutation follows for every block but the
  // last.
  spec squeeze(sh: Word[64]^9, more: Bool) -> Word[64]^9 {
    let s: Word[64]^5 = if more { ascon_p12([sh[0], sh[1], sh[2], sh[3], sh[4]]) }
      else { [sh[0], sh[1], sh[2], sh[3], sh[4]] };
    [s[0], s[1], s[2], s[3], s[4], sh[5], sh[6], sh[7], sh[8]]
  }

  // The message of LWC_HASH_KAT_128_256.txt (generated by
  // tests/genkat_hash.c of ascon-c): for Count = n + 1, the n bytes
  // 00 01 02 ...
  spec kat_message() -> Word[8]^64 {
    [
      0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
      0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
      0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27, 0x28, 0x29, 0x2a, 0x2b, 0x2c, 0x2d, 0x2e, 0x2f,
      0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x3a, 0x3b, 0x3c, 0x3d, 0x3e, 0x3f,
    ]
  }

  // LWC_HASH_KAT_128_256.txt, Count = 1: the empty message
  spec kat_count_1() -> Word[8]^32 {
    ascon_hash256(kat_message(), 0)
  }

  spec kat_count_1_expected() -> Word[8]^32 {
    [
      0x0b, 0x3b, 0xe5, 0x85, 0x0f, 0x2f, 0x6b, 0x98, 0xca, 0xf2, 0x9f, 0x8f, 0xde, 0xa8, 0x9b, 0x64,
      0xa1, 0xfa, 0x70, 0xaa, 0x24, 0x9b, 0x8f, 0x83, 0x9b, 0xd5, 0x3b, 0xaa, 0x30, 0x4d, 0x92, 0xb2,
    ]
  }

  // LWC_HASH_KAT_128_256.txt, Count = 2: the one-byte message 00
  spec kat_count_2() -> Word[8]^32 {
    ascon_hash256(kat_message(), 1)
  }

  spec kat_count_2_expected() -> Word[8]^32 {
    [
      0x07, 0x28, 0x62, 0x10, 0x35, 0xaf, 0x3e, 0xd2, 0xbc, 0xa0, 0x3b, 0xf6, 0xfd, 0xe9, 0x00, 0xf9,
      0x45, 0x6f, 0x53, 0x30, 0xe4, 0xb5, 0xee, 0x23, 0xe7, 0xf6, 0xa1, 0xe7, 0x02, 0x91, 0xbc, 0x80,
    ]
  }

  // LWC_HASH_KAT_128_256.txt, Count = 9: the 8-byte message 00 01 ... 07, one whole block
  spec kat_count_9() -> Word[8]^32 {
    ascon_hash256(kat_message(), 8)
  }

  spec kat_count_9_expected() -> Word[8]^32 {
    [
      0xb8, 0x8e, 0x49, 0x7a, 0xe8, 0xe6, 0xfb, 0x64, 0x1b, 0x87, 0xef, 0x62, 0x2e, 0xb8, 0xf2, 0xfc,
      0xa0, 0xed, 0x95, 0x38, 0x3f, 0x7f, 0xfe, 0xbe, 0x16, 0x7a, 0xcf, 0x10, 0x99, 0xba, 0x76, 0x4f,
    ]
  }

  // LWC_HASH_KAT_128_256.txt, Count = 33: the 32-byte message 00 01 ... 1f, four blocks
  spec kat_count_33() -> Word[8]^32 {
    ascon_hash256(kat_message(), 32)
  }

  spec kat_count_33_expected() -> Word[8]^32 {
    [
      0xbd, 0x9d, 0x3d, 0x60, 0xa6, 0x6b, 0x53, 0x86, 0x8e, 0xab, 0x2a, 0x5c, 0x74, 0x53, 0x9a, 0x51,
      0x8a, 0x1f, 0x60, 0xf0, 0x1e, 0xb1, 0x76, 0xc6, 0x0e, 0x43, 0xde, 0xe8, 0x16, 0x80, 0xb3, 0x3e,
    ]
  }

  // LWC_HASH_KAT_128_256.txt, Count = 65: the 64-byte message 00 01 ... 3f, eight blocks
  spec kat_count_65() -> Word[8]^32 {
    ascon_hash256(kat_message(), 64)
  }

  spec kat_count_65_expected() -> Word[8]^32 {
    [
      0xa6, 0xf2, 0x41, 0xbe, 0xa5, 0xd1, 0x64, 0x05, 0x81, 0x2c, 0x06, 0x01, 0x9d, 0x9f, 0x72, 0xd6,
      0x01, 0x32, 0xbd, 0x7c, 0x08, 0x9c, 0x60, 0x54, 0x9b, 0x2e, 0x56, 0xbb, 0x01, 0xc6, 0x4f, 0x48,
    ]
  }
}
