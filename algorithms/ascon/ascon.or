  // LWC_AEAD_KAT_128_128.txt, Count = 1089: 32-byte plaintext, 32-byte associated data.
  spec kat_count_1089() -> Word[8]^48 {
    let ct: Word[8]^48 = ascon_aead128_encrypt(
      kat_key(), kat_nonce(), kat_associated_data(), 32, kat_plaintext(), 32,
