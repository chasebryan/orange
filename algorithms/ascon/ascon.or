  }

  // LWC_AEAD_KAT_128_128.txt, Count = 1089, decrypted: the plaintext PT of
  // the entry, released because the tag verifies.
  spec kat_count_1089_decrypt() -> Word[8]^32 {
    ascon_aead128_decrypt(
      kat_key(), kat_nonce(), kat_associated_data(), 32,
      kat_count_1089_ciphertext(), 32, kat_count_1089_tag(),
