  // LWC_AEAD_KAT_128_128.txt, Count = 1089: the verdict of Algorithm 2.
  spec kat_count_1089_verify() -> Bool {
    ascon_aead128_verify(
      kat_key(), kat_nonce(), kat_associated_data(), 32,
      kat_count_1089_ciphertext(), 32, kat_count_1089_tag(),
    )
  }

  spec kat_count_1089_verify_expected() -> Bool { true }

  // Count = 1089 with the last tag byte changed from 0xaa to 0xab: Algorithm
  // 2 returns fail. The verdict is the definition's; the Python reference
  // written for this entry agrees.
  spec kat_count_1089_altered_tag_verify() -> Bool {
    ascon_aead128_verify(
      kat_key(), kat_nonce(), kat_associated_data(), 32,
      kat_count_1089_ciphertext(), 32, kat_count_1089_tag() with [15] = 0xab,
    )
  }

  spec kat_count_1089_altered_tag_verify_expected() -> Bool { false }
}
