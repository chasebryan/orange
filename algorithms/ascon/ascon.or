// Ascon-AEAD128 of NIST SP 800-232, "Ascon-Based Lightweight Cryptography
// Standards for Constrained Devices: Authenticated Encryption, Hash, and
// Extendable Output Functions" (final, August 2025,
// https://doi.org/10.6028/NIST.SP.800-232), written as the standard writes
// it: the 320-bit state as five 64-bit words S0 through S4 loaded
// little-endian (section 2), the permutation Ascon-p[rnd] of section 3 (the
// module permutation, in permutation.or beside this file), and the AEAD of
// section 4 with a 128-bit rate, 12 rounds in initialization and
// finalization and 8 between blocks. Encryption gives C || T; decryption
// recovers P and verifies T. The file reproduces nine entries of the
// designers' known-answer file LWC_AEAD_KAT_128_128.txt (ascon-c, the
// reference implementation of SP 800-232), one decryption, its verdict, and
// the rejection of an altered tag.
edition 2026;
module ascon {
  use permutation;

  // Section 3: the state S0 through S4. The rate S_r of Ascon-AEAD128 is
  // its first 128 bits, S0 and S1; the capacity the other 192.
  type State = Word[64]^5;

  // Section 4: the initial value of Ascon-AEAD128, 0x00001000808C0001,
  // which encodes in its bytes the algorithm identifier 1, the round
  // numbers a = 12 and b = 8, the tag length 128 and the rate 16 bytes
  // (constants.h of the reference implementation builds it from those
  // fields).
  spec iv() -> Word[64] { 0x00001000808c0001 }

  // Section 2, padding: a string X of len bytes becomes X || 0x01 || 0^*,
  // the smallest multiple of the 16-byte rate longer than X. In the bit
  // order of the standard the 0x01 byte is a single 1 bit followed by
  // zeros. padding[len]() is what is appended, 16 ((len / 16) + 1) - len
  // bytes; it is a spec of its own because the empty string has no array,
  // and its padded form is padding[0]() alone.
  spec padding[len in 0..33]() -> Word[8]^(16 * ((len / 16) + 1) - len) {
    [0; (16 * ((len / 16) + 1) - len)] with [0] = 0x01
  }

  spec pad[len in 1..33](x: Word[8]^len) -> Word[8]^(16 * ((len / 16) + 1)) {
    x ++ padding[len]()
  }

  // Section 2: a 16-byte block enters the rate, S_r <- S_r ^ X_i, as two
  // little-endian words, and the rate leaves the state as sixteen bytes.
  spec add_to_rate(s: State, x: Word[8]^16) -> State {
    let w: Word[64]^2 = x as little Word[64]^2;
    (s with [0] = s[0] ^ w[0]) with [1] = s[1] ^ w[1]
  }

  spec rate(s: State) -> Word[8]^16 { s[..2] as little Word[8]^16 }

  // Section 4, initialization: S <- IV || K || N, S <- Ascon-p[12](S),
  // S <- S ^ (0^192 || K). With little-endian loading K = K0 || K1 is the
  // key's first and last eight bytes, and likewise N.
  spec initialization(k: Word[8]^16, n: Word[8]^16) -> State {
    let key: Word[64]^2 = k as little Word[64]^2;
    let s: State = permutation::ascon_p[12]([iv()] ++ ((k ++ n) as little Word[64]^4));
    (s with [3] = s[3] ^ key[0]) with [4] = s[4] ^ key[1]
  }

  // Section 4, processing associated data, when A is not empty: each block
  // A_i of the padded A, b blocks, enters the rate followed by Ascon-p[8].
  spec associated_data[b in 1..4](s: State, a: Word[8]^(16 * b)) -> State {
    for i in 0..(b) with t: State = s {
      permutation::ascon_p[8](add_to_rate(t, a[16 * i..16 * i + 16]))
    }
  }

  // Section 4: after the associated data, absorbed or empty, the domain
  // separation S <- S ^ (0^319 || 1), the last bit of the state, which is
  // the top bit of S4 in little-endian words.
  spec domain_separation(s: State) -> State {
    s with [4] = s[4] ^ 0x8000000000000000
  }

  // Section 4, processing plaintext, over the padded P of b blocks: for
  // each block C_i <- S_r ^ P_i and S_r <- C_i, which is S_r <- S_r ^ P_i,
  // then Ascon-p[8] for every block but the last, padded one, which
  // finalization follows directly. The result is the state and the b
  // ciphertext blocks, the last of which still carries the padding and is
  // truncated to |P| bytes by the caller: C~ is S_r's first |P| mod 16
  // bytes.
  spec plaintext[b in 1..4](s: State, x: Word[8]^(16 * b)) -> (State, Word[8]^(16 * b)) {
    for i in 0..(b) with (t: State, c: Word[8]^(16 * b)) = (s, x) {
      let u: State = add_to_rate(t, x[16 * i..16 * i + 16]);
      let next: State = if i < (b - 1) { permutation::ascon_p[8](u) } else { u };
      (next, c with [16 * i..16 * i + 16] = rate(u))
    }
  }

  // Section 4, finalization: S <- S ^ (0^128 || K || 0^64), that is
  // S2 <- S2 ^ K0 and S3 <- S3 ^ K1, then Ascon-p[12], and the tag
  // T <- (S3 || S4) ^ K, as sixteen bytes.
  spec finalization(s: State, k: Word[8]^16) -> Word[8]^16 {
    let key: Word[64]^2 = k as little Word[64]^2;
    let keyed: State = (s with [2] = s[2] ^ key[0]) with [3] = s[3] ^ key[1];
    let t: State = permutation::ascon_p[12](keyed);
    let tag: Word[64]^2 = [t[3] ^ key[0], t[4] ^ key[1]];
    tag as little Word[8]^16
  }

  // Section 4, Algorithm 1, Ascon-AEAD128 encryption: C || T from K, N, A
  // and P, with A and P not empty. The plaintext is any of 1 through 32
  // bytes and the output C || T is |P| + 16 bytes; the associated data has
  // one of the lengths the vectors use, listed as types, because a spec has
  // at most 256 instances and 32 lengths of each would make 1,024.
  spec encrypt[
    A in {Word[8]^1, Word[8]^7, Word[8]^8, Word[8]^16, Word[8]^32},
    len in 1..33
  ](k: Word[8]^16, n: Word[8]^16, a: A, p: Word[8]^len) -> Word[8]^(len + 16) {
    let s: State = domain_separation(associated_data(initialization(k, n), pad(a)));
    let r: (State, Word[8]^(16 * ((len / 16) + 1))) = plaintext(s, pad(p));
    r.1[..len] ++ finalization(r.0, k)
  }

  // Algorithm 1 with A empty: nothing is absorbed before the domain
  // separation.
  spec encrypt_empty_a[len in 1..33](
    k: Word[8]^16,
    n: Word[8]^16,
    p: Word[8]^len,
  ) -> Word[8]^(len + 16) {
    let s: State = domain_separation(initialization(k, n));
    let r: (State, Word[8]^(16 * ((len / 16) + 1))) = plaintext(s, pad(p));
    r.1[..len] ++ finalization(r.0, k)
  }

  // Algorithm 1 with P empty: the padded P is the one block padding[0](),
  // C is empty, and C || T is T.
  spec encrypt_empty_p[A in {Word[8]^1, Word[8]^7, Word[8]^8, Word[8]^16, Word[8]^32}](
    k: Word[8]^16,
    n: Word[8]^16,
    a: A,
  ) -> Word[8]^16 {
    let s: State = domain_separation(associated_data(initialization(k, n), pad(a)));
    finalization(plaintext(s, padding[0]()).0, k)
  }

  // Algorithm 1 with A and P both empty: C || T is T.
  spec encrypt_empty(k: Word[8]^16, n: Word[8]^16) -> Word[8]^16 {
    let s: State = domain_separation(initialization(k, n));
    finalization(plaintext(s, padding[0]()).0, k)
  }

  // Section 4, Algorithm 2, processing ciphertext, over the padded C of b
  // blocks: P_i <- S_r ^ C_i and S_r <- C_i, then Ascon-p[8], for every
  // block but the last; for the last block P~ is the first |C| mod 16 bytes
  // of S_r ^ C~, which the caller takes. The last block's state is not
  // needed here; verify rebuilds it.
  spec ciphertext[b in 1..4](s: State, y: Word[8]^(16 * b)) -> Word[8]^(16 * b) {
    let r: (State, Word[8]^(16 * b)) =
      for i in 0..(b) with (t: State, p: Word[8]^(16 * b)) = (s, y) {
        let c: Word[64]^2 = y[16 * i..16 * i + 16] as little Word[64]^2;
        let q: Word[64]^2 = [t[0] ^ c[0], t[1] ^ c[1]];
        let u: State = (t with [0] = c[0]) with [1] = c[1];
        let next: State = if i < (b - 1) { permutation::ascon_p[8](u) } else { u };
        (next, p with [16 * i..16 * i + 16] = (q as little Word[8]^16))
      };
    r.1
  }

  // Section 4, Algorithm 2: the plaintext of |C| bytes, before the tag is
  // checked.
  spec plaintext_bytes[
    A in {Word[8]^1, Word[8]^7, Word[8]^8, Word[8]^16, Word[8]^32},
    len in 1..33
  ](
    k: Word[8]^16,
    n: Word[8]^16,
    a: A,
    c: Word[8]^len,
  ) -> Word[8]^len {
    let s: State = domain_separation(associated_data(initialization(k, n), pad(a)));
    ciphertext(s, pad(c))[..len]
  }

  // Section 4, Algorithm 2: S_r <- C_i is S_r <- S_r ^ P_i, and after the
  // last block S_r <- S_r ^ (P~ || 1 || 0^*) is the state encryption
  // reaches over the same P, so the tag T' is the tag of encrypting the
  // recovered P, and decryption succeeds when T' = T.
  spec verify[
    A in {Word[8]^1, Word[8]^7, Word[8]^8, Word[8]^16, Word[8]^32},
    len in 1..33
  ](
    k: Word[8]^16,
    n: Word[8]^16,
    a: A,
    c: Word[8]^len,
    t: Word[8]^16,
  ) -> Bool {
    let p: Word[8]^len = plaintext_bytes(k, n, a, c);
    encrypt(k, n, a, p)[len..] == t
  }

  // Section 4, Algorithm 2, Ascon-AEAD128 decryption: P when T verifies,
  // and fail otherwise. Orange has no value for fail, so the result is then
  // all zeros and the verdict of verify is false; no plaintext is released
  // before the tag is checked.
  spec decrypt[
    A in {Word[8]^1, Word[8]^7, Word[8]^8, Word[8]^16, Word[8]^32},
    len in 1..33
  ](
    k: Word[8]^16,
    n: Word[8]^16,
    a: A,
    c: Word[8]^len,
    t: Word[8]^16,
  ) -> Word[8]^len {
    if verify(k, n, a, c, t) { plaintext_bytes(k, n, a, c) } else { [0; len] }
  }

  // The inputs of LWC_AEAD_KAT_128_128.txt (generated by tests/genkat_aead.c
  // of ascon-c): the key 00 01 ... 0f, the nonce 10 11 ... 1f, and for
  // Count = 33 |P| + |A| + 1 the plaintext 20 21 ... of |P| bytes and the
  // associated data 30 31 ... of |A| bytes. Each test writes its PT and AD
  // as the file prints them, and its expected value is the file's CT,
  // C || T.
  spec kat_key() -> Word[8]^16 { hex"00010203 04050607 08090a0b 0c0d0e0f" }

  spec kat_nonce() -> Word[8]^16 { hex"10111213 14151617 18191a1b 1c1d1e1f" }

  test "LWC_AEAD_KAT_128_128 Count 1: empty P and A" {
    encrypt_empty(kat_key(), kat_nonce()) == hex"4f9c278211bec9316bf68f46ee8b2ec6"
  }

  test "LWC_AEAD_KAT_128_128 Count 2: empty P, 1-byte A" {
    encrypt_empty_p(kat_key(), kat_nonce(), hex"30") == hex"cccb674fe18a09a285d6ab11b35675c0"
  }

  test "LWC_AEAD_KAT_128_128 Count 17: empty P, 16-byte A" {
    let a: Word[8]^16 = hex"303132333435363738393a3b3c3d3e3f";
    encrypt_empty_p(kat_key(), kat_nonce(), a) == hex"e4230cdb8330ee9dc0cfd7c7b346e6dc"
  }

  test "LWC_AEAD_KAT_128_128 Count 33: empty P, 32-byte A" {
    let a: Word[8]^32 =
      hex"303132333435363738393a3b3c3d3e3f" ++ hex"404142434445464748494a4b4c4d4e4f";
    encrypt_empty_p(kat_key(), kat_nonce(), a) == hex"efc3e78b02ad9a80a6f0548c5b0bb5ba"
  }

  test "LWC_AEAD_KAT_128_128 Count 34: 1-byte P, empty A" {
    encrypt_empty_a(kat_key(), kat_nonce(), hex"20") == hex"e8dd576aba1cd3e6fc704de02aedb79588"
  }

  test "LWC_AEAD_KAT_128_128 Count 273: 8-byte P, 8-byte A" {
    let p: Word[8]^8 = hex"2021222324252627";
    let a: Word[8]^8 = hex"3031323334353637";
    encrypt(kat_key(), kat_nonce(), a, p) == hex"fabe2cb1e7eba63240524bc3388725341b84c3537042dec5"
  }

  test "LWC_AEAD_KAT_128_128 Count 545: 16-byte P, 16-byte A" {
    let p: Word[8]^16 = hex"202122232425262728292a2b2c2d2e2f";
    let a: Word[8]^16 = hex"303132333435363738393a3b3c3d3e3f";
    encrypt(kat_key(), kat_nonce(), a, p) ==
      hex"6373ebb28be97c9bac090cf399c13ef13abfc0d209e8f4844c90814d13f32c59"
  }

  test "LWC_AEAD_KAT_128_128 Count 767: 23-byte P, 7-byte A" {
    let p: Word[8]^23 = hex"202122232425262728292a2b2c2d2e2f" ++ hex"30313233343536";
    let a: Word[8]^7 = hex"30313233343536";
    encrypt(kat_key(), kat_nonce(), a, p) ==
      hex"6e024bd403f386eb9d1c56f459cfdcde1b2f6462f27f58127f1a88644e5d0e79a007ed237cd572"
  }

  test "LWC_AEAD_KAT_128_128 Count 1089: 32-byte P, 32-byte A" {
    let p: Word[8]^32 =
      hex"202122232425262728292a2b2c2d2e2f" ++ hex"303132333435363738393a3b3c3d3e3f";
    let a: Word[8]^32 =
      hex"303132333435363738393a3b3c3d3e3f" ++ hex"404142434445464748494a4b4c4d4e4f";
    encrypt(kat_key(), kat_nonce(), a, p) == (
      hex"cb34d04660a66dbfbe9c856601f5b8aa" ++ hex"51a499b55ac8f7fbefbc331a613ee9cd" ++
      hex"fd191750a47f211c0a15ed28173d7caa"
    )
  }

  // Count = 1089 taken apart for decryption: its AD, the 32 bytes of C and
  // the tag T that follow them in CT.
  spec kat_count_1089_a() -> Word[8]^32 {
    hex"303132333435363738393a3b3c3d3e3f" ++ hex"404142434445464748494a4b4c4d4e4f"
  }

  spec kat_count_1089_c() -> Word[8]^32 {
    hex"cb34d04660a66dbfbe9c856601f5b8aa" ++ hex"51a499b55ac8f7fbefbc331a613ee9cd"
  }

  spec kat_count_1089_t() -> Word[8]^16 { hex"fd191750a47f211c0a15ed28173d7caa" }

  // The PT field of Count = 1089, released because the tag verifies.
  test "LWC_AEAD_KAT_128_128 Count 1089: decryption returns P" {
    decrypt(kat_key(), kat_nonce(), kat_count_1089_a(), kat_count_1089_c(), kat_count_1089_t()) ==
      hex"202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f"
  }

  // The verdict of Algorithm 2 on Count = 1089.
  test "LWC_AEAD_KAT_128_128 Count 1089: the tag verifies" {
    verify(kat_key(), kat_nonce(), kat_count_1089_a(), kat_count_1089_c(), kat_count_1089_t())
  }

  // Count = 1089 with the last tag byte changed from 0xaa to 0xab:
  // Algorithm 2 returns fail. The verdict is the definition's; the Python
  // reference written for this entry agrees.
  test "LWC_AEAD_KAT_128_128 Count 1089 with the last tag byte changed: rejected" {
    let t: Word[8]^16 = kat_count_1089_t() with [15] = 0xab;
    !verify(kat_key(), kat_nonce(), kat_count_1089_a(), kat_count_1089_c(), t)
  }
}
