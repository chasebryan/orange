// AES-GCM: the Galois/Counter Mode of NIST SP 800-38D, Recommendation for
// Block Cipher Modes of Operation: Galois/Counter Mode (GCM) and GMAC
// (November 2007), https://doi.org/10.6028/NIST.SP.800-38D, with AES of
// FIPS 197 as the block cipher (the module aes, in aes.or beside this file;
// GCM never inverts the block cipher). The file transcribes the incrementing
// function (section 6.2), the block product (6.3, Algorithm 1) with the
// standard's bit order made explicit, GHASH (6.4, Algorithm 2), GCTR (6.5,
// Algorithm 3), the pre-counter block J0 for a 96-bit IV and through GHASH
// for any other IV length (7.1, step 2), GCM-AE (7.1, Algorithm 4) and
// GCM-AD (7.2, Algorithm 5), with 128-bit tags.
//
// It reproduces Test Cases 1, 2, 4 and 6 (AES-128) and 13 and 16 (AES-256)
// of the GCM specification (McGrew and Viega, 2005), case 2 of Wycheproof's
// aes_gcm_test.json (a 96-bit IV, an independent source), GCM-AD on Test
// Cases 4 and 6, and the decryption-error row of OpenSSL's
// evpciph_aes_common.txt that follows Test Case 6, whose changed tag GCM-AD
// rejects.
edition 2026;
module aes_gcm {
  use aes;

  type Block = Word[8]^16;

  // Section 6.2: inc_32(X) increments the rightmost 32 bits of X, as an
  // integer, modulo 2^32, and leaves the leftmost 96 bits unchanged.
  spec inc32(x: Block) -> Block {
    let counter: Word[32] = x[12..] as big Word[32];
    let next: Word[32] = counter + 1;
    x[..12] ++ (next as big Word[8]^4)
  }

  // Section 4.2.2: X ^ Y, the bitwise exclusive-or of two blocks.
  spec xor(x: Block, y: Block) -> Block {
    for i in 0..16 with z: Block = x { z with [i] = x[i] ^ y[i] }
  }

  // Section 6.3, Algorithm 1: the product X . Y of two blocks in GF(2^128).
  // The standard numbers the bits of a block from the left, x_0 x_1 ...
  // x_127, and the leftmost bit is the coefficient of x^0: a block is its
  // polynomial read in the reverse of the usual order. Here a block is read
  // as two 64-bit words, most significant byte first, so x_i is bit
  // 63 - (i mod 64) of word i / 64; V >> 1, multiplication by x, is a right
  // shift of the word pair; LSB_1(V) is bit 0 of the second word; and
  // R = 11100001 || 0^120, the reduction polynomial 1 + x + x^2 + x^7 + x^128
  // written in that order, is 0xe1 at the top of the first word. Step 2 sets
  // Z_0 = 0^128 and V_0 = Y, step 3 computes Z_(i+1) and V_(i+1) for i = 0
  // through 127, and step 4 returns Z_128.
  spec block_product(x: Block, y: Block) -> Block {
    let xw: Word[64]^2 = x as big Word[64]^2;
    let r: Word[64]^2 = hex"e1000000000000000000000000000000" as big Word[64]^2;
    let zv: (Word[64]^2, Word[64]^2) =
      for i in 0..128 with (z: Word[64]^2, v: Word[64]^2) = ([0, 0], y as big Word[64]^2) {
        let x_i: Word[64] = (xw[i / 64] >> (63 - (i % 64))) & 1;
        let shifted: Word[64]^2 = [v[0] >> 1, (v[1] >> 1) | (v[0] << 63)];
        (
          if x_i == 0 { z } else { [z[0] ^ v[0], z[1] ^ v[1]] },
          if (v[1] & 1) == 0 { shifted } else { [shifted[0] ^ r[0], shifted[1] ^ r[1]] },
        )
      };
    let z: Word[64]^2 = zv.0;
    z as big Word[8]^16
  }

  // Section 6.4, Algorithm 2: GHASH_H(X) for X = X_1 || ... || X_m, with
  // Y_0 = 0^128 and Y_i = (Y_(i-1) ^ X_i) . H; the result is Y_m. m runs
  // over 1 through 7, which covers the formatted inputs of the vectors.
  spec ghash[m in 1..8](h: Block, x: Word[8]^(16 * m)) -> Block {
    for i in 0..(m) with y: Block = [0; 16] { block_product(xor(y, x[16 * i..16 * i + 16]), h) }
  }

  // Section 6.5, Algorithm 3, steps 4 and 5: the counter blocks CB_1 = ICB
  // and CB_i = inc32(CB_(i-1)) for i = 2 through n, and their encryptions
  // CIPH_K(CB_i) of steps 6 and 7, joined into one keystream of n blocks. K
  // is the AES key, of 128 or 256 bits, and CIPH_K is aes::encrypt.
  spec keystream[K in {Word[8]^16, Word[8]^32}, n in 1..5](key: K, icb: Block)
    -> Word[8]^(16 * n) {
    let run: (Word[8]^(16 * n), Block) =
      for i in 0..(n) with (s: Word[8]^(16 * n), cb: Block) = ([0; (16 * n)], icb) {
        (s with [16 * i..16 * i + 16] = aes::encrypt(key, cb), inc32(cb))
      };
    run.0
  }

  // Section 6.5, Algorithm 3: GCTR_K(ICB, X) for X of len bytes, in
  // n = ceil(len(X) / 128) blocks (step 2), the last of them, X_n*, possibly
  // partial. Y_i = X_i ^ CIPH_K(CB_i) for the whole blocks and
  // Y_n* = X_n* ^ MSB_len(X_n*)(CIPH_K(CB_n)) for the last (steps 6 and 7),
  // so Y is X xored with the leading len(X) bits of the keystream. Step 1,
  // the empty X, has no value here (an array has at least one element);
  // GCM-AE below writes the empty plaintext separately.
  spec gctr[K in {Word[8]^16, Word[8]^32}, len in 1..65](key: K, icb: Block, x: Word[8]^len)
    -> Word[8]^len {
    let stream: Word[8]^(16 * ((len + 15) / 16)) = keystream[K, (len + 15) / 16](key, icb);
    for i in 0..(len) with y: Word[8]^len = x { y with [i] = x[i] ^ stream[i] }
  }

  // X || 0^s: a string of len bytes followed by the fewest zero bits that
  // make whole blocks, as section 7.1 pads the IV (step 2) and A and C
  // (Algorithm 4, step 5).
  spec pad[len in 1..65](x: Word[8]^len) -> Word[8]^(16 * ((len + 15) / 16)) {
    [0; (16 * ((len + 15) / 16))] with [0..len] = x
  }

  // Section 4.2.2: [len(X)]_64, the bit length of X as a 64-bit string, most
  // significant bit first.
  spec bit_length[len in 1..65](x: Word[8]^len) -> Word[8]^8 {
    let l: Int = 8 * len;
    l as big Word[8]^8
  }

  // Section 7.1, Algorithm 4, step 2: the pre-counter block J0. If
  // len(IV) = 96, J0 = IV || 0^31 || 1. Otherwise, with s the zero bits that
  // pad the IV to whole blocks, J0 = GHASH_H(IV || 0^(s+64) || [len(IV)]_64).
  // Every instance of the spec is checked, and for an IV of other than 12
  // bytes IV || 0^31 || 1 is not a block, so the first branch takes the
  // leading sixteen bytes of IV || 0^31 || 1 || 0^96, which for a 12-byte IV
  // are IV || 0^31 || 1 exactly; it runs only for that IV.
  spec pre_counter_block[len in 1..65](h: Block, iv: Word[8]^len) -> Block {
    if len == 12 {
      let j: Word[8]^(len + 16) = iv ++ hex"00000001" ++ [0; 12];
      j[..16]
    } else {
      ghash(h, pad(iv) ++ [0; 8] ++ bit_length(iv))
    }
  }

  // Section 7.1, Algorithm 4: GCM-AE_K(IV, P, A) = (C, T) with the full
  // tag, t = 128, so MSB_t in step 6 is the identity and is not written.
  // Step 1: H = CIPH_K(0^128). Step 2: J0. Step 3: C = GCTR_K(inc32(J0), P).
  // Steps 4 and 5: S = GHASH_H(A || 0^v || C || 0^u || [len(A)]_64 ||
  // [len(C)]_64), u and v the zero bits that pad C and A to whole blocks.
  // Step 6: T = GCTR_K(J0, S). The key, IV, P and A are byte strings whose
  // lengths are their types, listed here as the vectors use them.
  spec gcm_ae[
    K in {Word[8]^16, Word[8]^32},
    IV in {Word[8]^12, Word[8]^60},
    P in {Word[8]^16, Word[8]^60},
    A in {Word[8]^16, Word[8]^20}
  ](key: K, iv: IV, p: P, a: A) -> (P, Block) {
    let h: Block = aes::encrypt(key, [0; 16]);
    let j0: Block = pre_counter_block(h, iv);
    let c: P = gctr(key, inc32(j0), p);
    let s: Block = ghash(h, pad(a) ++ pad(c) ++ bit_length(a) ++ bit_length(c));
    (c, gctr(key, j0, s))
  }

  // Algorithm 4 with A the empty string, which has no value of its own:
  // A || 0^v is empty and [len(A)]_64 is 0^64, so step 5 hashes
  // C || 0^u || 0^64 || [len(C)]_64.
  spec gcm_ae_empty_a[
    K in {Word[8]^16, Word[8]^32},
    IV in {Word[8]^12, Word[8]^60},
    P in {Word[8]^16, Word[8]^60}
  ](key: K, iv: IV, p: P) -> (P, Block) {
    let h: Block = aes::encrypt(key, [0; 16]);
    let j0: Block = pre_counter_block(h, iv);
    let c: P = gctr(key, inc32(j0), p);
    let s: Block = ghash(h, pad(c) ++ [0; 8] ++ bit_length(c));
    (c, gctr(key, j0, s))
  }

  // Algorithm 4 with P and A both empty: C is the empty string (Algorithm 3,
  // step 1), and step 5 hashes the length block 0^64 || 0^64 alone. The
  // result is T.
  spec gcm_ae_empty[K in {Word[8]^16, Word[8]^32}, IV in {Word[8]^12, Word[8]^60}](
    key: K,
    iv: IV,
  ) -> Block {
    let h: Block = aes::encrypt(key, [0; 16]);
    let j0: Block = pre_counter_block(h, iv);
    gctr(key, j0, ghash(h, [0; 16]))
  }

  // Section 7.2, Algorithm 5: GCM-AD_K(IV, C, A, T). Step 1, the checks on
  // the lengths of IV, C, A and T, is not written: the inputs are the
  // vectors' own. Steps 2 to 7 are those of GCM-AE: H, J0,
  // P = GCTR_K(inc32(J0), C), S over A and C, and T' = GCTR_K(J0, S) with
  // t = 128. Step 8 returns P if T = T' and FAIL otherwise. A spec has one
  // result type, so the result is the verdict T = T' with the P of step 4
  // beside it: FAIL is a false verdict, and then P is not to be used.
  spec gcm_ad[
    K in {Word[8]^16, Word[8]^32},
    IV in {Word[8]^12, Word[8]^60},
    C in {Word[8]^16, Word[8]^60},
    A in {Word[8]^16, Word[8]^20}
  ](key: K, iv: IV, c: C, a: A, t: Block) -> (Bool, C) {
    let h: Block = aes::encrypt(key, [0; 16]);
    let j0: Block = pre_counter_block(h, iv);
    let p: C = gctr(key, inc32(j0), c);
    let s: Block = ghash(h, pad(a) ++ pad(c) ++ bit_length(a) ++ bit_length(c));
    let t_prime: Block = gctr(key, j0, s);
    (t == t_prime, p)
  }

  // The vectors. Test Cases 4, 6 and 16 of the GCM specification share the
  // 60-byte plaintext and the 20-byte additional data below; Test Cases 1,
  // 2 and 13 use the zero key and the zero 96-bit IV.

  // GCM specification, Test Cases 4, 6 and 16: P.
  spec test_case_4_p() -> Word[8]^60 {
    hex"d9313225f88406e5a55909c5aff5269a 86a7a9531534f7da2e4c303d8a318a72" ++
    hex"1c3c0c95956809532fcf0e2449a6b525 b16aedf5aa0de657ba637b39"
  }

  // GCM specification, Test Cases 4, 6 and 16: A.
  spec test_case_4_a() -> Word[8]^20 { hex"feedfacedeadbeeffeedfacedeadbeef abaddad2" }

  // GCM specification, Test Case 1: AES-128, zero key, zero 96-bit IV, empty
  // P and A; C is empty and T is the encryption of the length block's hash.
  test "GCM specification Test Case 1: AES-128, empty P and A" {
    let key: Word[8]^16 = [0; 16];
    let iv: Word[8]^12 = [0; 12];
    gcm_ae_empty(key, iv) == hex"58e2fccefa7e3061367f1d57a4e7455a"
  }

  // GCM specification, Test Case 2: AES-128, zero key and IV, one zero block
  // of P, empty A.
  test "GCM specification Test Case 2: AES-128, one block of P, empty A" {
    let key: Word[8]^16 = [0; 16];
    let iv: Word[8]^12 = [0; 12];
    let p: Word[8]^16 = [0; 16];
    gcm_ae_empty_a(key, iv, p) ==
      (hex"0388dace60b6a392f328c2b971b2fe78", hex"ab6e47d42cec13bdf53a67b21257bddf")
  }

  // GCM specification, Test Case 4: AES-128, 96-bit IV, 60-byte P, 20-byte A.
  test "GCM specification Test Case 4: AES-128, 60-byte P, 20-byte A" {
    let key: Word[8]^16 = hex"feffe9928665731c6d6a8f9467308308";
    let iv: Word[8]^12 = hex"cafebabefacedbaddecaf888";
    let c: Word[8]^60 =
      hex"42831ec2217774244b7221b784d0d49c e3aa212f2c02a4e035c17e2329aca12e" ++
      hex"21d514b25466931c7d8f6a5aac84aa05 1ba30b396a0aac973d58e091";
    gcm_ae(key, iv, test_case_4_p(), test_case_4_a()) ==
      (c, hex"5bc94fbc3221a5db94fae95ae7121a47")
  }

  // GCM specification, Test Case 6: as Test Case 4 with a 60-byte IV, so
  // that J0 is a GHASH.
  test "GCM specification Test Case 6: AES-128, 60-byte IV" {
    let key: Word[8]^16 = hex"feffe9928665731c6d6a8f9467308308";
    let iv: Word[8]^60 =
      hex"9313225df88406e555909c5aff5269aa 6a7a9538534f7da1e4c303d2a318a728" ++
      hex"c3c0c95156809539fcf0e2429a6b5254 16aedbf5a0de6a57a637b39b";
    let c: Word[8]^60 =
      hex"8ce24998625615b603a033aca13fb894 be9112a5c3a211a8ba262a3cca7e2ca7" ++
      hex"01e4a9a4fba43c90ccdcb281d48c7c6f d62875d2aca417034c34aee5";
    gcm_ae(key, iv, test_case_4_p(), test_case_4_a()) ==
      (c, hex"619cc5aefffe0bfa462af43c1699d050")
  }

  // Wycheproof testvectors_v1/aes_gcm_test.json, tcId 2 (flag Ktv): AES-128,
  // 96-bit IV, 16-byte msg, 16-byte aad.
  test "Wycheproof aes_gcm_test.json tcId 2: AES-128" {
    let key: Word[8]^16 = hex"5b9604fe14eadba931b0ccf34843dab9";
    let iv: Word[8]^12 = hex"921d2507fa8007b7bd067d34";
    let msg: Word[8]^16 = hex"001d0c231287c1182784554ca3a21908";
    let aad: Word[8]^16 = hex"00112233445566778899aabbccddeeff";
    gcm_ae(key, iv, msg, aad) ==
      (hex"49d8b9783e911913d87094d1f63cc765", hex"1e348ba07cca2cf04c618cb4d43a5b92")
  }

  // GCM specification, Test Case 4, decrypted: GCM-AD on its C, A and T
  // finds T = T' and returns P.
  test "GCM specification Test Case 4: GCM-AD returns P" {
    let key: Word[8]^16 = hex"feffe9928665731c6d6a8f9467308308";
    let iv: Word[8]^12 = hex"cafebabefacedbaddecaf888";
    let c: Word[8]^60 =
      hex"42831ec2217774244b7221b784d0d49c e3aa212f2c02a4e035c17e2329aca12e" ++
      hex"21d514b25466931c7d8f6a5aac84aa05 1ba30b396a0aac973d58e091";
    let t: Block = hex"5bc94fbc3221a5db94fae95ae7121a47";
    gcm_ad(key, iv, c, test_case_4_a(), t) == (true, test_case_4_p())
  }

  // GCM specification, Test Case 6, decrypted: GCM-AD with the 60-byte IV on
  // its C, A and T finds T = T' and returns P. It is the accepting
  // counterpart of the changed-tag row below, on the same path through the
  // GHASH-derived J0.
  test "GCM specification Test Case 6: GCM-AD returns P" {
    let key: Word[8]^16 = hex"feffe9928665731c6d6a8f9467308308";
    let iv: Word[8]^60 =
      hex"9313225df88406e555909c5aff5269aa 6a7a9538534f7da1e4c303d2a318a728" ++
      hex"c3c0c95156809539fcf0e2429a6b5254 16aedbf5a0de6a57a637b39b";
    let c: Word[8]^60 =
      hex"8ce24998625615b603a033aca13fb894 be9112a5c3a211a8ba262a3cca7e2ca7" ++
      hex"01e4a9a4fba43c90ccdcb281d48c7c6f d62875d2aca417034c34aee5";
    let t: Block = hex"619cc5aefffe0bfa462af43c1699d050";
    gcm_ad(key, iv, c, test_case_4_a(), t) == (true, test_case_4_p())
  }

  // OpenSSL evpciph_aes_common.txt, the Operation = DECRYPT,
  // Result = CIPHERFINAL_ERROR row that follows Test Case 6: Test Case 6's
  // key, IV, A and C with the tag's last byte 0x50 changed to 0x51. GCM-AD
  // returns FAIL.
  test "OpenSSL evpciph_aes_common.txt: Test Case 6 with a changed tag fails" {
    let key: Word[8]^16 = hex"feffe9928665731c6d6a8f9467308308";
    let iv: Word[8]^60 =
      hex"9313225df88406e555909c5aff5269aa 6a7a9538534f7da1e4c303d2a318a728" ++
      hex"c3c0c95156809539fcf0e2429a6b5254 16aedbf5a0de6a57a637b39b";
    let c: Word[8]^60 =
      hex"8ce24998625615b603a033aca13fb894 be9112a5c3a211a8ba262a3cca7e2ca7" ++
      hex"01e4a9a4fba43c90ccdcb281d48c7c6f d62875d2aca417034c34aee5";
    let t: Block = hex"619cc5aefffe0bfa462af43c1699d051";
    let result: (Bool, Word[8]^60) = gcm_ad(key, iv, c, test_case_4_a(), t);
    !result.0
  }

  // GCM specification, Test Case 13: AES-256, zero key, zero 96-bit IV,
  // empty P and A.
  test "GCM specification Test Case 13: AES-256, empty P and A" {
    let key: Word[8]^32 = [0; 32];
    let iv: Word[8]^12 = [0; 12];
    gcm_ae_empty(key, iv) == hex"530f8afbc74536b9a963b4f1c4cb738b"
  }

  // GCM specification, Test Case 16: AES-256, the key feffe992...8308 twice,
  // 96-bit IV, 60-byte P, 20-byte A.
  test "GCM specification Test Case 16: AES-256, 60-byte P, 20-byte A" {
    let key: Word[8]^32 =
      hex"feffe9928665731c6d6a8f9467308308 feffe9928665731c6d6a8f9467308308";
    let iv: Word[8]^12 = hex"cafebabefacedbaddecaf888";
    let c: Word[8]^60 =
      hex"522dc1f099567d07f47f37a32a84427d 643a8cdcbfe5c0c97598a2bd2555d1aa" ++
      hex"8cb08e48590dbb3da7b08b1056828838 c5f61e6393ba7a0abcc9f662";
    gcm_ae(key, iv, test_case_4_p(), test_case_4_a()) ==
      (c, hex"76fc6ece0f4e1768cddf8853bb2d551b")
  }
}
