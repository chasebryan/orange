// AES-GCM of NIST SP 800-38D (2007), https://doi.org/10.6028/NIST.SP.800-38D,
// with AES-128: the authenticated decryption function GCM-AD of section 7.2
// (algorithm 5) over the same cipher, block product, GHASH, GCTR and J0 as
// aes-gcm-iv.or. It decrypts and verifies Test Case 4 of the GCM
// specification (McGrew and Viega, 2005), and returns FAIL for the tag of
// Test Case 6 with one byte changed (the decryption-error row of OpenSSL's
// evpciph_aes_common.txt). It is a separate file because of the step budget.
edition 2026;
module aes_gcm {
  spec load_be32(b0: Word[8], b1: Word[8], b2: Word[8], b3: Word[8]) -> Word[32] {
    ((b0 as Word[32]) << 24) | ((b1 as Word[32]) << 16) | ((b2 as Word[32]) << 8) | (b3 as Word[32])
  }

  spec be_bytes(x: Word[32]) -> Word[8]^4 {
    [(x >> 24) as Word[8], (x >> 16) as Word[8], (x >> 8) as Word[8], x as Word[8]]
  }

  spec load_be64(
    b0: Word[8], b1: Word[8], b2: Word[8], b3: Word[8],
    b4: Word[8], b5: Word[8], b6: Word[8], b7: Word[8],
  ) -> Word[64] {
    ((b0 as Word[64]) << 56) | ((b1 as Word[64]) << 48) | ((b2 as Word[64]) << 40)
      | ((b3 as Word[64]) << 32) | ((b4 as Word[64]) << 24) | ((b5 as Word[64]) << 16)
      | ((b6 as Word[64]) << 8) | (b7 as Word[64])
  }

  spec be_bytes64(x: Word[64]) -> Word[8]^8 {
    [
      (x >> 56) as Word[8], (x >> 48) as Word[8], (x >> 40) as Word[8], (x >> 32) as Word[8],
      (x >> 24) as Word[8], (x >> 16) as Word[8], (x >> 8) as Word[8], x as Word[8],
    ]
  }

  // A 128-bit block as two 64-bit words, the first eight bytes in the first
  // word, most significant byte first, so that the standard's bit 0 (the
  // leftmost bit of the block) is the top bit of the first word.
  spec block_words(b: Word[8]^16) -> Word[64]^2 {
    [
      load_be64(b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]),
      load_be64(b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]),
    ]
  }

  spec block_bytes(x: Word[64]^2) -> Word[8]^16 {
    for i in 0..2 with b: Word[8]^16 = [0; 16] {
      for j in 0..8 with out: Word[8]^16 = b { out with [8 * i + j] = be_bytes64(x[i])[j] }
    }
  }

  // FIPS 197 section 5.1.1, Table 4 (Figure 7 in the 2001 text): the S-box,
  // packed eight entries to a word so that each literal reads as a row of
  // the table (0x637c777bf26b6fc5 is 63 7c 77 7b f2 6b 6f c5); an index must
  // be static, so a lookup is a selection over the 32 words.
  spec s_box() -> Word[64]^32 {
    [
      0x637c777bf26b6fc5, 0x3001672bfed7ab76, 0xca82c97dfa5947f0, 0xadd4a2af9ca472c0,
      0xb7fd9326363ff7cc, 0x34a5e5f171d83115, 0x04c723c31896059a, 0x071280e2eb27b275,
      0x09832c1a1b6e5aa0, 0x523bd6b329e32f84, 0x53d100ed20fcb15b, 0x6acbbe394a4c58cf,
      0xd0efaafb434d3385, 0x45f9027f503c9fa8, 0x51a3408f929d38f5, 0xbcb6da2110fff3d2,
      0xcd0c13ec5f974417, 0xc4a77e3d645d1973, 0x60814fdc222a9088, 0x46eeb814de5e0bdb,
      0xe0323a0a4906245c, 0xc2d3ac629195e479, 0xe7c8376d8dd54ea9, 0x6c56f4ea657aae08,
      0xba78252e1ca6b4c6, 0xe8dd741f4bbd8b8a, 0x703eb5664803f60e, 0x613557b986c11d9e,
      0xe1f8981169d98e94, 0x9b1e87e9ce5528df, 0x8ca1890dbfe64268, 0x41992d0fb054bb16,
    ]
  }

  // The byte at position k of a word holding eight table entries.
  spec byte_at(w: Word[64], k: Word[8]) -> Word[8] {
    if k == 0 { (w >> 56) as Word[8] }
    else if k == 1 { (w >> 48) as Word[8] }
    else if k == 2 { (w >> 40) as Word[8] }
    else if k == 3 { (w >> 32) as Word[8] }
    else if k == 4 { (w >> 24) as Word[8] }
    else if k == 5 { (w >> 16) as Word[8] }
    else if k == 6 { (w >> 8) as Word[8] }
    else { w as Word[8] }
  }

  // Entry x of a 256-entry table packed eight entries to a word.
  spec lookup(t: Word[64]^32, x: Word[8]) -> Word[8] {
    let w: Word[64] = for i in 0..32 with acc: Word[64] = 0 {
      if (x >> 3) == (i as Word[8]) { t[i] } else { acc }
    };
    byte_at(w, x & 7)
  }

  // FIPS 197 section 4.2.1: multiplication by x in GF(2^8) modulo
  // x^8 + x^4 + x^3 + x + 1.
  spec xtime(a: Word[8]) -> Word[8] {
    (a << 1) ^ (if (a & 0x80) != 0 { 0x1b } else { 0 })
  }

  // FIPS 197 section 5.2: the key expansion. RotWord, SubWord, and the round
  // constants Rcon[i] = [x^(i-1), 00, 00, 00] for i = 1 through 10.
  spec rot_word(w: Word[32]) -> Word[32] { w <<< 8 }

  spec sub_word(sbox: Word[64]^32, w: Word[32]) -> Word[32] {
    let b: Word[8]^4 = be_bytes(w);
    load_be32(lookup(sbox, b[0]), lookup(sbox, b[1]), lookup(sbox, b[2]), lookup(sbox, b[3]))
  }

  spec rcon() -> Word[32]^10 {
    [
      0x01000000, 0x02000000, 0x04000000, 0x08000000, 0x10000000,
      0x20000000, 0x40000000, 0x80000000, 0x1b000000, 0x36000000,
    ]
  }

  // Section 5.2 for Nk = 4: the first four words are the key, and word i is
  // word i - 4 xored with word i - 1, transformed every fourth word.
  spec key_expansion(key: Word[8]^16) -> Word[32]^44 {
    let sbox: Word[64]^32 = s_box();
    let r: Word[32]^10 = rcon();
    let head: Word[32]^44 = for i in 0..4 with w: Word[32]^44 = [0; 44] {
      w with [i] = load_be32(key[4 * i], key[4 * i + 1], key[4 * i + 2], key[4 * i + 3])
    };
    for i in 4..44 with w: Word[32]^44 = head {
      w with [i] = w[i - 4] ^ (
        if (i % 4) == 0 { sub_word(sbox, rot_word(w[i - 1])) ^ r[(i / 4) - 1] } else { w[i - 1] }
      )
    }
  }

  // Section 3.4: the state is the 4 x 4 array s[r, c] = in[r + 4c], kept
  // here in that byte order.
  // Section 5.1.1: SubBytes.
  spec sub_bytes(sbox: Word[64]^32, s: Word[8]^16) -> Word[8]^16 {
    for i in 0..16 with t: Word[8]^16 = s { t with [i] = lookup(sbox, s[i]) }
  }

  // Section 5.1.2: ShiftRows, row r rotated left by r positions.
  spec shift_rows(s: Word[8]^16) -> Word[8]^16 {
    [
      s[0], s[5], s[10], s[15],
      s[4], s[9], s[14], s[3],
      s[8], s[13], s[2], s[7],
      s[12], s[1], s[6], s[11],
    ]
  }

  // Section 5.1.3: MixColumns, one column multiplied by {03}x^3 + {01}x^2
  // + {01}x + {02} modulo x^4 + 1, with {02}a = xtime(a) and {03}a = xtime(a) ^ a.
  spec mix_column(a0: Word[8], a1: Word[8], a2: Word[8], a3: Word[8]) -> Word[8]^4 {
    [
      xtime(a0) ^ (xtime(a1) ^ a1) ^ a2 ^ a3,
      a0 ^ xtime(a1) ^ (xtime(a2) ^ a2) ^ a3,
      a0 ^ a1 ^ xtime(a2) ^ (xtime(a3) ^ a3),
      (xtime(a0) ^ a0) ^ a1 ^ a2 ^ xtime(a3),
    ]
  }

  spec mix_columns(s: Word[8]^16) -> Word[8]^16 {
    let c0: Word[8]^4 = mix_column(s[0], s[1], s[2], s[3]);
    let c1: Word[8]^4 = mix_column(s[4], s[5], s[6], s[7]);
    let c2: Word[8]^4 = mix_column(s[8], s[9], s[10], s[11]);
    let c3: Word[8]^4 = mix_column(s[12], s[13], s[14], s[15]);
    [
      c0[0], c0[1], c0[2], c0[3],
      c1[0], c1[1], c1[2], c1[3],
      c2[0], c2[1], c2[2], c2[3],
      c3[0], c3[1], c3[2], c3[3],
    ]
  }

  // Section 5.1.4: AddRoundKey, column c xored with round-key word c.
  spec add_round_key(s: Word[8]^16, k: Word[32]^4) -> Word[8]^16 {
    for c in 0..4 with t: Word[8]^16 = s {
      for r in 0..4 with u: Word[8]^16 = t { u with [4 * c + r] = u[4 * c + r] ^ be_bytes(k[c])[r] }
    }
  }

  // Section 5.1, algorithm 1: the cipher with Nr = 10 rounds over the
  // expanded key w. The final round has no MixColumns.
  spec cipher(w: Word[32]^44, input: Word[8]^16) -> Word[8]^16 {
    let sbox: Word[64]^32 = s_box();
    let start: Word[8]^16 = add_round_key(input, [w[0], w[1], w[2], w[3]]);
    let rounds: Word[8]^16 = for round in 1..10 with s: Word[8]^16 = start {
      add_round_key(
        mix_columns(shift_rows(sub_bytes(sbox, s))),
        [w[4 * round], w[4 * round + 1], w[4 * round + 2], w[4 * round + 3]],
      )
    };
    add_round_key(shift_rows(sub_bytes(sbox, rounds)), [w[40], w[41], w[42], w[43]])
  }

  // SP 800-38D section 6.2: inc32, the rightmost 32 bits incremented modulo
  // 2^32 and the other 96 bits unchanged.
  spec inc32(x: Word[64]^2) -> Word[64]^2 {
    [x[0], (x[1] & 0xffffffff00000000) | (((x[1] as Word[32]) + 1) as Word[64])]
  }

  // Section 6.3, algorithm 1: the product X . Y in GF(2^128). The standard
  // numbers the bits of a block from the left, x_0 x_1 ... x_127, and the
  // leftmost bit is the coefficient of x^0: a block is the polynomial read
  // in the reverse of the usual order. So x_i is the top bit of X after i
  // left shifts of the word pair, the standard's V >> 1 (multiplication by
  // x) is a right shift of the pair, LSB_1(V) is bit 0 of the low word, and
  // R = 11100001 || 0^120, the reduction polynomial 1 + x + x^2 + x^7 + x^128
  // written in that order, is 0xe1 followed by zeros: it lands in the high
  // word. The accumulator is [X, V, Z], two words each.
  spec block_product(x: Word[64]^2, y: Word[64]^2) -> Word[64]^2 {
    let s: Word[64]^6 = for i in 0..128 with s: Word[64]^6 = [x[0], x[1], y[0], y[1], 0, 0] {
      [
        (s[0] << 1) | (s[1] >> 63),
        s[1] << 1,
        (s[2] >> 1) ^ (if (s[3] & 1) != 0 { 0xe100000000000000 } else { 0 }),
        (s[3] >> 1) | (s[2] << 63),
        if (s[0] & 0x8000000000000000) != 0 { s[4] ^ s[2] } else { s[4] },
        if (s[0] & 0x8000000000000000) != 0 { s[5] ^ s[3] } else { s[5] },
      ]
    };
    [s[4], s[5]]
  }

  // Section 6.4, algorithm 2: GHASH_H(X) for X = X_1 || ... || X_m, with
  // Y_0 = 0 and Y_i = (Y_{i-1} ^ X_i) . H. The buffer holds up to seven
  // blocks and m says how many are used.
  spec ghash(h: Word[64]^2, x: Word[64]^14, m: Int) -> Word[64]^2 {
    for i in 0..7 with y: Word[64]^2 = [0, 0] {
      if i < m { block_product([y[0] ^ x[2 * i], y[1] ^ x[2 * i + 1]], h) } else { y }
    }
  }

  // Section 6.5, algorithm 3: CB_1 = ICB and CB_i = inc32(CB_{i-1}), so the
  // counter block of block i (from 0) is inc32 applied i times to ICB.
  spec counter_block(icb: Word[64]^2, i: Int) -> Word[64]^2 {
    for k in 0..4 with cb: Word[64]^2 = icb { if k < i { inc32(cb) } else { cb } }
  }

  // Y_i = X_i ^ CIPH_K(CB_i), and for the last, partial block only its
  // len(X_n*) leading bytes. The block index is a value, so the bytes of
  // block i are found by comparing n / 16 with i.
  spec xor_block(y: Word[8]^64, x: Word[8]^64, ks: Word[8]^16, i: Int, len: Int) -> Word[8]^64 {
    for n in 0..64 with out: Word[8]^64 = y {
      if ((n / 16) == i) && (n < len) { out with [n] = x[n] ^ ks[n % 16] } else { out }
    }
  }

  // Section 6.5, algorithm 3: GCTR_K(ICB, X) for X of len bytes in a 64-byte
  // buffer; the bytes past len are zero, which is also the padding of
  // section 7.1 step 5. A block past the end costs nothing: it is skipped.
  spec gctr(w: Word[32]^44, icb: Word[64]^2, x: Word[8]^64, len: Int) -> Word[8]^64 {
    for i in 0..4 with y: Word[8]^64 = [0; 64] {
      if (16 * i) < len {
        xor_block(y, x, cipher(w, block_bytes(counter_block(icb, i))), i, len)
      } else { y }
    }
  }

  // Section 7.1, step 2: J0, the pre-counter block. For a 96-bit IV,
  // J0 = IV || 0^31 || 1; for any other length, with s the padding to a block
  // boundary, J0 = GHASH_H(IV || 0^(s+64) || [len(IV)]64). The IV travels in
  // a 64-byte buffer with its length, so the GHASH branch is taken only when
  // len_iv is not 12.
  spec pre_counter_block(h: Word[64]^2, iv: Word[8]^64, len_iv: Int) -> Word[64]^2 {
    if len_iv == 12 {
      [
        load_be64(iv[0], iv[1], iv[2], iv[3], iv[4], iv[5], iv[6], iv[7]),
        load_be64(iv[8], iv[9], iv[10], iv[11], 0, 0, 0, 1),
      ]
    } else {
      ghash(h, j0_input(iv, len_iv), ((len_iv + 15) / 16) + 1)
    }
  }

  // The GHASH input of step 2: the IV padded with zeros to a block boundary,
  // then the block 0^64 || [len(IV)]64 at index ceil(len_iv / 16).
  spec j0_input(iv: Word[8]^64, len_iv: Int) -> Word[64]^14 {
    let m: Int = (len_iv + 15) / 16;
    let padded: Word[8]^64 = for i in 0..64 with b: Word[8]^64 = iv {
      b with [i] = if i < len_iv { iv[i] } else { 0 }
    };
    let words: Word[64]^14 = for i in 0..8 with x: Word[64]^14 = [0; 14] {
      x with [i] = load_be64(
        padded[8 * i], padded[8 * i + 1], padded[8 * i + 2], padded[8 * i + 3],
        padded[8 * i + 4], padded[8 * i + 5], padded[8 * i + 6], padded[8 * i + 7],
      )
    };
    for d in 0..7 with x: Word[64]^14 = [0; 14] {
      for j in 0..2 with y: Word[64]^14 = x {
        y with [2 * d + j] =
          if d < m { words[2 * d + j] }
          else if (d == m) && (j == 1) { (8 * len_iv) as Word[64] }
          else { 0 }
      }
    }
  }

  // The word at index i of eight, i a value: a selection, as an index must
  // be static.
  spec word_at(x: Word[64]^8, i: Int) -> Word[64] {
    for k in 0..8 with acc: Word[64] = 0 { if k == i { x[k] } else { acc } }
  }

  // Section 7.1, steps 4 and 5: the input to GHASH,
  // A || 0^v || C || 0^u || [len(A)]64 || [len(C)]64, with lengths in bits.
  // A occupies ceil(len_a / 16) blocks, C follows, then the length block;
  // C's block d - m_a is selected by value because m_a is a value.
  spec ghash_input(a: Word[8]^32, len_a: Int, c: Word[8]^64, len_c: Int) -> Word[64]^14 {
    let m_a: Int = (len_a + 15) / 16;
    let m_c: Int = (len_c + 15) / 16;
    let a_padded: Word[8]^32 = for i in 0..32 with b: Word[8]^32 = a {
      b with [i] = if i < len_a { a[i] } else { 0 }
    };
    let a_words: Word[64]^8 = for i in 0..4 with x: Word[64]^8 = [0; 8] {
      x with [i] = load_be64(
        a_padded[8 * i], a_padded[8 * i + 1], a_padded[8 * i + 2], a_padded[8 * i + 3],
        a_padded[8 * i + 4], a_padded[8 * i + 5], a_padded[8 * i + 6], a_padded[8 * i + 7],
      )
    };
    let c_words: Word[64]^8 = for i in 0..8 with x: Word[64]^8 = [0; 8] {
      x with [i] = load_be64(
        c[8 * i], c[8 * i + 1], c[8 * i + 2], c[8 * i + 3],
        c[8 * i + 4], c[8 * i + 5], c[8 * i + 6], c[8 * i + 7],
      )
    };
    let lengths: Word[64]^2 = [(8 * len_a) as Word[64], (8 * len_c) as Word[64]];
    for d in 0..7 with x: Word[64]^14 = [0; 14] {
      for j in 0..2 with y: Word[64]^14 = x {
        y with [2 * d + j] =
          if d < m_a { word_at(a_words, 2 * d + j) }
          else if d < (m_a + m_c) { word_at(c_words, 2 * (d - m_a) + j) }
          else if d == (m_a + m_c) { lengths[j] }
          else { 0 }
      }
    }
  }

  // Section 7.2, algorithm 5: GCM-AD_K(IV, C, A, T). A spec returns one
  // value, so the algorithm is two specs over the same steps 2 and 3:
  // gcm_ad_verify computes T' (steps 5 to 7) and gives the verdict of step 8,
  // T = T', and gcm_ad_plaintext gives the P of step 4. A caller returns P
  // when the verdict is true and FAIL when it is false.
  spec gcm_ad_verify(
    key: Word[8]^16,
    iv: Word[8]^64,
    len_iv: Int,
    c: Word[8]^64,
    len_c: Int,
    a: Word[8]^32,
    len_a: Int,
    t: Word[8]^16,
  ) -> Bool {
    let w: Word[32]^44 = key_expansion(key);
    let h: Word[64]^2 = block_words(cipher(w, [0; 16]));
    let j0: Word[64]^2 = pre_counter_block(h, iv, len_iv);
    let s: Word[64]^2 = ghash(h, ghash_input(a, len_a, c, len_c), ghash_blocks(len_a, len_c));
    let t2: Word[8]^64 = gctr(w, j0, block_padded(block_bytes(s)), 16);
    for i in 0..16 with equal: Bool = true { equal && (t[i] == t2[i]) }
  }

  spec gcm_ad_plaintext(
    key: Word[8]^16,
    iv: Word[8]^64,
    len_iv: Int,
    c: Word[8]^64,
    len_c: Int,
  ) -> Word[8]^64 {
    let w: Word[32]^44 = key_expansion(key);
    let h: Word[64]^2 = block_words(cipher(w, [0; 16]));
    let j0: Word[64]^2 = pre_counter_block(h, iv, len_iv);
    gctr(w, inc32(j0), c, len_c)
  }

  // The formatted input has ceil(len(A) / 16) + ceil(len(C) / 16) + 1 blocks.
  spec ghash_blocks(len_a: Int, len_c: Int) -> Int { ((len_a + 15) / 16) + ((len_c + 15) / 16) + 1 }

  // One block at the head of a 64-byte GCTR buffer, for the tag.
  spec block_padded(b: Word[8]^16) -> Word[8]^64 {
    for i in 0..16 with out: Word[8]^64 = [0; 64] { out with [i] = b[i] }
  }

  // GCM specification, Test Case 4 (AES-128, 12-byte IV, 60-byte C, 20-byte A),
  // decrypted: T = T' and P.
  spec nist_gcm_test_case_4_verify() -> Bool {
    gcm_ad_verify(
      [
        0xfe, 0xff, 0xe9, 0x92, 0x86, 0x65, 0x73, 0x1c, 0x6d, 0x6a, 0x8f, 0x94, 0x67, 0x30, 0x83, 0x08,
      ],
      [
        0xca, 0xfe, 0xba, 0xbe, 0xfa, 0xce, 0xdb, 0xad, 0xde, 0xca, 0xf8, 0x88, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      ],
      12,
      [
        0x42, 0x83, 0x1e, 0xc2, 0x21, 0x77, 0x74, 0x24, 0x4b, 0x72, 0x21, 0xb7, 0x84, 0xd0, 0xd4, 0x9c,
        0xe3, 0xaa, 0x21, 0x2f, 0x2c, 0x02, 0xa4, 0xe0, 0x35, 0xc1, 0x7e, 0x23, 0x29, 0xac, 0xa1, 0x2e,
        0x21, 0xd5, 0x14, 0xb2, 0x54, 0x66, 0x93, 0x1c, 0x7d, 0x8f, 0x6a, 0x5a, 0xac, 0x84, 0xaa, 0x05,
        0x1b, 0xa3, 0x0b, 0x39, 0x6a, 0x0a, 0xac, 0x97, 0x3d, 0x58, 0xe0, 0x91, 0x00, 0x00, 0x00, 0x00,
      ],
      60,
      [
        0xfe, 0xed, 0xfa, 0xce, 0xde, 0xad, 0xbe, 0xef, 0xfe, 0xed, 0xfa, 0xce, 0xde, 0xad, 0xbe, 0xef,
        0xab, 0xad, 0xda, 0xd2, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      ],
      20,
      [0x5b, 0xc9, 0x4f, 0xbc, 0x32, 0x21, 0xa5, 0xdb, 0x94, 0xfa, 0xe9, 0x5a, 0xe7, 0x12, 0x1a, 0x47],
    )
