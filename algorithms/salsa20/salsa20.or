// Salsa20 and XSalsa20. Salsa20 is the stream cipher of Bernstein's "Salsa20
// specification" (2005, https://cr.yp.to/snuffle/spec.pdf): the quarterround
// (section 3), rowround (4), columnround (5) and doubleround (6) functions,
// littleendian (7), the Salsa20 hash function (8), the expansion function
// with the constants "expand 32-byte k" and "expand 16-byte k" (9), and the
// encryption function with a 64-bit nonce and a 64-bit block counter (10).
// Salsa20/12 and Salsa20/8 ("Salsa20/8 and Salsa20/12", Bernstein, 2006) run
// 6 and 4 double rounds in place of 10; Salsa20/12 is the eSTREAM portfolio
// cipher (2008). XSalsa20 is the extended-nonce form of "Extending the
// Salsa20 nonce" (Bernstein, 2011,
// https://cr.yp.to/snuffle/xsalsa-20110204.pdf): HSalsa20 derives a subkey
// from the key and the first 16 bytes of a 24-byte nonce, and Salsa20 under
// that subkey uses the last 8. The file reproduces eSTREAM vectors of sets 1,
// 3 and 6 for 128- and 256-bit keys as Botan's salsa20.vec and Crypto++'s
// salsa.txt state them, Crypto++'s Salsa20/12, Salsa20/8 and counter-crossing
// cases, libsodium's core1, core2, core4 and stream3 tests, and the XSalsa20
// cases of Botan's file.
edition 2026;
module salsa20 {
  // Section 3: quarterround(y0, y1, y2, y3) = (z0, z1, z2, z3). Each word is
  // modified once, in the order z1, z2, z3, z0, by xor with a rotated sum;
  // the rotation amounts are 7, 9, 13 and 18.
  spec quarterround(y0: Word[32], y1: Word[32], y2: Word[32], y3: Word[32]) -> Word[32]^4 {
    let z1: Word[32] = y1 ^ ((y0 + y3) <<< 7);
    let z2: Word[32] = y2 ^ ((z1 + y0) <<< 9);
    let z3: Word[32] = y3 ^ ((z2 + z1) <<< 13);
    let z0: Word[32] = y0 ^ ((z3 + z2) <<< 18);
    [z0, z1, z2, z3]
  }

  // Section 4: rowround(y) = z. The quarterround on each row of the 4 by 4
  // matrix y0 ... y15, starting at the diagonal word: (z0, z1, z2, z3) =
  // quarterround(y0, y1, y2, y3), (z5, z6, z7, z4) = quarterround(y5, y6, y7,
  // y4), (z10, z11, z8, z9) = quarterround(y10, y11, y8, y9), (z15, z12, z13,
  // z14) = quarterround(y15, y12, y13, y14). The results are placed back in
  // one array literal, z0 through z15 in order.
  spec rowround(y: Word[32]^16) -> Word[32]^16 {
    let r0: Word[32]^4 = quarterround(y[0], y[1], y[2], y[3]);
    let r1: Word[32]^4 = quarterround(y[5], y[6], y[7], y[4]);
    let r2: Word[32]^4 = quarterround(y[10], y[11], y[8], y[9]);
    let r3: Word[32]^4 = quarterround(y[15], y[12], y[13], y[14]);
    [
      r0[0], r0[1], r0[2], r0[3],
      r1[3], r1[0], r1[1], r1[2],
      r2[2], r2[3], r2[0], r2[1],
      r3[1], r3[2], r3[3], r3[0],
    ]
  }

  // Section 5: columnround(x) = y, the quarterround on each column starting
  // at the diagonal word: (y0, y4, y8, y12) = quarterround(x0, x4, x8, x12),
  // (y5, y9, y13, y1) = quarterround(x5, x9, x13, x1), (y10, y14, y2, y6) =
  // quarterround(x10, x14, x2, x6), (y15, y3, y7, y11) = quarterround(x15,
  // x3, x7, x11). The specification notes that it is the transpose of
  // rowround.
  spec columnround(x: Word[32]^16) -> Word[32]^16 {
    let c0: Word[32]^4 = quarterround(x[0], x[4], x[8], x[12]);
    let c1: Word[32]^4 = quarterround(x[5], x[9], x[13], x[1]);
    let c2: Word[32]^4 = quarterround(x[10], x[14], x[2], x[6]);
    let c3: Word[32]^4 = quarterround(x[15], x[3], x[7], x[11]);
    [
      c0[0], c1[3], c2[2], c3[1],
      c0[1], c1[0], c2[3], c3[2],
      c0[2], c1[1], c2[0], c3[3],
      c0[3], c1[2], c2[1], c3[0],
    ]
  }

  // Section 6: doubleround(x) = rowround(columnround(x)).
  spec doubleround(x: Word[32]^16) -> Word[32]^16 { rowround(columnround(x)) }

  // Section 8: doubleround^10(x), or for Salsa20/r ("Salsa20/8 and
  // Salsa20/12") doubleround^(r/2)(x). r is a size, so the loop runs exactly
  // r/2 times; only the even r of 8, 12 and 20 are called.
  spec doublerounds[r in 8..21](x: Word[32]^16) -> Word[32]^16 {
    for d in 0..(r / 2) with z: Word[32]^16 = x { doubleround(z) }
  }

  // Sections 7 and 8: the Salsa20 hash function of a 64-byte sequence x.
  // Section 7's littleendian reads x as sixteen words x0 ... x15 and its
  // inverse writes the result back, both as `as little`; the output is
  // littleendian^-1(z0 + x0), ..., littleendian^-1(z15 + x15) with
  // (z0, ..., z15) = doubleround^10(x0, ..., x15), or r/2 doublerounds for
  // Salsa20/r.
  spec salsa20[r in 8..21](x: Word[8]^64) -> Word[8]^64 {
    let xw: Word[32]^16 = x as little Word[32]^16;
    let z: Word[32]^16 = doublerounds[r](xw);
    let sum: Word[32]^16 = for i in 0..16 with s: Word[32]^16 = z { s with [i] = s[i] + xw[i] };
    sum as little Word[8]^64
  }

  // Section 9: the expansion Salsa20_k(n) = Salsa20(sigma0, k0, sigma1, n,
  // sigma2, k1, sigma3) for a 32-byte key k = (k0, k1) and a 16-byte n, here
  // the 64-byte input of the hash. sigma0 to sigma3 are the four-byte pieces
  // "expa", "nd 3", "2-by" and "te k" of "expand 32-byte k", so that in the
  // 4 by 4 matrix of words the constants are the diagonal (words 0, 5, 10,
  // 15), k0 is words 1 to 4, n is words 6 to 9 and k1 is words 11 to 14.
  spec expand_32(k: Word[8]^32, n: Word[8]^16) -> Word[8]^64 {
    "expa" ++ k[..16] ++ "nd 3" ++ n ++ "2-by" ++ k[16..] ++ "te k"
  }

  // Section 9: the expansion Salsa20_k(n) = Salsa20(tau0, k, tau1, n, tau2,
  // k, tau3) for a 16-byte key, which stands in both key positions; tau0 to
  // tau3 are "expa", "nd 1", "6-by", "te k".
  spec expand_16(k: Word[8]^16, n: Word[8]^16) -> Word[8]^64 {
    "expa" ++ k ++ "nd 1" ++ n ++ "6-by" ++ k ++ "te k"
  }

  // Section 10: the 16-byte n of the expansion is (v, i), the 8-byte nonce v
  // followed by the block counter i as 8 little-endian bytes, so that i
  // occupies words 8 (low) and 9 (high) of the state.
  spec nonce_counter(v: Word[8]^8, i: Word[64]) -> Word[8]^16 {
    v ++ (i as little Word[8]^8)
  }

  // Section 10: b blocks of the keystream, Salsa20_k(v, i), Salsa20_k(v,
  // i + 1), ..., of Salsa20/r, from the hash input x of block i (an
  // expansion of section 9 with n = (v, i)). Bytes 32 to 39 of x are the
  // counter, words 8 and 9; block j writes i + j there as one 64-bit
  // integer, so the carry from word 8 into word 9 at counter 2^32 is the
  // specification's addition. The counter wraps modulo 2^64, where the
  // specification stops. b is limited to 4 blocks, enough for the 256 bytes
  // of encrypt; that is a choice of this file, not a limit of the
  // specification.
  spec keystream[r in 8..21, b in 1..5](x: Word[8]^64) -> Word[8]^(64 * b) {
    let i: Word[64] = x[32..40] as little Word[64];
    for j in 0..(b) with z: Word[8]^(64 * b) = [0; (64 * b)] {
      let ij: Word[64] = i + (j as Word[64]);
      z with [64 * j..64 * j + 64] = salsa20[r](x with [32..40] = (ij as little Word[8]^8))
    }
  }

  // Section 10: the encryption of an n-byte message m is m xor Salsa20_k(v),
  // the keystream of Salsa20/20 from the hash input x, with the surplus of
  // the last of its (n + 63) / 64 blocks discarded. Every encryption vector
  // here is Salsa20/20; the reduced-round vectors are keystream.
  spec encrypt[n in 1..257](x: Word[8]^64, m: Word[8]^n) -> Word[8]^n {
    let z: Word[8]^(64 * ((n + 63) / 64)) = keystream[20, (n + 63) / 64](x);
    for j in 0..(n) with c: Word[8]^n = m { c with [j] = m[j] ^ z[j] }
  }

  // Extending the Salsa20 nonce (2011): HSalsa20_k(n) for a 32-byte key and
  // a 16-byte n. The hash input is the Salsa20 expansion with n in place of
  // (v, i); after the 20 rounds, and without the final addition, the output
  // is the words z0, z5, z10, z15, z6, z7, z8, z9 (the diagonal, then the n
  // positions) as 32 little-endian bytes. Those eight positions held only
  // the public constants and n on input, which is what the paper's argument
  // that HSalsa20 is a PRF uses.
  spec hsalsa20(k: Word[8]^32, n: Word[8]^16) -> Word[8]^32 {
    let z: Word[32]^16 = doublerounds[20](expand_32(k, n) as little Word[32]^16);
    [z[0], z[5], z[10], z[15], z[6], z[7], z[8], z[9]] as little Word[8]^32
  }

  // Extending the Salsa20 nonce (2011): XSalsa20_k(n) for a 24-byte n is
  // Salsa20 under the subkey HSalsa20_k(n[0..15]) with the nonce n[16..23];
  // this is the hash input of its block 0, for keystream and encrypt.
  spec xsalsa20(k: Word[8]^32, n: Word[8]^24) -> Word[8]^64 {
    expand_32(hsalsa20(k, n[..16]), nonce_counter(n[16..], 0))
  }

  // The vectors. Botan's salsa20.vec states no set or vector numbers; a case
  // with no In line encrypts a zero message, so its Out is the keystream,
  // and is written here as the keystream. Crypto++'s salsa.txt labels its
  // eSTREAM cases and copies them from the eSTREAM verified.test-vectors
  // files. Cases longer than needed are reproduced as their first bytes, as
  // the title says.

  // Botan salsa20.vec, first case: the 128-bit key 00 01 ... 0f, no nonce
  // line (Botan's zero nonce) and no In line, so Out is the first 39 bytes of
  // keystream. By its key the case is eSTREAM set 3, vector 0, of the
  // 128-bit key file, which Botan does not label.
  test "Botan salsa20.vec case 1: 128-bit key, 39 bytes" {
    let k: Word[8]^16 = hex"00010203 04050607 08090a0b 0c0d0e0f";
    let v: Word[8]^8 = [0; 8];
    keystream[20, 1](expand_16(k, nonce_counter(v, 0)))[..39] == (
      hex"2dd5c3f7 ba2b20f7 6802410c 68868889 5ad8c1bd 4ea6c9b1 40fb9b90 e21049bf" ++
      hex"583f5279 70ebc1"
    )
  }

  // Botan salsa20.vec, second case: the 256-bit key 1b 1c ... 3a, zero nonce,
  // the first 111 bytes of keystream (blocks 0 and 1). By its key the case is
  // eSTREAM set 3, vector 27, of the 256-bit key file.
  test "Botan salsa20.vec case 2: 256-bit key, 111 bytes" {
    let k: Word[8]^32 =
      hex"1b1c1d1e 1f202122 23242526 2728292a 2b2c2d2e 2f303132 33343536 3738393a";
    let v: Word[8]^8 = [0; 8];
    keystream[20, 2](expand_32(k, nonce_counter(v, 0)))[..111] == (
      hex"ae39508e ac9aece7 bf97bb20 b9dee41f 87d947f8 28913598 db72cc23 2948565e" ++
      hex"837e0bf3 7d5d387b 2d7102b4 3bb5d823 b04adf3c ecb6d93b 9ba752be c5d45059" ++
      hex"1514b40e 40e653d1 839c5ba0 92296b5e 965b1e2f d3acc192 b1413f19 2fc43bc6" ++
      hex"95464554 e9750308 44afe58a 811209"
    )
  }

  // Botan salsa20.vec, ninth case: key 0f 62 b5 08 ..., nonce 28 8f f6 5d c4
  // 2b 92 f9, the first 64 bytes of keystream. Crypto++'s salsa.txt labels
  // this key and IV eSTREAM set 6, vector 3 (its 131072-byte xor digest).
  test "Botan salsa20.vec case 9: eSTREAM set 6, vector 3, block 0" {
    let k: Word[8]^32 =
      hex"0f62b508 5bae0154 a7fa4da0 f34699ec 3f92e538 8bde3184 d72a7dd0 2376c91c";
    let v: Word[8]^8 = hex"288ff65d c42b92f9";
    keystream[20, 1](expand_32(k, nonce_counter(v, 0))) == (
      hex"5e5e71f9 01993403 04abb22a 37b6625b f883fb89 ce3b21f5 4a10b810 66ef87da" ++
      hex"30b77699 aa7379da 595c77dd 59542da2 08e5954f 89e40eb7 aa80a84a 6176663f"
    )
  }

  // Botan salsa20.vec, tenth case: the same key and nonce with Seek = 65472,
  // that is block counter 1023 (eSTREAM set 6, vector 3,
  // stream[65472..65535]).
  test "Botan salsa20.vec case 10: eSTREAM set 6, vector 3, block 1023" {
    let k: Word[8]^32 =
      hex"0f62b508 5bae0154 a7fa4da0 f34699ec 3f92e538 8bde3184 d72a7dd0 2376c91c";
    let v: Word[8]^8 = hex"288ff65d c42b92f9";
    keystream[20, 1](expand_32(k, nonce_counter(v, 1023))) == (
      hex"2da2174b d150a1df ec1796e9 21e9d6e2 4ecf0209 bcbea4f9 8370fce6 29056f64" ++
      hex"91728343 6e2d3f45 55622530 7d5cc5a5 65325d89 93b37f16 54195c24 0bf75b16"
    )
  }

  // Botan salsa20.vec, thirteenth case ("Long random inputs/outputs"): the
  // key 00 01 ... 1f, nonce a0 a1 ... a7, and a 2600-byte message; its first
  // 128 bytes (blocks 0 and 1) are reproduced.
  test "Botan salsa20.vec case 13: first 128 bytes of a 2600-byte message" {
    let k: Word[8]^32 =
      hex"00010203 04050607 08090a0b 0c0d0e0f 10111213 14151617 18191a1b 1c1d1e1f";
    let v: Word[8]^8 = hex"a0a1a2a3 a4a5a6a7";
    let m: Word[8]^128 =
      hex"110c0702 fdf8f3ee e9e4dfda d5d0cbc6 c1bcb7b2 ada8a39e 99948f8a 85807b76" ++
      hex"716c6762 5d58534e 49443f3a 35302b26 211c1712 0d0803fe f9f4efea e5e0dbd6" ++
      hex"d1ccc7c2 bdb8b3ae a9a49f9a 95908b86 817c7772 6d68635e 59544f4a 45403b36" ++
      hex"312c2722 1d18130e 0904fffa f5f0ebe6 e1dcd7d2 cdc8c3be b9b4afaa a5a09b96";
    encrypt(expand_32(k, nonce_counter(v, 0)), m) == (
      hex"04cd66fc 0e74099d 7f93d5cb 0a2b9037 06839fa6 b219c4cf ede86068 7f9f0d9b" ++
      hex"a0d883e3 a5586937 425f4d38 6457a334 1626c321 08ac114e bdb0099f bde4b68c" ++
      hex"8f558ed4 e6400d3f 90e5e0ae 20d7324e 38fffb4b 37276112 31bb5fe1 08eadcc4" ++
      hex"b99540bf a210d963 05162abf 9f351987 9f4dc3c4 256fe7f1 ff155c2c b93381d9"
    )
  }

  // Botan salsa20.vec, fourteenth case: the 128-bit key b0 b1 ... bf, nonce
  // c0 c1 ... c7, 1300 bytes of keystream; its first block is reproduced.
  test "Botan salsa20.vec case 14: 128-bit key, first block" {
    let k: Word[8]^16 = hex"b0b1b2b3 b4b5b6b7 b8b9babb bcbdbebf";
    let v: Word[8]^8 = hex"c0c1c2c3 c4c5c6c7";
    keystream[20, 1](expand_16(k, nonce_counter(v, 0))) == (
      hex"9970db64 1010268e 34293d56 6842e95f 9e23091b 3e4380f6 bd6e07d6 724394fb" ++
      hex"d6e908c2 48fa4d01 31545385 44c1e493 d202c813 8cf172c8 af75b90b f0ee70b0"
    )
  }

  // Botan salsa20.vec, sixteenth case: the key ff fe ... e0, nonce d0 d1 ...
  // d7, Seek = 274877906816 = 0xfffffffe * 64, 2048 bytes of keystream. The
  // first 192 bytes are the blocks at counters 0xfffffffe, 0xffffffff and
  // 0x100000000: the carry into word 9 of the state.
  test "Botan salsa20.vec case 16: counter 0xfffffffe, first 192 bytes" {
    let k: Word[8]^32 =
      hex"fffefdfc fbfaf9f8 f7f6f5f4 f3f2f1f0 efeeedec ebeae9e8 e7e6e5e4 e3e2e1e0";
    let v: Word[8]^8 = hex"d0d1d2d3 d4d5d6d7";
    keystream[20, 3](expand_32(k, nonce_counter(v, 0xfffffffe))) == (
      hex"4f674bfd 84eadd02 8bc24643 0b105b51 f842a148 794c71b7 4d56f799 60ff0868" ++
      hex"166aa2f0 9cde0f4f 96a0eac1 7e667767 964053bc d1673c7d 51348ce7 7833f437" ++
      hex"bead720d 82da8bb8 a276e9c6 65d9bc7d c5083cde 47b2717f 11886ff7 bf4be58f" ++
      hex"dd4d81f7 6f35a990 ef4af9fa c1068249 205aafb6 22fbff75 19ba4b27 4e9d6121" ++
      hex"d01e7815 054484f8 8efa817d f2885689 d36de63b f002197b 9856eac6 0730eb8d" ++
      hex"c32409c7 91017ae8 59fc8c40 c3ed7f1c b8045f23 0378f493 6d61343b e3e612e2"
    )
  }

  // Botan salsa20.vec, third case: XSalsa20 with the key 1b 27 55 64 ... and
  // the 24-byte nonce 69 69 6e e9 ..., the first 139 bytes of keystream. The
  // key and nonce are those of NaCl's and libsodium's stream tests; Crypto++
  // carries the same case as "created by Wei Dai using naclcrypto-20090308".
  test "Botan salsa20.vec case 3: XSalsa20, 139 bytes" {
    let k: Word[8]^32 =
      hex"1b275564 73e985d4 62cd5119 7a9a46c7 6009549e ac6474f2 06c4ee08 44f68389";
    let n: Word[8]^24 = hex"69696ee9 55b62b73 cd62bda8 75fc73d6 8219e003 6b7a0b37";
    keystream[20, 3](xsalsa20(k, n))[..139] == (
      hex"eea6a725 1c1e7291 6d11c2cb 214d3c25 2539121d 8e234e65 2d651fa4 c8cff880" ++
      hex"309e645a 74e9e0a6 0d8243ac d9177ab5 1a1beb8d 5a2f5d70 0c093c5e 55855796" ++
      hex"25337bd3 ab619d61 5760d8c5 b224a85b 1d0efe0e b8a7ee16 3abb0376 529fcc09" ++
      hex"bab506c6 18e13ce7 77d82c3a e9d1a6f9 72d41602 87cbfe60 bf2130fc 0a6ff604" ++
      hex"9d0a5c8a 82f42923 1f0080"
    )
  }

  // Botan salsa20.vec, fourth case: XSalsa20 with the key a6 a7 25 1c ...,
  // the nonce 9e 64 5a 74 ..., and a 238-byte message (four blocks). Crypto++
  // carries the same case.
  test "Botan salsa20.vec case 4: XSalsa20, 238-byte message" {
    let k: Word[8]^32 =
      hex"a6a7251c 1e72916d 11c2cb21 4d3c2525 39121d8e 234e652d 651fa4c8 cff88030";
    let n: Word[8]^24 = hex"9e645a74 e9e0a60d 8243acd9 177ab51a 1beb8d5a 2f5d700c";
    let m: Word[8]^238 =
      hex"093c5e55 85579625 337bd3ab 619d6157 60d8c5b2 24a85b1d 0efe0eb8 a7ee163a" ++
      hex"bb037652 9fcc09ba b506c618 e13ce777 d82c3ae9 d1a6f972 d4160287 cbfe60bf" ++
      hex"2130fc0a 6ff6049d 0a5c8a82 f429231f 008082e8 45d7e189 d37f9ed2 b464e6b9" ++
      hex"19e6523a 8c1210bd 52a02a4c 3fe406d3 085f5068 d1909eee ca6369ab c981a42e" ++
      hex"87fe6655 83f0ab85 ae71f6f8 4f528e6b 397af86f 6917d975 4b7320db dc2fea81" ++
      hex"496f2732 f532ac78 c4e9c6cf b18f8e9b df74622e b1261414 16776971 a84f94d1" ++
      hex"56beaf67 aecbf2ad 412e76e6 6e8fad76 33f5b6d7 f3d64b5c 6c69ce29 003c6024" ++
      hex"465ae3b8 9be78e91 5d88b4b5 621d";
    encrypt(xsalsa20(k, n), m) == (
      hex"b2af688e 7d8fc4b5 08c05cc3 9dd583d6 714322c6 4d7f3e63 147aede2 d9534934" ++
      hex"b04ff6f3 37b03181 5cd094bd bc6d7a92 077dce70 94122868 22ef0737 ee47f6b7" ++
      hex"ffa22f9d 53f11dd2 b0a3bb9f c01d9a88 f9d53c26 e9365c2c 3c063bc4 840bfc81" ++
      hex"2e4b8046 3e69d179 530b25c1 58f54319 1cff9931 06511aa0 36043bbc 75866ab7" ++
      hex"e34afc57 e2cce493 4a5faae6 eabe4f22 1770183d d0604678 27c27a35 4159a081" ++
      hex"275a291f 69d946d6 fe28ed0b 9ce08206 cf484925 a51b9498 dbde178d dd3ae91a" ++
      hex"8581b916 82d860f8 40782f6e ea49dbb9 bd721501 d2c67122 dea3b728 3848c5f1" ++
      hex"3e0c0de8 76bd227a 856e4de5 93a3"
    )
  }

  // Crypto++ salsa.txt, Salsa20 "Set 1, vector# 0" (from the eSTREAM
  // verified.test-vectors of the 128-bit key file): key 80 00 ... 00, zero
  // IV, Seek 0, 64 zero bytes: stream[0..63].
  test "Crypto++ salsa.txt: Set 1, vector# 0" {
    let k: Word[8]^16 = hex"80000000 00000000 00000000 00000000";
    let v: Word[8]^8 = [0; 8];
    keystream[20, 1](expand_16(k, nonce_counter(v, 0))) == (
      hex"4dfa5e48 1da23ea0 9a310220 50859936 da52fcee 21800516 4f267cb6 5f5cfd7f" ++
      hex"2b4f97e0 ff16924a 52df2695 15110a07 f9e460bc 65ef95da 58f740b7 d1dbb0aa"
    )
  }

  // Crypto++ salsa.txt, the same case at Seek 448, block counter 7:
  // stream[448..511].
  test "Crypto++ salsa.txt: Set 1, vector# 0, Seek 448" {
    let k: Word[8]^16 = hex"80000000 00000000 00000000 00000000";
    let v: Word[8]^8 = [0; 8];
    keystream[20, 1](expand_16(k, nonce_counter(v, 7))) == (
      hex"b3757037 39daced4 dd4059fd 71c3c47f c2f99396 70fad4a4 6066adcc 6a564578" ++
      hex"3308b90f fb72be04 a6b147cb e38cc0c3 b9267c29 6a92a7c6 9873f9f2 63be9703"
    )
  }

  // Crypto++ salsa.txt, Salsa20 "Set 3, vector#243" (eSTREAM, 256-bit key
  // file): key f3 f4 ... 12, zero IV, stream[0..63].
  test "Crypto++ salsa.txt: Set 3, vector#243" {
    let k: Word[8]^32 =
      hex"f3f4f5f6 f7f8f9fa fbfcfdfe ff000102 03040506 0708090a 0b0c0d0e 0f101112";
    let v: Word[8]^8 = [0; 8];
    keystream[20, 1](expand_32(k, nonce_counter(v, 0))) == (
      hex"b4c0afa5 03be7fc2 9a620581 66d56f8f 5d27dc24 6f75b9ad 8760c8c3 9dfd8749" ++
      hex"2d3b76d5 d9637f00 9eada144 58a52dfb 09815337 e7267268 1dddc246 33750d83"
    )
  }

  // Crypto++ salsa.txt, Salsa20 with Rounds: 12, "Set 1, vector# 0" (from the
  // eSTREAM reduced/12-rounds verified.test-vectors): key 80 00 ... 00, zero
  // IV, stream[0..63] of Salsa20/12.
  test "Crypto++ salsa.txt: Salsa20/12, Set 1, vector# 0" {
    let k: Word[8]^16 = hex"80000000 00000000 00000000 00000000";
    let v: Word[8]^8 = [0; 8];
    keystream[12, 1](expand_16(k, nonce_counter(v, 0))) == (
      hex"fc207dbf c76c5e17 74961e7a 5aad0906 9b2225ac 1ce0fe7a 0ce77003 e7e5bdf8" ++
      hex"b31af821 000813e6 c56b8c17 71d6ee70 39b2fbd0 a68e8ad7 0a3944b6 77937897"
    )
  }

  // Crypto++ salsa.txt, Salsa20 with Rounds: 8, "Set 1, vector# 0" (eSTREAM
  // reduced/8-rounds): the same key and IV, stream[0..63] of Salsa20/8.
  test "Crypto++ salsa.txt: Salsa20/8, Set 1, vector# 0" {
    let k: Word[8]^16 = hex"80000000 00000000 00000000 00000000";
    let v: Word[8]^8 = [0; 8];
    keystream[8, 1](expand_16(k, nonce_counter(v, 0))) == (
      hex"a9c9f888 ab552a2d 1bbff9f3 6bebeb33 7a8b4b10 7c75b63b ae26cb9a 235bba9d" ++
      hex"784f38be fc3adf4c d3e26668 7ea7b9f0 9ba650ae 81eac606 3ae31ff1 2218ddc5"
    )
  }

  // Crypto++ salsa.txt, "Counter crosses 32-bit boundary (0xffffffff*64)":
  // zero key and IV, Seek64 0x3fffffffc0, that is block counter 0xffffffff,
  // 1024 zero bytes; the first 128 bytes are the blocks at counters
  // 0xffffffff and 0x100000000.
  test "Crypto++ salsa.txt: counter crosses 32-bit boundary, first 128 bytes" {
    let k: Word[8]^32 = [0; 32];
    let v: Word[8]^8 = [0; 8];
    keystream[20, 2](expand_32(k, nonce_counter(v, 0xffffffff))) == (
      hex"59fc4dd7 3f4b7b28 ce1b0ef5 62bab604 82407689 8a800797 b59902a9 9f312254" ++
      hex"5231e85b 887ffa19 f71f24aa f352dc6a fe47281d 8f546c9d 41919447 9a369392" ++
      hex"b65fc777 c4f950ec 0274ff0f fbb0a6e3 ededf784 77e94945 e87f26e3 162bf6a1" ++
      hex"05093342 1833f249 da1162db 6e92a767 8505190c 80dc4635 0b81e831 f974b28c"
    )
  }

  // libsodium test/default/core4.c: crypto_core_salsa20 on the key 1, 2, ...,
  // 16, 201, ..., 216, the 16-byte input 101, ..., 116 and the constant
  // "expand 32-byte k": the Salsa20 hash of the section 9 expansion for a
  // 32-byte key, the input standing for (v, i).
  test "libsodium core4: crypto_core_salsa20" {
    let k: Word[8]^32 =
      hex"01020304 05060708 090a0b0c 0d0e0f10 c9cacbcc cdcecfd0 d1d2d3d4 d5d6d7d8";
    let n: Word[8]^16 = hex"65666768 696a6b6c 6d6e6f70 71727374";
    salsa20[20](expand_32(k, n)) == (
      hex"45254427 290f6bc1 ff8b7a06 aae9d962 5990b66a 1533c841 ef31de22 d772287e" ++
      hex"68c507e1 c5991f02 664e4cb0 54f5f6b8 b1a08582 06489577 c0c384ec ea67f64a"
    )
  }

  // libsodium test/default/core1.c: crypto_core_hsalsa20 on the shared key 4a
  // 5d 9d 5b ... and a zero 16-byte input (the HSalsa20 step of NaCl's
  // crypto_box, deriving the first key from the Diffie-Hellman result).
  test "libsodium core1: crypto_core_hsalsa20 of the shared key" {
    let k: Word[8]^32 =
      hex"4a5d9d5b a4ce2de1 728e3bf4 80350f25 e07e21c9 47d19e33 76f09b3c 1e161742";
    let n: Word[8]^16 = [0; 16];
    hsalsa20(k, n) ==
      hex"1b275564 73e985d4 62cd5119 7a9a46c7 6009549e ac6474f2 06c4ee08 44f68389"
  }

  // libsodium test/default/core2.c: crypto_core_hsalsa20 on core1's first key
  // and the nonce prefix 69 69 6e e9 ... (the first 16 bytes of the 24-byte
  // nonce of stream3): the XSalsa20 subkey.
  test "libsodium core2: crypto_core_hsalsa20, the XSalsa20 subkey" {
    let k: Word[8]^32 =
      hex"1b275564 73e985d4 62cd5119 7a9a46c7 6009549e ac6474f2 06c4ee08 44f68389";
    let n: Word[8]^16 = hex"69696ee9 55b62b73 cd62bda8 75fc73d6";
    hsalsa20(k, n) ==
      hex"dc908dda 0b9344a9 53629b73 38207788 80f3ceb4 21bb61b9 1cbd4c3e 66256ce4"
  }

  // libsodium test/default/stream3.c: crypto_stream (XSalsa20) under core1's
  // first key and the 24-byte nonce 69 69 6e e9 ... 0b 37, the first 32 bytes
  // of keystream; equal to Salsa20 under core2's second key with the nonce 82
  // 19 e0 03 6b 7a 0b 37, and to the first 32 bytes of Botan's third case.
  test "libsodium stream3: XSalsa20 keystream, 32 bytes" {
    let k: Word[8]^32 =
      hex"1b275564 73e985d4 62cd5119 7a9a46c7 6009549e ac6474f2 06c4ee08 44f68389";
    let n: Word[8]^24 = hex"69696ee9 55b62b73 cd62bda8 75fc73d6 8219e003 6b7a0b37";
    keystream[20, 1](xsalsa20(k, n))[..32] ==
      hex"eea6a725 1c1e7291 6d11c2cb 214d3c25 2539121d 8e234e65 2d651fa4 c8cff880"
  }
}
