  // Crypto++ salsa.txt, "Counter crosses 32-bit boundary (0xffffffff*64)":
  // zero key and IV, Seek64 0x3fffffffc0, that is block counter 0xffffffff,
  // 1024 zero bytes; the first 128 bytes are the blocks at counters
  // 0xffffffff and 0x100000000.
  spec cryptopp_counter_crossing_head() -> Word[8]^128 {
    encrypt_128(
      expand_32(
        [
          0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
          0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        ],
        nonce_counter([0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00], 0xffffffff),
      ),
      [0; 128],
      20,
    )
  }

