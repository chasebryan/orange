  // libsodium test/default/stream3.c: crypto_stream (XSalsa20) under core1's
  // first key and the 24-byte nonce 69 69 6e e9 ... 0b 37, the first 32 bytes
  // of keystream; equal to Salsa20 under core2's second key with the nonce 82
  // 19 e0 03 6b 7a 0b 37, and to the first 32 bytes of Botan's third case.
  spec libsodium_stream3() -> Word[8]^32 {
    encrypt_32(
      xsalsa20_state(
        nacl_first_key(),
        [
          0x69, 0x69, 0x6e, 0xe9, 0x55, 0xb6, 0x2b, 0x73, 0xcd, 0x62, 0xbd, 0xa8, 0x75, 0xfc, 0x73, 0xd6,
          0x82, 0x19, 0xe0, 0x03, 0x6b, 0x7a, 0x0b, 0x37,
        ],
        0,
      ),
      [0; 32],
      20,
    )
  }

  spec libsodium_stream3_expected() -> Word[8]^32 {
    [
      0xee, 0xa6, 0xa7, 0x25, 0x1c, 0x1e, 0x72, 0x91, 0x6d, 0x11, 0xc2, 0xcb, 0x21, 0x4d, 0x3c, 0x25,
      0x25, 0x39, 0x12, 0x1d, 0x8e, 0x23, 0x4e, 0x65, 0x2d, 0x65, 0x1f, 0xa4, 0xc8, 0xcf, 0xf8, 0x80,
    ]
  }
