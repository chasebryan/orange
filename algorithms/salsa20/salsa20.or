  // libsodium test/default/core1.c: crypto_core_hsalsa20 on the shared key 4a
  // 5d 9d 5b ... and a zero 16-byte input (the HSalsa20 step of NaCl's
  // crypto_box, deriving the first key from the Diffie-Hellman result).
  spec libsodium_core1() -> Word[8]^32 {
    hsalsa20(
      [
        0x4a, 0x5d, 0x9d, 0x5b, 0xa4, 0xce, 0x2d, 0xe1, 0x72, 0x8e, 0x3b, 0xf4, 0x80, 0x35, 0x0f, 0x25,
