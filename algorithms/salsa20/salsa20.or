  // libsodium test/default/core2.c: crypto_core_hsalsa20 on core1's first key
  // and the nonce prefix 69 69 6e e9 ... (the first 16 bytes of the 24-byte
  // nonce of stream3): the XSalsa20 subkey.
  spec libsodium_core2() -> Word[8]^32 {
    hsalsa20(
      nacl_first_key(),
      [
        0x69, 0x69, 0x6e, 0xe9, 0x55, 0xb6, 0x2b, 0x73, 0xcd, 0x62, 0xbd, 0xa8, 0x75, 0xfc, 0x73, 0xd6,
