// Serpent, the 128-bit block cipher of "Serpent: A Proposal for the Advanced
// Encryption Standard" (Ross Anderson, Eli Biham, Lars Knudsen; submitted
// to NIST in June 1998, https://www.cl.cam.ac.uk/~rja14/serpent.html), one
// of the five AES finalists, written the way its designers implemented it:
// bitsliced. The block is four 32-bit words, the eight 4-bit S-boxes S0 to
// S7 are boolean functions on those four words (the forms of Osvik,
// "Speeding up Serpent", AES3, 2000, as carried in Botan), the linear
// transformation is rotations, shifts and xors, and the key schedule makes
// the 132 prekeys w_i from the padded key with phi = 0x9e3779b9 and passes
// them through the S-boxes to give the 33 subkeys. In this representation
// the initial and final permutations IP and FP of the proposal are the
// identity. The proposal could not be read from the machine this entry was
// written on, so the comments name its parts rather than section numbers.
//
// Encryption and decryption for 128-, 192- and 256-bit keys reproduce
// NESSIE set 1 and set 2 vectors and the designers' example vectors as
// carried in Botan's serpent.vec: nine encryptions and three decryptions.
edition 2026;
module serpent {
  // The bitslice representation: a block, or a round key, is four 32-bit
  // words X0, X1, X2, X3.
  type Block = Word[32]^4;
  // The 33 round keys K_0 to K_32, K_i at index i.
  type RoundKeys = Block^33;

  // The S-boxes (the proposal's "The S-boxes" and its bitslice
  // implementation). Each S_i is a permutation of the sixteen 4-bit
  // values; applied bitsliced, bit j of the words x[0], x[1], x[2], x[3]
  // holds bits 0, 1, 2, 3 of the j-th nibble, and the 32 nibbles of a
  // block go through the S-box at once. The specs below are the boolean
  // forms of Osvik as written in Botan's serpent_sbox.h, each assignment
  // of that straight-line code renamed into one let; each was checked
  // against its 16-entry table (S0 = 3 8 15 1 10 6 5 11 14 13 4 2 7 0 9 12
  // and so on) on all sixteen inputs before transcription. They are the
  // cipher's own form, not a stand-in for a table: no S-box here is ever
  // indexed by data.
  // S0.
  spec sbox0(x: Block) -> Block {
    let d1: Word[32] = x[3] ^ x[0];
    let b1: Word[32] = x[1] & d1;
    let t1: Word[32] = x[1] ^ x[2];
    let b2: Word[32] = b1 ^ x[0];
    let a1: Word[32] = x[0] | d1;
    let a2: Word[32] = a1 ^ t1;
    let t2: Word[32] = t1 ^ d1;
    let d2: Word[32] = d1 ^ x[2];
    let c1: Word[32] = x[2] | b2;
    let c2: Word[32] = c1 ^ t2;
    let t3: Word[32] = ~t2;
    let t4: Word[32] = t3 | b2;
    let b3: Word[32] = b2 ^ d2;
    let b4: Word[32] = b3 ^ t4;
    let d3: Word[32] = d2 | a2;
    let b5: Word[32] = b4 ^ d3;
    let t5: Word[32] = t4 ^ d3;
    [b5, t5, c2, a2]
  }

  // S1.
  spec sbox1(x: Block) -> Block {
    let a1: Word[32] = ~x[0];
    let c1: Word[32] = ~x[2];
    let a2: Word[32] = a1 & x[1];
    let c2: Word[32] = c1 ^ a2;
    let a3: Word[32] = a2 | x[3];
    let d1: Word[32] = x[3] ^ c2;
    let b1: Word[32] = x[1] ^ a3;
    let a4: Word[32] = a3 ^ a1;
    let t1: Word[32] = a1 | b1;
    let b2: Word[32] = b1 ^ d1;
    let c3: Word[32] = c2 | a4;
    let c4: Word[32] = c3 & t1;
    let a5: Word[32] = a4 ^ b2;
    let b3: Word[32] = b2 & c4;
    let b4: Word[32] = b3 ^ a5;
    let a6: Word[32] = a5 & c4;
    let t2: Word[32] = t1 ^ a6;
    [c4, t2, d1, b4]
  }

  // S2.
  spec sbox2(x: Block) -> Block {
    let a1: Word[32] = x[0] & x[2];
    let a2: Word[32] = a1 ^ x[3];
    let c1: Word[32] = x[2] ^ x[1];
    let c2: Word[32] = c1 ^ a2;
    let d1: Word[32] = x[3] | x[0];
    let d2: Word[32] = d1 ^ x[1];
    let t1: Word[32] = x[0] ^ c2;
    let d3: Word[32] = d2 | t1;
    let d4: Word[32] = d3 ^ a2;
    let a3: Word[32] = a2 & d2;
    let t2: Word[32] = t1 ^ a3;
    let b1: Word[32] = d2 ^ d4;
    let b2: Word[32] = b1 ^ t2;
    let d5: Word[32] = ~t2;
    [c2, d4, b2, d5]
  }

  // S3.
  spec sbox3(x: Block) -> Block {
    let a1: Word[32] = x[0] | x[3];
    let d1: Word[32] = x[3] ^ x[1];
    let b1: Word[32] = x[1] & x[0];
    let t1: Word[32] = x[0] ^ x[2];
    let c1: Word[32] = x[2] ^ d1;
    let d2: Word[32] = d1 & a1;
    let t2: Word[32] = t1 | b1;
    let d3: Word[32] = d2 ^ t2;
    let a2: Word[32] = a1 ^ b1;
    let t3: Word[32] = t2 & a2;
    let b2: Word[32] = b1 ^ d3;
    let t4: Word[32] = t3 ^ c1;
    let b3: Word[32] = b2 | a2;
    let b4: Word[32] = b3 ^ c1;
    let a3: Word[32] = a2 ^ d3;
    let b5: Word[32] = b4 | d3;
    let a4: Word[32] = a3 ^ b5;
    [a4, b4, d3, t4]
  }

  // S4.
  spec sbox4(x: Block) -> Block {
    let b1: Word[32] = x[1] ^ x[3];
    let d1: Word[32] = ~x[3];
    let c1: Word[32] = x[2] ^ d1;
    let d2: Word[32] = d1 ^ x[0];
    let b2: Word[32] = b1 & d2;
    let b3: Word[32] = b2 ^ c1;
    let t1: Word[32] = b1 ^ d2;
    let a1: Word[32] = x[0] ^ t1;
    let c2: Word[32] = c1 & t1;
    let c3: Word[32] = c2 ^ a1;
    let a2: Word[32] = a1 & b3;
    let d3: Word[32] = d2 ^ a2;
    let t2: Word[32] = t1 | b3;
    let t3: Word[32] = t2 ^ a2;
    let a3: Word[32] = a2 | d3;
    let a4: Word[32] = a3 ^ c3;
    let c4: Word[32] = c3 & d3;
    let a5: Word[32] = ~a4;
    let t4: Word[32] = t3 ^ c4;
    [b3, t4, a5, d3]
  }

  // S5.
  spec sbox5(x: Block) -> Block {
    let a1: Word[32] = x[0] ^ x[1];
    let b1: Word[32] = x[1] ^ x[3];
    let d1: Word[32] = ~x[3];
    let b2: Word[32] = b1 & a1;
    let c1: Word[32] = x[2] ^ d1;
    let b3: Word[32] = b2 ^ c1;
    let c2: Word[32] = c1 | b1;
    let t1: Word[32] = b1 ^ d1;
    let d2: Word[32] = d1 & b3;
    let d3: Word[32] = d2 ^ a1;
    let t2: Word[32] = t1 ^ b3;
    let t3: Word[32] = t2 ^ c2;
    let c3: Word[32] = c2 ^ a1;
    let a2: Word[32] = a1 & d3;
    let c4: Word[32] = ~c3;
    let a3: Word[32] = a2 ^ t3;
    let t4: Word[32] = t3 | d3;
    let t5: Word[32] = t4 ^ c4;
    [b3, d3, a3, t5]
  }

  // S6.
  spec sbox6(x: Block) -> Block {
    let c1: Word[32] = ~x[2];
    let d1: Word[32] = x[3] & x[0];
    let a1: Word[32] = x[0] ^ x[3];
    let d2: Word[32] = d1 ^ c1;
    let c2: Word[32] = c1 | x[3];
    let b1: Word[32] = x[1] ^ d2;
    let c3: Word[32] = c2 ^ a1;
    let a2: Word[32] = a1 | b1;
    let c4: Word[32] = c3 ^ b1;
    let t1: Word[32] = x[3] ^ a2;
    let a3: Word[32] = a2 | d2;
    let a4: Word[32] = a3 ^ c4;
    let t2: Word[32] = t1 ^ d2;
    let t3: Word[32] = t2 ^ a4;
    let d3: Word[32] = ~d2;
    let c5: Word[32] = c4 & t3;
    let d4: Word[32] = d3 ^ c5;
    [a4, b1, t3, d4]
  }

  // S7.
  spec sbox7(x: Block) -> Block {
    let b1: Word[32] = x[1] | x[2];
    let b2: Word[32] = b1 ^ x[3];
    let t1: Word[32] = x[1] ^ x[2];
    let c1: Word[32] = x[2] ^ b2;
    let d1: Word[32] = x[3] | t1;
    let d2: Word[32] = d1 & x[0];
    let t2: Word[32] = t1 ^ c1;
    let d3: Word[32] = d2 ^ b2;
    let b3: Word[32] = b2 | t2;
    let b4: Word[32] = b3 ^ x[0];
    let a1: Word[32] = x[0] | t2;
    let a2: Word[32] = a1 ^ c1;
    let b5: Word[32] = b4 ^ t2;
    let c2: Word[32] = c1 ^ b5;
    let b6: Word[32] = b5 & a2;
    let b7: Word[32] = b6 ^ t2;
    let c3: Word[32] = ~c2;
    let c4: Word[32] = c3 | a2;
    let t3: Word[32] = t2 ^ c4;
    [t3, d3, b7, a2]
  }

  // S0 inverse.
  spec inverse_sbox0(x: Block) -> Block {
    let c1: Word[32] = ~x[2];
    let b1: Word[32] = x[1] | x[0];
    let t1: Word[32] = ~x[1];
    let b2: Word[32] = b1 ^ c1;
    let c2: Word[32] = c1 | t1;
    let b3: Word[32] = b2 ^ x[3];
    let a1: Word[32] = x[0] ^ t1;
    let c3: Word[32] = c2 ^ a1;
    let a2: Word[32] = a1 & x[3];
    let t2: Word[32] = t1 ^ a2;
    let a3: Word[32] = a2 | b3;
    let a4: Word[32] = a3 ^ c3;
    let d1: Word[32] = x[3] ^ t2;
    let c4: Word[32] = c3 ^ b3;
    let d2: Word[32] = d1 ^ a4;
    let d3: Word[32] = d2 ^ b3;
    let c5: Word[32] = c4 & d3;
    let t3: Word[32] = t2 ^ c5;
    [a4, t3, b3, d3]
  }

  // S1 inverse.
  spec inverse_sbox1(x: Block) -> Block {
    let b1: Word[32] = x[1] ^ x[3];
    let d1: Word[32] = x[3] & b1;
    let t1: Word[32] = x[1] ^ x[2];
    let d2: Word[32] = d1 ^ x[0];
    let a1: Word[32] = x[0] | b1;
    let c1: Word[32] = x[2] ^ d2;
    let a2: Word[32] = a1 ^ t1;
    let a3: Word[32] = a2 | c1;
    let b2: Word[32] = b1 ^ d2;
    let a4: Word[32] = a3 ^ b2;
    let b3: Word[32] = b2 | d2;
    let b4: Word[32] = b3 ^ a4;
    let t2: Word[32] = ~t1;
    let t3: Word[32] = t2 ^ b4;
    let b5: Word[32] = b4 | a4;
    let b6: Word[32] = b5 ^ a4;
    let b7: Word[32] = b6 | t3;
    let d3: Word[32] = d2 ^ b7;
    [t3, a4, d3, c1]
  }

  // S2 inverse.
  spec inverse_sbox2(x: Block) -> Block {
    let c1: Word[32] = x[2] ^ x[3];
    let d1: Word[32] = x[3] ^ x[0];
    let d2: Word[32] = d1 & c1;
    let d3: Word[32] = d2 ^ x[1];
    let b1: Word[32] = x[1] | c1;
    let b2: Word[32] = b1 ^ d1;
    let t1: Word[32] = d1 & d3;
    let c2: Word[32] = c1 ^ d3;
    let t2: Word[32] = t1 & x[0];
    let t3: Word[32] = t2 ^ c2;
    let c3: Word[32] = c2 & b2;
    let c4: Word[32] = c3 | x[0];
    let d4: Word[32] = ~d3;
    let c5: Word[32] = c4 ^ d4;
    let a1: Word[32] = x[0] ^ d4;
    let a2: Word[32] = a1 & b2;
    let d5: Word[32] = d4 ^ t3;
    let d6: Word[32] = d5 ^ a2;
    [b2, t3, c5, d6]
  }

  // S3 inverse.
  spec inverse_sbox3(x: Block) -> Block {
    let c1: Word[32] = x[2] ^ x[1];
    let a1: Word[32] = x[0] ^ c1;
    let t1: Word[32] = x[2] & c1;
    let t2: Word[32] = t1 ^ a1;
    let a2: Word[32] = a1 & x[1];
    let b1: Word[32] = x[1] ^ x[3];
    let d1: Word[32] = x[3] | t2;
    let c2: Word[32] = c1 ^ d1;
    let a3: Word[32] = a2 ^ d1;
    let b2: Word[32] = b1 ^ t2;
    let d2: Word[32] = d1 & c2;
    let d3: Word[32] = d2 ^ b2;
    let b3: Word[32] = b2 ^ a3;
    let b4: Word[32] = b3 | c2;
    let a4: Word[32] = a3 ^ d3;
    let b5: Word[32] = b4 ^ t2;
    let a5: Word[32] = a4 ^ b5;
    [c2, b5, d3, a5]
  }

  // S4 inverse.
  spec inverse_sbox4(x: Block) -> Block {
    let c1: Word[32] = x[2] & x[3];
    let c2: Word[32] = c1 ^ x[1];
    let b1: Word[32] = x[1] | x[3];
    let b2: Word[32] = b1 & x[0];
    let t1: Word[32] = x[2] ^ c2;
    let t2: Word[32] = t1 ^ b2;
    let b3: Word[32] = b2 & c2;
    let a1: Word[32] = ~x[0];
    let d1: Word[32] = x[3] ^ t2;
    let b4: Word[32] = b3 ^ d1;
    let d2: Word[32] = d1 & a1;
    let d3: Word[32] = d2 ^ c2;
    let a2: Word[32] = a1 ^ b4;
    let c3: Word[32] = c2 & a2;
    let d4: Word[32] = d3 ^ a2;
    let c4: Word[32] = c3 ^ t2;
    let c5: Word[32] = c4 | d4;
    let d5: Word[32] = d4 ^ a2;
    let c6: Word[32] = c5 ^ b4;
    [a2, d5, c6, t2]
  }

  // S5 inverse.
  spec inverse_sbox5(x: Block) -> Block {
    let b1: Word[32] = ~x[1];
    let c1: Word[32] = x[2] ^ b1;
    let d1: Word[32] = x[3] | x[0];
    let d2: Word[32] = d1 ^ c1;
    let c2: Word[32] = c1 | b1;
    let c3: Word[32] = c2 & x[0];
    let t1: Word[32] = x[3] ^ d2;
    let c4: Word[32] = c3 ^ t1;
    let t2: Word[32] = t1 | x[0];
    let t3: Word[32] = t2 ^ b1;
    let b2: Word[32] = b1 & c4;
    let b3: Word[32] = b2 ^ d2;
    let t4: Word[32] = t3 ^ c4;
    let d3: Word[32] = d2 & t4;
    let t5: Word[32] = t4 ^ b3;
    let d4: Word[32] = d3 ^ t5;
    let t6: Word[32] = ~t5;
    let d5: Word[32] = d4 ^ x[0];
    [b3, t6, d5, c4]
  }

  // S6 inverse.
  spec inverse_sbox6(x: Block) -> Block {
    let a1: Word[32] = x[0] ^ x[2];
    let c1: Word[32] = x[2] & a1;
    let t1: Word[32] = x[2] ^ x[3];
    let c2: Word[32] = ~c1;
    let d1: Word[32] = x[3] ^ x[1];
    let c3: Word[32] = c2 ^ d1;
    let t2: Word[32] = t1 | a1;
    let a2: Word[32] = a1 ^ c3;
    let d2: Word[32] = d1 ^ t2;
    let t3: Word[32] = t2 ^ x[1];
    let b1: Word[32] = x[1] & d2;
    let b2: Word[32] = b1 ^ a2;
    let a3: Word[32] = a2 ^ d2;
    let a4: Word[32] = a3 | c3;
    let d3: Word[32] = d2 ^ b2;
    let t4: Word[32] = t3 ^ a4;
    [b2, c3, t4, d3]
  }

  // S7 inverse.
  spec inverse_sbox7(x: Block) -> Block {
    let c1: Word[32] = x[2] ^ x[0];
    let a1: Word[32] = x[0] & x[3];
    let t1: Word[32] = x[2] | x[3];
    let c2: Word[32] = ~c1;
    let d1: Word[32] = x[3] ^ x[1];
    let b1: Word[32] = x[1] | a1;
    let a2: Word[32] = a1 ^ c2;
    let c3: Word[32] = c2 & t1;
    let d2: Word[32] = d1 & t1;
    let b2: Word[32] = b1 ^ c3;
    let c4: Word[32] = c3 ^ a2;
    let a3: Word[32] = a2 | c4;
    let t2: Word[32] = t1 ^ b2;
    let a4: Word[32] = a3 ^ d2;
    let d3: Word[32] = d2 ^ t2;
    let t3: Word[32] = t2 | a4;
    let d4: Word[32] = d3 ^ c4;
    let t4: Word[32] = t3 ^ c4;
    [d4, a4, b2, t4]
  }

  // The linear transformation L of the proposal's bitslice description, on
  // the four words after the S-box, one let per line of the proposal:
  // X0 <<< 13, X2 <<< 3, X1 ^= X0 ^ X2, X3 ^= X2 ^ (X0 << 3), X1 <<< 1,
  // X3 <<< 7, X0 ^= X1 ^ X3, X2 ^= X3 ^ (X1 << 7), X0 <<< 5, X2 <<< 22.
  // Each name is a word after its update: a0 is X0 after the first line,
  // b0 after the second update of X0, c0 after the third.
  spec linear_transformation(x: Block) -> Block {
    let a0: Word[32] = x[0] <<< 13;
    let a2: Word[32] = x[2] <<< 3;
    let a1: Word[32] = x[1] ^ a0 ^ a2;
    let a3: Word[32] = x[3] ^ a2 ^ (a0 << 3);
    let b1: Word[32] = a1 <<< 1;
    let b3: Word[32] = a3 <<< 7;
    let b0: Word[32] = a0 ^ b1 ^ b3;
    let b2: Word[32] = a2 ^ b3 ^ (b1 << 7);
    let c0: Word[32] = b0 <<< 5;
    let c2: Word[32] = b2 <<< 22;
    [c0, b1, c2, b3]
  }

  // L inverse: the same ten lines undone in reverse order, each rotation
  // turned the other way and each xor applied again. Each name is the word
  // of linear_transformation that its line recovers: x[0] to x[3] are that
  // spec's c0, b1, c2 and b3, the lines give back b2, b0, a2, a0, a3 and
  // a1, and x0 to x3 are the four words L was applied to.
  spec inverse_linear_transformation(x: Block) -> Block {
    let b2: Word[32] = x[2] >>> 22;
    let b0: Word[32] = x[0] >>> 5;
    let a2: Word[32] = b2 ^ x[3] ^ (x[1] << 7);
    let a0: Word[32] = b0 ^ x[1] ^ x[3];
    let a3: Word[32] = x[3] >>> 7;
    let a1: Word[32] = x[1] >>> 1;
    let x3: Word[32] = a3 ^ a2 ^ (a0 << 3);
    let x1: Word[32] = a1 ^ a0 ^ a2;
    let x2: Word[32] = a2 >>> 3;
    let x0: Word[32] = a0 >>> 13;
    [x0, x1, x2, x3]
  }

  // Round i uses S_(i mod 8). The S-box is selected by the round number,
  // an Int fixed by the loop, never by the data; the key schedule uses the
  // same selection with 3 - i in place of i (Euclidean `%` keeps the index
  // in 0..7 when 3 - i is negative). A spec is not a value, so the
  // selection is a conditional over the eight specs rather than a lookup.
  spec sbox(r: Int, x: Block) -> Block {
    let i: Int = r % 8;
    if i == 0 { sbox0(x) }
    else if i == 1 { sbox1(x) }
    else if i == 2 { sbox2(x) }
    else if i == 3 { sbox3(x) }
    else if i == 4 { sbox4(x) }
    else if i == 5 { sbox5(x) }
    else if i == 6 { sbox6(x) }
    else { sbox7(x) }
  }

  spec inverse_sbox(r: Int, x: Block) -> Block {
    let i: Int = r % 8;
    if i == 0 { inverse_sbox0(x) }
    else if i == 1 { inverse_sbox1(x) }
    else if i == 2 { inverse_sbox2(x) }
    else if i == 3 { inverse_sbox3(x) }
    else if i == 4 { inverse_sbox4(x) }
    else if i == 5 { inverse_sbox5(x) }
    else if i == 6 { inverse_sbox6(x) }
    else { inverse_sbox7(x) }
  }

  // The key schedule, key padding. The user key is 256 bits, eight
  // little-endian words w_-8 to w_-1; a shorter key is padded with one 1
  // bit at its most significant end and then 0 bits to 256 bits. The
  // proposal writes its words little-endian, so for a key of len whole
  // bytes the 1 bit is the low bit of byte len: a 128-bit key has w_-4 = 1
  // and a 192-bit key w_-2 = 1. A 256-bit key is used as it is.
  spec pad_key[len in 1..32](k: Word[8]^len) -> Word[8]^32 {
    k ++ ([0; (32 - len)] with [0] = 0x01)
  }

  // phi, the fractional part of the golden ratio.
  spec phi() -> Word[32] { 0x9e3779b9 }

  // The prekeys w_0 to w_131 by the affine recurrence
  // w_i = (w_(i-8) ^ w_(i-5) ^ w_(i-3) ^ w_(i-1) ^ phi ^ i) <<< 11.
  // The array holds w_-8 to w_131, so w_i sits at index i + 8; the 256-bit
  // key, read as eight little-endian words, fills indices 0 to 7.
  spec prekeys(key: Word[8]^32) -> Word[32]^140 {
    for i in 0..132 with w: Word[32]^140 = (key as little Word[32]^8) ++ [0; 132] {
      w with [i + 8] = (w[i] ^ w[i + 3] ^ w[i + 5] ^ w[i + 7] ^ phi() ^ (i as Word[32])) <<< 11
    }
  }

  // The round keys K_0 to K_32: K_i is S_((3 - i) mod 8) applied
  // bitsliced to (w_4i, w_4i+1, w_4i+2, w_4i+3), so K_0 uses S3, K_1 uses
  // S2, and so on down and around to K_32 using S3 again.
  spec key_schedule(key: Word[8]^32) -> RoundKeys {
    let w: Word[32]^140 = prekeys(key);
    for i in 0..33 with k: RoundKeys = [[0; 4]; 33] {
      k with [i] = sbox(3 - i, w[4 * i + 8..4 * i + 12])
    }
  }

  // Key mixing: the xor of a round key into the four words.
  spec xor(x: Block, k: Block) -> Block {
    [x[0] ^ k[0], x[1] ^ k[1], x[2] ^ k[2], x[3] ^ k[3]]
  }

  // The cipher. Round i for 0 <= i < 31 is R_i(X) = L(S_i(X ^ K_i)); the
  // last round is R_31(X) = S_7(X ^ K_31) ^ K_32. In the bitsliced
  // representation IP and FP are the identity, so the plaintext's four
  // little-endian words enter the first round directly and the last
  // round's words are the ciphertext.
  spec round(i: Int, x: Block, k: Block) -> Block {
    linear_transformation(sbox(i, xor(x, k)))
  }

  // key is the 256-bit padded user key: a 128- or 192-bit key goes through
  // pad_key first, and a 256-bit key is used as it is.
  spec encrypt(key: Word[8]^32, plaintext: Word[8]^16) -> Word[8]^16 {
    let k: RoundKeys = key_schedule(key);
    let b0: Block = plaintext as little Block;
    let b31: Block = for i in 0..31 with x: Block = b0 { round(i, x, k[i]) };
    let b32: Block = xor(sbox7(xor(b31, k[31])), k[32]);
    b32 as little Word[8]^16
  }

  // Decryption: the inverse rounds in reverse order,
  // R_31^-1(X) = S_7^-1(X ^ K_32) ^ K_31, then
  // R_i^-1(X) = S_i^-1(L^-1(X)) ^ K_i for i = 30 down to 0. key is the
  // padded 256-bit key, as for encrypt.
  spec inverse_round(i: Int, x: Block, k: Block) -> Block {
    xor(inverse_sbox(i, inverse_linear_transformation(x)), k)
  }

  spec decrypt(key: Word[8]^32, ciphertext: Word[8]^16) -> Word[8]^16 {
    let k: RoundKeys = key_schedule(key);
    let b32: Block = ciphertext as little Block;
    let b31: Block = xor(inverse_sbox7(xor(b32, k[32])), k[31]);
    let b0: Block = for j in 0..31 with x: Block = b31 { inverse_round(30 - j, x, k[30 - j]) };
    b0 as little Word[8]^16
  }

  // Vectors. Botan's src/tests/data/block/serpent.vec carries, unlabelled,
  // the NESSIE sets 1 (a single key bit set, zero plaintext) and 2 (zero
  // key, a single plaintext bit set) for the three key sizes, and ends with
  // the designers' example vectors. Keys, plaintexts and ciphertexts are
  // written as the file prints them, as bytes; line numbers refer to that
  // file. NESSIE's decryption sets are not in the file, so each decryption
  // test inverts an encryption record and expects the record's plaintext.

  // serpent.vec line 813: key 80 00..00 (128 bits), zero plaintext.
  test "NESSIE Serpent-128 set 1, vector 0: encrypts" {
    encrypt(pad_key(hex"80000000 00000000 00000000 00000000"), [0; 16])
      == hex"264e5481 eff42a46 06abda06 c0bfda3d"
  }

  // The same record decrypted: the ciphertext gives the zero block back.
  test "NESSIE Serpent-128 set 1, vector 0: decrypts" {
    decrypt(
      pad_key(hex"80000000 00000000 00000000 00000000"),
      hex"264e5481 eff42a46 06abda06 c0bfda3d",
    ) == [0; 16]
  }

  // serpent.vec line 3117: zero 128-bit key, plaintext 80 00..00.
  test "NESSIE Serpent-128 set 2, vector 0: encrypts" {
    let key: Word[8]^16 = [0; 16];
    encrypt(pad_key(key), hex"80000000 00000000 00000000 00000000")
      == hex"a3b35de7 c358ddd8 2644678c 64b8bcbb"
  }

  // serpent.vec line 1581: key 80 00..00 (192 bits), zero plaintext.
  test "NESSIE Serpent-192 set 1, vector 0: encrypts" {
    encrypt(pad_key(hex"80000000 00000000 00000000 00000000 00000000 00000000"), [0; 16])
      == hex"9e274ead 9b737bb2 1efcfca5 48602689"
  }

  // serpent.vec line 3629: zero 192-bit key, plaintext 80 00..00.
  test "NESSIE Serpent-192 set 2, vector 0: encrypts" {
    let key: Word[8]^24 = [0; 24];
    encrypt(pad_key(key), hex"80000000 00000000 00000000 00000000")
      == hex"23f5f432 ad687e0d 4574c164 59618abb"
  }

  // serpent.vec line 2605: key 80 00..00 (256 bits), zero plaintext.
  test "NESSIE Serpent-256 set 1, vector 0: encrypts" {
    let key: Word[8]^32 =
      hex"80000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000";
    encrypt(key, [0; 16]) == hex"a223aa12 88463c0e 2be38ebd 825616c0"
  }

  // serpent.vec line 4141: zero 256-bit key, plaintext 80 00..00.
  test "NESSIE Serpent-256 set 2, vector 0: encrypts" {
    encrypt([0; 32], hex"80000000 00000000 00000000 00000000")
      == hex"8314675e 8ad5c3ec d83d852b cf7f566e"
  }

  // The same record decrypted.
  test "NESSIE Serpent-256 set 2, vector 0: decrypts" {
    decrypt([0; 32], hex"8314675e 8ad5c3ec d83d852b cf7f566e")
      == hex"80000000 00000000 00000000 00000000"
  }

  // The designers' example: the 128-bit key 0x00112233445566778899aabbccddeeff
  // and the plaintext 0x0123456789abcdeffedcba9876543210 are the proposal's
  // little-endian integers, so their bytes appear reversed in the file;
  // the 192- and 256-bit keys extend the 128-bit one by its mirror.

  // serpent.vec line 4173: Serpent-128 encryption of the example plaintext.
  test "Botan serpent.vec line 4173, designers' example: Serpent-128 encrypts" {
    encrypt(
      pad_key(hex"ffeeddcc bbaa9988 77665544 33221100"),
      hex"10325476 98badcfe efcdab89 67452301",
    ) == hex"d5baa00a 4bb9d8a7 c981c8dc 90d89d92"
  }

  // serpent.vec line 4177, read as a decryption: under the same key the
  // example plaintext, taken as a ciphertext, decrypts to the record's In.
  test "Botan serpent.vec line 4177, designers' example: Serpent-128 decrypts" {
    decrypt(
      pad_key(hex"ffeeddcc bbaa9988 77665544 33221100"),
      hex"10325476 98badcfe efcdab89 67452301",
    ) == hex"145f0b8b 663176b9 5dcab7e9 dcd5cc24"
  }

  // serpent.vec line 4181: Serpent-192 with the key
  // 0x00112233445566778899aabbccddeeffffeeddccbbaa9988.
  test "Botan serpent.vec line 4181, designers' example: Serpent-192 encrypts" {
    encrypt(
      pad_key(hex"8899aabb ccddeeff ffeeddcc bbaa9988 77665544 33221100"),
      hex"10325476 98badcfe efcdab89 67452301",
    ) == hex"da860842 b720802b f404a4c7 1034879a"
  }

  // serpent.vec line 4189: Serpent-256 with the key
  // 0x00112233445566778899aabbccddeeffffeeddccbbaa99887766554433221100.
  test "Botan serpent.vec line 4189, designers' example: Serpent-256 encrypts" {
    let key: Word[8]^32 =
      hex"00112233 44556677 8899aabb ccddeeff" ++ hex"ffeeddcc bbaa9988 77665544 33221100";
    encrypt(key, hex"10325476 98badcfe efcdab89 67452301")
      == hex"93df9a3c afe387bd 999eebe3 93a17fca"
  }
}
