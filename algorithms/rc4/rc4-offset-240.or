// RC4 (Rivest, 1987; "Arcfour", 1994), the companion of rc4.or: the same
// key-scheduling algorithm (KSA) and pseudo-random generation algorithm
// (PRGA), packed the same way, for the vectors that do not fit in that
// file's step budget. Reproduced here: the keystream of RFC 6229
// (https://www.rfc-editor.org/rfc/rfc6229), section 2, for the 40-bit key
// 01 02 03 04 05 at offsets 240 through 271 (the RFC's rows for offsets 240
// and 256), which needs the first 240 bytes generated and discarded; and an
// encryption, the xor of a message with the keystream, from Botan's
// src/tests/data/stream/rc4.vec: the 64-bit key 01 23 45 67 89 ab cd ef of
// the 1994 Cypherpunks posting applied to a message of 0x01 bytes, its
// first 32 bytes.
edition 2026;
module rc4_offset_240 {
  // The RC4 state, as one array so that it can travel through a loop:
  // words 0 through 31 hold the permutation S packed eight bytes to a
  // 64-bit word, big-endian, so that S[8w] is the top byte of word w and
  // 0x0001020304050607 reads as S[0] = 0, S[1] = 1, ..., S[7] = 7; word 32
  // holds the index j; word 33 holds the byte carried between the two
  // halves of a swap; words 34 through 37 hold 32 keystream bytes, packed
  // the same way. An Orange index is static, so S[x] for a data byte x is
  // a selection among the 32 words, then among the 8 bytes of the one
  // selected; S[i] for the loop index i is the ordinary index i / 8 and
  // the byte i mod 8 of that word.

  // The byte at position k of a word holding eight entries of S.
  spec byte_at(w: Word[64], k: Word[8]) -> Word[8] {
    if k == 0 { (w >> 56) as Word[8] }
    else if k == 1 { (w >> 48) as Word[8] }
    else if k == 2 { (w >> 40) as Word[8] }
    else if k == 3 { (w >> 32) as Word[8] }
    else if k == 4 { (w >> 24) as Word[8] }
    else if k == 5 { (w >> 16) as Word[8] }
    else if k == 6 { (w >> 8) as Word[8] }
    else { w as Word[8] }
  }

  // The word w with the byte at position k replaced by v.
  spec put_byte(w: Word[64], k: Word[8], v: Word[8]) -> Word[64] {
    let x: Word[64] = v as Word[64];
    if k == 0 { (w & 0x00ffffffffffffff) | (x << 56) }
    else if k == 1 { (w & 0xff00ffffffffffff) | (x << 48) }
    else if k == 2 { (w & 0xffff00ffffffffff) | (x << 40) }
    else if k == 3 { (w & 0xffffff00ffffffff) | (x << 32) }
    else if k == 4 { (w & 0xffffffff00ffffff) | (x << 24) }
    else if k == 5 { (w & 0xffffffffff00ffff) | (x << 16) }
    else if k == 6 { (w & 0xffffffffffff00ff) | (x << 8) }
    else { (w & 0xffffffffffffff00) | x }
  }

  // S[x] for a data byte x: the word x / 8 of the state, chosen by walking
  // the 32 words, then its byte x mod 8.
  spec get_byte(t: Word[64]^38, x: Word[8]) -> Word[8] {
    let w: Word[64] = for i in 0..32 with acc: Word[64] = 0 {
      if (x >> 3) == (i as Word[8]) { t[i] } else { acc }
    };
    byte_at(w, x & 7)
  }

  // S[x] := v for a data byte x: the same walk, replacing the byte in the
  // one word that holds it.
  spec set_byte(t: Word[64]^38, x: Word[8], v: Word[8]) -> Word[64]^38 {
    for i in 0..32 with acc: Word[64]^38 = t {
      if (x >> 3) == (i as Word[8]) { acc with [i] = put_byte(acc[i], x & 7, v) } else { acc }
    }
  }

  // swap(S[i], S[j]), first half. Both algorithms swap S[i] with S[j] after
  // computing j, and a loop step is one expression, so the swap is two
  // steps of an inner loop: this one, given the new j and si = S[i], reads
  // S[j], writes S[j] := si, and holds j in word 32 and the old S[j] in
  // word 33; the caller's next step writes S[i] := word 33 at the static
  // index i.
  spec swap_at_j(t: Word[64]^38, j: Word[8], si: Word[8]) -> Word[64]^38 {
    let sj: Word[8] = get_byte(t, j);
    (set_byte(t, j, si) with [32] = j as Word[64]) with [33] = sj as Word[64]
  }

  // The state before the KSA: S is the identity permutation, j = 0.
  spec initial_state() -> Word[64]^38 {
    [
      0x0001020304050607, 0x08090a0b0c0d0e0f, 0x1011121314151617, 0x18191a1b1c1d1e1f,
      0x2021222324252627, 0x28292a2b2c2d2e2f, 0x3031323334353637, 0x38393a3b3c3d3e3f,
      0x4041424344454647, 0x48494a4b4c4d4e4f, 0x5051525354555657, 0x58595a5b5c5d5e5f,
      0x6061626364656667, 0x68696a6b6c6d6e6f, 0x7071727374757677, 0x78797a7b7c7d7e7f,
      0x8081828384858687, 0x88898a8b8c8d8e8f, 0x9091929394959697, 0x98999a9b9c9d9e9f,
      0xa0a1a2a3a4a5a6a7, 0xa8a9aaabacadaeaf, 0xb0b1b2b3b4b5b6b7, 0xb8b9babbbcbdbebf,
      0xc0c1c2c3c4c5c6c7, 0xc8c9cacbcccdcecf, 0xd0d1d2d3d4d5d6d7, 0xd8d9dadbdcdddedf,
      0xe0e1e2e3e4e5e6e7, 0xe8e9eaebecedeeef, 0xf0f1f2f3f4f5f6f7, 0xf8f9fafbfcfdfeff,
      0, 0, 0, 0, 0, 0,
    ]
  }

  // The key-scheduling algorithm: for i from 0 to 255,
  // j := j + S[i] + K[i mod L]; swap(S[i], S[j]). The modulus L of the key
  // index is a literal, so each key length has its own copy of the loop.
  spec key_scheduling_40(key: Word[8]^5) -> Word[64]^38 {
    for i in 0..256 with s: Word[64]^38 = initial_state() {
      for p in 0..2 with t: Word[64]^38 = s {
        if p == 0 {
          swap_at_j(
            t,
            (t[32] as Word[8]) + byte_at(t[i / 8], (i % 8) as Word[8]) + key[i % 5],
            byte_at(t[i / 8], (i % 8) as Word[8]),
          )
        } else {
          t with [i / 8] = put_byte(t[i / 8], (i % 8) as Word[8], t[33] as Word[8])
        }
      }
    }
  }

  spec key_scheduling_64(key: Word[8]^8) -> Word[64]^38 {
    for i in 0..256 with s: Word[64]^38 = initial_state() {
      for p in 0..2 with t: Word[64]^38 = s {
        if p == 0 {
          swap_at_j(
            t,
            (t[32] as Word[8]) + byte_at(t[i / 8], (i % 8) as Word[8]) + key[i % 8],
            byte_at(t[i / 8], (i % 8) as Word[8]),
          )
        } else {
          t with [i / 8] = put_byte(t[i / 8], (i % 8) as Word[8], t[33] as Word[8])
        }
      }
    }
  }

  // The pseudo-random generation algorithm, one keystream byte n at a time:
  // i := i + 1; j := j + S[i]; swap(S[i], S[j]); output S[S[i] + S[j]].
  // The PRGA starts from i = 0 and j = 0 after the KSA, so the i of byte n
  // is (n + 1) mod 256, a static index; only j and the output index are
  // data. The three steps of the inner loop are the two halves of the swap
  // and the output, written to byte n of words 34 through 37.
  spec keystream(state: Word[64]^38) -> Word[8]^32 {
    let s: Word[64]^38 = for n in 0..32 with s: Word[64]^38 = state with [32] = 0 {
      for p in 0..3 with t: Word[64]^38 = s {
        if p == 0 {
          swap_at_j(
            t,
            (t[32] as Word[8]) + byte_at(t[((n + 1) % 256) / 8], ((n + 1) % 8) as Word[8]),
            byte_at(t[((n + 1) % 256) / 8], ((n + 1) % 8) as Word[8]),
          )
        } else if p == 1 {
          t with [((n + 1) % 256) / 8] =
            put_byte(t[((n + 1) % 256) / 8], ((n + 1) % 8) as Word[8], t[33] as Word[8])
        } else {
          t with [34 + (n / 8)] = put_byte(
            t[34 + (n / 8)],
            (n % 8) as Word[8],
            get_byte(
              t,
              byte_at(t[((n + 1) % 256) / 8], ((n + 1) % 8) as Word[8])
                + get_byte(t, t[32] as Word[8]),
            ),
          )
        }
      }
    };
    for n in 0..32 with out: Word[8]^32 = [0; 32] {
      out with [n] = byte_at(s[34 + (n / 8)], (n % 8) as Word[8])
    }
  }

  // The PRGA for the first 240 bytes, generated and discarded: the two
  // halves of the swap, with no output.
  spec discard_240(state: Word[64]^38) -> Word[64]^38 {
    for n in 0..240 with s: Word[64]^38 = state with [32] = 0 {
      for p in 0..2 with t: Word[64]^38 = s {
        if p == 0 {
          swap_at_j(
            t,
            (t[32] as Word[8]) + byte_at(t[((n + 1) % 256) / 8], ((n + 1) % 8) as Word[8]),
            byte_at(t[((n + 1) % 256) / 8], ((n + 1) % 8) as Word[8]),
          )
        } else {
          t with [((n + 1) % 256) / 8] =
            put_byte(t[((n + 1) % 256) / 8], ((n + 1) % 8) as Word[8], t[33] as Word[8])
        }
      }
    }
  }

  // The PRGA for bytes 240 through 271, continuing from the state and the j
  // that discard_240 leaves: i is (n + 1) mod 256 as before, and byte n is
  // written to position n - 240 of words 34 through 37.
  spec keystream_240(state: Word[64]^38) -> Word[8]^32 {
    let s: Word[64]^38 = for n in 240..272 with s: Word[64]^38 = state {
      for p in 0..3 with t: Word[64]^38 = s {
        if p == 0 {
          swap_at_j(
            t,
            (t[32] as Word[8]) + byte_at(t[((n + 1) % 256) / 8], ((n + 1) % 8) as Word[8]),
            byte_at(t[((n + 1) % 256) / 8], ((n + 1) % 8) as Word[8]),
          )
        } else if p == 1 {
          t with [((n + 1) % 256) / 8] =
            put_byte(t[((n + 1) % 256) / 8], ((n + 1) % 8) as Word[8], t[33] as Word[8])
        } else {
          t with [34 + ((n - 240) / 8)] = put_byte(
            t[34 + ((n - 240) / 8)],
            ((n - 240) % 8) as Word[8],
            get_byte(
              t,
              byte_at(t[((n + 1) % 256) / 8], ((n + 1) % 8) as Word[8])
                + get_byte(t, t[32] as Word[8]),
            ),
          )
        }
      }
    };
    for n in 0..32 with out: Word[8]^32 = [0; 32] {
      out with [n] = byte_at(s[34 + (n / 8)], (n % 8) as Word[8])
    }
  }

  // Encryption, and decryption, is the xor of the message with the
  // keystream.
  spec encrypt(keystream: Word[8]^32, message: Word[8]^32) -> Word[8]^32 {
    for n in 0..32 with c: Word[8]^32 = message { c with [n] = message[n] ^ keystream[n] }
  }

  // RFC 6229, section 2, key length 40 bits, key 0x0102030405: the rows at
  // offsets 240 and 256, keystream bytes 240 through 271.
  spec rfc6229_key_40_offset_240() -> Word[8]^32 {
    keystream_240(discard_240(key_scheduling_40([0x01, 0x02, 0x03, 0x04, 0x05])))
  }

  spec rfc6229_key_40_offset_240_expected() -> Word[8]^32 {
    [
      0x28, 0xcb, 0x11, 0x32, 0xc9, 0x6c, 0xe2, 0x86, 0x42, 0x1d, 0xca, 0xad, 0xb8, 0xb6, 0x9e, 0xae,
      0x1c, 0xfc, 0xf6, 0x2b, 0x03, 0xed, 0xdb, 0x64, 0x1d, 0x77, 0xdf, 0xcf, 0x7f, 0x8d, 0x8c, 0x93,
    ]
  }

  // Botan src/tests/data/stream/rc4.vec, section [RC4], the fifth case:
  // Key = 0123456789ABCDEF, In = 0101...01, Out = 7595C3E6...; the first 32
  // bytes of the message and of the ciphertext.
  spec botan_rc4_vec_encrypt_ones() -> Word[8]^32 {
    encrypt(
      keystream(key_scheduling_64([0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef])),
      [0x01; 32],
    )
  }

  spec botan_rc4_vec_encrypt_ones_expected() -> Word[8]^32 {
    [
      0x75, 0x95, 0xc3, 0xe6, 0x11, 0x4a, 0x09, 0x78, 0x0c, 0x4a, 0xd4, 0x52, 0x33, 0x8e, 0x1f, 0xfd,
      0x9a, 0x1b, 0xe9, 0x49, 0x8f, 0x81, 0x3d, 0x76, 0x53, 0x34, 0x49, 0xb6, 0x77, 0x8d, 0xca, 0xd8,
    ]
  }
}
