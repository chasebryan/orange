// RC4 (Rivest, RSA Data Security, 1987), the stream cipher published
// anonymously as "Arcfour" on the Cypherpunks list in September 1994. RC4 has
// no standard of its own: this file writes the two algorithms of that posting
// as the literature names them, the key-scheduling algorithm (KSA), which
// turns a key of 1 to 256 bytes into a permutation S of the 256 byte values,
// and the pseudo-random generation algorithm (PRGA), which walks S with two
// indices i and j, swapping as it goes, and emits S[S[i] + S[j]] as each
// keystream byte; a message is encrypted, and decrypted, by xor with the
// keystream.
//
// The file reproduces the test vectors of RFC 6229 (Strombergson and
// Josefsson, 2011, "Test Vectors for the Stream Cipher RC4",
// https://www.rfc-editor.org/rfc/rfc6229), section 2: for the 40-, 128- and
// 256-bit keys 01 02 03 ..., the keystream bytes at offsets 0 through 31 (the
// RFC's rows for offsets 0 and 16), and for the 40-bit key the bytes at
// offsets 240 through 271 (the rows for offsets 240 and 256), after the first
// 240 bytes are generated and discarded. It also reproduces an encryption
// from Botan's src/tests/data/stream/rc4.vec: the 64-bit key
// 01 23 45 67 89 ab cd ef of the 1994 posting applied to a message of 0x01
// bytes, its first 32 bytes. RC4 is broken and RFC 7465 (2015,
// https://www.rfc-editor.org/rfc/rfc7465) prohibits it in TLS; the file is
// kept for study.
edition 2026;
module rc4 {
  // The permutation S of the byte values 0 through 255, indexed by a byte.
  type Permutation = Word[8]^256;

  // The PRGA's state: the permutation S and its two indices i and j.
  type State = (Permutation, Word[8], Word[8]);

  // The key-scheduling algorithm of the 1994 posting: for i from 0 to 255,
  // S[i] := i; then j := 0 and, for i from 0 to 255,
  // j := j + S[i] + K[i mod L] and swap(S[i], S[j]), all arithmetic modulo
  // 256 and L the key length in bytes. The key length is the size parameter
  // L, 1 through 256 bytes. The swap is the two writes S[i] := S[j] and
  // S[j] := S[i], both reading the S from before it; the j that a step
  // computes is named j1, since a name is bound once, and carried into the
  // next step as j.
  spec key_scheduling[L in 1..257](key: Word[8]^L) -> Permutation {
    let identity: Permutation = for i in 0..256 with s: Permutation = [0; 256] {
      s with [i] = i as Word[8]
    };
    let scheduled: (Permutation, Word[8]) =
      for i in 0..256 with (s: Permutation, j: Word[8]) = (identity, 0) {
        let j1: Word[8] = j + s[i] + key[i % L];
        ((s with [i] = s[j1]) with [j1] = s[i], j1)
      };
    scheduled.0
  }

  // The PRGA starts from S as the KSA leaves it, with i := 0 and j := 0.
  spec start(s: Permutation) -> State { (s, 0, 0) }

  // One step of the pseudo-random generation algorithm, without its output:
  // i := i + 1; j := j + S[i]; swap(S[i], S[j]), modulo 256, the swap
  // written as in the KSA. The new i and j are named i1 and j1.
  spec advance(state: State) -> State {
    let (s: Permutation, i: Word[8], j: Word[8]) = state;
    let i1: Word[8] = i + 1;
    let j1: Word[8] = j + s[i1];
    ((s with [i1] = s[j1]) with [j1] = s[i1], i1, j1)
  }

  // The output of a step, read after its swap: S[S[i] + S[j]].
  spec output(state: State) -> Word[8] {
    let (s: Permutation, i: Word[8], j: Word[8]) = state;
    s[s[i] + s[j]]
  }

  // n steps of the PRGA with their output discarded, the "RC4-drop[n]" of
  // later usage; RFC 6229's offsets are counted from the first byte, so the
  // keystream at offset n is the keystream that follows discard[n].
  spec discard[n in 1..257](state: State) -> State {
    for k in 0..(n) with t: State = state { advance(t) }
  }

  // n bytes of keystream: byte k is the output of step k + 1. The loop
  // carries S, i and j beside the bytes written so far, since a tuple holds
  // arrays and words but not another tuple.
  spec keystream[n in 1..257](state: State) -> Word[8]^n {
    let run: (Permutation, Word[8], Word[8], Word[8]^n) =
      for k in 0..(n) with (s: Permutation, i: Word[8], j: Word[8], z: Word[8]^n) =
        (state.0, state.1, state.2, [0; n]) {
        let (s1: Permutation, i1: Word[8], j1: Word[8]) = advance((s, i, j));
        (s1, i1, j1, z with [k] = output((s1, i1, j1)))
      };
    run.3
  }

  // Encryption, and decryption, is the xor of the message with the keystream
  // that the PRGA generates from S.
  spec encrypt[n in 1..257](s: Permutation, message: Word[8]^n) -> Word[8]^n {
    let z: Word[8]^n = keystream[n](start(s));
    for k in 0..(n) with c: Word[8]^n = message { c with [k] = message[k] ^ z[k] }
  }

  // RFC 6229, section 2, key length 40 bits, key 0x0102030405: the rows at
  // offsets 0 and 16, the first 32 keystream bytes.
  test "RFC 6229 section 2: 40-bit key, offsets 0 and 16" {
    keystream[32](start(key_scheduling(hex"0102030405"))) == (
      hex"b2396305 f03dc027 ccc3524a 0a1118a8" ++ hex"6982944f 18fc82d5 89c403a4 7a0d0919"
    )
  }

  // RFC 6229, section 2, key length 128 bits, key 0x0102...0f10: the rows at
  // offsets 0 and 16.
  test "RFC 6229 section 2: 128-bit key, offsets 0 and 16" {
    let key: Word[8]^16 = hex"01020304 05060708 090a0b0c 0d0e0f10";
    keystream[32](start(key_scheduling(key))) == (
      hex"9ac7cc9a 609d1ef7 b2932899 cde41b97" ++ hex"5248c495 9014126a 6e8a84f1 1d1a9e1c"
    )
  }

  // RFC 6229, section 2, key length 256 bits, key 0x0102...1f20: the rows at
  // offsets 0 and 16.
  test "RFC 6229 section 2: 256-bit key, offsets 0 and 16" {
    let key: Word[8]^32 =
      hex"01020304 05060708 090a0b0c 0d0e0f10" ++ hex"11121314 15161718 191a1b1c 1d1e1f20";
    keystream[32](start(key_scheduling(key))) == (
      hex"eaa6bd25 880bf93d 3f5d1e4c a2611d91" ++ hex"cfa45c9f 7e714b54 bdfa8002 7cb14380"
    )
  }

  // RFC 6229, section 2, key length 40 bits, key 0x0102030405: the rows at
  // offsets 240 and 256, keystream bytes 240 through 271.
  test "RFC 6229 section 2: 40-bit key, offsets 240 and 256" {
    keystream[32](discard[240](start(key_scheduling(hex"0102030405")))) == (
      hex"28cb1132 c96ce286 421dcaad b8b69eae" ++ hex"1cfcf62b 03eddb64 1d77dfcf 7f8d8c93"
    )
  }

  // Botan src/tests/data/stream/rc4.vec, section [RC4], the fifth case:
  // Key = 0123456789ABCDEF, In = 0101...01, Out = 7595C3E6...; the first 32
  // bytes of the message and of the ciphertext, which is sound for a stream
  // cipher.
  test "Botan rc4.vec [RC4] case 5: encryption of 0x01 bytes, first 32" {
    encrypt(key_scheduling(hex"0123456789abcdef"), [0x01; 32]) == (
      hex"7595c3e6 114a0978 0c4ad452 338e1ffd" ++ hex"9a1be949 8f813d76 533449b6 778dcad8"
    )
  }
}
