// SHA-2: SHA-224, SHA-256, SHA-384, SHA-512 and SHA-512/256 of FIPS 180-4,
// Secure Hash Standard (NIST, August 2015),
// https://doi.org/10.6028/NIST.FIPS.180-4: the functions of section 4.1, the
// constants of section 4.2, the padding and parsing of sections 5.1 and 5.2,
// the initial hash values of section 5.3, and the hash computations of
// sections 6.2 and 6.4, written as the standard writes them, with the 64-bit
// computation a copy of the 32-bit one over Word[64]. SHA-224, SHA-384 and
// SHA-512/256 (sections 6.3, 6.5 and 6.7) are the same computations from
// their own initial values, truncated. Names without a suffix are the 32-bit
// (SHA-224 and SHA-256) ones; the 64-bit ones carry the suffix _512, except
// Ch, Maj and the padding, one spec each for both widths.
//
// The file reproduces the digests of NIST's examples for SHA-256 ("abc" and
// the 56-byte two-block message) and SHA-512 ("abc" and the 112-byte
// two-block message), the empty message and a 64-byte message from Botan's
// vector file, the SHA-224 and SHA-512/256 digests from OpenSSL's vector
// file, the SHA-384 digests from Botan's, and the SHA-512 digest of the empty
// message from Python's hashlib; every value was cross-checked with hashlib.
edition 2026;
module sha2 {
  // Sections 4.1.2 (equations 4.2 and 4.3) and 4.1.3 (4.8 and 4.9): Ch and
  // Maj are the same formulas on 32-bit and 64-bit words, so one spec serves
  // both widths.
  spec ch[W in {Word[32], Word[64]}](x: W, y: W, z: W) -> W { (x & y) ^ (~x & z) }
  spec maj[W in {Word[32], Word[64]}](x: W, y: W, z: W) -> W { (x & y) ^ (x & z) ^ (y & z) }

  // Section 4.1.2: the SHA-224 and SHA-256 Sigma and sigma functions on 32-bit
  // words.
  spec big_sigma0(x: Word[32]) -> Word[32] { (x >>> 2) ^ (x >>> 13) ^ (x >>> 22) }
  spec big_sigma1(x: Word[32]) -> Word[32] { (x >>> 6) ^ (x >>> 11) ^ (x >>> 25) }
  spec small_sigma0(x: Word[32]) -> Word[32] { (x >>> 7) ^ (x >>> 18) ^ (x >> 3) }
  spec small_sigma1(x: Word[32]) -> Word[32] { (x >>> 17) ^ (x >>> 19) ^ (x >> 10) }

  // Section 4.1.3: the SHA-384, SHA-512, SHA-512/224 and SHA-512/256 Sigma
  // and sigma functions on 64-bit words. The standard reuses the names; here
  // the 64-bit versions carry the suffix _512.
  spec big_sigma0_512(x: Word[64]) -> Word[64] { (x >>> 28) ^ (x >>> 34) ^ (x >>> 39) }
  spec big_sigma1_512(x: Word[64]) -> Word[64] { (x >>> 14) ^ (x >>> 18) ^ (x >>> 41) }
  spec small_sigma0_512(x: Word[64]) -> Word[64] { (x >>> 1) ^ (x >>> 8) ^ (x >> 7) }
  spec small_sigma1_512(x: Word[64]) -> Word[64] { (x >>> 19) ^ (x >>> 61) ^ (x >> 6) }

  // Section 4.2.2: K{256}, the first 32 bits of the fractional parts of the
  // cube roots of the first 64 primes, in hex from left to right as the
  // standard prints them, read as big-endian words.
  spec round_constants() -> Word[32]^64 {
    (
      hex"428a2f98 71374491 b5c0fbcf e9b5dba5 3956c25b 59f111f1 923f82a4 ab1c5ed5" ++
      hex"d807aa98 12835b01 243185be 550c7dc3 72be5d74 80deb1fe 9bdc06a7 c19bf174" ++
      hex"e49b69c1 efbe4786 0fc19dc6 240ca1cc 2de92c6f 4a7484aa 5cb0a9dc 76f988da" ++
      hex"983e5152 a831c66d b00327c8 bf597fc7 c6e00bf3 d5a79147 06ca6351 14292967" ++
      hex"27b70a85 2e1b2138 4d2c6dfc 53380d13 650a7354 766a0abb 81c2c92e 92722c85" ++
      hex"a2bfe8a1 a81a664b c24b8b70 c76c51a3 d192e819 d6990624 f40e3585 106aa070" ++
      hex"19a4c116 1e376c08 2748774c 34b0bcb5 391c0cb3 4ed8aa4a 5b9cca4f 682e6ff3" ++
      hex"748f82ee 78a5636f 84c87814 8cc70208 90befffa a4506ceb bef9a3f7 c67178f2"
    ) as big Word[32]^64
  }

  // Section 4.2.3: K{512}, the first 64 bits of the fractional parts of the
  // cube roots of the first 80 primes.
  spec round_constants_512() -> Word[64]^80 {
    (
      hex"428a2f98d728ae22 7137449123ef65cd b5c0fbcfec4d3b2f e9b5dba58189dbbc" ++
      hex"3956c25bf348b538 59f111f1b605d019 923f82a4af194f9b ab1c5ed5da6d8118" ++
      hex"d807aa98a3030242 12835b0145706fbe 243185be4ee4b28c 550c7dc3d5ffb4e2" ++
      hex"72be5d74f27b896f 80deb1fe3b1696b1 9bdc06a725c71235 c19bf174cf692694" ++
      hex"e49b69c19ef14ad2 efbe4786384f25e3 0fc19dc68b8cd5b5 240ca1cc77ac9c65" ++
      hex"2de92c6f592b0275 4a7484aa6ea6e483 5cb0a9dcbd41fbd4 76f988da831153b5" ++
      hex"983e5152ee66dfab a831c66d2db43210 b00327c898fb213f bf597fc7beef0ee4" ++
      hex"c6e00bf33da88fc2 d5a79147930aa725 06ca6351e003826f 142929670a0e6e70" ++
      hex"27b70a8546d22ffc 2e1b21385c26c926 4d2c6dfc5ac42aed 53380d139d95b3df" ++
      hex"650a73548baf63de 766a0abb3c77b2a8 81c2c92e47edaee6 92722c851482353b" ++
      hex"a2bfe8a14cf10364 a81a664bbc423001 c24b8b70d0f89791 c76c51a30654be30" ++
      hex"d192e819d6ef5218 d69906245565a910 f40e35855771202a 106aa07032bbd1b8" ++
      hex"19a4c116b8d2d0c8 1e376c085141ab53 2748774cdf8eeb99 34b0bcb5e19b48a8" ++
      hex"391c0cb3c5c95a63 4ed8aa4ae3418acb 5b9cca4f7763e373 682e6ff3d6b2b8a3" ++
      hex"748f82ee5defb2fc 78a5636f43172f60 84c87814a1f0ab72 8cc702081a6439ec" ++
      hex"90befffa23631e28 a4506cebde82bde9 bef9a3f7b2c67915 c67178f2e372532b" ++
      hex"ca273eceea26619c d186b8c721c0c207 eada7dd6cde0eb1e f57d4f7fee6ed178" ++
      hex"06f067aa72176fba 0a637dc5a2c898a6 113f9804bef90dae 1b710b35131c471b" ++
      hex"28db77f523047d84 32caab7b40c72493 3c9ebe0a15c9bebc 431d67c49c100d4c" ++
      hex"4cc5d4becb3e42b6 597f299cfc657e2a 5fcb6fab3ad6faec 6c44198c4a475817"
    ) as big Word[64]^80
  }

  // Section 5.3.2: SHA-224's initial hash value, the second 32 bits of the
  // fractional parts of the square roots of the ninth through sixteenth
  // primes.
  spec initial_hash_224() -> Word[32]^8 {
    [
      0xc1059ed8, 0x367cd507, 0x3070dd17, 0xf70e5939,
      0xffc00b31, 0x68581511, 0x64f98fa7, 0xbefa4fa4,
    ]
  }

  // Section 5.3.3: SHA-256's initial hash value, the first 32 bits of the
  // fractional parts of the square roots of the first eight primes.
  spec initial_hash_256() -> Word[32]^8 {
    [
      0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
      0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
    ]
  }

  // Section 5.3.4: SHA-384's initial hash value, the first 64 bits of the
  // fractional parts of the square roots of the ninth through sixteenth
  // primes.
  spec initial_hash_384() -> Word[64]^8 {
    [
      0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
      0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4,
    ]
  }

  // Section 5.3.5: SHA-512's initial hash value, the first 64 bits of the
  // fractional parts of the square roots of the first eight primes.
  spec initial_hash_512() -> Word[64]^8 {
    [
      0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
      0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,
    ]
  }

  // Section 5.3.6.2: SHA-512/256's initial hash value, the SHA-512 digest of
  // the string "SHA-512/256" computed from the SHA-512 initial value with
  // every word xored with a5a5...a5 (the generation function of 5.3.6).
  spec initial_hash_512_256() -> Word[64]^8 {
    [
      0x22312194fc2bf72c, 0x9f555fa3c84c64c2, 0x2393b86b6f53b151, 0x963877195940eabd,
      0x96283ee2a88effe3, 0xbe5e1e2553863992, 0x2b0199fc2c85b8aa, 0x0eb72ddc81c52ca2,
    ]
  }

  // Section 5.1: the bits appended to a message of len bytes, l = 8 len bits.
  // The standard pads at two sizes, and s selects one: s = w / 32 = m / 512,
  // the standard's word size w and block size m in units of SHA-256's. s = 1
  // is section 5.1.1 (SHA-224 and SHA-256: l + 1 + k = 448 mod 512, l as a
  // 64-bit integer), s = 2 is section 5.1.2 (SHA-384, SHA-512 and
  // SHA-512/256: l + 1 + k = 896 mod 1024, l as a 128-bit integer). So a
  // block is 64 s bytes and the length field, two words, 8 s bytes. What is
  // appended is the bit 1, k zero bits, and l big-endian; every message here
  // is whole bytes, so the bit 1 and the first seven zero bits are the byte
  // 0x80 that opens the fill. The padded message M ++ padding[len, s]() is
  // 64 s ((len + 72 s) / (64 s)) bytes, the fewest whole blocks that hold
  // the message, the byte 0x80 and the length field. The spec returns what
  // is appended rather than the padded message because an array has at
  // least one element: the empty message has no array of its own, and its
  // padded form is padding[0, s]() alone. len runs over 0 through 112, which
  // covers the vectors' 0, 3, 56, 64 and 112 bytes.
  spec padding[len in 0..113, s in 1..3]()
    -> Word[8]^(64 * s * ((len + 72 * s) / (64 * s)) - len) {
    let l: Int = 8 * len;
    ([0; (64 * s * ((len + 72 * s) / (64 * s)) - len - 8 * s)] with [0] = 0x80)
      ++ (l as big Word[8]^(8 * s))
  }

  // Section 6.2.2, step 1: the SHA-256 message schedule. W_0 through W_15 are
  // the block's words; the zeros after them are placeholders that the
  // recurrence replaces, W_16 through W_63, in order.
  spec schedule(m: Word[32]^16) -> Word[32]^64 {
    for t in 16..64 with w: Word[32]^64 = m ++ [0; 48] {
      w with [t] = small_sigma1(w[t - 2]) + w[t - 7] + small_sigma0(w[t - 15]) + w[t - 16]
    }
  }

  // Section 6.2.2, step 3: one round on the working variables a through h,
  // carried as v = [a, b, c, d, e, f, g, h].
  spec round(v: Word[32]^8, k: Word[32], w: Word[32]) -> Word[32]^8 {
    let t1: Word[32] = v[7] + big_sigma1(v[4]) + ch(v[4], v[5], v[6]) + k + w;
    let t2: Word[32] = big_sigma0(v[0]) + maj(v[0], v[1], v[2]);
    [t1 + t2, v[0], v[1], v[2], v[3] + t1, v[4], v[5], v[6]]
  }

  // Section 6.2.2, steps 1 through 4: one block, from H(i-1) to H(i).
  spec compress(h: Word[32]^8, m: Word[32]^16) -> Word[32]^8 {
    let w: Word[32]^64 = schedule(m);
    let k: Word[32]^64 = round_constants();
    let v: Word[32]^8 = for t in 0..64 with v: Word[32]^8 = h { round(v, k[t], w[t]) };
    for i in 0..8 with out: Word[32]^8 = v { out with [i] = out[i] + h[i] }
  }

  // Section 6.2.2, "for i = 1 to N", over a padded message of N = n blocks,
  // each parsed as section 5.2.1 parses it: sixteen big-endian 32-bit words,
  // M(i)_0 the leftmost.
  spec hash[n in 1..3](h0: Word[32]^8, p: Word[8]^(64 * n)) -> Word[32]^8 {
    for i in 0..(n) with h: Word[32]^8 = h0 {
      compress(h, p[64 * i..64 * i + 64] as big Word[32]^16)
    }
  }

  // Section 6.2.2: the SHA-256 digest of a padded message is
  // H(N)_0 || H(N)_1 || ... || H(N)_7.
  spec sha256[n in 1..3](p: Word[8]^(64 * n)) -> Word[8]^32 {
    hash(initial_hash_256(), p) as big Word[8]^32
  }

  // Section 6.3: SHA-224 is SHA-256 from its own initial value, and the
  // digest is the leftmost 224 bits, H(N)_0 through H(N)_6.
  spec sha224[n in 1..3](p: Word[8]^(64 * n)) -> Word[8]^28 {
    hash(initial_hash_224(), p)[..7] as big Word[8]^28
  }

  // Section 6.4.2, step 1: the SHA-512 message schedule W_0 through W_79.
  spec schedule_512(m: Word[64]^16) -> Word[64]^80 {
    for t in 16..80 with w: Word[64]^80 = m ++ [0; 64] {
      w with [t] =
        small_sigma1_512(w[t - 2]) + w[t - 7] + small_sigma0_512(w[t - 15]) + w[t - 16]
    }
  }

  // Section 6.4.2, step 3: one SHA-512 round.
  spec round_512(v: Word[64]^8, k: Word[64], w: Word[64]) -> Word[64]^8 {
    let t1: Word[64] = v[7] + big_sigma1_512(v[4]) + ch(v[4], v[5], v[6]) + k + w;
    let t2: Word[64] = big_sigma0_512(v[0]) + maj(v[0], v[1], v[2]);
    [t1 + t2, v[0], v[1], v[2], v[3] + t1, v[4], v[5], v[6]]
  }

  // Section 6.4.2, steps 1 through 4: one 1024-bit block, 80 rounds.
  spec compress_512(h: Word[64]^8, m: Word[64]^16) -> Word[64]^8 {
    let w: Word[64]^80 = schedule_512(m);
    let k: Word[64]^80 = round_constants_512();
    let v: Word[64]^8 = for t in 0..80 with v: Word[64]^8 = h { round_512(v, k[t], w[t]) };
    for i in 0..8 with out: Word[64]^8 = v { out with [i] = out[i] + h[i] }
  }

  // Section 6.4.2, "for i = 1 to N", each block parsed as section 5.2.2
  // parses it: sixteen big-endian 64-bit words.
  spec hash_512[n in 1..3](h0: Word[64]^8, p: Word[8]^(128 * n)) -> Word[64]^8 {
    for i in 0..(n) with h: Word[64]^8 = h0 {
      compress_512(h, p[128 * i..128 * i + 128] as big Word[64]^16)
    }
  }

  // Section 6.4.2: the SHA-512 digest is H(N)_0 || ... || H(N)_7.
  spec sha512[n in 1..3](p: Word[8]^(128 * n)) -> Word[8]^64 {
    hash_512(initial_hash_512(), p) as big Word[8]^64
  }

  // Section 6.5: SHA-384 is SHA-512 from its own initial value, truncated to
  // the leftmost 384 bits, H(N)_0 through H(N)_5.
  spec sha384[n in 1..3](p: Word[8]^(128 * n)) -> Word[8]^48 {
    hash_512(initial_hash_384(), p)[..6] as big Word[8]^48
  }

  // Section 6.7: SHA-512/256 is SHA-512 from the initial value of 5.3.6.2,
  // truncated to the leftmost 256 bits, H(N)_0 through H(N)_3.
  spec sha512_256[n in 1..3](p: Word[8]^(128 * n)) -> Word[8]^32 {
    hash_512(initial_hash_512_256(), p)[..4] as big Word[8]^32
  }

  // The vectors. Each test hashes its message followed by the padding for
  // its length; the empty message's padded form is the padding alone. The
  // two-block messages are those of NIST's examples:
  // "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq" (56 bytes) for
  // SHA-224 and SHA-256, whose bit 1 fits in the first block but whose
  // length does not, and "abcdefghbcdefghi...nopqrstu" (112 bytes) for the
  // 64-bit variants, likewise.

  // Botan sha2_32.vec, [SHA-256], the empty input (also hashlib).
  test "Botan sha2_32.vec: SHA-256 of the empty message" {
    sha256(padding[0, 1]()) ==
      hex"e3b0c442 98fc1c14 9afbf4c8 996fb924 27ae41e4 649b934c a495991b 7852b855"
  }

  // NIST, "SHA-256 Examples with Intermediate Values", one-block message
  // "abc"; the value as printed in Botan sha2_32.vec and OpenSSL
  // evpmd_sha.txt.
  test "NIST example: SHA-256 of abc" {
    sha256("abc" ++ padding[3, 1]()) ==
      hex"ba7816bf 8f01cfea 414140de 5dae2223 b00361a3 96177a9c b410ff61 f20015ad"
  }

  // NIST, "SHA-256 Examples with Intermediate Values", the two-block
  // message; the value as printed in Botan sha2_32.vec and OpenSSL
  // evpmd_sha.txt.
  test "NIST example: SHA-256 of the two-block message" {
    let m: Word[8]^56 = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
    sha256(m ++ padding[56, 1]()) ==
      hex"248d6a61 d20638b8 e5c02693 0c3e6039 a33ce459 64ff2167 f6ecedd4 19db06c1"
  }

  // Botan sha2_32.vec, [SHA-256], the 64-byte input 3b47876f...ba43524d
  // (also hashlib): exactly one block, so the padding is a whole second
  // block.
  test "Botan sha2_32.vec: SHA-256 of a 64-byte message" {
    let m: Word[8]^64 =
      hex"3b47876f88f7c4e7ce09f8bb35240915391cd5d335f12b40b3da5e30eb504a19" ++
      hex"6b484f864929c89793f93691ad4c062ee4861e811ef2c0c047266752ba43524d";
    sha256(m ++ padding[64, 1]()) ==
      hex"14609c05 4e038a8c b4f0886d e99b3130 7f2e707a 072c674a bfa64616 1b6bff63"
  }

  // OpenSSL evpmd_sha.txt, Digest = SHA224, Input = "abc" (also hashlib).
  test "OpenSSL evpmd_sha.txt: SHA-224 of abc" {
    sha224("abc" ++ padding[3, 1]()) ==
      hex"23097d22 3405d822 8642a477 bda255b3 2aadbce4 bda0b3f7 e36c9da7"
  }

  // OpenSSL evpmd_sha.txt, Digest = SHA224, the two-block message (also
  // hashlib).
  test "OpenSSL evpmd_sha.txt: SHA-224 of the two-block message" {
    let m: Word[8]^56 = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
    sha224(m ++ padding[56, 1]()) ==
      hex"75388b16 512776cc 5dba5da1 fd890150 b0c6455c b4f58b19 52522525"
  }

  // hashlib.sha512(b"").hexdigest(); no fetched vector file carries the
  // empty message for SHA-512.
  test "hashlib: SHA-512 of the empty message" {
    sha512(padding[0, 2]()) == (
      hex"cf83e1357eefb8bd f1542850d66d8007 d620e4050b5715dc 83f4a921d36ce9ce" ++
      hex"47d0d13c5d85f2b0 ff8318d2877eec2f 63b931bd47417a81 a538327af927da3e"
    )
  }

  // NIST, "SHA-512 Examples with Intermediate Values", one-block message
  // "abc"; the value as printed in Botan sha2_64.vec and OpenSSL
  // evpmd_sha.txt.
  test "NIST example: SHA-512 of abc" {
    sha512("abc" ++ padding[3, 2]()) == (
      hex"ddaf35a193617aba cc417349ae204131 12e6fa4e89a97ea2 0a9eeee64b55d39a" ++
      hex"2192992a274fc1a8 36ba3c23a3feebbd 454d4423643ce80e 2a9ac94fa54ca49f"
    )
  }

  // NIST, "SHA-512 Examples with Intermediate Values", the two-block
  // message; the value as printed in Botan sha2_64.vec and OpenSSL
  // evpmd_sha.txt.
  test "NIST example: SHA-512 of the two-block message" {
    let m: Word[8]^112 =
      "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmn" ++
      "hijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
    sha512(m ++ padding[112, 2]()) == (
      hex"8e959b75dae313da 8cf4f72814fc143f 8f7779c6eb9f7fa1 7299aeadb6889018" ++
      hex"501d289e4900f7e4 331b99dec4b5433a c7d329eeb6dd2654 5e96e55b874be909"
    )
  }

  // Botan sha2_64.vec, [SHA-384], input 616263 (also hashlib).
  test "Botan sha2_64.vec: SHA-384 of abc" {
    sha384("abc" ++ padding[3, 2]()) == (
      hex"cb00753f45a35e8b b5a03d699ac65007 272c32ab0eded163" ++
      hex"1a8b605a43ff5bed 8086072ba1e7cc23 58baeca134c825a7"
    )
  }

  // Botan sha2_64.vec, [SHA-384], the two-block message (also hashlib).
  test "Botan sha2_64.vec: SHA-384 of the two-block message" {
    let m: Word[8]^112 =
      "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmn" ++
      "hijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
    sha384(m ++ padding[112, 2]()) == (
      hex"09330c33f71147e8 3d192fc782cd1b47 53111b173b3b05d2" ++
      hex"2fa08086e3b0f712 fcc7c71a557e2db9 66c3e9fa91746039"
    )
  }

  // OpenSSL evpmd_sha.txt, Digest = SHA512-256, Input = "abc" (also hashlib).
  test "OpenSSL evpmd_sha.txt: SHA-512/256 of abc" {
    sha512_256("abc" ++ padding[3, 2]()) ==
      hex"53048e2681941ef9 9b2e29b76b4c7dab e4c2d0c634fc6d46 e0e2f13107e7af23"
  }

  // OpenSSL evpmd_sha.txt, Digest = SHA512-256, the two-block message (also
  // hashlib).
  test "OpenSSL evpmd_sha.txt: SHA-512/256 of the two-block message" {
    let m: Word[8]^112 =
      "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmn" ++
      "hijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
    sha512_256(m ++ padding[112, 2]()) ==
      hex"3928e184fb8690f8 40da3988121d31be 65cb9d3ef83ee614 6feac861e19b563a"
  }
}
