// Rust evaluates a row update inside a matrix. This slice rejects the value.
edition 2026;
module rows {
  type Row = Word[8]^3;
  spec cell(x: Row^3) -> Row^3 { x with [1] = (x[1] with [2] = 9) }
  spec revised() -> Row^3 {
    let x: Row^3 = [[1, 2, 3], [4, 5, 6], [7, 8, 9]];
    x with [1] = (x[1] with [2] = 9)
  }
}
