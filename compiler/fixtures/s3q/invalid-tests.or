// S3q rejection: a test's title is 1 through 128 printable ASCII characters,
// with no backslash, and no two tests of a module share one; a test's body
// is a `Bool`; and `==` and `!=` compare arrays and tuples whole, which have
// no order.
edition 2026;
module invalid_tests {
  spec pair() -> (Int, Int) { (1, 2) }
  test "" { true }
  test "café au lait" { true }
  test "back\\slash" { true }
  test "twice" { true }
  test "twice" { pair() == (1, 2) }
  test "a number" { 3 }
  test "ordered pairs" { pair() < (1, 3) }
  test "ordered literals" { (1, 2) <= (1, 3) }
  test "two literals" { [1, 2] == [1, 2] }
  test "an unknown function" { missing() }
}
