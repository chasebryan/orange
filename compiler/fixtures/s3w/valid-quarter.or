// RFC 8439, "ChaCha20 and Poly1305 for IETF Protocols" (2018),
// https://www.rfc-editor.org/rfc/rfc8439, section 2.1.1. The quarter-round
// inputs and outputs are cited, not copied as a vendored vector file.
edition 2026;
module quarter {
  spec quarter_round(a: Word[32], b: Word[32], c: Word[32], d: Word[32]) -> Word[32]^4 {
    let a1: Word[32] = a + b;
    let d1: Word[32] = (d ^ a1) <<< 16;
    let c1: Word[32] = c + d1;
    let b1: Word[32] = (b ^ c1) <<< 12;
    let a2: Word[32] = a1 + b1;
    let d2: Word[32] = (d1 ^ a2) <<< 8;
    let c2: Word[32] = c1 + d2;
    let b2: Word[32] = (b1 ^ c2) <<< 7;
    [a2, b2, c2, d2]
  }

  // One definition, checked for every integer in 0..16, called at the column
  // QUARTERROUND(0, 4, 8, 12) of RFC 8439 section 2.1.
  spec quarter_at[a at 0..16, b at 0..16, c at 0..16, d at 0..16](s: Word[32]^16) -> Word[32]^16 {
    let q: Word[32]^4 = quarter_round(s[a], s[b], s[c], s[d]);
    let s1: Word[32]^16 = s with [a] = q[0];
    let s2: Word[32]^16 = s1 with [b] = q[1];
    let s3: Word[32]^16 = s2 with [c] = q[2];
    s3 with [d] = q[3]
  }

  spec result() -> Word[32]^4 {
    let s: Word[32]^16 = quarter_at[0, 4, 8, 12]([
      0x11111111, 0, 0, 0,
      0x01020304, 0, 0, 0,
      0x9b8d6f43, 0, 0, 0,
      0x01234567, 0, 0, 0,
    ]);
    [s[0], s[4], s[8], s[12]]
  }

  test "RFC 8439 section 2.1.1 at positions 0, 4, 8, 12" {
    result() == [0xea2a92f4, 0xcb1cf8ce, 0x4581472e, 0x5881c4bb]
  }
}
