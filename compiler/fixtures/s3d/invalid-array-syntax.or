// S3d rejection: arrays have at least one element, an index names a
// position, and an array has at most four dimensions. (A variable index
// such as `x[i]` parses since S3e, and `x[i][j]` since S3s.)
edition 2026;
module syntax {
  spec empty() -> Word[8]^1 { [] }
  spec twice(x: Word[8]^4) -> Word[8] { x[0][] }
  spec nested() -> Word[8]^2^2^2^2^2 { [1, 2] }
}
