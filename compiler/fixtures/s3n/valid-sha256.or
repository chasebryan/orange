// S3n conformance: SHA-256 of FIPS 180-4 for every message of 1 through
// 119 bytes, reading and writing its words as the standard does, most
// significant byte first. A block's sixteen message words are the block as
// big-endian words (section 6.2.2, step 1), the digest is the hash value as
// big-endian bytes, and the padding ends with the message's length in bits
// as a big-endian 64-bit number (section 5.1.1). The digests of "abc" and of
// the 56-byte message whose padding takes a second block are the ones FIPS
// 180-4's examples print.
edition 2026;
module sha256 {
  spec big_sigma0(x: Word[32]) -> Word[32] { (x >>> 2) ^ (x >>> 13) ^ (x >>> 22) }
  spec big_sigma1(x: Word[32]) -> Word[32] { (x >>> 6) ^ (x >>> 11) ^ (x >>> 25) }
  spec small_sigma0(x: Word[32]) -> Word[32] { (x >>> 7) ^ (x >>> 18) ^ (x >> 3) }
  spec small_sigma1(x: Word[32]) -> Word[32] { (x >>> 17) ^ (x >>> 19) ^ (x >> 10) }
  spec ch(x: Word[32], y: Word[32], z: Word[32]) -> Word[32] { (x & y) ^ (~x & z) }
  spec maj(x: Word[32], y: Word[32], z: Word[32]) -> Word[32] { (x & y) ^ (x & z) ^ (y & z) }

  // Section 4.2.2.
  spec round_constants() -> Word[32]^64 {
    [
      0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
      0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
      0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
      0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
      0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
      0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
      0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
      0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ]
  }

  // Section 5.3.3.
  spec initial_hash() -> Word[32]^8 {
    [
      0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
      0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
    ]
  }

  // Section 6.2.2, step 1: the message schedule of one 64-byte block. Its
  // first sixteen words are the block itself, read as big-endian words.
  spec schedule(block: Word[8]^64) -> Word[32]^64 {
    let head: Word[32]^16 = block as big Word[32]^16;
    for t in 16..64 with w: Word[32]^64 = head ++ [0; 48] {
      w with [t] = small_sigma1(w[t - 2]) + w[t - 7] + small_sigma0(w[t - 15]) + w[t - 16]
    }
  }

  // Section 6.2.2, steps 2 through 4: one block absorbed into `hash`.
  spec compress(hash: Word[32]^8, block: Word[8]^64) -> Word[32]^8 {
    let w: Word[32]^64 = schedule(block);
    let k: Word[32]^64 = round_constants();
    let (a: Word[32], b: Word[32], c: Word[32], d: Word[32],
         e: Word[32], f: Word[32], g: Word[32], h: Word[32]) =
      for t in 0..64 with (a: Word[32], b: Word[32], c: Word[32], d: Word[32],
                           e: Word[32], f: Word[32], g: Word[32], h: Word[32]) =
        (hash[0], hash[1], hash[2], hash[3], hash[4], hash[5], hash[6], hash[7]) {
        let t1: Word[32] = h + big_sigma1(e) + ch(e, f, g) + k[t] + w[t];
        let t2: Word[32] = big_sigma0(a) + maj(a, b, c);
        (t1 + t2, a, b, c, d + t1, e, f, g)
      };
    [
      a + hash[0], b + hash[1], c + hash[2], d + hash[3],
      e + hash[4], f + hash[5], g + hash[6], h + hash[7],
    ]
  }

  // Section 6.2.2: the digest of a padded message of `blocks` blocks, each
  // absorbed in turn, and written as the hash value's big-endian bytes.
  spec absorb[blocks in 1..4](p: Word[8]^(64 * blocks)) -> Word[8]^32 {
    let hash: Word[32]^8 = for b in 0..blocks with h: Word[32]^8 = initial_hash() {
      compress(h, p[64 * b..64 * b + 64])
    };
    hash as big Word[8]^32
  }

  // Section 5.1.1: the message, the bit 1 and then zeros, as a byte 80 and
  // zero bytes, and the message's length in bits as a big-endian 64-bit
  // number fill ((len + 8) / 64) + 1 blocks.
  spec pad[len in 1..120](m: Word[8]^len) -> Word[8]^(64 * (((len + 8) / 64) + 1)) {
    m ++ ([0; ((64 * (((len + 8) / 64) + 1)) - len - 8)] with [0] = 0x80)
      ++ ((8 * len) as big Word[8]^8)
  }

  spec sha256[len in 1..120](m: Word[8]^len) -> Word[8]^32 { absorb(pad(m)) }

  // FIPS 180-4's examples: "abc", one block, and a 56-byte message, whose
  // padding takes a second block.
  spec abc() -> Word[8]^32 { sha256("abc") }

  spec two_blocks() -> Word[8]^32 {
    sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
  }

  // The longest message of one block, whose padding puts no zero byte
  // between the byte 80 and the length, and the longest message of all.
  spec full_block() -> Word[8]^32 {
    sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnop")
  }

  spec longest() -> Word[8]^32 { sha256([0x61; 119]) }
}
