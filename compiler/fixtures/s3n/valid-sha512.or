// S3n conformance: SHA-512 of FIPS 180-4 for every message of 1 through
// 239 bytes, with 64-bit words read and written most significant byte
// first. A block's sixteen message words are the block as big-endian 64-bit
// words (section 6.4.2, step 1), the digest is the hash value as big-endian
// bytes, and the padding ends with the message's length in bits as a
// big-endian 128-bit number (section 5.1.2). The digests of "abc" and of the
// 112-byte message whose padding takes a second block are the ones FIPS
// 180-4's examples print.
edition 2026;
module sha512 {
  spec big_sigma0(x: Word[64]) -> Word[64] { (x >>> 28) ^ (x >>> 34) ^ (x >>> 39) }
  spec big_sigma1(x: Word[64]) -> Word[64] { (x >>> 14) ^ (x >>> 18) ^ (x >>> 41) }
  spec small_sigma0(x: Word[64]) -> Word[64] { (x >>> 1) ^ (x >>> 8) ^ (x >> 7) }
  spec small_sigma1(x: Word[64]) -> Word[64] { (x >>> 19) ^ (x >>> 61) ^ (x >> 6) }
  spec ch(x: Word[64], y: Word[64], z: Word[64]) -> Word[64] { (x & y) ^ (~x & z) }
  spec maj(x: Word[64], y: Word[64], z: Word[64]) -> Word[64] { (x & y) ^ (x & z) ^ (y & z) }

  // Section 4.2.3.
  spec round_constants() -> Word[64]^80 {
    [
      0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
      0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
      0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
      0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
      0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
      0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
      0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
      0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
      0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
      0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
      0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
      0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
      0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
      0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
      0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
      0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
      0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
      0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
      0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
      0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
    ]
  }

  // Section 5.3.5.
  spec initial_hash() -> Word[64]^8 {
    [
      0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
      0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,
    ]
  }

  // Section 6.4.2, step 1: the message schedule of one 128-byte block. Its
  // first sixteen words are the block itself, read as big-endian words.
  spec schedule(block: Word[8]^128) -> Word[64]^80 {
    let head: Word[64]^16 = block as big Word[64]^16;
    for t in 16..80 with w: Word[64]^80 = head ++ [0; 64] {
      w with [t] = small_sigma1(w[t - 2]) + w[t - 7] + small_sigma0(w[t - 15]) + w[t - 16]
    }
  }

  // Section 6.4.2, steps 2 through 4: one block absorbed into `hash`.
  spec compress(hash: Word[64]^8, block: Word[8]^128) -> Word[64]^8 {
    let w: Word[64]^80 = schedule(block);
    let k: Word[64]^80 = round_constants();
    let (a: Word[64], b: Word[64], c: Word[64], d: Word[64],
         e: Word[64], f: Word[64], g: Word[64], h: Word[64]) =
      for t in 0..80 with (a: Word[64], b: Word[64], c: Word[64], d: Word[64],
                           e: Word[64], f: Word[64], g: Word[64], h: Word[64]) =
        (hash[0], hash[1], hash[2], hash[3], hash[4], hash[5], hash[6], hash[7]) {
        let t1: Word[64] = h + big_sigma1(e) + ch(e, f, g) + k[t] + w[t];
        let t2: Word[64] = big_sigma0(a) + maj(a, b, c);
        (t1 + t2, a, b, c, d + t1, e, f, g)
      };
    [
      a + hash[0], b + hash[1], c + hash[2], d + hash[3],
      e + hash[4], f + hash[5], g + hash[6], h + hash[7],
    ]
  }

  // Section 6.4.2: the digest of a padded message of `blocks` blocks, each
  // absorbed in turn, and written as the hash value's big-endian bytes.
  spec absorb[blocks in 1..3](p: Word[8]^(128 * blocks)) -> Word[8]^64 {
    let hash: Word[64]^8 = for b in 0..blocks with h: Word[64]^8 = initial_hash() {
      compress(h, p[128 * b..128 * b + 128])
    };
    hash as big Word[8]^64
  }

  // Section 5.1.2: the message, the byte 80 and zero bytes, and the
  // message's length in bits as a big-endian 128-bit number fill
  // ((len + 16) / 128) + 1 blocks.
  spec pad[len in 1..240](m: Word[8]^len) -> Word[8]^(128 * (((len + 16) / 128) + 1)) {
    m ++ ([0; ((128 * (((len + 16) / 128) + 1)) - len - 16)] with [0] = 0x80)
      ++ ((8 * len) as big Word[8]^16)
  }

  spec sha512[len in 1..240](m: Word[8]^len) -> Word[8]^64 { absorb(pad(m)) }

  // FIPS 180-4's examples: "abc", one block, and a 112-byte message, whose
  // padding takes a second block.
  spec abc() -> Word[8]^64 { sha512("abc") }

  spec two_blocks() -> Word[8]^64 {
    sha512(
      "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmno"
        ++ "ijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
    )
  }

  // The longest message of one block, whose padding puts no zero byte
  // between the byte 80 and the length, and the longest message of all.
  spec full_block() -> Word[8]^64 { sha512([0x61; 111]) }

  spec longest() -> Word[8]^64 { sha512([0x61; 239]) }
}
