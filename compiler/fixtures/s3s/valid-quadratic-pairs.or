// FIPS 203 section 4.3 uses quadratic factors, rather than scalar pointwise
// products. This mathematical demonstrator evaluates the first two factors
// X^2 - 17 and X^2 + 17 modulo 3329. It is neither an NTT nor a KEM.
// For (a0 + a1*X)(b0 + b1*X) modulo X^2 - z:
// c0 = a0*b0 + z*a1*b1 and c1 = a0*b1 + a1*b0.
// The hand-derived answers are [3 + 17*8, 4 + 6] = [139, 10],
// and [-2 + (-17)*(-1), 1 + 2] = [15, 3].
edition 2026;
module quadratic {
  type F = Mod[3329];
  type Pair = F^2;
  type Factors = Pair^2;

  spec multiply(a: Factors, b: Factors) -> Factors {
    let zetas: F^2 = [17, -17];
    for i in 0..2 with products: Factors = [[0; 2]; 2] {
      let p: Pair = [
        (a[i][0] * b[i][0]) + (zetas[i] * (a[i][1] * b[i][1])),
        (a[i][0] * b[i][1]) + (a[i][1] * b[i][0])
      ];
      products with [i] = p
    }
  }

  spec products() -> Factors { multiply([[1, 2], [-1, 1]], [[3, 4], [2, -1]]) }

  test "two quadratic-factor products, hand-derived" { products() == [[139, 10], [15, 3]] }
  test "quadratic-pair multiplication is commutative in this example" {
    multiply([[3, 4], [2, -1]], [[1, 2], [-1, 1]]) == products()
  }
  test "the multiplicative identity has one in every constant coefficient" {
    multiply(products(), [[1, 0]; 2]) == products()
  }
}
