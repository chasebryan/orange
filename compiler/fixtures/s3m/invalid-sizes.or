// S3m rejection: a size's range is nonempty and within 0 through 65536, a
// function has at most 256 instances, and its sizes' names are its own. A
// size is built from integer literals and size parameters. Every instance is
// checked, and the first of a function in error is named. A call gives one
// size in its callee's range for each size parameter, or gives none and fits
// exactly one instance. Instances call one another without a cycle.
edition 2026;
module sizes {
  spec empty[n in 3..3]() -> Int { n }
  spec far[n in 1..70000]() -> Int { n }
  spec many[a in 1..20, b in 1..20]() -> Int { a + b }
  spec twice[n in 1..3, n in 1..3]() -> Int { n }
  spec shadow[n in 1..3](n: Int) -> Int { n }
  spec value(k: Int) -> Word[8]^k { [0; 1] }
  spec last[n in 1..5](x: Word[8]^n) -> Word[8] { x[3] }
  spec none[n in 0..2]() -> Word[8]^n { [0; n] }
  spec first[n in 1..4](x: Word[8]^n) -> Word[8] { x[0] }
  spec count[n in 1..3]() -> Int { n }
  spec outside() -> Word[8] { first[4]([0; 4]) }
  spec extra() -> Word[8] { first[1, 2]([0]) }
  spec unsized() -> Int { outside[1]() }
  spec unfit() -> Word[8] { first([0; 9]) }
  spec unclear() -> Int { count() }
  spec swap[n in 1..3]() -> Int { swap[3 - n]() }
}
