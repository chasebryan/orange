// The 5-bit S-box of Ascon (NIST SP 800-232, 2025, section 3.3, table 6),
// and chi, the 5-bit map of Keccak-f (FIPS 202, section 3.2.4) from which
// it is built, y_i = x_i + (x_(i+1) + 1) x_(i+2), the indices modulo 5.
// Both are held in the low five bits of a byte; analyze them with
// `--bits 5`.
edition 2026;
module ascon {
  spec sbox(x: Word[8]) -> Word[8] {
    let table: Word[8]^32 = [
      0x04, 0x0b, 0x1f, 0x14, 0x1a, 0x15, 0x09, 0x02, 0x1b, 0x05, 0x08, 0x12, 0x1d, 0x03, 0x06, 0x1c,
      0x1e, 0x13, 0x07, 0x0e, 0x00, 0x0d, 0x11, 0x18, 0x10, 0x0c, 0x01, 0x19, 0x16, 0x0a, 0x0f, 0x17,
    ];
    table[x & 0x1f]
  }

  spec chi(x: Word[8]) -> Word[8] {
    let a: Word[8] = x & 0x1f;
    let next: Word[8] = ((a >> 1) | (a << 4)) & 0x1f;
    let after: Word[8] = ((a >> 2) | (a << 3)) & 0x1f;
    a ^ ((next ^ 0x1f) & after)
  }
}
