// S3e conformance: ChaCha20 of RFC 8439 with loops. The key and nonce are
// loaded by loops whose indices are proved in range, the twenty rounds are
// one loop over ten double rounds, and the whole encryption of the "sunscreen"
// plaintext of section 2.4.2 matches the RFC's ciphertext.
edition 2026;
module chacha20 {
  // Section 2.1.
  spec quarter_round(a: Word[32], b: Word[32], c: Word[32], d: Word[32]) -> Word[32]^4 {
    let a1: Word[32] = a + b;
    let d1: Word[32] = (d ^ a1) <<< 16;
    let c1: Word[32] = c + d1;
    let b1: Word[32] = (b ^ c1) <<< 12;
    let a2: Word[32] = a1 + b1;
    let d2: Word[32] = (d1 ^ a2) <<< 8;
    let c2: Word[32] = c1 + d2;
    let b2: Word[32] = (b1 ^ c2) <<< 7;
    [a2, b2, c2, d2]
  }

  // Section 2.3: a column round, then a diagonal round.
  spec double_round(x: Word[32]^16) -> Word[32]^16 {
    let q0: Word[32]^4 = quarter_round(x[0], x[4], x[8], x[12]);
    let q1: Word[32]^4 = quarter_round(x[1], x[5], x[9], x[13]);
    let q2: Word[32]^4 = quarter_round(x[2], x[6], x[10], x[14]);
    let q3: Word[32]^4 = quarter_round(x[3], x[7], x[11], x[15]);
    let d0: Word[32]^4 = quarter_round(q0[0], q1[1], q2[2], q3[3]);
    let d1: Word[32]^4 = quarter_round(q1[0], q2[1], q3[2], q0[3]);
    let d2: Word[32]^4 = quarter_round(q2[0], q3[1], q0[2], q1[3]);
    let d3: Word[32]^4 = quarter_round(q3[0], q0[1], q1[2], q2[3]);
    [
      d0[0], d1[0], d2[0], d3[0],
      d3[1], d0[1], d1[1], d2[1],
      d2[2], d3[2], d0[2], d1[2],
      d1[3], d2[3], d3[3], d0[3],
    ]
  }

  spec load_le32(b0: Word[8], b1: Word[8], b2: Word[8], b3: Word[8]) -> Word[32] {
    (b0 as Word[32]) | ((b1 as Word[32]) << 8) | ((b2 as Word[32]) << 16)
      | ((b3 as Word[32]) << 24)
  }

  spec le_bytes(x: Word[32]) -> Word[8]^4 {
    [x as Word[8], (x >> 8) as Word[8], (x >> 16) as Word[8], (x >> 24) as Word[8]]
  }

  // Section 2.3: the block function. Words 4 through 11 are the key and
  // words 13 through 15 the nonce, each read little-endian.
  spec block(key: Word[8]^32, counter: Word[32], nonce: Word[8]^12) -> Word[32]^16 {
    let constants: Word[32]^16 = [
      0x61707865, 0x3320646e, 0x79622d32, 0x6b206574,
      0, 0, 0, 0,
      0, 0, 0, 0,
      counter, 0, 0, 0,
    ];
    let keyed: Word[32]^16 = for i in 0..8 with s: Word[32]^16 = constants {
      s with [4 + i] = load_le32(key[4 * i], key[4 * i + 1], key[4 * i + 2], key[4 * i + 3])
    };
    let initial: Word[32]^16 = for i in 0..3 with s: Word[32]^16 = keyed {
      s with [13 + i] = load_le32(nonce[4 * i], nonce[4 * i + 1], nonce[4 * i + 2], nonce[4 * i + 3])
    };
    let mixed: Word[32]^16 = for i in 0..10 with s: Word[32]^16 = initial { double_round(s) };
    for i in 0..16 with s: Word[32]^16 = mixed { s with [i] = s[i] + initial[i] }
  }

  // Section 2.3: the state serialized as 64 little-endian bytes.
  spec serialize(s: Word[32]^16) -> Word[8]^64 {
    for i in 0..16 with bytes: Word[8]^64 = [0; 64] {
      for j in 0..4 with b: Word[8]^64 = bytes { b with [4 * i + j] = le_bytes(s[i])[j] }
    }
  }

  spec key() -> Word[8]^32 {
    [
      0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
      0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
      0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
      0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
    ]
  }

  // Section 2.3.2: block count 1 with nonce 00:00:00:09:00:00:00:4a:00:00:00:00.
  spec block_test_vector() -> Word[32]^16 {
    block(key(), 1, [0x00, 0x00, 0x00, 0x09, 0x00, 0x00, 0x00, 0x4a, 0x00, 0x00, 0x00, 0x00])
  }

  // Section 2.4: encryption of a 114-byte message from initial counter 1,
  // with the keystream of blocks 1 and 2.
  spec encrypt(key: Word[8]^32, nonce: Word[8]^12, plaintext: Word[8]^114) -> Word[8]^114 {
    let first: Word[8]^64 = serialize(block(key, 1, nonce));
    let second: Word[8]^64 = serialize(block(key, 2, nonce));
    let head: Word[8]^114 = for n in 0..64 with c: Word[8]^114 = plaintext {
      c with [n] = plaintext[n] ^ first[n]
    };
    for n in 64..114 with c: Word[8]^114 = head { c with [n] = plaintext[n] ^ second[n - 64] }
  }

  // Section 2.4.2: "Ladies and Gentlemen of the class of '99: If I could
  // offer you only one tip for the future, sunscreen would be it."
  spec sunscreen() -> Word[8]^114 {
    [
      0x4c, 0x61, 0x64, 0x69, 0x65, 0x73, 0x20, 0x61, 0x6e, 0x64, 0x20, 0x47,
      0x65, 0x6e, 0x74, 0x6c, 0x65, 0x6d, 0x65, 0x6e, 0x20, 0x6f, 0x66, 0x20,
      0x74, 0x68, 0x65, 0x20, 0x63, 0x6c, 0x61, 0x73, 0x73, 0x20, 0x6f, 0x66,
      0x20, 0x27, 0x39, 0x39, 0x3a, 0x20, 0x49, 0x66, 0x20, 0x49, 0x20, 0x63,
      0x6f, 0x75, 0x6c, 0x64, 0x20, 0x6f, 0x66, 0x66, 0x65, 0x72, 0x20, 0x79,
      0x6f, 0x75, 0x20, 0x6f, 0x6e, 0x6c, 0x79, 0x20, 0x6f, 0x6e, 0x65, 0x20,
      0x74, 0x69, 0x70, 0x20, 0x66, 0x6f, 0x72, 0x20, 0x74, 0x68, 0x65, 0x20,
      0x66, 0x75, 0x74, 0x75, 0x72, 0x65, 0x2c, 0x20, 0x73, 0x75, 0x6e, 0x73,
      0x63, 0x72, 0x65, 0x65, 0x6e, 0x20, 0x77, 0x6f, 0x75, 0x6c, 0x64, 0x20,
      0x62, 0x65, 0x20, 0x69, 0x74, 0x2e,
    ]
  }

  spec sunscreen_ciphertext() -> Word[8]^114 {
    encrypt(key(), [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x4a, 0x00, 0x00, 0x00, 0x00], sunscreen())
  }
}
