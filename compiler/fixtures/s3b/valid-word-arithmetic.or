// S3b conformance: Word[n] arithmetic is exact modulo 2^n, and bitwise,
// shift, and rotation operators act on exactly n bits.
edition 2026;
module words {
  spec add_wraps() -> Word[8] { 200 + 100 }
  spec subtract_wraps() -> Word[8] { 0 - 1 }
  spec multiply_wraps() -> Word[16] { 0xffff * 0xffff }
  spec negation_is_subtraction() -> Word[32] { 0 - 0x80000000 }
  spec precedence() -> Word[32] { 1 + 2 * 3 - 4 }
  spec complement() -> Word[16] { ~0x00ff }
  spec mask() -> Word[64] { 0xdeadbeefcafef00d & 0xffffffff00000000 }
  spec merge() -> Word[64] { 0xdeadbeef00000000 | 0xcafef00d }
  spec toggle() -> Word[8] { 0b1010_1010 ^ 0b1111_0000 }
  spec shift_out() -> Word[8] { 0x81 << 1 }
  spec shift_in() -> Word[8] { 0x81 >> 7 }
  spec rotate_left() -> Word[8] { 0x81 <<< 1 }
  spec rotate_right() -> Word[64] { 1 >>> 1 }
  spec rotate_zero() -> Word[16] { 0xabcd <<< 0 }
  spec largest_amount() -> Word[64] { 0x8000000000000001 <<< 63 }
}
