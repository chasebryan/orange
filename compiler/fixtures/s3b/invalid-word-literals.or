// S3b rejection: every Word[n] literal lies in 0 through 2^n - 1, wherever
// it appears.
edition 2026;
module literals {
  spec pass(x: Word[16]) -> Word[16] { x }
  spec over16() -> Word[16] { pass(65536) }
  spec over32(x: Word[32]) -> Word[32] { x ^ 4294967296 }
  spec over64(x: Word[64]) -> Word[64] { x + 0x1_0000_0000_0000_0000 }
  spec negative32(x: Word[32]) -> Word[32] { x & -1 }
}
