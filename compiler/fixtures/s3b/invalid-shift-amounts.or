// S3b rejection: a shift or rotation amount written as a literal is an
// unsigned integer less than the operand's width. Since S3r an amount that
// is not one literal is computed from data (docs/AMOUNTS_2026.md).
edition 2026;
module amounts {
  spec full_width(x: Word[8]) -> Word[8] { x << 8 }
  spec hexadecimal_width(x: Word[32]) -> Word[32] { x >>> 0x20 }
  spec negative(x: Word[16]) -> Word[16] { x >> -1 }
  spec past_every_width(x: Word[64]) -> Word[64] { x <<< 0x1_0000_0000_0000_0000 }
}
