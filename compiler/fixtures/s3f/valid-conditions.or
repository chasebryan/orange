// S3f conformance: `Bool` values, comparisons, conditionals, and Euclidean
// division, each with its exact value.
edition 2026;
module conditions {
  spec truth() -> Bool^2 { [true, false] }

  // `&&` and `||` evaluate both operands; `!` negates.
  spec logic() -> Bool^4 { [true && false, true || false, !true, !(false || false)] }

  // Integers compare by value and words as unsigned numbers.
  spec order() -> Bool^4 {
    let a: Int = -5;
    let b: Word[8] = 0x80;
    [a < 3, a >= -5, b > 0x7f, b == 128]
  }

  // Division is Euclidean: the remainder is never negative, and
  // a = b * (a / b) + a % b.
  spec euclid() -> Int^8 {
    let p: Int = 7;
    let n: Int = -7;
    [p / 2, p % 2, n / 2, n % 2, p / -2, p % -2, n / -2, n % -2]
  }

  // Division is total: x / 0 = 0 and x % 0 = x, for integers and words.
  spec by_zero() -> Int^2 { let x: Int = 42; [x / 0, x % 0] }
  spec words() -> Word[8]^4 { let x: Word[8] = 200; [x / 7, x % 7, x / 0, x % 0] }

  // An `else if` chain chooses the value of the first true condition.
  spec sign(x: Int) -> Int { if x < 0 { -1 } else if x == 0 { 0 } else { 1 } }
  spec signs() -> Int^3 { [sign(-12), sign(0), sign(7)] }

  // Only the chosen branch is evaluated, so the loops of `heavy`, which the
  // step budget could never finish, are never started.
  spec heavy(x: Int) -> Int {
    for i in 0..65536 with s: Int = x { for j in 0..65536 with t: Int = s { t + j } }
  }
  spec lazy() -> Int { let one: Int = 1; if one == 1 { 7 } else { heavy(one) } }

  // A remainder keeps an index in range: `(i + 1) % 5` runs from 0 through
  // 4, so the rotation is checked before anything runs.
  spec rotate(x: Word[8]^5) -> Word[8]^5 {
    for i in 0..5 with r: Word[8]^5 = x { r with [i] = x[(i + 1) % 5] }
  }
  spec rotated() -> Word[8]^5 { rotate([1, 2, 3, 4, 5]) }

  // Counting with a condition in a loop's step.
  spec evens() -> Int { for i in 0..10 with s: Int = 0 { if (i % 2) == 0 { s + 1 } else { s } } }

  // `if`, `else`, `true`, and `false` stay ordinary names where a program
  // declares them, so earlier programs keep their meaning.
  spec contextual(if: Int, else: Int, true: Int) -> Int { if + else + true }
  spec names() -> Int { contextual(1, 2, 3) }
}
