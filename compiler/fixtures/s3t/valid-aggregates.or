edition 2026;
module aggregates {
  spec fill[m in 3..6, n in 1..4](x: Mod[m]) -> Mod[m]^n { [x; n] }
  spec total[m in 3..6, n in 1..4](xs: Mod[m]^n) -> Mod[m] {
    for i in 0..n with sum: Mod[m] = 0 {
      let value: Mod[m] = xs[i];
      sum + value
    }
  }
  spec pair[m in 3..6](x: Mod[m]) -> (Mod[m], Mod[m]^2) { (x, [x, x * x]) }
  spec join[m in 3..6](x: Mod[m]) -> Mod[m]^3 {
    let values: Mod[m]^3 = [x; 1] ++ [x; 2];
    values with [1..3] = [x + 1; 2]
  }
  spec result() -> (Mod[3], Mod[4]^2) { (total[3, 3](fill[3, 3](2)), pair[4](3).1) }
  test "array elements and loop bindings retain the instance domain" {
    (total[3, 3](fill[3, 3](2)) == 0) && (total[5, 3](fill[5, 3](2)) == 1)
  }
  test "tuples retain scalar and array modular types" { pair[4](3) == (3, [3, 1]) }
  test "slice updates preserve specialized residue types" { join[5](4) == [4, 0, 0] }
}
