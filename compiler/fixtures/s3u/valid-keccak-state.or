// S3u conformance: SHA3-256 of FIPS 202 (August 2015) with the state as the
// standard indexes it, a 5 x 5 array of 64-bit lanes A[x][y]. Section 3.1.2
// places lane (x, y) at w(5y + x) of the state string, so a block's word
// 5y + x fills A[x][y]; each step mapping of section 3.2 is then written
// with the coordinates the standard writes, modulo 5.
edition 2026;
module keccak {
  // A sheet is the five lanes A[x][0] through A[x][4] of one x.
  type Sheet = Word[64]^5;
  type State = Sheet^5;
  type Z5 = Mod[5];

  // Algorithm 1, theta: C[x] is the parity of column x, and every lane of
  // column x takes in D[x] = C[x - 1] ^ rot(C[x + 1], 1).
  spec theta(a: State) -> State {
    let c: Word[64]^5 = for x in 0..5 with c: Word[64]^5 = [0; 5] {
      c with [x] = a[x][0] ^ a[x][1] ^ a[x][2] ^ a[x][3] ^ a[x][4]
    };
    for x in 0..5 with b: State = a {
      for y in 0..5 with t: State = b {
        t with [x][y] = a[x][y] ^ c[(x + 4) % 5] ^ (c[(x + 1) % 5] <<< 1)
      }
    }
  }

  // Algorithm 2, rho: from (x, y) = (1, 0), step t turns A[x][y] by
  // (t + 1)(t + 2)/2 and moves to (y, 2x + 3y).
  spec rho_walk(a: State) -> (State, Z5, Z5) {
    for t in 0..24 with (b: State, x: Z5, y: Z5) = (a, 1, 0) {
      (
        b with [x as Int][y as Int] = a[x as Int][y as Int] <<< (((t + 1) * (t + 2)) / 2),
        y,
        2 * x + 3 * y,
      )
    }
  }

  spec rho(a: State) -> State { rho_walk(a).0 }

  // Algorithm 3, pi: A'[x][y] = A[x + 3y][x].
  spec pi(a: State) -> State {
    for x in 0..5 with b: State = a {
      for y in 0..5 with t: State = b { t with [x][y] = a[(x + 3 * y) % 5][x] }
    }
  }

  // Algorithm 4, chi: A'[x][y] = A[x][y] ^ (~A[x + 1][y] & A[x + 2][y]).
  spec chi(a: State) -> State {
    for x in 0..5 with b: State = a {
      for y in 0..5 with t: State = b {
        t with [x][y] = a[x][y] ^ (~a[(x + 1) % 5][y] & a[(x + 2) % 5][y])
      }
    }
  }

  // Algorithms 5 and 6: round i_r's constant has bit 2^j - 1 equal to
  // rc(j + 7 i_r), where rc(t) is bit 0 of an 8-bit linear feedback shift
  // register after t steps.
  spec rc_walk() -> (Word[64]^24, Word[16]) {
    for t in 0..168 with (rc: Word[64]^24, r: Word[16]) = ([0; 24], 1) {
      let next: Word[16] = r << 1;
      let one: Word[8] = 1;
      (
        rc with [t / 7] = rc[t / 7] | (((r & 1) as Word[64]) << ((one << (t % 7)) - 1)),
        if (next & 0x100) == 0 { next } else { next ^ 0x171 },
      )
    }
  }

  // Algorithm 7, Keccak-p[1600, 24], with iota adding the round's
  // constant to A[0][0].
  spec keccak_f(a: State) -> State {
    let rc: Word[64]^24 = rc_walk().0;
    for round in 0..24 with s: State = a {
      let b: State = chi(pi(rho(theta(s))));
      b with [0][0] = b[0][0] ^ rc[round]
    }
  }

  // Sections 4, 5.1 and 6.1: SHA3-256 absorbs one block of 136 bytes, the
  // message, the byte 06, zeros, and the byte 80, as 17 lanes; lane
  // 5y + x is A[x][y]. The digest is lanes (0, 0) through (3, 0).
  spec sha3_256[len in 1..134](m: Word[8]^len) -> Word[8]^32 {
    let block: Word[64]^17 = (m ++ hex"06" ++ [0; (134 - len)] ++ hex"80") as little Word[64]^17;
    let absorbed: State = for i in 0..17 with s: State = [[0; 5]; 5] {
      s with [i % 5][i / 5] = block[i]
    };
    let out: State = keccak_f(absorbed);
    [out[0][0], out[1][0], out[2][0], out[3][0]] as little Word[8]^32
  }

  test "FIPS 202 example: SHA3-256 of abc" {
    sha3_256("abc") ==
      hex"3a985da7 4fe225b2 045c172d 6bd390bd 855f086e 3e9d525b 46bfe245 11431532"
  }

  test "FIPS 202 example: SHA3-256 of the 448-bit message" {
    sha3_256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") ==
      hex"41c0dba2 a9d62408 49100376 a8235e2c 82e1b999 8a999e21 db32dd97 496d3376"
  }

  // Keccak-f of the zero state, lane A[0][0], from the Keccak team's
  // KeccakF-1600 intermediate values.
  test "Keccak-f[1600] of the zero state" {
    keccak_f([[0; 5]; 5])[0][0] == 0xf1258f7940e1dde7
  }

  test "the round constants of iota" {
    let rc: Word[64]^24 = rc_walk().0;
    (rc[0] == 1) && (rc[1] == 0x0000000000008082) && (rc[23] == 0x8000000080008008)
  }
}
