// ChaCha20-Poly1305, the authenticated cipher of RFC 8439, behind the sealing
// interface of `orangec enc` and `orangec dec`.
//
// Key 256 bits, nonce 96 bits, tag 128 bits. A chunk is 240 bytes of
// plaintext, sealed with 64 bytes of associated data; both are whole
// multiples of sixteen bytes, so Poly1305 reads them with no padding
// (section 2.8).
//
// Reference code: the Orange evaluator is not constant-time, and nothing here
// is verified.
edition 2026;
module chacha20_poly1305 {
  // ---- ChaCha20, section 2 ----

  // Section 2.1.
  spec quarter_round(a: Word[32], b: Word[32], c: Word[32], d: Word[32]) -> Word[32]^4 {
    let a1: Word[32] = a + b;
    let d1: Word[32] = (d ^ a1) <<< 16;
    let c1: Word[32] = c + d1;
    let b1: Word[32] = (b ^ c1) <<< 12;
    let a2: Word[32] = a1 + b1;
    let d2: Word[32] = (d1 ^ a2) <<< 8;
    let c2: Word[32] = c1 + d2;
    let b2: Word[32] = (b1 ^ c2) <<< 7;
    [a2, b2, c2, d2]
  }

  // Section 2.3: a column round, then a diagonal round.
  spec double_round(x: Word[32]^16) -> Word[32]^16 {
    let q0: Word[32]^4 = quarter_round(x[0], x[4], x[8], x[12]);
    let q1: Word[32]^4 = quarter_round(x[1], x[5], x[9], x[13]);
    let q2: Word[32]^4 = quarter_round(x[2], x[6], x[10], x[14]);
    let q3: Word[32]^4 = quarter_round(x[3], x[7], x[11], x[15]);
    let d0: Word[32]^4 = quarter_round(q0[0], q1[1], q2[2], q3[3]);
    let d1: Word[32]^4 = quarter_round(q1[0], q2[1], q3[2], q0[3]);
    let d2: Word[32]^4 = quarter_round(q2[0], q3[1], q0[2], q1[3]);
    let d3: Word[32]^4 = quarter_round(q3[0], q0[1], q1[2], q2[3]);
    [
      d0[0], d1[0], d2[0], d3[0],
      d3[1], d0[1], d1[1], d2[1],
      d2[2], d3[2], d0[2], d1[2],
      d1[3], d2[3], d3[3], d0[3],
    ]
  }

  spec load_le32(b0: Word[8], b1: Word[8], b2: Word[8], b3: Word[8]) -> Word[32] {
    (b0 as Word[32]) | ((b1 as Word[32]) << 8) | ((b2 as Word[32]) << 16)
      | ((b3 as Word[32]) << 24)
  }

  spec le_bytes(x: Word[32]) -> Word[8]^4 {
    [x as Word[8], (x >> 8) as Word[8], (x >> 16) as Word[8], (x >> 24) as Word[8]]
  }

  // Section 2.3: the block function. Words 4 through 11 are the key and
  // words 13 through 15 the nonce, each read little-endian.
  spec block(key: Word[8]^32, counter: Word[32], nonce: Word[8]^12) -> Word[32]^16 {
    let constants: Word[32]^16 = [
      0x61707865, 0x3320646e, 0x79622d32, 0x6b206574,
      0, 0, 0, 0,
      0, 0, 0, 0,
      counter, 0, 0, 0,
    ];
    let keyed: Word[32]^16 = for i in 0..8 with s: Word[32]^16 = constants {
      s with [4 + i] = load_le32(key[4 * i], key[4 * i + 1], key[4 * i + 2], key[4 * i + 3])
    };
    let initial: Word[32]^16 = for i in 0..3 with s: Word[32]^16 = keyed {
      s with [13 + i] = load_le32(nonce[4 * i], nonce[4 * i + 1], nonce[4 * i + 2], nonce[4 * i + 3])
    };
    let mixed: Word[32]^16 = for i in 0..10 with s: Word[32]^16 = initial { double_round(s) };
    for i in 0..16 with s: Word[32]^16 = mixed { s with [i] = s[i] + initial[i] }
  }

  // Section 2.3: the state serialized as 64 little-endian bytes.
  spec serialize(s: Word[32]^16) -> Word[8]^64 {
    for i in 0..64 with b: Word[8]^64 = [0; 64] { b with [i] = le_bytes(s[i / 4])[i % 4] }
  }

  // Section 2.4: the keystream of a chunk, blocks 1 through 4 as 64 words.
  // Byte n of the stream is byte n % 4 of word n / 4; a chunk uses the first
  // 240.
  spec keystream(key: Word[8]^32, nonce: Word[8]^12) -> Word[32]^64 {
    let b1: Word[32]^16 = block(key, 1, nonce);
    let b2: Word[32]^16 = block(key, 2, nonce);
    let b3: Word[32]^16 = block(key, 3, nonce);
    let b4: Word[32]^16 = block(key, 4, nonce);
    let s1: Word[32]^64 = for w in 0..16 with s: Word[32]^64 = [0; 64] { s with [w] = b1[w] };
    let s2: Word[32]^64 = for w in 0..16 with s: Word[32]^64 = s1 { s with [16 + w] = b2[w] };
    let s3: Word[32]^64 = for w in 0..16 with s: Word[32]^64 = s2 { s with [32 + w] = b3[w] };
    for w in 0..16 with s: Word[32]^64 = s3 { s with [48 + w] = b4[w] }
  }

  // ---- Poly1305, section 2.5 ----

  // p = 2^130 - 5.
  spec prime() -> Int { 1361129467683753853853498429727072845819 }

  // Section 2.5.1: add one block to the accumulator and multiply by r.
  spec absorb(a: Int, r: Int, block: Int) -> Int { ((a + block) * r) % prime() }

  // Section 2.5: r is the first sixteen key bytes, little-endian, with
  // r &= 0x0ffffffc0ffffffc0ffffffc0fffffff.
  spec poly_r(key: Word[8]^32) -> Int {
    let clamp: Word[8]^16 = [
      0xff, 0xff, 0xff, 0x0f, 0xfc, 0xff, 0xff, 0x0f,
      0xfc, 0xff, 0xff, 0x0f, 0xfc, 0xff, 0xff, 0x0f,
    ];
    for i in 0..16 with n: Int = 0 { n * 256 + ((key[15 - i] & clamp[15 - i]) as Int) }
  }

  // Section 2.5: s is the other sixteen key bytes, little-endian.
  spec poly_s(key: Word[8]^32) -> Int {
    for i in 0..16 with n: Int = 0 { n * 256 + (key[31 - i] as Int) }
  }

  // 256^k for 0 <= k < 16: the weight of byte k of a little-endian integer.
  spec byte_weight(k: Int) -> Int {
    for j in 0..16 with w: Int = 1 { if j < k { w * 256 } else { w } }
  }

  // Section 2.5.1: the tag is the low 128 bits of the accumulator plus s,
  // little-endian.
  spec tag_bytes(x: Int) -> Word[8]^16 {
    for i in 0..16 with t: Word[8]^16 = [0; 16] { t with [i] = (x / byte_weight(i)) as Word[8] }
  }

  // ---- The AEAD construction, section 2.8 ----

  // Section 2.6: the one-time Poly1305 key is the first 32 bytes of block 0.
  spec one_time_key(key: Word[8]^32, nonce: Word[8]^12) -> Word[8]^32 {
    let block0: Word[8]^64 = serialize(block(key, 0, nonce));
    for i in 0..32 with k: Word[8]^32 = [0; 32] { k with [i] = block0[i] }
  }

  // Section 2.8: Poly1305 under the one-time key of the associated data, the
  // ciphertext, and both lengths as 64-bit little-endian integers. Each
  // whole block is its sixteen bytes, little-endian, with the byte 0x01 above
  // them (section 2.5.1), read straight from `ad` and `sealed`: four blocks,
  // fifteen blocks, and the lengths 64 and 240. The tag bytes of `sealed`
  // are not read.
  spec tag(key: Word[8]^32, nonce: Word[8]^12, ad: Word[8]^64, sealed: Word[8]^256) -> Word[8]^16 {
    let otk: Word[8]^32 = one_time_key(key, nonce);
    let r: Int = poly_r(otk);
    let a: Int = for j in 0..4 with x: Int = 0 {
      absorb(x, r, for i in 0..16 with n: Int = 1 { n * 256 + (ad[16 * j + 15 - i] as Int) })
    };
    let c: Int = for j in 0..15 with x: Int = a {
      absorb(x, r, for i in 0..16 with n: Int = 1 { n * 256 + (sealed[16 * j + 15 - i] as Int) })
    };
    let lengths: Word[8]^16 = [64, 0, 0, 0, 0, 0, 0, 0, 240, 0, 0, 0, 0, 0, 0, 0];
    let l: Int = absorb(c, r, for i in 0..16 with n: Int = 1 { n * 256 + (lengths[15 - i] as Int) });
    tag_bytes(l + poly_s(otk))
  }

  // Interface.

  // Section 2.8: the plaintext is encrypted from counter 1 (section 2.4),
  // and the tag follows the ciphertext.
  spec seal(key: Word[8]^32, nonce: Word[8]^12, ad: Word[8]^64, plaintext: Word[8]^240) -> Word[8]^256 {
    let s: Word[32]^64 = keystream(key, nonce);
    let body: Word[8]^256 = for i in 0..240 with c: Word[8]^256 = [0; 256] {
      c with [i] = plaintext[i] ^ le_bytes(s[i / 4])[i % 4]
    };
    let t: Word[8]^16 = tag(key, nonce, ad, body);
    for i in 0..16 with c: Word[8]^256 = body { c with [240 + i] = t[i] }
  }

  // The tag is recomputed and compared byte by byte with no early exit.
  spec authentic(key: Word[8]^32, nonce: Word[8]^12, ad: Word[8]^64, sealed: Word[8]^256) -> Bool {
    let t: Word[8]^16 = tag(key, nonce, ad, sealed);
    (for i in 0..16 with d: Word[8] = 0 { d | (t[i] ^ sealed[240 + i]) }) == 0
  }

  // Section 2.4: decryption is the same exclusive-or with the keystream.
  spec open(key: Word[8]^32, nonce: Word[8]^12, ad: Word[8]^64, sealed: Word[8]^256) -> Word[8]^240 {
    let s: Word[32]^64 = keystream(key, nonce);
    for i in 0..240 with p: Word[8]^240 = [0; 240] { p with [i] = sealed[i] ^ le_bytes(s[i / 4])[i % 4] }
  }

  // Known answers.

  // Section 2.3.2: the block function on the key 00 01 ... 1f, counter 1, and
  // the nonce 00 00 00 09 00 00 00 4a 00 00 00 00.
  spec rfc8439_2_3_2() -> Bool {
    let key: Word[8]^32 = for i in 0..32 with k: Word[8]^32 = [0; 32] { k with [i] = i as Word[8] };
    let got: Word[8]^64 = serialize(block(key, 1, [0x00, 0x00, 0x00, 0x09, 0x00, 0x00, 0x00, 0x4a, 0x00, 0x00, 0x00, 0x00]));
    let expected: Word[8]^64 = [
      0x10, 0xf1, 0xe7, 0xe4, 0xd1, 0x3b, 0x59, 0x15, 0x50, 0x0f, 0xdd, 0x1f, 0xa3, 0x20, 0x71, 0xc4,
      0xc7, 0xd1, 0xf4, 0xc7, 0x33, 0xc0, 0x68, 0x03, 0x04, 0x22, 0xaa, 0x9a, 0xc3, 0xd4, 0x6c, 0x4e,
      0xd2, 0x82, 0x64, 0x46, 0x07, 0x9f, 0xaa, 0x09, 0x14, 0xc2, 0xd7, 0x05, 0xd9, 0x8b, 0x02, 0xa2,
      0xb5, 0x12, 0x9c, 0xd1, 0xde, 0x16, 0x4e, 0xb9, 0xcb, 0xd0, 0x83, 0xe8, 0xa2, 0x50, 0x3c, 0x4e,
    ];
    (for i in 0..64 with d: Word[8] = 0 { d | (got[i] ^ expected[i]) }) == 0
  }

  // Section 2.6.2: the one-time key for the key 80 81 ... 9f and the nonce
  // 00 00 00 00 00 01 02 03 04 05 06 07.
  spec rfc8439_2_6_2() -> Bool {
    let key: Word[8]^32 = for i in 0..32 with k: Word[8]^32 = [0; 32] { k with [i] = 0x80 + (i as Word[8]) };
    let got: Word[8]^32 = one_time_key(key, [0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07]);
    let expected: Word[8]^32 = [
      0x8a, 0xd5, 0xa0, 0x8b, 0x90, 0x5f, 0x81, 0xcc, 0x81, 0x50, 0x40, 0x27, 0x4a, 0xb2, 0x94, 0x71,
      0xa8, 0x33, 0xb6, 0x37, 0xe3, 0xfd, 0x0d, 0xa5, 0x08, 0xdb, 0xb8, 0xe2, 0xfd, 0xd1, 0xa6, 0x46,
    ];
    (for i in 0..32 with d: Word[8] = 0 { d | (got[i] ^ expected[i]) }) == 0
  }

  // A whole chunk: the key and nonce of section 2.8.2, the associated data
  // 00 01 ... 3f, and the plaintext 00 01 ... ef. The expected sealed chunk
  // was computed by pycryptodome 3.23.0. `seal` must give it, `authentic`
  // must accept it and reject it with one bit flipped, and `open` must
  // recover the plaintext.
  spec chunk() -> Bool {
    let key: Word[8]^32 = for i in 0..32 with k: Word[8]^32 = [0; 32] { k with [i] = 0x80 + (i as Word[8]) };
    let nonce: Word[8]^12 = [0x07, 0x00, 0x00, 0x00, 0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47];
    let ad: Word[8]^64 = for i in 0..64 with a: Word[8]^64 = [0; 64] { a with [i] = i as Word[8] };
    let plaintext: Word[8]^240 = for i in 0..240 with p: Word[8]^240 = [0; 240] { p with [i] = i as Word[8] };
    let expected: Word[8]^256 = [
      0x9f, 0x7a, 0xeb, 0x5e, 0x05, 0xf8, 0x46, 0xbd, 0x1d, 0xeb, 0x85, 0xf0, 0x3a, 0x8c, 0x04, 0xa1,
      0xd1, 0xd1, 0x9a, 0x2c, 0x1d, 0x14, 0x78, 0xc9, 0xc5, 0x93, 0xca, 0x9c, 0x49, 0x9f, 0x1d, 0xba,
      0x6e, 0xbf, 0xe9, 0x1b, 0x88, 0xab, 0x78, 0x0c, 0x90, 0xf3, 0x98, 0x24, 0xd6, 0xf6, 0x7c, 0xc7,
      0x45, 0x35, 0x80, 0x5d, 0x8a, 0x5c, 0x5b, 0x78, 0x58, 0x9d, 0xbf, 0xf4, 0x2d, 0x85, 0x25, 0x66,
      0xbc, 0xf0, 0x86, 0x1c, 0x06, 0x5c, 0xa8, 0xeb, 0xa4, 0x23, 0x94, 0x88, 0x02, 0x2b, 0x27, 0x37,
      0xde, 0x8a, 0x13, 0x97, 0xc8, 0xf6, 0x57, 0xb6, 0x7f, 0xb9, 0xf6, 0xf0, 0x67, 0x19, 0xe7, 0x90,
      0x3c, 0xe7, 0xd9, 0xf6, 0x84, 0x0e, 0x6b, 0x95, 0xf8, 0x73, 0xdc, 0x2e, 0x88, 0xc6, 0x88, 0x4d,
      0x65, 0x49, 0x7e, 0x70, 0xba, 0x40, 0x1a, 0xa0, 0xde, 0x0f, 0x19, 0x80, 0xa1, 0x92, 0x81, 0x1b,
      0xf5, 0x75, 0xfd, 0xd5, 0xfd, 0x1b, 0x4b, 0x44, 0xd7, 0xe5, 0xac, 0xd4, 0xdd, 0xce, 0xfe, 0xac,
      0x50, 0x18, 0x86, 0xd5, 0x8f, 0x4d, 0x76, 0xcd, 0x6d, 0x8e, 0x4f, 0x35, 0xa5, 0x3b, 0x64, 0x2b,
      0x27, 0xec, 0xd0, 0x53, 0x7d, 0x1f, 0x9f, 0x6c, 0xd7, 0xf1, 0xce, 0x50, 0x57, 0x76, 0xd7, 0xd7,
      0xe6, 0x10, 0xec, 0xa8, 0x89, 0xa6, 0x7f, 0xbd, 0xd2, 0x13, 0xdc, 0x38, 0x6b, 0xb4, 0x38, 0x09,
      0x43, 0xb3, 0x08, 0xd0, 0x3d, 0xd6, 0xe4, 0xab, 0x46, 0x5e, 0xf1, 0xa8, 0x14, 0x89, 0x58, 0xdc,
      0x55, 0xc0, 0x68, 0x8b, 0x7f, 0x4b, 0x05, 0x94, 0x27, 0x21, 0x2a, 0x0d, 0x6c, 0x89, 0x3c, 0xcd,
      0xf4, 0xdf, 0xfa, 0xac, 0xe2, 0x38, 0x93, 0x14, 0xc3, 0x56, 0xa8, 0xbd, 0x0a, 0xed, 0x17, 0xb5,
      0x37, 0x59, 0x09, 0xfa, 0xd9, 0x59, 0x40, 0xcb, 0x43, 0x5b, 0x25, 0x94, 0xc6, 0x8b, 0xa8, 0xdc,
    ];
    let sealed: Word[8]^256 = seal(key, nonce, ad, plaintext);
    let opened: Word[8]^240 = open(key, nonce, ad, expected);
    let seals: Bool = (for i in 0..256 with d: Word[8] = 0 { d | (sealed[i] ^ expected[i]) }) == 0;
    let opens: Bool = (for i in 0..240 with d: Word[8] = 0 { d | (opened[i] ^ plaintext[i]) }) == 0;
    let tampered: Word[8]^256 = expected with [100] = expected[100] ^ 0x01;
    seals && opens && authentic(key, nonce, ad, expected) && !authentic(key, nonce, ad, tampered)
  }
}
