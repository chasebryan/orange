{
  "schema_version": "d006-v0.3-adapter-1",
  "candidate": "C-02",
  "language": "lean4",
  "build": {
    "serial": [
      [
        "{toolchain}/bin/lean",
        "--json",
        "--threads=1",
        "--tstack=65536",
        "--root=.",
        "-o",
        ".lake/build/lib/lean/D006/Sieve.olean",
        "D006/Sieve.lean"
      ]
    ],
    "declared_parallel": [
      [
        "{toolchain}/bin/lean",
        "--json",
        "--threads={jobs}",
        "--tstack=65536",
        "--root=.",
        "-o",
        ".lake/build/lib/lean/D006/Sieve.olean",
        "D006/Sieve.lean"
      ]
    ]
  },
  "preamble": {
    "DS-02": "import D006.Core\nimport D006.Sieve"
  },
  "symbols": {
    "S-T01": "D006.Sieve.Label",
    "S-T02": "D006.Sieve.Ty",
    "S-T03": "D006.Sieve.Val",
    "S-T04": "D006.Sieve.Expr",
    "S-T05": "D006.Sieve.Cmd",
