  "theorems": {
    "D2-TH01": "D006.Sieve.progress",
    "D2-TH02": "D006.Sieve.preservation",
    "D2-TH03": "D006.Sieve.lockstep_noninterference",
    "D2-TH04": "D006.Sieve.run_noninterference",
    "D2-TH05": "D006.Sieve.positive_program_witness",
    "D2-TH06": "D006.Sieve.negative_program_leaks"
  },
  "patches": {
    "D2-M01": "patches/D2-M01.patch",
    "D2-M02": "patches/D2-M02.patch",
    "D2-M05": {
      "artifact": ".lake/build/lib/lean/D006/Sieve.olean",
      "check": [
        "{toolchain}/bin/lean",
        "--tstack=65536",
        "--threads=1",
        "--run",
        "Loader/OleanCheck.lean",
        "{artifact}"
      ]
    },
    "D2-M06": "patches/D2-M06.patch"
  },
  "classifier": [
    {
      "category": "parse_failure",
      "phases": [
        "artifact"
      ],
      "pattern": "^error: .*: (malformed|incompatible) compiled module: "
    },
    {
      "category": "proof_failure",
      "phases": [
        "artifact"
      ],
      "pattern": "^error: .*: kernel check failed: "
    }
  ],
  "trust": {
    "inventory": [
      {
        "name": "the built D006.Sieve (.olean)",
        "kind": "library",
        "reason": "imported by the DS-02 check file without re-checking at lean's default trust level; the same kernel checks every declaration in it when the build compiles D006/Sieve.lean"
      },
      {
        "name": "propext and Quot.sound (DS-02)",
        "kind": "axiom",
        "reason": "already allowed by the base and the only axioms in the DS-02 audits. The D2-TH proofs use them through simp and omega; the observations inherit them from proof fields of core definitions (BitVec operations, List lookups) and from the structural-recursion encodings, never from computation. Classical.choice does not appear"
      },
      {
        "name": "kernel evaluation of the Sieve interpreter",
        "kind": "evaluator",
        "reason": "the DS-02 observations use the base method `decide +kernel`: the kernel alone reduces `well_typed`, `step` and `run` (all structurally recursive) and the derived `DecidableEq` instances, with its GMP arithmetic for the word operations. D2-TH05 and D2-TH06 use `decide` the same way on closed facts (P+ is well typed; wf, and the traces of P- from the two fixed states)"
      },
      {
        "name": "Loader/OleanCheck.lean under lean --run",
        "kind": "loader",
        "reason": "the independent check of the truncated artifact for D2-M05. Interpreted by lean's IR interpreter; it validates the .olean structure (header, object tiling, every reachable pointer) as bytes, and only for a sound file loads it like leanchecker and replays every declaration through the kernel (Lean.Environment.replay). It proves nothing and is outside the trusted base of every theorem"
      }
    ]
  }
}
