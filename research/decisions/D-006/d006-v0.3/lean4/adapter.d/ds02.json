    "S-C17": "D006.Sieve.Cmd.seq",
    "S-C18": "D006.Sieve.Cmd.cond",
    "S-C19": "D006.Sieve.Cmd.loop",
    "S-C20": "D006.Sieve.Cmd.declassify",
    "S-C21": "D006.Sieve.Obs.read",
    "S-C22": "D006.Sieve.Obs.write",
    "S-C23": "D006.Sieve.Obs.branch",
