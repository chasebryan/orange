  // Fixed public test context only. Real Horizon uses the adapter and fresh nonces.
  spec seal_fixture(root: Word[8]^32, p: Word[8]^32) -> Word[8]^219 {
    let v0: Word[32]^8 = sha_compress([1779033703,3144134277,1013904242,2773480762,1359893119,2600822924,528734635,1541459225],[be32(0x44,0x4c,0x54,0x48),be32(0x56,0x31,0x41,0x7b),be32(0x22,0x61,0x75,0x74),be32(0x68,0x6f,0x72,0x69),be32(0x7a,0x61,0x74,0x69),be32(0x6f,0x6e,0x22,0x3a),be32(0x7b,0x22,0x61,0x75),be32(0x74,0x68,0x6f,0x72),be32(0x69,0x7a,0x61,0x74),be32(0x69,0x6f,0x6e,0x5f),be32(0x74,0x61,0x67,0x22),be32(0x3a,0x22,0x30,0x31),be32(0x32,0x33,0x34,0x35),be32(0x36,0x37,0x38,0x39),be32(0x61,0x62,0x63,0x64),be32(0x65,0x66,0x30,0x31)]);
