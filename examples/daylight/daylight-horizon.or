// Daylight Horizon v17 in Orange 2026.
//
// A Horizon vault seals a plaintext for a header under a root key. The header
// is canonical JSON. The key is derived from the root key, the header, and the
// header's authorization tag. The frame is the header's framing, the
// ciphertext, and the tag. Pinned to chasebryan/-wuci-ji at fec91dc
// (daylight/v17-singularity/src/horizon_crypto.py):
//
//   salt   = SHA-256(magic || header_bytes)
//   info   = "DAYLIGHT-HORIZON-ALPHA-AEAD-KEY:" || magic || ":" || authorization_tag
//   key    = HKDF-SHA256(root, salt, info, 32)
//   aad    = magic || LE32(length(header_bytes)) || header_bytes
//   sealed = aad || ChaCha20-Poly1305(key, nonce, aad, plaintext)
//
// The standards it computes are SHA-256 (FIPS 180-4), HMAC (RFC 2104), HKDF
// (RFC 5869), and ChaCha20, Poly1305, and their AEAD (RFC 8439). Orange has no
// strings, so every text is written as its bytes, with the text in a comment.
//
// The header here is the public interoperability header of README.md: an
// authorization tag and a nonce in a fixed JSON shape, and a 32-byte
// plaintext. A vault header carries more fields; the adapter in daylight.py
// serves the vault itself.
//
// Research reference. Nothing here claims constant time, secret erasure, or
// verification.
edition 2026;
module daylight {
  // ---- Bytes and words ----

  spec load_be32(b0: Word[8], b1: Word[8], b2: Word[8], b3: Word[8]) -> Word[32] {
    ((b0 as Word[32]) << 24) | ((b1 as Word[32]) << 16) | ((b2 as Word[32]) << 8)
      | (b3 as Word[32])
  }

  spec load_le32(b0: Word[8], b1: Word[8], b2: Word[8], b3: Word[8]) -> Word[32] {
    (b0 as Word[32]) | ((b1 as Word[32]) << 8) | ((b2 as Word[32]) << 16)
      | ((b3 as Word[32]) << 24)
  }

  spec be_bytes(x: Word[32]) -> Word[8]^4 {
    [(x >> 24) as Word[8], (x >> 16) as Word[8], (x >> 8) as Word[8], x as Word[8]]
  }

  spec le_bytes(x: Word[32]) -> Word[8]^4 {
    [x as Word[8], (x >> 8) as Word[8], (x >> 16) as Word[8], (x >> 24) as Word[8]]
  }

  // 256^k for 0 <= k <= 16: the weight of byte k of a little-endian integer.
  spec byte_weight(k: Int) -> Int {
    for j in 0..16 with w: Int = 1 { if j < k { w * 256 } else { w } }
  }

  // The lowercase hexadecimal digit of a value below 16, and its value again.
  spec hex_digit(n: Word[8]) -> Word[8] { if n < 10 { 0x30 + n } else { 0x57 + n } }
  spec hex_value(c: Word[8]) -> Word[8] { if c < 0x3a { c - 0x30 } else { c - 0x57 } }

  // Thirty-two bytes as sixty-four hexadecimal digits, as JSON quotes a digest.
  spec hex_32(b: Word[8]^32) -> Word[8]^64 {
    for i in 0..32 with h: Word[8]^64 = [0; 64] {
      (h with [2 * i] = hex_digit(b[i] >> 4)) with [2 * i + 1] = hex_digit(b[i] & 0x0f)
    }
  }

  // Twelve bytes as twenty-four hexadecimal digits, as JSON quotes a nonce.
  spec hex_12(b: Word[8]^12) -> Word[8]^24 {
    for i in 0..12 with h: Word[8]^24 = [0; 24] {
      (h with [2 * i] = hex_digit(b[i] >> 4)) with [2 * i + 1] = hex_digit(b[i] & 0x0f)
    }
  }

  // A message buffer of three SHA-256 blocks, holding a 32-byte value.
  spec buffer(d: Word[8]^32) -> Word[8]^192 {
    for i in 0..32 with b: Word[8]^192 = [0; 192] { b with [i] = d[i] }
  }

  // `m` with `byte` at position `length`. An index must be static, so the
  // position is found by a scan; only the matching step makes an update.
  spec append(m: Word[8]^192, length: Int, byte: Word[8]) -> Word[8]^192 {
    for i in 0..192 with b: Word[8]^192 = m { if i == length { b with [i] = byte } else { b } }
  }

  // ---- SHA-256, FIPS 180-4 ----

  spec big_sigma0(x: Word[32]) -> Word[32] { (x >>> 2) ^ (x >>> 13) ^ (x >>> 22) }
  spec big_sigma1(x: Word[32]) -> Word[32] { (x >>> 6) ^ (x >>> 11) ^ (x >>> 25) }
  spec small_sigma0(x: Word[32]) -> Word[32] { (x >>> 7) ^ (x >>> 18) ^ (x >> 3) }
  spec small_sigma1(x: Word[32]) -> Word[32] { (x >>> 17) ^ (x >>> 19) ^ (x >> 10) }
  spec ch(x: Word[32], y: Word[32], z: Word[32]) -> Word[32] { (x & y) ^ (~x & z) }
  spec maj(x: Word[32], y: Word[32], z: Word[32]) -> Word[32] { (x & y) ^ (x & z) ^ (y & z) }

  // Section 5.3.3: the first 32 bits of the fractional parts of the square
  // roots of the first eight primes.
  spec initial_hash() -> Word[32]^8 {
    [
      0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
      0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
    ]
  }

  // Section 6.2.2, step 1: the message schedule of one block, whose sixteen
  // big-endian words are W_0 through W_15.
  spec schedule(block: Word[8]^64) -> Word[32]^64 {
    let head: Word[32]^64 = for t in 0..16 with w: Word[32]^64 = [0; 64] {
      w with [t] = load_be32(block[4 * t], block[4 * t + 1], block[4 * t + 2], block[4 * t + 3])
    };
    for t in 16..64 with w: Word[32]^64 = head {
      w with [t] = small_sigma1(w[t - 2]) + w[t - 7] + small_sigma0(w[t - 15]) + w[t - 16]
    }
  }

  // Section 6.2.2, step 3: one round on the working variables a through h.
  spec round(v: Word[32]^8, k: Word[32], w: Word[32]) -> Word[32]^8 {
    let t1: Word[32] = v[7] + big_sigma1(v[4]) + ch(v[4], v[5], v[6]) + k + w;
    let t2: Word[32] = big_sigma0(v[0]) + maj(v[0], v[1], v[2]);
    [t1 + t2, v[0], v[1], v[2], v[3] + t1, v[4], v[5], v[6]]
  }

  // Section 6.2.2, steps 2 through 4: one 64-byte block absorbed into the hash
  // value, with the constants of section 4.2.2, the first 32 bits of the
  // fractional parts of the cube roots of the first 64 primes.
  spec compress(h: Word[32]^8, block: Word[8]^64) -> Word[32]^8 {
    let k: Word[32]^64 = [
      0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
      0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
      0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
      0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
      0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
      0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
      0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
      0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ];
    let w: Word[32]^64 = schedule(block);
    let v: Word[32]^8 = for t in 0..64 with s: Word[32]^8 = h { round(s, k[t], w[t]) };
    for i in 0..8 with out: Word[32]^8 = v { out with [i] = out[i] + h[i] }
  }

  // Section 6.2.2: the hash value as 32 big-endian bytes.
  spec digest(h: Word[32]^8) -> Word[8]^32 {
    for i in 0..8 with d: Word[8]^32 = [0; 32] {
      for j in 0..4 with e: Word[8]^32 = d { e with [4 * i + j] = be_bytes(h[i])[j] }
    }
  }

  // Sections 5.1.1 and 6.2: `length` more bytes, held left-aligned in `m`,
  // hashed as the continuation of a hash whose value `h` has absorbed
  // `consumed` bytes, a multiple of 64. The padding is a 1 bit, zeros, and the
  // total length in bits as a 64-bit big-endian integer, ending a block. Three
  // blocks hold every `length` up to 183; each is built and absorbed only when
  // the padded message reaches it.
  spec sha256_tail(h: Word[32]^8, consumed: Int, m: Word[8]^192, length: Int) -> Word[8]^32 {
    let bits: Int = 8 * (consumed + length);
    let blocks: Int = (length + 72) / 64;
    let end: Int = 64 * blocks;
    let value: Word[32]^8 = for i in 0..3 with s: Word[32]^8 = h {
      if i < blocks {
        compress(s, for j in 0..64 with b: Word[8]^64 = [0; 64] {
          b with [j] = if length > (64 * i + j) { m[64 * i + j] }
            else if length == (64 * i + j) { 0x80 }
            else if end > (64 * i + j + 8) { 0 }
            else { (bits / byte_weight(end - 1 - (64 * i + j))) as Word[8] }
        })
      } else { s }
    };
    digest(value)
  }

  // Section 6.2: the hash of `length` bytes held in `m`, `length` at most 183.
  spec sha256(m: Word[8]^192, length: Int) -> Word[8]^32 {
    sha256_tail(initial_hash(), 0, m, length)
  }

  // ---- HMAC, RFC 2104, and HKDF, RFC 5869 ----

  // A key of at most 64 bytes, zero-padded to the block size, exclusive-ored
  // with a pad byte: 0x36 for the inner hash and 0x5c for the outer.
  spec keyed_block(key: Word[8]^64, pad: Word[8]) -> Word[8]^64 {
    for i in 0..64 with b: Word[8]^64 = [0; 64] { b with [i] = key[i] ^ pad }
  }

  // A 32-byte key zero-padded to the block size.
  spec block_key(key: Word[8]^32) -> Word[8]^64 {
    for i in 0..32 with b: Word[8]^64 = [0; 64] { b with [i] = key[i] }
  }

  // RFC 2104 section 2: H((K xor opad) || H((K xor ipad) || text)) for a
  // 32-byte key and `length` bytes of text held in `m`, `length` at most 119.
  // Each padded key is exactly one block, so both hashes absorb their key
  // block first and continue with the text or the inner digest.
  spec hmac(key: Word[8]^32, m: Word[8]^192, length: Int) -> Word[8]^32 {
    let inner: Word[32]^8 = compress(initial_hash(), keyed_block(block_key(key), 0x36));
    let outer: Word[32]^8 = compress(initial_hash(), keyed_block(block_key(key), 0x5c));
    sha256_tail(outer, 64, buffer(sha256_tail(inner, 64, m, length)), 32)
  }

  // RFC 5869 with SHA-256 for 32 bytes of output: extract PRK = HMAC(salt, IKM),
  // then expand T(1) = HMAC(PRK, info || 0x01), for a 32-byte IKM and salt and
  // `length` bytes of info held in `info`, `length` at most 118.
  spec hkdf_32(ikm: Word[8]^32, salt: Word[8]^32, info: Word[8]^192, length: Int) -> Word[8]^32 {
    let prk: Word[8]^32 = hmac(salt, buffer(ikm), 32);
    hmac(prk, append(info, length, 0x01), length + 1)
  }

  // ---- ChaCha20, RFC 8439 section 2 ----

  // Section 2.1.
  spec quarter_round(a: Word[32], b: Word[32], c: Word[32], d: Word[32]) -> Word[32]^4 {
    let a1: Word[32] = a + b;
    let d1: Word[32] = (d ^ a1) <<< 16;
    let c1: Word[32] = c + d1;
    let b1: Word[32] = (b ^ c1) <<< 12;
    let a2: Word[32] = a1 + b1;
    let d2: Word[32] = (d1 ^ a2) <<< 8;
    let c2: Word[32] = c1 + d2;
    let b2: Word[32] = (b1 ^ c2) <<< 7;
    [a2, b2, c2, d2]
  }

  // Section 2.3: a column round, then a diagonal round.
  spec double_round(x: Word[32]^16) -> Word[32]^16 {
    let q0: Word[32]^4 = quarter_round(x[0], x[4], x[8], x[12]);
    let q1: Word[32]^4 = quarter_round(x[1], x[5], x[9], x[13]);
    let q2: Word[32]^4 = quarter_round(x[2], x[6], x[10], x[14]);
    let q3: Word[32]^4 = quarter_round(x[3], x[7], x[11], x[15]);
    let d0: Word[32]^4 = quarter_round(q0[0], q1[1], q2[2], q3[3]);
    let d1: Word[32]^4 = quarter_round(q1[0], q2[1], q3[2], q0[3]);
    let d2: Word[32]^4 = quarter_round(q2[0], q3[1], q0[2], q1[3]);
    let d3: Word[32]^4 = quarter_round(q3[0], q0[1], q1[2], q2[3]);
    [
      d0[0], d1[0], d2[0], d3[0],
      d3[1], d0[1], d1[1], d2[1],
      d2[2], d3[2], d0[2], d1[2],
      d1[3], d2[3], d3[3], d0[3],
    ]
  }

  // Section 2.3: the block function. Words 4 through 11 are the key and words
  // 13 through 15 the nonce, each read little-endian.
  spec block(key: Word[8]^32, counter: Word[32], nonce: Word[8]^12) -> Word[32]^16 {
    let constants: Word[32]^16 = [
      0x61707865, 0x3320646e, 0x79622d32, 0x6b206574,
      0, 0, 0, 0,
      0, 0, 0, 0,
      counter, 0, 0, 0,
    ];
    let keyed: Word[32]^16 = for i in 0..8 with s: Word[32]^16 = constants {
      s with [4 + i] = load_le32(key[4 * i], key[4 * i + 1], key[4 * i + 2], key[4 * i + 3])
    };
    let initial: Word[32]^16 = for i in 0..3 with s: Word[32]^16 = keyed {
      s with [13 + i] = load_le32(nonce[4 * i], nonce[4 * i + 1], nonce[4 * i + 2], nonce[4 * i + 3])
    };
    let mixed: Word[32]^16 = for i in 0..10 with s: Word[32]^16 = initial { double_round(s) };
    for i in 0..16 with s: Word[32]^16 = mixed { s with [i] = s[i] + initial[i] }
  }

  // Section 2.3: the state serialized as 64 little-endian bytes.
  spec serialize(s: Word[32]^16) -> Word[8]^64 {
    for i in 0..16 with bytes: Word[8]^64 = [0; 64] {
      for j in 0..4 with b: Word[8]^64 = bytes { b with [4 * i + j] = le_bytes(s[i])[j] }
    }
  }

  // Section 2.4: the keystream block at `counter`.
  spec keystream(key: Word[8]^32, counter: Word[32], nonce: Word[8]^12) -> Word[8]^64 {
    serialize(block(key, counter, nonce))
  }

  // Section 2.4: one block of the cipher, the message exclusive-ored with the
  // keystream. Decryption is the same operation.
  spec xor_64(m: Word[8]^64, stream: Word[8]^64) -> Word[8]^64 {
    for i in 0..64 with c: Word[8]^64 = m { c with [i] = m[i] ^ stream[i] }
  }

  // Section 2.4: a 32-byte message encrypted from counter 1 is one block.
  spec encrypt_32(key: Word[8]^32, nonce: Word[8]^12, plaintext: Word[8]^32) -> Word[8]^32 {
    let stream: Word[8]^64 = keystream(key, 1, nonce);
    for i in 0..32 with c: Word[8]^32 = plaintext { c with [i] = plaintext[i] ^ stream[i] }
  }

  // Section 2.6: the one-time Poly1305 key is the first 32 bytes of block 0.
  spec one_time_key(key: Word[8]^32, nonce: Word[8]^12) -> Word[8]^32 {
    let stream: Word[8]^64 = keystream(key, 0, nonce);
    for i in 0..32 with k: Word[8]^32 = [0; 32] { k with [i] = stream[i] }
  }

  // ---- Poly1305, RFC 8439 section 2.5 ----

  // p = 2^130 - 5.
  spec prime() -> Int { 1361129467683753853853498429727072845819 }

  // Section 2.5.1: add one block to the accumulator and multiply by r.
  spec absorb(a: Int, r: Int, block: Int) -> Int { ((a + block) * r) % prime() }

  // Section 2.5: r is the first sixteen key bytes, little-endian, with
  // r &= 0x0ffffffc0ffffffc0ffffffc0fffffff.
  spec poly_r(key: Word[8]^32) -> Int {
    let mask: Word[8]^16 = [
      0xff, 0xff, 0xff, 0x0f, 0xfc, 0xff, 0xff, 0x0f,
      0xfc, 0xff, 0xff, 0x0f, 0xfc, 0xff, 0xff, 0x0f,
    ];
    for i in 0..16 with n: Int = 0 { n * 256 + ((key[15 - i] & mask[15 - i]) as Int) }
  }

  // Section 2.5: s is the other sixteen key bytes, little-endian.
  spec poly_s(key: Word[8]^32) -> Int {
    for i in 0..16 with n: Int = 0 { n * 256 + (key[31 - i] as Int) }
  }

  // Section 2.5.1: a block is its bytes, little-endian, with the byte 0x01
  // above them. `tail` is that byte, 1, for a whole block, and 0 for a final
  // block that was padded and carries its own 0x01.
  spec block_value(block: Word[8]^16, tail: Int) -> Int {
    for i in 0..16 with n: Int = tail { n * 256 + (block[15 - i] as Int) }
  }

  // Section 2.5.1: the tag is the low 128 bits of the accumulator plus s,
  // little-endian.
  spec tag(x: Int) -> Word[8]^16 {
    for i in 0..16 with t: Word[8]^16 = [0; 16] { t with [i] = (x / byte_weight(i)) as Word[8] }
  }

  // Whether two tags agree. Every byte is compared: `&&` evaluates both sides.
  spec same_tag(a: Word[8]^16, b: Word[8]^16) -> Bool {
    for i in 0..16 with same: Bool = true { same && (a[i] == b[i]) }
  }

  // ---- Daylight Horizon framing ----

  // "DLTHV1A"
  spec magic() -> Word[8]^7 { [0x44, 0x4c, 0x54, 0x48, 0x56, 0x31, 0x41] }

  // The header is canonical JSON of 160 bytes, its keys in order:
  //
  //   {"authorization":{"authorization_tag":"<64 hex digits>"},"nonce":"<24 hex digits>","plaintext_len":32}
  //
  // The tag's digits are bytes 39 through 102 and the nonce's bytes 115
  // through 138.
  spec header(nonce: Word[8]^12, authorization_tag: Word[8]^32) -> Word[8]^160 {
    // `{"authorization":{"authorization_tag":"`
    let head: Word[8]^39 = [
      0x7b, 0x22, 0x61, 0x75, 0x74, 0x68, 0x6f, 0x72, 0x69, 0x7a, 0x61, 0x74, 0x69, 0x6f, 0x6e, 0x22,
      0x3a, 0x7b, 0x22, 0x61, 0x75, 0x74, 0x68, 0x6f, 0x72, 0x69, 0x7a, 0x61, 0x74, 0x69, 0x6f, 0x6e,
      0x5f, 0x74, 0x61, 0x67, 0x22, 0x3a, 0x22,
    ];
    let tag_hex: Word[8]^64 = hex_32(authorization_tag);
    // `"},"nonce":"`
    let middle: Word[8]^12 = [0x22, 0x7d, 0x2c, 0x22, 0x6e, 0x6f, 0x6e, 0x63, 0x65, 0x22, 0x3a, 0x22];
    let nonce_hex: Word[8]^24 = hex_12(nonce);
    // `","plaintext_len":32}`
    let tail: Word[8]^21 = [
      0x22, 0x2c, 0x22, 0x70, 0x6c, 0x61, 0x69, 0x6e, 0x74, 0x65, 0x78, 0x74, 0x5f, 0x6c, 0x65, 0x6e,
      0x22, 0x3a, 0x33, 0x32, 0x7d,
    ];
    let h0: Word[8]^160 = for i in 0..39 with h: Word[8]^160 = [0; 160] { h with [i] = head[i] };
    let h1: Word[8]^160 = for i in 0..64 with h: Word[8]^160 = h0 { h with [39 + i] = tag_hex[i] };
    let h2: Word[8]^160 = for i in 0..12 with h: Word[8]^160 = h1 { h with [103 + i] = middle[i] };
    let h3: Word[8]^160 = for i in 0..24 with h: Word[8]^160 = h2 { h with [115 + i] = nonce_hex[i] };
    for i in 0..21 with h: Word[8]^160 = h3 { h with [139 + i] = tail[i] }
  }

  // The header's nonce, decoded from its digits.
  spec header_nonce(h: Word[8]^160) -> Word[8]^12 {
    for i in 0..12 with n: Word[8]^12 = [0; 12] {
      n with [i] = (hex_value(h[115 + 2 * i]) << 4) | hex_value(h[116 + 2 * i])
    }
  }

  // salt = SHA-256(magic || header_bytes): 167 bytes hashed.
  spec salt(h: Word[8]^160) -> Word[8]^32 {
    let m: Word[8]^7 = magic();
    let s0: Word[8]^192 = for i in 0..7 with s: Word[8]^192 = [0; 192] { s with [i] = m[i] };
    sha256(for i in 0..160 with s: Word[8]^192 = s0 { s with [7 + i] = h[i] }, 167)
  }

  // info = "DAYLIGHT-HORIZON-ALPHA-AEAD-KEY:" || magic || ":" || authorization_tag,
  // 104 bytes, the tag as the header quotes it.
  spec info(h: Word[8]^160) -> Word[8]^192 {
    // "DAYLIGHT-HORIZON-ALPHA-AEAD-KEY:"
    let label: Word[8]^32 = [
      0x44, 0x41, 0x59, 0x4c, 0x49, 0x47, 0x48, 0x54, 0x2d, 0x48, 0x4f, 0x52, 0x49, 0x5a, 0x4f, 0x4e,
      0x2d, 0x41, 0x4c, 0x50, 0x48, 0x41, 0x2d, 0x41, 0x45, 0x41, 0x44, 0x2d, 0x4b, 0x45, 0x59, 0x3a,
    ];
    let m: Word[8]^7 = magic();
    let i0: Word[8]^192 = for i in 0..32 with s: Word[8]^192 = [0; 192] { s with [i] = label[i] };
    let i1: Word[8]^192 = for i in 0..7 with s: Word[8]^192 = i0 { s with [32 + i] = m[i] };
    for i in 0..64 with s: Word[8]^192 = i1 with [39] = 0x3a { s with [40 + i] = h[39 + i] }
  }

  // key = HKDF-SHA256(root, salt, info, 32).
  spec derive_key(root: Word[8]^32, h: Word[8]^160) -> Word[8]^32 {
    hkdf_32(root, salt(h), info(h), 104)
  }

  // A frame is aad || ciphertext || tag, 219 bytes: the additional data is
  // magic || LE32(160) || header_bytes, bytes 0 through 170, of which the
  // header is 11 through 170; the ciphertext is 171 through 202; and the tag
  // is 203 through 218. `framed` lays out a frame with its tag still zero.
  spec framed(h: Word[8]^160, ciphertext: Word[8]^32) -> Word[8]^219 {
    let m: Word[8]^7 = magic();
    let length: Word[8]^4 = le_bytes(160);
    let f0: Word[8]^219 = for i in 0..7 with f: Word[8]^219 = [0; 219] { f with [i] = m[i] };
    let f1: Word[8]^219 = for i in 0..4 with f: Word[8]^219 = f0 { f with [7 + i] = length[i] };
    let f2: Word[8]^219 = for i in 0..160 with f: Word[8]^219 = f1 { f with [11 + i] = h[i] };
    for i in 0..32 with f: Word[8]^219 = f2 { f with [171 + i] = ciphertext[i] }
  }

  spec with_tag(sealed: Word[8]^219, t: Word[8]^16) -> Word[8]^219 {
    for i in 0..16 with f: Word[8]^219 = sealed { f with [203 + i] = t[i] }
  }

  spec frame_header(sealed: Word[8]^219) -> Word[8]^160 {
    for i in 0..160 with h: Word[8]^160 = [0; 160] { h with [i] = sealed[11 + i] }
  }

  spec frame_ciphertext(sealed: Word[8]^219) -> Word[8]^32 {
    for i in 0..32 with c: Word[8]^32 = [0; 32] { c with [i] = sealed[171 + i] }
  }

  spec frame_tag(sealed: Word[8]^219) -> Word[8]^16 {
    for i in 0..16 with t: Word[8]^16 = [0; 16] { t with [i] = sealed[203 + i] }
  }

  // RFC 8439 section 2.8: the tag is Poly1305, under the one-time key, of the
  // additional data padded with zeros to a multiple of sixteen bytes, the
  // ciphertext padded likewise, and both lengths as 64-bit little-endian
  // integers. Read from the frame: ten whole blocks of additional data, its
  // last eleven bytes padded, two blocks of ciphertext, and the lengths
  // 171 = 0xab and 32 = 0x20. The frame's tag bytes are not read.
  spec authenticator(key: Word[8]^32, nonce: Word[8]^12, sealed: Word[8]^219) -> Word[8]^16 {
    let otk: Word[8]^32 = one_time_key(key, nonce);
    let r: Int = poly_r(otk);
    let whole: Int = for j in 0..10 with a: Int = 0 {
      absorb(a, r, block_value(for i in 0..16 with b: Word[8]^16 = [0; 16] { b with [i] = sealed[16 * j + i] }, 1))
    };
    let padded: Int = absorb(whole, r, block_value(
      for i in 0..11 with b: Word[8]^16 = [0; 16] { b with [i] = sealed[160 + i] }, 1));
    let ciphered: Int = for j in 0..2 with a: Int = padded {
      absorb(a, r, block_value(for i in 0..16 with b: Word[8]^16 = [0; 16] { b with [i] = sealed[171 + 16 * j + i] }, 1))
    };
    let lengths: Word[8]^16 = [0xab, 0, 0, 0, 0, 0, 0, 0, 0x20, 0, 0, 0, 0, 0, 0, 0];
    tag(absorb(ciphered, r, block_value(lengths, 1)) + poly_s(otk))
  }

  // Seal `plaintext` for the header of `nonce` and `authorization_tag` under
  // `root`, as horizon_crypto.seal_framed does: the one-time key is ChaCha20
  // block 0, the ciphertext is block 1, and the tag covers the additional data
  // and the ciphertext.
  spec seal(
    root: Word[8]^32,
    nonce: Word[8]^12,
    authorization_tag: Word[8]^32,
    plaintext: Word[8]^32,
  ) -> Word[8]^219 {
    let h: Word[8]^160 = header(nonce, authorization_tag);
    let key: Word[8]^32 = derive_key(root, h);
    let f: Word[8]^219 = framed(h, encrypt_32(key, nonce, plaintext));
    with_tag(f, authenticator(key, nonce, f))
  }

  // The tag a frame should carry under `root`, recomputed from its header and
  // ciphertext.
  spec expected_tag(root: Word[8]^32, sealed: Word[8]^219) -> Word[8]^16 {
    let h: Word[8]^160 = frame_header(sealed);
    authenticator(derive_key(root, h), header_nonce(h), sealed)
  }

  // Whether `sealed` was sealed under `root`: its tag is the expected one.
  spec authentic(root: Word[8]^32, sealed: Word[8]^219) -> Bool {
    same_tag(expected_tag(root, sealed), frame_tag(sealed))
  }

  // Open `sealed` under `root`, as horizon_crypto.open_framed does: the
  // plaintext when the frame is authentic, and zeros otherwise. Only the chosen
  // branch is evaluated, so no plaintext is computed for a frame that does not
  // authenticate.
  spec open(root: Word[8]^32, sealed: Word[8]^219) -> Word[8]^32 {
    let h: Word[8]^160 = frame_header(sealed);
    let key: Word[8]^32 = derive_key(root, h);
    let nonce: Word[8]^12 = header_nonce(h);
    if same_tag(authenticator(key, nonce, sealed), frame_tag(sealed)) {
      encrypt_32(key, nonce, frame_ciphertext(sealed))
    } else {
      [0; 32]
    }
  }

  // ---- Examples ----
  //
  // The public interoperability vector of README.md. `orangec eval` prints
  // every specification without parameters, so daylight.py loads the program
  // only up to the line above.

  // The root key 00 01 02 ... 1f.
  spec root() -> Word[8]^32 {
    for i in 0..32 with k: Word[8]^32 = [0; 32] { k with [i] = i as Word[8] }
  }

  spec nonce() -> Word[8]^12 { [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01] }

  // 01 23 45 67 89 ab cd ef, four times: "0123456789abcdef" repeated in the header.
  spec authorization_tag() -> Word[8]^32 {
    for i in 0..4 with t: Word[8]^32 = [0; 32] {
      for j in 0..8 with u: Word[8]^32 = t { u with [8 * i + j] = 0x01 + 0x22 * (j as Word[8]) }
    }
  }

  // "Daylight Horizon runs in Orange."
  spec plaintext() -> Word[8]^32 {
    [
      0x44, 0x61, 0x79, 0x6c, 0x69, 0x67, 0x68, 0x74, 0x20, 0x48, 0x6f, 0x72, 0x69, 0x7a, 0x6f, 0x6e,
      0x20, 0x72, 0x75, 0x6e, 0x73, 0x20, 0x69, 0x6e, 0x20, 0x4f, 0x72, 0x61, 0x6e, 0x67, 0x65, 0x2e,
    ]
  }

  spec example() -> Word[8]^219 { seal(root(), nonce(), authorization_tag(), plaintext()) }

  // The frame horizon_crypto.seal_framed produces for these inputs at the
  // pinned revision; `example` must equal it, byte for byte.
  spec pinned_frame() -> Word[8]^219 {
    [
      0x44, 0x4c, 0x54, 0x48, 0x56, 0x31, 0x41, 0xa0, 0x00, 0x00, 0x00, 0x7b, 0x22, 0x61, 0x75, 0x74,
      0x68, 0x6f, 0x72, 0x69, 0x7a, 0x61, 0x74, 0x69, 0x6f, 0x6e, 0x22, 0x3a, 0x7b, 0x22, 0x61, 0x75,
      0x74, 0x68, 0x6f, 0x72, 0x69, 0x7a, 0x61, 0x74, 0x69, 0x6f, 0x6e, 0x5f, 0x74, 0x61, 0x67, 0x22,
      0x3a, 0x22, 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x61, 0x62, 0x63, 0x64,
      0x65, 0x66, 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x61, 0x62, 0x63, 0x64,
      0x65, 0x66, 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x61, 0x62, 0x63, 0x64,
      0x65, 0x66, 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x61, 0x62, 0x63, 0x64,
      0x65, 0x66, 0x22, 0x7d, 0x2c, 0x22, 0x6e, 0x6f, 0x6e, 0x63, 0x65, 0x22, 0x3a, 0x22, 0x30, 0x30,
      0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30,
      0x30, 0x30, 0x30, 0x30, 0x30, 0x31, 0x22, 0x2c, 0x22, 0x70, 0x6c, 0x61, 0x69, 0x6e, 0x74, 0x65,
      0x78, 0x74, 0x5f, 0x6c, 0x65, 0x6e, 0x22, 0x3a, 0x33, 0x32, 0x7d, 0x52, 0xa6, 0x74, 0x7c, 0xca,
      0xe6, 0xef, 0x15, 0x48, 0xb8, 0x6f, 0x1e, 0xab, 0xbf, 0xa9, 0x56, 0x9f, 0x81, 0x5f, 0x01, 0x84,
      0x1a, 0x4b, 0x7f, 0x17, 0x38, 0x4f, 0xac, 0xd1, 0x77, 0x2f, 0xb5, 0xdb, 0xff, 0x15, 0x31, 0xab,
      0x89, 0xbb, 0x41, 0x61, 0xa5, 0xaf, 0xca, 0x9e, 0xa0, 0x71, 0x7c,
    ]
  }

  // Opening the pinned frame gives the plaintext back.
  spec recovered() -> Word[8]^32 { open(root(), pinned_frame()) }
}
